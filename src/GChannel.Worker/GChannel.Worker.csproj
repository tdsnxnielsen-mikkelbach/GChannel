<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>c8d2f7a1-4f3b-4f9d-9c2a-7e6b1a0d5e44</UserSecretsId>
    <!-- Worker SDK doesn't enable SDK container publish by default (Web SDK does); azd needs it. -->
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Microsoft.Azure.StackExchangeRedis" Version="13.5.0" />
    <PackageReference Include="Aspire.StackExchange.Redis" Version="13.5.0" />
    <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" Version="13.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GChannel.Core\GChannel.Core.csproj" />
    <ProjectReference Include="..\GChannel.ServiceDefaults\GChannel.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
