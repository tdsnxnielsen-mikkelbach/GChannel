<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>c8d2f7a1-4f3b-4f9d-9c2a-7e6b1a0d5e44</UserSecretsId>
    <!-- Worker SDK doesn't enable SDK container publish by default (Web SDK does); azd needs it. -->
    <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Microsoft.Azure.StackExchangeRedis" Version="13.6.4" />
    <PackageReference Include="Aspire.StackExchange.Redis" Version="13.6.4" />
    <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" Version="13.6.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GChannel.Core\GChannel.Core.csproj" />
    <ProjectReference Include="..\GChannel.ServiceDefaults\GChannel.ServiceDefaults.csproj" />
  </ItemGroup>

  <!-- Wolverine code pre-generated by `codegen write` (azd predeploy hook) is compiled only into the Release builds
       azd publishes, which load it in TypeLoadMode.Static. Debug builds (dev, tests) compile it at runtime, so
       leftover generated files never break them. -->
  <ItemGroup Condition="'$(Configuration)' != 'Release'">
    <Compile Remove="Internal\Generated\**" />
  </ItemGroup>

</Project>
