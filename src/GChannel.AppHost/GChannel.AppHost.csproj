<Project Sdk="Aspire.AppHost.Sdk/13.6.4">

  <ItemGroup>
    <ProjectReference Include="..\GChannel.ApiService\GChannel.ApiService.csproj" />
    <ProjectReference Include="..\GChannel.Web\GChannel.Web.csproj" />
    <ProjectReference Include="..\GChannel.Worker\GChannel.Worker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.AppContainers" Version="13.6.4" />
    <PackageReference Include="Aspire.Hosting.Azure.KeyVault" Version="13.6.4" />
    <PackageReference Include="Aspire.Hosting.Azure.PostgreSQL" Version="13.6.4" />
    <PackageReference Include="Aspire.Hosting.Azure.Redis" Version="13.6.4" />
    <PackageReference Include="Aspire.Hosting.Azure.ServiceBus" Version="13.6.4" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>3721c89f-db66-48d9-bf4c-06b182626d81</UserSecretsId>
    <!-- We deploy via azd, not the Aspire CLI bundle; suppress the 13.5 advisory to keep the build clean. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

</Project>
