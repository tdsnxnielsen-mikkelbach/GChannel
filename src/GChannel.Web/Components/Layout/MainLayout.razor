@inherits LayoutComponentBase
@implements IDisposable
@inject OnboardingTourService Tour
@inject ThemeService Theme
@inject CookieThemeService CookieTheme

@* Radzen's dialog / notification / tooltip / context-menu hosts, rendered once and driven from any page through
   their services. CookieThemeService is injected (not otherwise used) so it starts persisting the chosen theme. *@
<RadzenComponents @rendermode="InteractiveServer" />

@* Plain wrapper so the scoped CSS (::deep selectors) in MainLayout.razor.css reaches the Radzen markup. *@
<div class="gchannel-shell">
<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-px-3" Style="height: 100%">
            <RadzenSidebarToggle Click="@(() => _sidebarExpanded = !_sidebarExpanded)" />
            <RadzenText TextStyle="TextStyle.H6" TagName="TagName.Span" class="rz-m-0">GChannel</RadzenText>
            <span style="flex: 1 1 auto"></span>
            <Tip Text="Take the product tour" Position="TooltipPosition.Bottom">
                <RadzenButton Icon="@AppIcons.HelpOutline" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Click="StartTourAsync"
                              data-onboarding="appbar-help" aria-label="Take the product tour" />
            </Tip>
            <span data-onboarding="appbar-theme">
                <RadzenAppearanceToggle />
            </span>
            <AuthorizeView>
                <Authorized>
                    <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.Span" class="rz-mx-2 rz-display-none rz-display-md-inline-block">@context.User.Identity?.Name</RadzenText>
                    <form action="/account/logout" method="post" class="rz-display-inline">
                        <AntiforgeryToken />
                        <RadzenButton ButtonType="ButtonType.Submit" Text="Sign out" Icon="@AppIcons.Logout" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Size="ButtonSize.Small" />
                    </form>
                </Authorized>
                <NotAuthorized>
                    <LinkButton To="/account/login" Text="Sign in with Google" Icon="@AppIcons.Login" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Size="ButtonSize.Small" />
                </NotAuthorized>
            </AuthorizeView>
        </RadzenStack>
    </RadzenHeader>
    <RadzenSidebar @bind-Expanded="_sidebarExpanded" class="gchannel-sidebar">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="gchannel-brand rz-px-4 rz-py-3">
            <RadzenIcon Icon="@AppIcons.Hub" />
            <RadzenLink Path="" Text="Channel Partner" class="gchannel-brand-link" />
        </RadzenStack>
        <NavMenu />
    </RadzenSidebar>
    <RadzenBody>
        <div class="gchannel-content">
            <CascadingValue Name="IsDarkMode" Value="_isDarkMode">
                @Body
            </CascadingValue>
        </div>
    </RadzenBody>
</RadzenLayout>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _sidebarExpanded = true;
    private bool _isDarkMode;

    protected override void OnInitialized()
    {
        _isDarkMode = IsDark(Theme.Theme);
        Theme.ThemeChanged += OnThemeChanged;
    }

    // Cascaded to the pages so ApexCharts (which paints its own axis/legend text) follows the Radzen theme.
    private static bool IsDark(string? theme) => theme?.EndsWith("-dark", StringComparison.OrdinalIgnoreCase) == true || string.Equals(theme, "dark", StringComparison.OrdinalIgnoreCase);

    private void OnThemeChanged()
    {
        var dark = IsDark(Theme.Theme);
        if (dark != _isDarkMode)
        {
            _isDarkMode = dark;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private Task StartTourAsync() => Tour.StartAsync();

    public void Dispose() => Theme.ThemeChanged -= OnThemeChanged;
}
