@inherits LayoutComponentBase
@using Blazorise
@using Blazorise.Components
@inject IJSRuntime JS
@inject OnboardingTourService Tour

@* Blazorise providers: toasts (INotificationService), confirm dialogs (IMessageService), dynamic modals and the
   page progress bar are rendered once here and driven from any page through their services. *@
<NotificationProvider Location="NotificationLocation.End" />
<MessageProvider />
<ModalProvider />
<PageProgressProvider />

<Layout Sider>
    <LayoutSider>
        <LayoutSiderContent>
            <Bar @ref="_sidebar"
                 Mode="BarMode.VerticalInline"
                 CollapseMode="BarCollapseMode.Hide"
                 Breakpoint="Breakpoint.Desktop"
                 NavigationBreakpoint="Breakpoint.Tablet"
                 ThemeContrast="ThemeContrast.Dark"
                 Class="gchannel-sidebar">
                <BarBrand>
                    <BarItem>
                        <BarLink To="">
                            <Icon Name="@AppIcons.Hub" Class="me-2" /> Channel Partner
                        </BarLink>
                    </BarItem>
                </BarBrand>
                <BarMenu>
                    <BarStart>
                        <NavMenu />
                    </BarStart>
                </BarMenu>
            </Bar>
        </LayoutSiderContent>
    </LayoutSider>
    <Layout>
        <LayoutHeader Fixed>
            <Bar Breakpoint="Breakpoint.Desktop" Background="Background.Light" ThemeContrast="ThemeContrast.Light" Class="gchannel-appbar border-bottom">
                <BarToggler Bar="@_sidebar" />
                <BarBrand>GChannel</BarBrand>
                <BarMenu>
                    <BarEnd>
                        <BarItem>
                            <Tooltip Text="Take the product tour" Placement="TooltipPlacement.Bottom">
                                <Button Color="Color.Light" Clicked="StartTourAsync" data-onboarding="appbar-help" aria-label="Take the product tour">
                                    <Icon Name="@AppIcons.HelpOutline" />
                                </Button>
                            </Tooltip>
                        </BarItem>
                        <BarItem>
                            <Button Color="Color.Light" Clicked="ToggleDarkModeAsync" data-onboarding="appbar-theme" aria-label="Toggle light / dark theme">
                                <Icon Name="@(_isDarkMode ? AppIcons.LightMode : AppIcons.DarkMode)" />
                            </Button>
                        </BarItem>
                        <AuthorizeView>
                            <Authorized>
                                <BarItem>
                                    <Text Class="mx-3 d-none d-md-inline">@context.User.Identity?.Name</Text>
                                </BarItem>
                                <BarItem>
                                    <form action="/account/logout" method="post" class="d-inline">
                                        <AntiforgeryToken />
                                        <Button Type="ButtonType.Submit" Color="Color.Secondary" Outline>
                                            <Icon Name="@AppIcons.Logout" Class="me-1" /> Sign out
                                        </Button>
                                    </form>
                                </BarItem>
                            </Authorized>
                            <NotAuthorized>
                                <BarItem>
                                    <Button Type="ButtonType.Link" To="/account/login" Color="Color.Primary" Outline>
                                        <Icon Name="@AppIcons.Login" Class="me-1" /> Sign in with Google
                                    </Button>
                                </BarItem>
                            </NotAuthorized>
                        </AuthorizeView>
                    </BarEnd>
                </BarMenu>
            </Bar>
        </LayoutHeader>
        <LayoutContent Padding="Padding.Is4.OnX.Is4.OnY">
            <Container Fluid Class="gchannel-content">
                <CascadingValue Name="IsDarkMode" Value="_isDarkMode">
                    @Body
                </CascadingValue>
            </Container>
        </LayoutContent>
    </Layout>
</Layout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // Browser localStorage key the chosen theme is persisted under so it survives a page refresh.
    private const string ThemeStorageKey = "gchannel-theme";

    private Bar _sidebar = null!;
    private bool _isDarkMode;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // localStorage / matchMedia are only reachable once the interactive circuit is connected (not during
        // the static prerender), so restore the saved preference here and re-render with the right theme.
        var stored = await JS.InvokeAsync<string?>("localStorage.getItem", ThemeStorageKey);
        _isDarkMode = stored switch
        {
            "dark" => true,
            "light" => false,
            // No saved choice yet: honour the operating-system / browser preference.
            _ => await JS.InvokeAsync<bool>("gchannelTheme.prefersDark")
        };
        await ApplyThemeAsync();
        StateHasChanged();
    }

    private async Task ToggleDarkModeAsync()
    {
        _isDarkMode = !_isDarkMode;
        await JS.InvokeVoidAsync("localStorage.setItem", ThemeStorageKey, _isDarkMode ? "dark" : "light");
        await ApplyThemeAsync();
    }

    // Bootstrap 5.3 colour modes: every Bootstrap/Blazorise component follows the data-bs-theme attribute on <html>.
    private Task ApplyThemeAsync() =>
        JS.InvokeVoidAsync("gchannelTheme.apply", _isDarkMode ? "dark" : "light").AsTask();

    private Task StartTourAsync() => Tour.StartAsync();
}
