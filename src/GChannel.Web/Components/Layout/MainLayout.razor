@inherits LayoutComponentBase
@inject IJSRuntime JS

<MudThemeProvider @ref="_mudThemeProvider" Theme="_theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        <MudText Typo="Typo.h6" Class="ml-2">GChannel</MudText>
        <MudSpacer />
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" OnClick="ToggleDarkModeAsync" />
        <AuthorizeView>
            <Authorized>
                <MudText Typo="Typo.body2" Class="mx-3">@context.User.Identity?.Name</MudText>
                <form action="/account/logout" method="post">
                    <AntiforgeryToken />
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined"
                               Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Logout">
                        Sign out
                    </MudButton>
                </form>
            </Authorized>
            <NotAuthorized>
                <MudButton Href="/account/login" Variant="Variant.Outlined" Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Login">
                    Sign in with Google
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" ClipMode="DrawerClipMode.Always">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">Channel Partner</MudText>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-6">
            <CascadingValue Name="IsDarkMode" Value="_isDarkMode">
                @Body
            </CascadingValue>
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // Browser localStorage key the chosen theme is persisted under so it survives a page refresh.
    private const string ThemeStorageKey = "gchannel-theme";

    private bool _drawerOpen = true;
    private bool _isDarkMode;
    private MudThemeProvider _mudThemeProvider = null!;
    private readonly MudTheme _theme = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // localStorage is only reachable once the interactive circuit is connected (not during the
        // static prerender), so restore the saved preference here and re-render with the right theme.
        var stored = await JS.InvokeAsync<string?>("localStorage.getItem", ThemeStorageKey);
        _isDarkMode = stored switch
        {
            "dark" => true,
            "light" => false,
            // No saved choice yet: honour the operating-system / browser preference.
            _ => await _mudThemeProvider.GetSystemDarkModeAsync()
        };
        StateHasChanged();
    }

    private async Task ToggleDarkModeAsync()
    {
        _isDarkMode = !_isDarkMode;
        await JS.InvokeVoidAsync("localStorage.setItem", ThemeStorageKey, _isDarkMode ? "dark" : "light");
    }
}
