@page "/support/cases/{CaseId}"
@attribute [Authorize]
@implements IDisposable
@inject GChannelApiClient Api
@inject UiNotifier Snackbar

<PageTitle>Case @CaseId · Support · GChannel</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap" class="rz-mb-4">
    <RadzenStack Gap="0.25rem">
        <RadzenLink Path="/support" Text="← Support" />
        <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">@(_detail?.Case.DisplayName ?? $"Case {CaseId}")</RadzenText>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">#@CaseId</RadzenText>
            @if (_detail is { } d)
            {
                <RadzenBadge BadgeStyle="@Support.StateStyle(d.Case.State)" Text="@Support.StateLabel(d.Case.State)" />
                <RadzenBadge BadgeStyle="@Support.PriorityStyle(d.Case.Priority)" Variant="Variant.Outlined" Text="@(d.Case.Priority ?? "—")" />
                @if (d.Case.Escalated) { <RadzenBadge BadgeStyle="BadgeStyle.Danger" Variant="Variant.Flat" Text="Escalated" /> }
                @if (d.Case.TestCase) { <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="Test case" /> }
            }
        </RadzenStack>
    </RadzenStack>
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" data-walkthrough="case-actions">
        <GuidedWalkthrough Id="support-case" Steps="_walkthrough" />
        <RadzenButton Text="Refresh from Google" Icon="@AppIcons.Refresh" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Click="@(() => LoadAsync(refresh: true))" Disabled="_busy" />
        @if (_detail?.Case.IsOpen == true)
        {
            @if (!_detail.Case.Escalated)
            {
                <RadzenButton Text="Escalate" Icon="@AppIcons.PriorityHigh" ButtonStyle="ButtonStyle.Warning" Variant="Variant.Outlined" Click="@(() => _showEscalate = !_showEscalate)" Disabled="_busy" />
            }
            <RadzenButton Text="Close case" Icon="@AppIcons.CheckCircle" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="CloseAsync" Disabled="_busy" />
        }
    </RadzenStack>
</RadzenStack>

@if (_loading && _detail is null)
{
    <LoadingPanel Title="Loading case…" Hint="Reading the case, its comments and attachments." />
}
else if (_detail is null)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">
        Case @CaseId was not found in the mirror and could not be read from Google.
    </RadzenAlert>
}
else
{
    @if (!string.IsNullOrEmpty(_detail.RefreshError))
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-mb-4">
            Refresh failed (@_detail.RefreshError) — showing the copy synced @DisplayFormat.Timestamp(_detail.LastSyncedUtc) UTC.
        </RadzenAlert>
    }

    @if (_showEscalate)
    {
        <RadzenCard Variant="Variant.Outlined" class="rz-mb-4">
            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Escalate case</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-mb-3">
                Escalation brings in a Customer Care manager. It needs a support plan that allows escalations and is meant for
                cases that are stuck or business-critical.
            </RadzenText>
            <RadzenStack Gap="1rem">
                <RadzenFormField Text="Reason" Variant="Variant.Outlined" Style="max-width: 360px">
                    <RadzenDropDown @bind-Value="_escalationReason" Data="EscalationReasons" TextProperty="Text" ValueProperty="Value" Name="escalationReason" />
                </RadzenFormField>
                <RadzenFormField Text="Justification" Variant="Variant.Outlined" Style="width: 100%">
                    <RadzenTextArea @bind-Value="_escalationJustification" Rows="3" MaxLength="1000" Name="escalationJustification" />
                </RadzenFormField>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenButton Text="Escalate" Icon="@AppIcons.PriorityHigh" ButtonStyle="ButtonStyle.Warning" Click="EscalateAsync"
                                  Disabled="@(_busy || string.IsNullOrWhiteSpace(_escalationJustification))" />
                    <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Click="@(() => _showEscalate = false)" />
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    }

    <RadzenRow Gap="1rem" RowGap="1rem">
        <RadzenColumn Size="12" SizeLG="8">
            <RadzenCard Variant="Variant.Filled" class="rz-mb-4">
                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">Description</RadzenText>
                <RadzenText TextStyle="TextStyle.Body1" class="rz-m-0" Style="white-space: pre-wrap; overflow-wrap: anywhere">@(_detail.Case.Description ?? "—")</RadzenText>
            </RadzenCard>

            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Comments (@_detail.Comments.Count)</RadzenText>
            <div data-walkthrough="case-comments">
                @if (_detail.Comments.Count == 0)
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-mb-4">No comments yet.</RadzenText>
                }
                @foreach (var comment in _detail.Comments)
                {
                    <RadzenCard Variant="@(comment.FromGoogleSupport ? Variant.Outlined : Variant.Filled)" class="rz-mb-3">
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-2">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <RadzenIcon Icon="@(comment.FromGoogleSupport ? AppIcons.SupportAgent : AppIcons.Person)" />
                                <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-m-0">@(comment.FromGoogleSupport ? "Google Support" : comment.CreatorName ?? comment.CreatorEmail ?? "Us")</RadzenText>
                            </RadzenStack>
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">@DisplayFormat.Timestamp(comment.CreateTime)</RadzenText>
                        </RadzenStack>
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0" Style="white-space: pre-wrap; overflow-wrap: anywhere">@comment.Body</RadzenText>
                    </RadzenCard>
                }
            </div>

            @if (_detail.Case.IsOpen)
            {
                <RadzenCard Variant="Variant.Outlined" data-walkthrough="case-reply">
                    <RadzenFormField Text="Add a comment" Variant="Variant.Outlined" Style="width: 100%" class="rz-mb-2">
                        <RadzenTextArea @bind-Value="_comment" Rows="4" MaxLength="10000" Name="supportComment" />
                    </RadzenFormField>
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">Sent as the service account, signed with your name.</RadzenText>
                        <RadzenButton Text="Send" Icon="@AppIcons.Send" ButtonStyle="ButtonStyle.Primary" Click="CommentAsync" Disabled="@(_busy || string.IsNullOrWhiteSpace(_comment))" />
                    </RadzenStack>
                </RadzenCard>
            }
        </RadzenColumn>

        <RadzenColumn Size="12" SizeLG="4">
            <RadzenCard Variant="Variant.Filled" class="rz-mb-4">
                <DetailRow Label="Classification">@(_detail.Case.ClassificationName ?? "—")</DetailRow>
                <DetailRow Label="Created">@DisplayFormat.Timestamp(_detail.Case.CreateTime)</DetailRow>
                <DetailRow Label="Updated">@DisplayFormat.Timestamp(_detail.Case.UpdateTime)</DetailRow>
                <DetailRow Label="Creator">@(_detail.Case.CreatorName ?? _detail.Case.CreatorEmail ?? "—")</DetailRow>
                <DetailRow Label="Contact">@(_detail.Case.ContactEmail ?? "—")</DetailRow>
                <DetailRow Label="Subscribers">@(_detail.Case.SubscriberEmailAddresses.Count > 0 ? string.Join(", ", _detail.Case.SubscriberEmailAddresses) : "—")</DetailRow>
                <DetailRow Label="Language">@(_detail.Case.LanguageCode ?? "—")</DetailRow>
                <DetailRow Label="Last synced">@DisplayFormat.Timestamp(_detail.LastSyncedUtc)</DetailRow>
            </RadzenCard>

            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Attachments (@_detail.Attachments.Count)</RadzenText>
            <RadzenCard Variant="Variant.Filled" class="rz-mb-4">
                @if (_detail.Attachments.Count == 0)
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">None.</RadzenText>
                }
                @foreach (var a in _detail.Attachments)
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-py-1">
                        <RadzenIcon Icon="@AppIcons.AttachFile" />
                        <div>
                            <div style="overflow-wrap: anywhere">@(a.Filename ?? a.Name)</div>
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">
                                @Size(a.SizeBytes) · @(a.CreatorName ?? "—") · @DisplayFormat.Timestamp(a.CreateTime)
                            </RadzenText>
                        </div>
                    </RadzenStack>
                }
                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-mt-2 rz-mb-0">Download attachments from the Google Cloud console.</RadzenText>
            </RadzenCard>

            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Events</RadzenText>
            <RadzenCard Variant="Variant.Filled">
                @if (_detail.Events.Count == 0)
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-m-0">No events received for this case.</RadzenText>
                }
                @foreach (var e in _detail.Events)
                {
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-py-1">
                        <RadzenBadge BadgeStyle="@Support.EventStyle(e.NotificationType)" Variant="Variant.Flat" Text="@Support.EventLabel(e.NotificationType)" />
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">@DisplayFormat.Timestamp(e.ReceivedAt)</RadzenText>
                    </RadzenStack>
                }
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>
}

@code {
    [Parameter] public string CaseId { get; set; } = string.Empty;

    private static readonly IReadOnlyList<WalkthroughStep> _walkthrough =
    [
        new("[data-walkthrough=\"case-actions\"]", "Case actions", "Re-read the case from Google, escalate it, or close it once it's resolved."),
        new("[data-walkthrough=\"case-comments\"]", "Conversation", "The full comment thread — Google Support's replies are outlined."),
        new("[data-walkthrough=\"case-reply\"]", "Reply", "Comments are posted with the service account and signed with your name."),
    ];

    private sealed record Option(string Value, string Text);

    private static readonly IReadOnlyList<Option> EscalationReasons =
    [
        new("RESOLUTION_TIME", "Resolution is taking too long"),
        new("TECHNICAL_EXPERTISE", "Needs more technical expertise"),
        new("BUSINESS_IMPACT", "Business impact has increased"),
    ];

    private readonly CancellationTokenSource _cts = new();

    private SupportCaseDetail? _detail;
    private bool _loading = true;
    private bool _busy;
    private string? _comment;
    private bool _showEscalate;
    private string _escalationReason = "RESOLUTION_TIME";
    private string? _escalationJustification;

    protected override async Task OnParametersSetAsync()
    {
        _detail = null;
        _showEscalate = false;
        await LoadAsync(refresh: false);
    }

    private async Task LoadAsync(bool refresh)
    {
        CancellationToken token;
        try
        {
            token = _cts.Token;
        }
        catch (ObjectDisposedException)
        {
            return;
        }

        _loading = true;
        _busy = true;
        try
        {
            _detail = await Api.GetSupportCaseAsync(CaseId, refresh, token);
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            return;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            _detail = null;
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load case {CaseId}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            _busy = false;
        }
    }

    private async Task CommentAsync()
    {
        if (string.IsNullOrWhiteSpace(_comment))
        {
            return;
        }

        await RunAsync(async token =>
        {
            _detail = await Api.AddSupportCommentAsync(CaseId, _comment, token) ?? _detail;
            _comment = null;
            await Snackbar.Add("Comment sent to Google Support.", Severity.Success);
        }, "send the comment");
    }

    private async Task CloseAsync()
    {
        if (!await Snackbar.ConfirmAsync("Close case", $"Close case {CaseId}? Google stops working on it; open a new case if the problem returns.", "Close case"))
        {
            return;
        }

        await RunAsync(async token =>
        {
            _detail = await Api.CloseSupportCaseAsync(CaseId, token) ?? _detail;
            await Snackbar.Add("Case closed.", Severity.Success);
        }, "close the case");
    }

    private async Task EscalateAsync()
    {
        if (string.IsNullOrWhiteSpace(_escalationJustification))
        {
            return;
        }

        await RunAsync(async token =>
        {
            _detail = await Api.EscalateSupportCaseAsync(CaseId,
                new EscalateSupportCaseRequest { Reason = _escalationReason, Justification = _escalationJustification }, token) ?? _detail;
            _showEscalate = false;
            _escalationJustification = null;
            await Snackbar.Add("Case escalated.", Severity.Success);
        }, "escalate the case");
    }

    private async Task RunAsync(Func<CancellationToken, Task> action, string what)
    {
        CancellationToken token;
        try
        {
            token = _cts.Token;
        }
        catch (ObjectDisposedException)
        {
            return;
        }

        _busy = true;
        try
        {
            await action(token);
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            return;
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to {what}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string Size(long? bytes) => bytes switch
    {
        null => "—",
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        _ => $"{bytes / (1024.0 * 1024):0.#} MB"
    };

    public void Dispose()
    {
        try
        {
            _cts.Cancel();
        }
        catch (ObjectDisposedException)
        {
        }

        _cts.Dispose();
    }
}
