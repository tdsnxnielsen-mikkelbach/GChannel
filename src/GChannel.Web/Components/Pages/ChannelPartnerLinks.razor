@page "/channel-partner-links"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject UiNotifier Snackbar

<PageTitle>Channel partner links · GChannel</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap" class="rz-mb-4">
    <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">Channel partner links</RadzenText>
    <LinkButton To="/channel-partner-links/new" Text="Invite partner" Icon="@AppIcons.AddLink" />
</RadzenStack>

<RadzenText TextStyle="TextStyle.Body1" class="rz-text-secondary-color rz-mb-4">
    Downstream resellers (channel partners) linked to your distributor account. Paging, sorting and
    search run server-side against the synced read-model. Open a link to view its details and customers.
</RadzenText>

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap" class="rz-mb-2">
    <SearchBox Value="@_search" ValueChanged="OnSearchChanged" Label="Search domain, cloud id, link id…" />
    <AsOfBadge AsOf="_asOf" />
</RadzenStack>

<RadzenCard Variant="Variant.Filled">
    <RadzenDataGrid @ref="_grid" TItem="EstateReseller" Data="_items" Count="_total" LoadData="OnLoadData" IsLoading="_loading"
                    AllowPaging="true" PageSize="25" PageSizeOptions="_pageSizes" ShowPagingSummary="true"
                    AllowSorting="true" Density="Density.Compact" GridLines="DataGridGridLines.Horizontal" Responsive="true">
        <Columns>
            <RadzenDataGridColumn TItem="EstateReseller" Property="@nameof(EstateReseller.PrimaryDomain)" SortProperty="domain" Title="Reseller Cloud Identity">
                <Template Context="r">@(r.PrimaryDomain ?? r.ResellerCloudId ?? r.LinkId)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="EstateReseller" Property="@nameof(EstateReseller.CustomerCount)" Title="Customers" Sortable="false" Width="110px" />
            <RadzenDataGridColumn TItem="EstateReseller" Title="Billed (last month)" Sortable="false">
                <Template Context="r">
                    @if (BilledLabel(r.LinkId) is { } billed)
                    {
                        <Tip Text="Actual billed GCP/Marketplace spend across this reseller's customers (BigQuery cost export).">@billed</Tip>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="EstateReseller" Property="@nameof(EstateReseller.LinkState)" SortProperty="state" Title="State">
                <Template Context="r">
                    <RadzenBadge BadgeStyle="@StateColor(r.LinkState)" Text="@(string.IsNullOrEmpty(r.LinkState) ? "—" : r.LinkState)" />
                    @if (!string.IsNullOrEmpty(r.SyncError))
                    {
                        <Tip Text="@r.SyncError">
                            <RadzenIcon Icon="@AppIcons.Warning" IconColor="@Colors.Warning" class="rz-ms-1" />
                        </Tip>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="EstateReseller" Property="@nameof(EstateReseller.CreateTime)" SortProperty="created" Title="Created" Width="110px">
                <Template Context="r">@(r.CreateTime?.ToString("yyyy-MM-dd") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="EstateReseller" Title="Actions" Sortable="false" TextAlign="TextAlign.End" Width="110px">
                <Template Context="r">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.25rem" class="rz-text-nowrap">
                        <Tip Text="Refresh now">
                            <RadzenButton Icon="@AppIcons.Sync" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Click="@(() => ResyncAsync(r))" aria-label="Refresh now" />
                        </Tip>
                        <Tip Text="View">
                            <LinkButton To="@($"/channel-partner-links/{r.LinkId}")" Icon="@AppIcons.Visibility" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Title="View" />
                        </Tip>
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
        <EmptyTemplate>
            @if (_loading)
            {
                <LoadingPanel Title="Loading channel partner links…" Hint="Querying the synced read-model." />
            }
            else
            {
                <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-m-3">No channel partner links yet. Use <strong>Invite partner</strong> to link a downstream reseller.</RadzenAlert>
            }
        </EmptyTemplate>
    </RadzenDataGrid>
</RadzenCard>

@code {
    private static readonly IEnumerable<int> _pageSizes = [25, 50, 100];
    private RadzenDataGrid<EstateReseller>? _grid;
    private List<EstateReseller> _items = [];
    private int _total;
    private bool _loading = true;
    private string? _search;
    private DateTimeOffset? _asOf;

    // Server-side read: Radzen gives Skip/Top, the API takes a 0-based page; sort keys come from SortProperty.
    private async Task OnLoadData(LoadDataArgs args)
    {
        _loading = true;
        var pageSize = args.Top ?? 25;
        var page = pageSize == 0 ? 0 : (args.Skip ?? 0) / pageSize;
        var sort = args.Sorts?.FirstOrDefault();
        try
        {
            await EnsureBilledAsync(CancellationToken.None);
            var result = await Api.ListEstateResellersAsync(
                page, pageSize, sort?.Property,
                sort?.SortOrder == SortOrder.Descending,
                _search, state: null, CancellationToken.None);

            _items = result?.Items?.ToList() ?? [];
            _total = result?.Total ?? 0;
            _asOf = result?.AsOf;
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load channel partner links: {ex.Message}", Severity.Error);
            _items = [];
            _total = 0;
        }
        finally
        {
            _loading = false;
        }
    }

    // Billed (actual) spend per reseller link for the list column — loaded once, best-effort.
    private readonly Dictionary<string, (decimal Cost, string Currency)> _billed = new(StringComparer.OrdinalIgnoreCase);
    private bool _billedLoaded;

    private async Task EnsureBilledAsync(CancellationToken token)
    {
        if (_billedLoaded) { return; }
        _billedLoaded = true;
        try
        {
            var result = await Api.GetResellerSpendAsync(1, token);
            foreach (var g in (result?.Resellers ?? [])
                .Where(r => r.OwningLinkId != null)
                .GroupBy(r => r.OwningLinkId!, StringComparer.OrdinalIgnoreCase))
            {
                var top = g.OrderByDescending(x => x.Cost).First();
                _billed[g.Key] = (top.Cost, top.Currency);
            }
        }
        catch
        {
            // Best-effort column; leave blanks if the billed lookup fails.
        }
    }

    private string? BilledLabel(string linkId) =>
        _billed.TryGetValue(linkId, out var v)
            ? $"{v.Currency} {v.Cost.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)}"
            : null;

    private async Task OnSearchChanged(string? value)
    {
        _search = value;
        await (_grid?.FirstPage(true) ?? Task.CompletedTask);
    }

    private async Task ResyncAsync(EstateReseller link)
    {
        try
        {
            await Api.ResyncLinkAsync(link.LinkId);
            await Snackbar.Add("Queued for refresh — data updates on the next sync cycle.", Severity.Info);
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to queue refresh: {ex.Message}", Severity.Error);
        }
    }

    private static BadgeStyle StateColor(string? state) => state?.ToUpperInvariant() switch
    {
        "ACTIVE" => BadgeStyle.Success,
        "INVITED" => BadgeStyle.Info,
        "SUSPENDED" => BadgeStyle.Warning,
        "REVOKED" => BadgeStyle.Danger,
        _ => BadgeStyle.Light
    };
}
