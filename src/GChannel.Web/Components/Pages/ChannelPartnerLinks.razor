@page "/channel-partner-links"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Channel partner links · GChannel</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h4">Channel partner links</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.AddLink"
               Href="/channel-partner-links/new">
        Invite partner
    </MudButton>
</div>

<MudText Typo="Typo.body1" Class="mb-4" Color="Color.Secondary">
    Downstream resellers (channel partners) linked to your distributor account. Paging, sorting and
    search run server-side against the synced read-model. Open a link to view its details and customers.
</MudText>

<div class="d-flex justify-space-between align-center mb-2">
    <MudTextField T="string" @bind-Value="_search" Immediate="false" DebounceInterval="400"
                  OnDebounceIntervalElapsed="OnSearchChanged" Placeholder="Search domain, cloud id, link id…"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:360px" />
    <AsOfBadge AsOf="_asOf" />
</div>

<MudTable @ref="_table" ServerData="LoadServerData" Hover="true" Elevation="2" Dense="false" RowsPerPage="25">
    <HeaderContent>
        <MudTh><MudTableSortLabel SortLabel="domain" T="EstateReseller">Reseller Cloud Identity</MudTableSortLabel></MudTh>
        <MudTh>Customers</MudTh>
        <MudTh><MudTableSortLabel SortLabel="state" T="EstateReseller">State</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortLabel="created" T="EstateReseller">Created</MudTableSortLabel></MudTh>
        <MudTh Style="text-align:right">Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Reseller Cloud Identity">@(context.PrimaryDomain ?? context.ResellerCloudId ?? context.LinkId)</MudTd>
        <MudTd DataLabel="Customers">@context.CustomerCount</MudTd>
        <MudTd DataLabel="State">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@StateColor(context.LinkState)">
                @(string.IsNullOrEmpty(context.LinkState) ? "—" : context.LinkState)
            </MudChip>
            @if (!string.IsNullOrEmpty(context.SyncError))
            {
                <MudTooltip Text="@context.SyncError">
                    <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Small" />
                </MudTooltip>
            }
        </MudTd>
        <MudTd DataLabel="Created">@(context.CreateTime?.ToString("yyyy-MM-dd") ?? "—")</MudTd>
        <MudTd DataLabel="Actions" Style="text-align:right">
            <MudTooltip Text="Refresh now">
                <MudIconButton Icon="@Icons.Material.Filled.Sync" Size="Size.Small"
                               OnClick="@(() => ResyncAsync(context))" />
            </MudTooltip>
            <MudTooltip Text="View">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                               Href="@($"/channel-partner-links/{context.LinkId}")" />
            </MudTooltip>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudAlert Severity="Severity.Info">No channel partner links yet. Use <strong>Invite partner</strong> to link a downstream reseller.</MudAlert>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" />
    </PagerContent>
</MudTable>

@code {
    private MudTable<EstateReseller>? _table;
    private string? _search;
    private DateTimeOffset? _asOf;

    private async Task<TableData<EstateReseller>> LoadServerData(TableState state, CancellationToken token)
    {
        try
        {
            var result = await Api.ListEstateResellersAsync(
                state.Page, state.PageSize, state.SortLabel,
                state.SortDirection == SortDirection.Descending,
                _search, state: null, token);

            _asOf = result?.AsOf;
            await InvokeAsync(StateHasChanged); // re-render the parent so the As-of badge reflects the loaded data
            return new TableData<EstateReseller> { Items = result?.Items ?? [], TotalItems = result?.Total ?? 0 };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load channel partner links: {ex.Message}", Severity.Error);
            return new TableData<EstateReseller> { Items = [], TotalItems = 0 };
        }
    }

    private async Task OnSearchChanged(string _) => await (_table?.ReloadServerData() ?? Task.CompletedTask);

    private async Task ResyncAsync(EstateReseller link)
    {
        try
        {
            await Api.ResyncLinkAsync(link.LinkId);
            Snackbar.Add("Queued for refresh — data updates on the next sync cycle.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to queue refresh: {ex.Message}", Severity.Error);
        }
    }

    private static Color StateColor(string? state) => state?.ToUpperInvariant() switch
    {
        "ACTIVE" => Color.Success,
        "INVITED" => Color.Info,
        "SUSPENDED" => Color.Warning,
        "REVOKED" => Color.Error,
        _ => Color.Default
    };
}
