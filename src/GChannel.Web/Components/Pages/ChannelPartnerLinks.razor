@page "/channel-partner-links"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject UiNotifier Snackbar

<PageTitle>Channel partner links · GChannel</PageTitle>

<Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Margin="Margin.Is4.FromBottom">
    <Heading Size="HeadingSize.Is3" Margin="Margin.Is0">Channel partner links</Heading>
    <Button Type="ButtonType.Link" To="/channel-partner-links/new" Color="Color.Primary">
        <Icon Name="@AppIcons.AddLink" Class="me-1" /> Invite partner
    </Button>
</Div>

<Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is4.FromBottom">
    Downstream resellers (channel partners) linked to your distributor account. Paging, sorting and
    search run server-side against the synced read-model. Open a link to view its details and customers.
</Paragraph>

<Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Margin="Margin.Is2.FromBottom">
    <Addons Style="max-width:360px">
        <Addon AddonType="AddonType.Start"><AddonLabel><Icon Name="@AppIcons.Search" /></AddonLabel></Addon>
        <Addon AddonType="AddonType.Body">
            <TextInput Value="@_search" ValueChanged="OnSearchChanged" Debounce="true" DebounceInterval="400"
                       Placeholder="Search domain, cloud id, link id…" />
        </Addon>
    </Addons>
    <AsOfBadge AsOf="_asOf" />
</Div>

<Card Shadow="Shadow.Small">
    <DataGrid @ref="_grid" TItem="EstateReseller" Data="_items" ReadData="OnReadData" TotalItems="_total"
              ShowPager ShowPageSizes PageSize="25" PageSizes="_pageSizes" Hoverable Responsive Sortable SortMode="DataGridSortMode.Single">
        <DataGridColumns>
            <DataGridColumn TItem="EstateReseller" Field="@nameof(EstateReseller.PrimaryDomain)" SortField="domain" Caption="Reseller Cloud Identity">
                <DisplayTemplate>@(context.Item.PrimaryDomain ?? context.Item.ResellerCloudId ?? context.Item.LinkId)</DisplayTemplate>
            </DataGridColumn>
            <DataGridColumn TItem="EstateReseller" Field="@nameof(EstateReseller.CustomerCount)" Caption="Customers" Sortable="false" />
            <DataGridColumn TItem="EstateReseller" Field="@nameof(EstateReseller.LinkId)" Caption="Billed (last month)" Sortable="false">
                <DisplayTemplate>
                    @if (BilledLabel(context.Item.LinkId) is { } billed)
                    {
                        <Tooltip Text="Actual billed GCP/Marketplace spend across this reseller's customers (BigQuery cost export)." Inline>
                            <span>@billed</span>
                        </Tooltip>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </DisplayTemplate>
            </DataGridColumn>
            <DataGridColumn TItem="EstateReseller" Field="@nameof(EstateReseller.LinkState)" SortField="state" Caption="State">
                <DisplayTemplate>
                    <Badge Color="@StateColor(context.Item.LinkState)">@(string.IsNullOrEmpty(context.Item.LinkState) ? "—" : context.Item.LinkState)</Badge>
                    @if (!string.IsNullOrEmpty(context.Item.SyncError))
                    {
                        <Tooltip Text="@context.Item.SyncError" Multiline Inline>
                            <Icon Name="@AppIcons.Warning" TextColor="TextColor.Warning" Class="ms-1" />
                        </Tooltip>
                    }
                </DisplayTemplate>
            </DataGridColumn>
            <DataGridColumn TItem="EstateReseller" Field="@nameof(EstateReseller.CreateTime)" SortField="created" Caption="Created">
                <DisplayTemplate>@(context.Item.CreateTime?.ToString("yyyy-MM-dd") ?? "—")</DisplayTemplate>
            </DataGridColumn>
            <DataGridColumn TItem="EstateReseller" Field="@nameof(EstateReseller.ResellerCloudId)" Caption="Actions" Sortable="false" TextAlignment="TextAlignment.End" HeaderTextAlignment="TextAlignment.End">
                <DisplayTemplate>
                    <Div Flex="Flex.JustifyContent.End" Gap="Gap.Is1" Class="text-nowrap">
                        <Tooltip Text="Refresh now" Inline>
                            <Button Size="Size.Small" Color="Color.Light" Clicked="@(() => ResyncAsync(context.Item))" aria-label="Refresh now"><Icon Name="@AppIcons.Sync" /></Button>
                        </Tooltip>
                        <Tooltip Text="View" Inline>
                            <Button Type="ButtonType.Link" To="@($"/channel-partner-links/{context.Item.LinkId}")" Size="Size.Small" Color="Color.Light" aria-label="View"><Icon Name="@AppIcons.Visibility" /></Button>
                        </Tooltip>
                    </Div>
                </DisplayTemplate>
            </DataGridColumn>
        </DataGridColumns>
        <EmptyTemplate>
            <Alert Color="Color.Info" Visible Margin="Margin.Is0">No channel partner links yet. Use <strong>Invite partner</strong> to link a downstream reseller.</Alert>
        </EmptyTemplate>
        <LoadingTemplate>
            <LoadingPanel Title="Loading channel partner links…" Hint="Querying the synced read-model." />
        </LoadingTemplate>
    </DataGrid>
</Card>

@code {
    private static readonly int[] _pageSizes = [25, 50, 100];
    private DataGrid<EstateReseller>? _grid;
    private List<EstateReseller> _items = [];
    private int _total;
    private string? _search;
    private DateTimeOffset? _asOf;

    // Server-side read: Blazorise pages are 1-based, the API's are 0-based; sort keys come from SortField.
    private async Task OnReadData(DataGridReadDataEventArgs<EstateReseller> e)
    {
        if (e.CancellationToken.IsCancellationRequested)
        {
            return;
        }

        var sortColumn = e.Columns.FirstOrDefault(c => c.SortDirection != SortDirection.Default);
        try
        {
            await EnsureBilledAsync(e.CancellationToken);
            var result = await Api.ListEstateResellersAsync(
                e.Page - 1, e.PageSize, sortColumn?.SortField,
                sortColumn?.SortDirection == SortDirection.Descending,
                _search, state: null, e.CancellationToken);

            _items = result?.Items?.ToList() ?? [];
            _total = result?.Total ?? 0;
            _asOf = result?.AsOf;
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load channel partner links: {ex.Message}", Severity.Error);
            _items = [];
            _total = 0;
        }
    }

    // Billed (actual) spend per reseller link for the list column — loaded once, best-effort.
    private readonly Dictionary<string, (decimal Cost, string Currency)> _billed = new(StringComparer.OrdinalIgnoreCase);
    private bool _billedLoaded;

    private async Task EnsureBilledAsync(CancellationToken token)
    {
        if (_billedLoaded) { return; }
        _billedLoaded = true;
        try
        {
            var result = await Api.GetResellerSpendAsync(1, token);
            foreach (var g in (result?.Resellers ?? [])
                .Where(r => r.OwningLinkId != null)
                .GroupBy(r => r.OwningLinkId!, StringComparer.OrdinalIgnoreCase))
            {
                var top = g.OrderByDescending(x => x.Cost).First();
                _billed[g.Key] = (top.Cost, top.Currency);
            }
        }
        catch
        {
            // Best-effort column; leave blanks if the billed lookup fails.
        }
    }

    private string? BilledLabel(string linkId) =>
        _billed.TryGetValue(linkId, out var v)
            ? $"{v.Currency} {v.Cost.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)}"
            : null;

    private async Task OnSearchChanged(string value)
    {
        _search = value;
        await (_grid?.Reload() ?? Task.CompletedTask);
    }

    private async Task ResyncAsync(EstateReseller link)
    {
        try
        {
            await Api.ResyncLinkAsync(link.LinkId);
            await Snackbar.Add("Queued for refresh — data updates on the next sync cycle.", Severity.Info);
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to queue refresh: {ex.Message}", Severity.Error);
        }
    }

    private static Color StateColor(string? state) => state?.ToUpperInvariant() switch
    {
        "ACTIVE" => Color.Success,
        "INVITED" => Color.Info,
        "SUSPENDED" => Color.Warning,
        "REVOKED" => Color.Danger,
        _ => Color.Secondary
    };
}
