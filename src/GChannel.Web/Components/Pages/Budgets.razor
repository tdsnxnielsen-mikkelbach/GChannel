@page "/billing/budgets"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject UiNotifier Snackbar

<PageTitle>GCP budgets · GChannel</PageTitle>

<Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Margin="Margin.Is2.FromBottom">
    <Div>
        <Heading Size="HeadingSize.Is3" Margin="Margin.Is0">GCP budgets</Heading>
        <Small TextColor="TextColor.Secondary">
            Cloud Billing budgets on your reseller billing accounts and per-customer sub-accounts
        </Small>
    </Div>
    <Button Color="Color.Secondary" Outline Clicked="RefreshAsync" Disabled="_loadingAccounts">
        <Icon Name="@AppIcons.Refresh" Class="me-1" /> Refresh
    </Button>
</Div>

<Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is4.FromBottom">
    Budgets are read and written through the Cloud Billing Budget API using the reseller service
    account — a separate data plane from the Channel API. Budgets raise alerts at their thresholds; they
    don't cap spend.
</Paragraph>

@if (_accountsError is not null)
{
    <Alert Color="Color.Warning" Visible Margin="Margin.Is4.FromBottom">
        Couldn't discover billing accounts live (@_accountsError). Showing configured accounts if any —
        ensure <code>cloudbilling.googleapis.com</code> is enabled and the service account has
        <code>roles/billing.viewer</code>.
    </Alert>
}

<Row>
    <Column ColumnSize="ColumnSize.Is12.Is5.OnDesktop">
        <Field>
            <FieldLabel>Billing account</FieldLabel>
            <Select TValue="string" Value="@_selectedAccountId" ValueChanged="OnAccountChanged" Disabled="_loadingAccounts">
                <SelectItem TValue="string" Value="@((string?)null)">Choose a billing account…</SelectItem>
                @foreach (var account in _accounts)
                {
                    <SelectItem TValue="string" Value="@account.Id">@AccountLabel(account)</SelectItem>
                }
            </Select>
        </Field>
    </Column>
    <Column ColumnSize="ColumnSize.Is12.Is7.OnDesktop" Flex="Flex.AlignItems.Center">
        @if (!string.IsNullOrEmpty(_selectedAccountId))
        {
            <Button Color="Color.Primary" Clicked="StartCreate">
                <Icon Name="@AppIcons.Add" Class="me-1" /> New budget
            </Button>
        }
    </Column>
</Row>

@if (_editing is not null)
{
    <Card Shadow="Shadow.Small" Margin="Margin.Is4.OnY">
        <CardBody>
            <Heading Size="HeadingSize.Is5" Margin="Margin.Is3.FromBottom">@(_editing.BudgetId is null ? "New budget" : "Edit budget")</Heading>
            <Row>
                <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop">
                    <Field>
                        <FieldLabel>Display name</FieldLabel>
                        <TextInput @bind-Value="_editing.DisplayName" />
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is6.Is3.OnDesktop">
                    <Field>
                        <FieldLabel>Amount</FieldLabel>
                        <NumericPicker TValue="decimal" @bind-Value="_editing.Amount" Min="0" Decimals="2" />
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is6.Is3.OnDesktop">
                    <Field>
                        <FieldLabel>Currency</FieldLabel>
                        <TextInput @bind-Value="_editing.CurrencyCode" MaxLength="3" />
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop">
                    <Field>
                        <FieldLabel>Reset period</FieldLabel>
                        <Select TValue="string" @bind-Value="_editing.CalendarPeriod">
                            <SelectItem TValue="string" Value="@("MONTH")">Monthly</SelectItem>
                            <SelectItem TValue="string" Value="@("QUARTER")">Quarterly</SelectItem>
                            <SelectItem TValue="string" Value="@("YEAR")">Yearly</SelectItem>
                        </Select>
                    </Field>
                </Column>
                <Column ColumnSize="ColumnSize.Is12.Is8.OnDesktop" Flex="Flex.AlignItems.Center" Gap="Gap.Is4">
                    <span class="me-2">Alert thresholds:</span>
                    <Check TValue="bool" @bind-Value="_t50" Inline>50%</Check>
                    <Check TValue="bool" @bind-Value="_t90" Inline>90%</Check>
                    <Check TValue="bool" @bind-Value="_t100" Inline>100%</Check>
                </Column>
            </Row>
            <Div Flex="Flex.JustifyContent.End" Gap="Gap.Is2" Margin="Margin.Is3.FromTop">
                <Button Color="Color.Secondary" Class="btn-link text-decoration-none" Clicked="@(() => _editing = null)" Disabled="_saving">Cancel</Button>
                <Button Color="Color.Primary" Clicked="SaveAsync" Loading="_saving"
                        Disabled="_saving || string.IsNullOrWhiteSpace(_editing.DisplayName)">
                    @(_saving ? "Saving…" : "Save budget")
                </Button>
            </Div>
        </CardBody>
    </Card>
}

<Heading Size="HeadingSize.Is5" Margin="Margin.Is4.FromTop.Is2.FromBottom">Budgets</Heading>
@if (_loadingBudgets)
{
    <LoadingPanel Title="Loading budgets…" Hint="Reading budgets for the selected billing account." />
}
else if (string.IsNullOrEmpty(_selectedAccountId))
{
    <Alert Color="Color.Info" Visible>Select a billing account to view its budgets.</Alert>
}
else
{
    <Card Shadow="Shadow.Small">
        <Table Narrow Hoverable Responsive Margin="Margin.Is0">
            <TableHeader>
                <TableRow>
                    <TableHeaderCell>Name</TableHeaderCell>
                    <TableHeaderCell>Amount</TableHeaderCell>
                    <TableHeaderCell>Reset</TableHeaderCell>
                    <TableHeaderCell>Alert thresholds</TableHeaderCell>
                    <TableHeaderCell TextAlignment="TextAlignment.End">Actions</TableHeaderCell>
                </TableRow>
            </TableHeader>
            <TableBody>
                @if (_budgets.Count == 0)
                {
                    <TableRow><TableRowCell ColumnSpan="5">No budgets on this billing account yet.</TableRowCell></TableRow>
                }
                @foreach (var budget in _budgets)
                {
                    <TableRow>
                        <TableRowCell>@budget.DisplayName</TableRowCell>
                        <TableRowCell>
                            @if (budget.UsesLastPeriodAmount)
                            {
                                <span>Tracks last period</span>
                            }
                            else
                            {
                                <span>@budget.Amount.ToString("N2") @budget.CurrencyCode</span>
                            }
                        </TableRowCell>
                        <TableRowCell>@(budget.CalendarPeriod ?? "Custom")</TableRowCell>
                        <TableRowCell>@string.Join(", ", budget.ThresholdPercents.Select(p => $"{p * 100:0}%"))</TableRowCell>
                        <TableRowCell TextAlignment="TextAlignment.End">
                            <Div Flex="Flex.JustifyContent.End" Gap="Gap.Is1" Class="text-nowrap">
                                <Button Size="Size.Small" Color="Color.Primary" Outline Clicked="@(() => StartEdit(budget))" Disabled="budget.UsesLastPeriodAmount" aria-label="Edit">
                                    <Icon Name="@AppIcons.Edit" />
                                </Button>
                                <Button Size="Size.Small" Color="Color.Danger" Outline Clicked="@(() => DeleteAsync(budget))" aria-label="Delete">
                                    <Icon Name="@AppIcons.Delete" />
                                </Button>
                            </Div>
                        </TableRowCell>
                    </TableRow>
                }
            </TableBody>
        </Table>
    </Card>
}

@if (!string.IsNullOrEmpty(_selectedAccountId))
{
    <Heading Size="HeadingSize.Is5" Margin="Margin.Is5.FromTop.Is2.FromBottom">Billing permissions</Heading>
    <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is3.FromBottom">
        Members with roles on this billing account, read live from its Cloud Billing IAM policy. Inherited
        members come from the master billing account; direct members are granted on this account itself.
    </Paragraph>

    @if (_loadingMembers)
    {
        <LoadingPanel Title="Loading members…" Hint="Reading the billing account IAM policy." />
    }
    else if (_members is { Available: false })
    {
        <Alert Color="Color.Warning" Visible>
            Couldn't read billing permissions (@(_members.Error ?? "unavailable")). The service account needs
            <code>roles/billing.viewer</code> (or <code>billing.accounts.getIamPolicy</code>) on the account.
        </Alert>
    }
    else if (_members is not null)
    {
        @if (_identity is { DirectoryAvailable: false, DirectoryError: not null })
        {
            <Alert Color="Color.Info" Visible Margin="Margin.Is3.FromBottom">
                2SV / Advanced Protection are readable via the Admin SDK only for users in your own Workspace
                tenant or in resold customers you have reseller admin access to (@_identity.DirectoryError).
                Account type is still classified from the domain's Cloud Identity status.
            </Alert>
        }
        <Row>
            <Column ColumnSize="ColumnSize.Is12">
                <Card Shadow="Shadow.Small" Margin="Margin.Is3.FromBottom">
                    <CardBody Padding="Padding.Is3">
                        <Div Flex="Flex.AlignItems.Center" Gap="Gap.Is2" Margin="Margin.Is2.FromBottom">
                            <Icon Name="@AppIcons.Person" TextColor="TextColor.Secondary" />
                            <Strong>Direct members (@_members.Direct.Count)</Strong>
                        </Div>
                        <Small TextColor="TextColor.Secondary" Display="Display.Block" Margin="Margin.Is2.FromBottom">
                            Granted on this sub-account — not inherited.
                        </Small>
                        @MemberTable(_members.Direct, "No members set directly on this account.")
                    </CardBody>
                </Card>
            </Column>
            <Column ColumnSize="ColumnSize.Is12">
                <Card Shadow="Shadow.Small">
                    <CardBody Padding="Padding.Is3">
                        <Div Flex="Flex.AlignItems.Center" Gap="Gap.Is2" Margin="Margin.Is2.FromBottom">
                            <Icon Name="@AppIcons.AccountTree" TextColor="TextColor.Secondary" />
                            <Strong>Inherited members (@_members.Inherited.Count)</Strong>
                        </Div>
                        <Small TextColor="TextColor.Secondary" Display="Display.Block" Margin="Margin.Is2.FromBottom">
                            @(_members.MasterBillingAccountId is null
                                ? "This is a master account — no inherited members."
                                : $"Inherited from master billing account {_members.MasterBillingAccountId}.")
                        </Small>
                        @MemberTable(_members.Inherited, "No inherited members.")
                    </CardBody>
                </Card>
            </Column>
        </Row>
    }
}

@code {
    private RenderFragment MemberTable(IReadOnlyList<BillingAccountMember> rows, string emptyText) => __builder =>
    {
        <DataGrid TItem="BillingAccountMember" Data="rows" Narrow Hoverable Responsive Sortable>
            <DataGridColumns>
                <DataGridColumn TItem="BillingAccountMember" Field="@nameof(BillingAccountMember.Email)" Caption="Member">
                    <DisplayTemplate>
                        <Div Flex="Flex.AlignItems.Center" Gap="Gap.Is1">
                            <Icon Name="@MemberTypeIcon(context.Item.MemberType)" TextColor="TextColor.Secondary" title="@context.Item.MemberType" />
                            <span>@context.Item.Email</span>
                            @if (_identityByEmail.TryGetValue(context.Item.Email, out var who))
                            {
                                if (who.IsAdmin == true)
                                {
                                    <Tooltip Text="Workspace super administrator in their tenant" Inline>
                                        <Badge Color="Color.Info" Margin="Margin.Is1.FromStart">admin</Badge>
                                    </Tooltip>
                                }
                                if (who.Suspended == true)
                                {
                                    <Tooltip Text="Account is suspended in Workspace but still holds this billing role" Inline>
                                        <Badge Color="Color.Danger" Margin="Margin.Is1.FromStart">suspended</Badge>
                                    </Tooltip>
                                }
                            }
                        </Div>
                    </DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="BillingAccountMember" Field="@nameof(BillingAccountMember.RoleDisplayName)" Caption="Role">
                    <DisplayTemplate><span class="text-nowrap">@context.Item.RoleDisplayName</span></DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="BillingAccountMember" Field="@nameof(BillingAccountMember.MemberType)" Caption="Account" SortComparer="@(Compare(AccountRank))">
                    <DisplayTemplate><span class="text-nowrap">@AccountKindChip(context.Item)</span></DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="BillingAccountMember" Field="@nameof(BillingAccountMember.Email)" Caption="2SV" SortComparer="@(Compare(TwoSvRank))">
                    <DisplayTemplate><span class="text-nowrap">@TwoSvChip(context.Item)</span></DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="BillingAccountMember" Field="@nameof(BillingAccountMember.Email)" Caption="Adv. Protection" SortComparer="@(Compare(AdvancedProtectionRank))">
                    <DisplayTemplate><span class="text-nowrap">@AdvancedProtectionChip(context.Item)</span></DisplayTemplate>
                </DataGridColumn>
            </DataGridColumns>
            <EmptyTemplate><Paragraph Margin="Margin.Is0">@emptyText</Paragraph></EmptyTemplate>
        </DataGrid>
    };

    // In-memory DataGrid sorting over the posture ranks (the grid can only sort declared fields on its own).
    private static IComparer<BillingAccountMember> Compare(Func<BillingAccountMember, int> rank) =>
        Comparer<BillingAccountMember>.Create((a, b) => rank(a).CompareTo(rank(b)));

    private RenderFragment AccountKindChip(BillingAccountMember m) => __builder =>
    {
        if (!IsUserLike(m)) { <Small TextColor="TextColor.Secondary">—</Small> return; }
        if (_loadingIdentity && !_identityByEmail.ContainsKey(m.Email)) { <div class="spinner-border spinner-border-sm text-secondary" role="status"></div> return; }
        if (!_identityByEmail.TryGetValue(m.Email, out var id))
        {
            <Tooltip Text="Identity lookup for this member didn't return — refresh to retry." Inline>
                <Small TextColor="TextColor.Secondary">?</Small>
            </Tooltip>
            return;
        }

        var (label, color) = id.AccountKind switch
        {
            GoogleAccountKind.Managed => ("Managed", Color.Success),
            GoogleAccountKind.ManagedTeam => ("Managed (team)", Color.Warning),
            GoogleAccountKind.Consumer => ("Consumer", Color.Danger),
            _ => ("Unknown", Color.Secondary)
        };
        <Tooltip Text="@(id.AccountKindReason ?? label)" Multiline Inline>
            <Badge Color="@color">@label</Badge>
        </Tooltip>
    };

    private RenderFragment TwoSvChip(BillingAccountMember m) => __builder =>
    {
        if (!IsUserLike(m) || !_identityByEmail.TryGetValue(m.Email, out var id)) { <Small TextColor="TextColor.Secondary">—</Small> return; }
        if (id.TwoStepVerificationEnrolled is null)
        {
            <Tooltip Text="Not visible: the user's tenant is neither ours nor a resold customer we have reseller admin access to." Multiline Inline>
                <Small TextColor="TextColor.Secondary">n/a</Small>
            </Tooltip>
            return;
        }
        var enrolled = id.TwoStepVerificationEnrolled.Value;
        var enforced = id.TwoStepVerificationEnforced == true;
        <Tooltip Text="@(enforced ? "Enrolled and enforced by policy" : enrolled ? "Enrolled (not enforced)" : "Not enrolled in 2-Step Verification")" Inline>
            <Badge Color="@(enrolled ? Color.Success : Color.Danger)">
                <Icon Name="@(enrolled ? AppIcons.VerifiedUser : AppIcons.GppBad)" Class="me-1" />@(enrolled ? (enforced ? "On · enforced" : "On") : "Off")
            </Badge>
        </Tooltip>
    };

    private RenderFragment AdvancedProtectionChip(BillingAccountMember m) => __builder =>
    {
        if (!IsUserLike(m) || !_identityByEmail.TryGetValue(m.Email, out var id))
        {
            <Small TextColor="TextColor.Secondary">—</Small>
            return;
        }
        if (!id.SecurityVisible)
        {
            <Tooltip Text="@(id.AccountKind == GoogleAccountKind.Consumer
                ? "Consumer Google Account — not in any Workspace tenant, so Google exposes no 2SV, passkey or Advanced Protection data to anyone but the owner."
                : "This user's tenant is neither ours nor a resold customer we have reseller admin access to.")" Multiline Inline>
                <Small TextColor="TextColor.Secondary">—</Small>
            </Tooltip>
            return;
        }
        var keys = KeysSummary(id);
        <Div Flex="Flex.Column.AlignItems.Start">
            @switch (id.AdvancedProtection)
            {
                case AdvancedProtectionStatus.Enrolled:
                    <Tooltip Text="@($"Enrolled (audit event {id.AdvancedProtectionAsOf:yyyy-MM-dd}){keys}")" Multiline Inline>
                        <Badge Color="Color.Success"><Icon Name="@AppIcons.Shield" Class="me-1" />Enrolled</Badge>
                    </Tooltip>
                    break;
                case AdvancedProtectionStatus.NotEnrolled:
                    <Tooltip Text="@($"Unenrolled (audit event {id.AdvancedProtectionAsOf:yyyy-MM-dd}){keys}")" Multiline Inline>
                        <Badge Color="Color.Warning">Not enrolled</Badge>
                    </Tooltip>
                    break;
                case AdvancedProtectionStatus.Unavailable:
                    <Tooltip Text="@($"Audit log not readable: {id.AdvancedProtectionError}{keys}")" Multiline Inline>
                        <Badge Color="Color.Danger"><Icon Name="@AppIcons.ErrorOutline" Class="me-1" />Unavailable</Badge>
                    </Tooltip>
                    break;
                default:
                    // Advanced Protection requires a passkey or security key, so a confirmed 0/0 from the usage
                    // report is a safe "not enrolled" even without an audit event.
                    if (id is { SecurityKeys: 0, Passkeys: 0 })
                    {
                        <Tooltip Text="@($"No enroll/unenroll audit event retained, but the usage report shows no passkeys or security keys — Advanced Protection requires one.{keys}")" Multiline Inline>
                            <Badge Color="Color.Warning">Not enrolled</Badge>
                        </Tooltip>
                    }
                    else
                    {
                        <Tooltip Text="@($"No Advanced Protection enroll/unenroll event in the ~6 months of audit log Google retains — there is no state field, so enrollment before that can't be confirmed.{keys}")" Multiline Inline>
                            <Small TextColor="TextColor.Secondary">No recent event</Small>
                        </Tooltip>
                    }
                    break;
            }
            @* Passkey / security-key line: the factor Advanced Protection enforces, shown for every state. *@
            @if (id.SecurityKeys is not null || id.Passkeys is not null)
            {
                var (label, color) = KeysLine(id);
                <Tooltip Text="@($"From the user usage report for {id.KeysAsOf:yyyy-MM-dd} (accounts:num_security_keys / num_passkeys_enrolled).")" Multiline Inline>
                    <Small TextColor="@color" Class="d-flex align-items-center gap-1">
                        <Icon Name="@AppIcons.Key" />@label
                    </Small>
                </Tooltip>
            }
        </Div>
    };

    // Advanced Protection requires a passkey or security key, so surface those counts alongside.
    private static string KeysSummary(MemberIdentityInfo id) =>
        id.SecurityKeys is null && id.Passkeys is null
            ? ""
            : $" Keys as of {id.KeysAsOf:yyyy-MM-dd}: {id.SecurityKeys ?? 0} security key(s), {id.Passkeys ?? 0} passkey(s).";

    private static (string Label, TextColor Color) KeysLine(MemberIdentityInfo id)
    {
        var keys = id.SecurityKeys ?? 0;
        var passkeys = id.Passkeys ?? 0;
        if (keys == 0 && passkeys == 0)
        {
            return ("no keys or passkeys", TextColor.Danger);
        }

        var parts = new List<string>();
        if (keys > 0) parts.Add($"{keys} security key{(keys == 1 ? "" : "s")}");
        if (passkeys > 0) parts.Add($"{passkeys} passkey{(passkeys == 1 ? "" : "s")}");
        return (string.Join(" · ", parts), TextColor.Success);
    }

    private static bool IsUserLike(BillingAccountMember m) =>
        m.MemberType is "user" || m.MemberType is "group";

    // Sort keys: ascending = weakest posture first, so one click surfaces the members to act on.
    // Rows with no data (service accounts, unreadable tenants) sink to the bottom.
    private int AccountRank(BillingAccountMember m)
    {
        if (!IsUserLike(m) || !_identityByEmail.TryGetValue(m.Email, out var id)) { return 9; }
        return id.AccountKind switch
        {
            GoogleAccountKind.Consumer => 0,
            GoogleAccountKind.ManagedTeam => 1,
            GoogleAccountKind.Unknown => 2,
            GoogleAccountKind.Managed => 3,
            _ => 8
        };
    }

    private int TwoSvRank(BillingAccountMember m)
    {
        if (!IsUserLike(m) || !_identityByEmail.TryGetValue(m.Email, out var id)) { return 9; }
        return id.TwoStepVerificationEnrolled switch
        {
            false => 0,                                                 // Off
            true when id.TwoStepVerificationEnforced != true => 1,      // On, not enforced
            true => 2,                                                  // On · enforced
            null => 8                                                   // n/a (tenant not readable)
        };
    }

    private int AdvancedProtectionRank(BillingAccountMember m)
    {
        if (!IsUserLike(m) || !_identityByEmail.TryGetValue(m.Email, out var id) || !id.SecurityVisible) { return 9; }
        return id.AdvancedProtection switch
        {
            AdvancedProtectionStatus.NotEnrolled => 0,
            AdvancedProtectionStatus.Unknown when id is { SecurityKeys: 0, Passkeys: 0 } => 0, // inferred not enrolled
            AdvancedProtectionStatus.Unavailable => 1,
            AdvancedProtectionStatus.Unknown => 2,                       // no recent event, has keys
            AdvancedProtectionStatus.Enrolled => 3,
            _ => 8
        };
    }

    private static string MemberTypeIcon(string type) => type switch
    {
        "user" => AppIcons.Person,
        "group" => AppIcons.Groups,
        "serviceAccount" => AppIcons.SmartToy,
        "domain" => AppIcons.Language,
        _ => AppIcons.HelpOutline
    };

    private sealed class BudgetForm
    {
        public string? BudgetId { get; set; }
        public string DisplayName { get; set; } = "";
        public decimal Amount { get; set; }
        public string CurrencyCode { get; set; } = "USD";
        public string CalendarPeriod { get; set; } = "MONTH";
    }

    private bool _loadingAccounts = true;
    private bool _loadingBudgets;
    private bool _saving;
    private string? _accountsError;
    private string? _selectedAccountId;
    private List<BillingAccountInfo> _accounts = [];
    private List<BudgetInfo> _budgets = [];
    private BudgetForm? _editing;
    private bool _t50 = true, _t90 = true, _t100 = true;
    private bool _loadingMembers;
    private BillingAccountMembersResult? _members;
    private bool _loadingIdentity;
    private MemberIdentityResult? _identity;
    private Dictionary<string, MemberIdentityInfo> _identityByEmail = new(StringComparer.OrdinalIgnoreCase);

    protected override Task OnInitializedAsync() => ReloadAsync(refreshIdentities: false);

    // The toolbar Refresh button bypasses the server-side identity cache so a stale security verdict
    // can be re-read from Google on demand; initial load and account switches use the cache.
    private Task RefreshAsync() => ReloadAsync(refreshIdentities: true);

    private async Task ReloadAsync(bool refreshIdentities)
    {
        _loadingAccounts = true;
        _editing = null;
        try
        {
            var result = await Api.ListBillingAccountsAsync();
            _accounts = (result?.Accounts ?? []).Where(a => a.Open).ToList();
            _accountsError = result is { DiscoveryAvailable: false } ? (result.DiscoveryError ?? "unavailable") : null;

            if (_selectedAccountId is null || _accounts.All(a => a.Id != _selectedAccountId))
            {
                _selectedAccountId = _accounts.FirstOrDefault()?.Id;
            }
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load billing accounts: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingAccounts = false;
        }

        await LoadBudgetsAsync(refreshIdentities);
    }

    private async Task OnAccountChanged(string? accountId)
    {
        _selectedAccountId = accountId;
        _editing = null;
        await LoadBudgetsAsync(refreshIdentities: false);
    }

    private async Task LoadBudgetsAsync(bool refreshIdentities = false)
    {
        if (string.IsNullOrEmpty(_selectedAccountId))
        {
            _budgets = [];
            _members = null;
            return;
        }

        _loadingBudgets = true;
        try
        {
            var result = await Api.ListBudgetsAsync(_selectedAccountId);
            _budgets = (result?.Budgets ?? []).ToList();
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load budgets: {ex.Message}", Severity.Error);
            _budgets = [];
        }
        finally
        {
            _loadingBudgets = false;
        }

        await LoadMembersAsync(refreshIdentities);
    }

    private async Task LoadMembersAsync(bool refreshIdentities)
    {
        if (string.IsNullOrEmpty(_selectedAccountId))
        {
            _members = null;
            return;
        }

        _loadingMembers = true;
        _members = null;
        _identity = null;
        _identityByEmail = new(StringComparer.OrdinalIgnoreCase);
        try
        {
            _members = await Api.ListBillingAccountMembersAsync(_selectedAccountId);
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load billing permissions: {ex.Message}", Severity.Error);
            _members = null;
        }
        finally
        {
            _loadingMembers = false;
        }

        await LoadIdentitiesAsync(refreshIdentities);
    }

    // Second pass: classify each user/group member's Google Account and read 2SV / Advanced Protection
    // where visible. Kept separate so the members tables render immediately and enrich in place.
    private async Task LoadIdentitiesAsync(bool refresh)
    {
        if (_members is not { Available: true })
        {
            return;
        }

        var emails = _members.Direct.Concat(_members.Inherited)
            .Where(IsUserLike)
            .Select(m => m.Email)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (emails.Count == 0)
        {
            return;
        }

        _loadingIdentity = true;
        StateHasChanged();
        try
        {
            // Chunked so each request stays far inside the HTTP attempt timeout and rows fill in
            // progressively instead of all-or-nothing after the slowest member.
            const int chunkSize = 16;
            var merged = new Dictionary<string, MemberIdentityInfo>(StringComparer.OrdinalIgnoreCase);
            MemberIdentityResult? last = null;
            string? firstError = null;
            foreach (var chunk in emails.Chunk(chunkSize))
            {
                try
                {
                    var result = await Api.ResolveMemberIdentitiesAsync(chunk, refresh);
                    if (result is null) { continue; }
                    last = result;
                    firstError ??= result.DirectoryError;
                    foreach (var m in result.Members)
                    {
                        merged[m.Email] = m;
                    }
                    _identityByEmail = new Dictionary<string, MemberIdentityInfo>(merged, StringComparer.OrdinalIgnoreCase);
                    StateHasChanged();
                }
                catch (Exception ex)
                {
                    await Snackbar.Add($"Failed to resolve some member identities: {ex.Message}", Severity.Warning);
                }
            }

            _identity = last is null ? null : last with { DirectoryError = firstError, DirectoryAvailable = firstError is null && last.DirectoryAvailable };
        }
        finally
        {
            _loadingIdentity = false;
        }
    }

    private void StartCreate()
    {
        var currency = _budgets.FirstOrDefault()?.CurrencyCode ?? "USD";
        _editing = new BudgetForm { CurrencyCode = currency };
        _t50 = _t90 = _t100 = true;
    }

    private void StartEdit(BudgetInfo budget)
    {
        _editing = new BudgetForm
        {
            BudgetId = budget.BudgetId,
            DisplayName = budget.DisplayName ?? "",
            Amount = budget.Amount,
            CurrencyCode = budget.CurrencyCode ?? "USD",
            CalendarPeriod = budget.CalendarPeriod ?? "MONTH"
        };
        _t50 = budget.ThresholdPercents.Any(p => Math.Abs(p - 0.5) < 0.001);
        _t90 = budget.ThresholdPercents.Any(p => Math.Abs(p - 0.9) < 0.001);
        _t100 = budget.ThresholdPercents.Any(p => Math.Abs(p - 1.0) < 0.001);
    }

    private async Task SaveAsync()
    {
        if (_editing is null || string.IsNullOrEmpty(_selectedAccountId))
        {
            return;
        }

        _saving = true;
        try
        {
            var thresholds = new List<double>();
            if (_t50) thresholds.Add(0.5);
            if (_t90) thresholds.Add(0.9);
            if (_t100) thresholds.Add(1.0);

            await Api.SaveBudgetAsync(new SaveBudgetRequest
            {
                BillingAccountId = _selectedAccountId,
                BudgetId = _editing.BudgetId,
                DisplayName = _editing.DisplayName,
                Amount = _editing.Amount,
                CurrencyCode = string.IsNullOrWhiteSpace(_editing.CurrencyCode) ? "USD" : _editing.CurrencyCode.ToUpperInvariant(),
                ThresholdPercents = thresholds,
                CalendarPeriod = _editing.CalendarPeriod
            });

            await Snackbar.Add(_editing.BudgetId is null ? "Budget created." : "Budget updated.", Severity.Success);
            _editing = null;
            await LoadBudgetsAsync();
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to save budget: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync(BudgetInfo budget)
    {
        var confirmed = await Snackbar.ConfirmAsync(
            "Delete budget",
            $"Delete the budget \"{budget.DisplayName}\"? This cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");
        if (!confirmed || string.IsNullOrEmpty(_selectedAccountId))
        {
            return;
        }

        try
        {
            await Api.DeleteBudgetAsync(_selectedAccountId, budget.BudgetId);
            await Snackbar.Add("Budget deleted.", Severity.Success);
            await LoadBudgetsAsync();
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to delete budget: {ex.Message}", Severity.Error);
        }
    }

    private static string AccountLabel(BillingAccountInfo account)
    {
        var name = account.DisplayName ?? account.Id;
        // Reseller sub-accounts named for a resold Channel customer carry the customer resource path.
        if (name.StartsWith("channel-gcp:accounts/", StringComparison.Ordinal))
        {
            var customerIdx = name.IndexOf("/customers/", StringComparison.Ordinal);
            if (customerIdx >= 0)
            {
                name = $"Channel customer {name[(customerIdx + "/customers/".Length)..]}";
            }
        }

        return account.IsSubaccount ? $"— {name} ({account.Id})" : $"{name} ({account.Id})";
    }
}

