@page "/billing/budgets"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject UiNotifier Snackbar

<PageTitle>GCP budgets · GChannel</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="1rem" class="rz-mb-2">
    <div>
        <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">GCP budgets</RadzenText>
        <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">
            Cloud Billing budgets on your reseller billing accounts and per-customer sub-accounts
        </RadzenText>
    </div>
    <RadzenButton Text="Refresh" Icon="@AppIcons.Refresh" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Click="RefreshAsync" Disabled="_loadingAccounts" />
</RadzenStack>

<RadzenText TextStyle="TextStyle.Body1" class="rz-text-secondary-color rz-mb-4">
    Budgets are read and written through the Cloud Billing Budget API using the reseller service
    account — a separate data plane from the Channel API. Budgets raise alerts at their thresholds; they
    don't cap spend.
</RadzenText>

@if (_accountsError is not null)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-mb-4">
        Couldn't discover billing accounts live (@_accountsError). Showing configured accounts if any —
        ensure <code>cloudbilling.googleapis.com</code> is enabled and the service account has
        <code>roles/billing.viewer</code>.
    </RadzenAlert>
}

<RadzenRow Gap="1rem" RowGap="1rem" AlignItems="AlignItems.Center">
    <RadzenColumn Size="12" SizeLG="5">
        <RadzenFormField Text="Billing account" Variant="Variant.Outlined" Style="width:100%">
            <RadzenDropDown TValue="string" Data="_accountOptions" ValueProperty="@nameof(SelectOption.Value)" TextProperty="@nameof(SelectOption.Text)"
                            Value="@_selectedAccountId" ValueChanged="OnAccountChanged" Disabled="_loadingAccounts" AllowClear="true" Placeholder="Choose a billing account…" Name="billingAccount" />
        </RadzenFormField>
    </RadzenColumn>
    <RadzenColumn Size="12" SizeLG="7">
        @if (!string.IsNullOrEmpty(_selectedAccountId))
        {
            <RadzenButton Text="New budget" Icon="@AppIcons.Add" ButtonStyle="ButtonStyle.Primary" Click="StartCreate" />
        }
    </RadzenColumn>
</RadzenRow>

@if (_editing is not null)
{
    <RadzenCard Variant="Variant.Filled" class="rz-my-4">
        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">@(_editing.BudgetId is null ? "New budget" : "Edit budget")</RadzenText>
        <RadzenRow Gap="1rem" RowGap="1rem" AlignItems="AlignItems.Center">
            <RadzenColumn Size="12" SizeLG="6">
                <RadzenFormField Text="Display name" Variant="Variant.Outlined" Style="width:100%">
                    <RadzenTextBox @bind-Value="_editing.DisplayName" Name="displayName" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="6" SizeLG="3">
                <RadzenFormField Text="Amount" Variant="Variant.Outlined" Style="width:100%">
                    <RadzenNumeric TValue="decimal" @bind-Value="_editing.Amount" Min="0" Format="0.00" Name="amount" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="6" SizeLG="3">
                <RadzenFormField Text="Currency" Variant="Variant.Outlined" Style="width:100%">
                    <RadzenTextBox @bind-Value="_editing.CurrencyCode" MaxLength="3" Name="currency" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeLG="4">
                <RadzenFormField Text="Reset period" Variant="Variant.Outlined" Style="width:100%">
                    <RadzenDropDown TValue="string" @bind-Value="_editing.CalendarPeriod" Data="_periodOptions" ValueProperty="@nameof(SelectOption.Value)" TextProperty="@nameof(SelectOption.Text)" Name="period" />
                </RadzenFormField>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeLG="8">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
                    <span class="rz-me-2">Alert thresholds:</span>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                        <RadzenCheckBox TValue="bool" @bind-Value="_t50" Name="t50" /><RadzenLabel Text="50%" Component="t50" />
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                        <RadzenCheckBox TValue="bool" @bind-Value="_t90" Name="t90" /><RadzenLabel Text="90%" Component="t90" />
                    </RadzenStack>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                        <RadzenCheckBox TValue="bool" @bind-Value="_t100" Name="t100" /><RadzenLabel Text="100%" Component="t100" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenColumn>
        </RadzenRow>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" class="rz-mt-3">
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Click="@(() => _editing = null)" Disabled="_saving" />
            <RadzenButton Text="Save budget" ButtonStyle="ButtonStyle.Primary" Click="SaveAsync" IsBusy="_saving" BusyText="Saving…"
                          Disabled="@string.IsNullOrWhiteSpace(_editing.DisplayName)" />
        </RadzenStack>
    </RadzenCard>
}

<RadzenText TextStyle="TextStyle.H6" class="rz-mt-4 rz-mb-2">Budgets</RadzenText>
@if (_loadingBudgets)
{
    <LoadingPanel Title="Loading budgets…" Hint="Reading budgets for the selected billing account." />
}
else if (string.IsNullOrEmpty(_selectedAccountId))
{
    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">Select a billing account to view its budgets.</RadzenAlert>
}
else
{
    <RadzenCard Variant="Variant.Filled">
        <RadzenDataGrid TItem="BudgetInfo" Data="_budgets" AllowPaging="false" AllowSorting="false" Density="Density.Compact" GridLines="DataGridGridLines.Horizontal" Responsive="true"
                        EmptyText="No budgets on this billing account yet.">
            <Columns>
                <RadzenDataGridColumn TItem="BudgetInfo" Property="@nameof(BudgetInfo.DisplayName)" Title="Name" />
                <RadzenDataGridColumn TItem="BudgetInfo" Title="Amount">
                    <Template Context="budget">
                        @if (budget.UsesLastPeriodAmount)
                        {
                            <span>Tracks last period</span>
                        }
                        else
                        {
                            <span>@budget.Amount.ToString("N2") @budget.CurrencyCode</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="BudgetInfo" Title="Reset" Width="110px">
                    <Template Context="budget">@(budget.CalendarPeriod ?? "Custom")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="BudgetInfo" Title="Alert thresholds">
                    <Template Context="budget">@string.Join(", ", budget.ThresholdPercents.Select(p => $"{p * 100:0}%"))</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="BudgetInfo" Title="Actions" TextAlign="TextAlign.End" Width="110px">
                    <Template Context="budget">
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.25rem" class="rz-text-nowrap">
                            <RadzenButton Icon="@AppIcons.Edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Click="@(() => StartEdit(budget))" Disabled="budget.UsesLastPeriodAmount" aria-label="Edit" />
                            <RadzenButton Icon="@AppIcons.Delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="@(() => DeleteAsync(budget))" aria-label="Delete" />
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
}

@if (!string.IsNullOrEmpty(_selectedAccountId))
{
    <RadzenText TextStyle="TextStyle.H6" class="rz-mt-6 rz-mb-2">Billing permissions</RadzenText>
    <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-mb-3">
        Members with roles on this billing account, read live from its Cloud Billing IAM policy. Inherited
        members come from the master billing account; direct members are granted on this account itself.
    </RadzenText>

    @if (_loadingMembers)
    {
        <LoadingPanel Title="Loading members…" Hint="Reading the billing account IAM policy." />
    }
    else if (_members is { Available: false })
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">
            Couldn't read billing permissions (@(_members.Error ?? "unavailable")). The service account needs
            <code>roles/billing.viewer</code> (or <code>billing.accounts.getIamPolicy</code>) on the account.
        </RadzenAlert>
    }
    else if (_members is not null)
    {
        @if (_identity is { DirectoryAvailable: false, DirectoryError: not null })
        {
            <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-mb-3">
                2SV / Advanced Protection are readable via the Admin SDK only for users in your own Workspace
                tenant or in resold customers you have reseller admin access to (@_identity.DirectoryError).
                Account type is still classified from the domain's Cloud Identity status.
            </RadzenAlert>
        }
        <RadzenCard Variant="Variant.Filled" class="rz-mb-3">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-1">
                <RadzenIcon Icon="@AppIcons.Person" class="rz-text-secondary-color" />
                <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-m-0" Style="font-weight:600">Direct members (@_members.Direct.Count)</RadzenText>
            </RadzenStack>
            <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-mb-2">
                Granted on this sub-account — not inherited.
            </RadzenText>
            <BillingMembersGrid Rows="_members.Direct" EmptyText="No members set directly on this account." IdentityByEmail="_identityByEmail" LoadingIdentity="_loadingIdentity" />
        </RadzenCard>
        <RadzenCard Variant="Variant.Filled">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-1">
                <RadzenIcon Icon="@AppIcons.AccountTree" class="rz-text-secondary-color" />
                <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-m-0" Style="font-weight:600">Inherited members (@_members.Inherited.Count)</RadzenText>
            </RadzenStack>
            <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-mb-2">
                @(_members.MasterBillingAccountId is null
                    ? "This is a master account — no inherited members."
                    : $"Inherited from master billing account {_members.MasterBillingAccountId}.")
            </RadzenText>
            <BillingMembersGrid Rows="_members.Inherited" EmptyText="No inherited members." IdentityByEmail="_identityByEmail" LoadingIdentity="_loadingIdentity" />
        </RadzenCard>
    }
}

@code {
    private static readonly SelectOption[] _periodOptions =
    [
        new("MONTH", "Monthly"),
        new("QUARTER", "Quarterly"),
        new("YEAR", "Yearly"),
    ];

    private IEnumerable<SelectOption> _accountOptions => _accounts.Select(a => new SelectOption(a.Id, AccountLabel(a)));

    private sealed class BudgetForm
    {
        public string? BudgetId { get; set; }
        public string DisplayName { get; set; } = "";
        public decimal Amount { get; set; }
        public string CurrencyCode { get; set; } = "USD";
        public string CalendarPeriod { get; set; } = "MONTH";
    }

    private bool _loadingAccounts = true;
    private bool _loadingBudgets;
    private bool _saving;
    private string? _accountsError;
    private string? _selectedAccountId;
    private List<BillingAccountInfo> _accounts = [];
    private List<BudgetInfo> _budgets = [];
    private BudgetForm? _editing;
    private bool _t50 = true, _t90 = true, _t100 = true;
    private bool _loadingMembers;
    private BillingAccountMembersResult? _members;
    private bool _loadingIdentity;
    private MemberIdentityResult? _identity;
    private Dictionary<string, MemberIdentityInfo> _identityByEmail = new(StringComparer.OrdinalIgnoreCase);

    protected override Task OnInitializedAsync() => ReloadAsync(refreshIdentities: false);

    // The toolbar Refresh button bypasses the server-side identity cache so a stale security verdict
    // can be re-read from Google on demand; initial load and account switches use the cache.
    private Task RefreshAsync() => ReloadAsync(refreshIdentities: true);

    private async Task ReloadAsync(bool refreshIdentities)
    {
        _loadingAccounts = true;
        _editing = null;
        try
        {
            var result = await Api.ListBillingAccountsAsync();
            _accounts = (result?.Accounts ?? []).Where(a => a.Open).ToList();
            _accountsError = result is { DiscoveryAvailable: false } ? (result.DiscoveryError ?? "unavailable") : null;

            if (_selectedAccountId is null || _accounts.All(a => a.Id != _selectedAccountId))
            {
                _selectedAccountId = _accounts.FirstOrDefault()?.Id;
            }
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load billing accounts: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingAccounts = false;
        }

        await LoadBudgetsAsync(refreshIdentities);
    }

    private async Task OnAccountChanged(string? accountId)
    {
        _selectedAccountId = accountId;
        _editing = null;
        await LoadBudgetsAsync(refreshIdentities: false);
    }

    private async Task LoadBudgetsAsync(bool refreshIdentities = false)
    {
        if (string.IsNullOrEmpty(_selectedAccountId))
        {
            _budgets = [];
            _members = null;
            return;
        }

        _loadingBudgets = true;
        try
        {
            var result = await Api.ListBudgetsAsync(_selectedAccountId);
            _budgets = (result?.Budgets ?? []).ToList();
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load budgets: {ex.Message}", Severity.Error);
            _budgets = [];
        }
        finally
        {
            _loadingBudgets = false;
        }

        await LoadMembersAsync(refreshIdentities);
    }

    private async Task LoadMembersAsync(bool refreshIdentities)
    {
        if (string.IsNullOrEmpty(_selectedAccountId))
        {
            _members = null;
            return;
        }

        _loadingMembers = true;
        _members = null;
        _identity = null;
        _identityByEmail = new(StringComparer.OrdinalIgnoreCase);
        try
        {
            _members = await Api.ListBillingAccountMembersAsync(_selectedAccountId);
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load billing permissions: {ex.Message}", Severity.Error);
            _members = null;
        }
        finally
        {
            _loadingMembers = false;
        }

        await LoadIdentitiesAsync(refreshIdentities);
    }

    // Second pass: classify each user/group member's Google Account and read 2SV / Advanced Protection
    // where visible. Kept separate so the members tables render immediately and enrich in place.
    private async Task LoadIdentitiesAsync(bool refresh)
    {
        if (_members is not { Available: true })
        {
            return;
        }

        var emails = _members.Direct.Concat(_members.Inherited)
            .Where(m => m.MemberType is "user" or "group")
            .Select(m => m.Email)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (emails.Count == 0)
        {
            return;
        }

        _loadingIdentity = true;
        StateHasChanged();
        try
        {
            // Chunked so each request stays far inside the HTTP attempt timeout and rows fill in
            // progressively instead of all-or-nothing after the slowest member.
            const int chunkSize = 16;
            var merged = new Dictionary<string, MemberIdentityInfo>(StringComparer.OrdinalIgnoreCase);
            MemberIdentityResult? last = null;
            string? firstError = null;
            foreach (var chunk in emails.Chunk(chunkSize))
            {
                try
                {
                    var result = await Api.ResolveMemberIdentitiesAsync(chunk, refresh);
                    if (result is null) { continue; }
                    last = result;
                    firstError ??= result.DirectoryError;
                    foreach (var m in result.Members)
                    {
                        merged[m.Email] = m;
                    }
                    _identityByEmail = new Dictionary<string, MemberIdentityInfo>(merged, StringComparer.OrdinalIgnoreCase);
                    StateHasChanged();
                }
                catch (Exception ex)
                {
                    await Snackbar.Add($"Failed to resolve some member identities: {ex.Message}", Severity.Warning);
                }
            }

            _identity = last is null ? null : last with { DirectoryError = firstError, DirectoryAvailable = firstError is null && last.DirectoryAvailable };
        }
        finally
        {
            _loadingIdentity = false;
        }
    }

    private void StartCreate()
    {
        var currency = _budgets.FirstOrDefault()?.CurrencyCode ?? "USD";
        _editing = new BudgetForm { CurrencyCode = currency };
        _t50 = _t90 = _t100 = true;
    }

    private void StartEdit(BudgetInfo budget)
    {
        _editing = new BudgetForm
        {
            BudgetId = budget.BudgetId,
            DisplayName = budget.DisplayName ?? "",
            Amount = budget.Amount,
            CurrencyCode = budget.CurrencyCode ?? "USD",
            CalendarPeriod = budget.CalendarPeriod ?? "MONTH"
        };
        _t50 = budget.ThresholdPercents.Any(p => Math.Abs(p - 0.5) < 0.001);
        _t90 = budget.ThresholdPercents.Any(p => Math.Abs(p - 0.9) < 0.001);
        _t100 = budget.ThresholdPercents.Any(p => Math.Abs(p - 1.0) < 0.001);
    }

    private async Task SaveAsync()
    {
        if (_editing is null || string.IsNullOrEmpty(_selectedAccountId))
        {
            return;
        }

        _saving = true;
        try
        {
            var thresholds = new List<double>();
            if (_t50) thresholds.Add(0.5);
            if (_t90) thresholds.Add(0.9);
            if (_t100) thresholds.Add(1.0);

            await Api.SaveBudgetAsync(new SaveBudgetRequest
            {
                BillingAccountId = _selectedAccountId,
                BudgetId = _editing.BudgetId,
                DisplayName = _editing.DisplayName,
                Amount = _editing.Amount,
                CurrencyCode = string.IsNullOrWhiteSpace(_editing.CurrencyCode) ? "USD" : _editing.CurrencyCode.ToUpperInvariant(),
                ThresholdPercents = thresholds,
                CalendarPeriod = _editing.CalendarPeriod
            });

            await Snackbar.Add(_editing.BudgetId is null ? "Budget created." : "Budget updated.", Severity.Success);
            _editing = null;
            await LoadBudgetsAsync();
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to save budget: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync(BudgetInfo budget)
    {
        var confirmed = await Snackbar.ConfirmAsync(
            "Delete budget",
            $"Delete the budget \"{budget.DisplayName}\"? This cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");
        if (!confirmed || string.IsNullOrEmpty(_selectedAccountId))
        {
            return;
        }

        try
        {
            await Api.DeleteBudgetAsync(_selectedAccountId, budget.BudgetId);
            await Snackbar.Add("Budget deleted.", Severity.Success);
            await LoadBudgetsAsync();
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to delete budget: {ex.Message}", Severity.Error);
        }
    }

    private static string AccountLabel(BillingAccountInfo account)
    {
        var name = account.DisplayName ?? account.Id;
        // Reseller sub-accounts named for a resold Channel customer carry the customer resource path.
        if (name.StartsWith("channel-gcp:accounts/", StringComparison.Ordinal))
        {
            var customerIdx = name.IndexOf("/customers/", StringComparison.Ordinal);
            if (customerIdx >= 0)
            {
                name = $"Channel customer {name[(customerIdx + "/customers/".Length)..]}";
            }
        }

        return account.IsSubaccount ? $"— {name} ({account.Id})" : $"{name} ({account.Id})";
    }
}
