@page "/channel-partner-links/{Id}/repricing"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject UiNotifier Snackbar

<PageTitle>Repricing · Channel partner · GChannel</PageTitle>

@if (_loading)
{
    <LoadingPanel Title="Loading repricing configs…"
                  Hint="Fetching the channel partner link and any margin configs." />
}
else if (_link is null)
{
    <Alert Color="Color.Danger" Visible>Channel partner link not found.</Alert>
    <Button Type="ButtonType.Link" To="/channel-partner-links" Color="Color.Secondary" Outline Margin="Margin.Is4.FromTop">
        <Icon Name="@AppIcons.ArrowBack" Class="me-1" /> Back to links
    </Button>
}
else
{
    <Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Margin="Margin.Is4.FromBottom">
        <Div Flex="Flex.AlignItems.Center" Gap="Gap.Is2">
            <Button Type="ButtonType.Link" To="@($"/channel-partner-links/{Id}")" Color="Color.Light" aria-label="Back to link">
                <Icon Name="@AppIcons.ArrowBack" />
            </Button>
            <Div>
                <Heading Size="HeadingSize.Is3" Margin="Margin.Is0">Repricing margin</Heading>
                <Small TextColor="TextColor.Secondary">
                    @(_link.ChannelPartner?.PrimaryDomain ?? _link.ResellerCloudIdentityId ?? _link.Id)
                </Small>
            </Div>
        </Div>
        <Button Color="Color.Primary" Clicked="@(() => BeginEdit(null))" Disabled="_editing">
            <Icon Name="@AppIcons.Add" Class="me-1" /> New config
        </Button>
    </Div>

    <Alert Color="Color.Info" Visible Margin="Margin.Is4.FromBottom">
        A channel partner repricing config marks up (positive %) or discounts (negative %) the whole
        downstream reseller's bill, starting from the chosen invoice month. Configs can only be created
        or edited for the current or a future invoice month.
    </Alert>

    @if (_editing)
    {
        <Card Shadow="Shadow.Small" Margin="Margin.Is4.FromBottom">
            <CardHeader>
                <CardTitle Size="HeadingSize.Is5" Margin="Margin.Is0">@(_editingId is null ? "New repricing config" : "Edit repricing config")</CardTitle>
            </CardHeader>
            <CardBody>
                <Row>
                    <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop">
                        <Field>
                            <FieldLabel>
                                Rebilling basis
                                <Tooltip Text="The price your adjustment is applied to. List price = Google's published list price; Direct customer cost = what a direct customer would pay." Multiline Inline>
                                    <Icon Name="@AppIcons.Info" TextColor="TextColor.Secondary" Class="ms-1" />
                                </Tooltip>
                            </FieldLabel>
                            <Select TValue="string" @bind-Value="_form.RebillingBasis">
                                <SelectItem TValue="string" Value="@RebillingBases.CostAtList">List price (cost at list)</SelectItem>
                                <SelectItem TValue="string" Value="@RebillingBases.DirectCustomerCost">Direct customer cost</SelectItem>
                            </Select>
                        </Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop">
                        <Field>
                            <FieldLabel>Adjustment</FieldLabel>
                            <Addons>
                                <Addon AddonType="AddonType.Body">
                                    <NumericPicker TValue="decimal" @bind-Value="_form.Percentage" Step="0.5M" Decimals="2" />
                                </Addon>
                                <Addon AddonType="AddonType.End"><AddonLabel>%</AddonLabel></Addon>
                            </Addons>
                            <FieldHelp>Positive marks up, negative discounts, 0 passes through.</FieldHelp>
                        </Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is6.Is3.OnDesktop">
                        <Field>
                            <FieldLabel>Effective year</FieldLabel>
                            <NumericPicker TValue="int" @bind-Value="_form.Year" Min="2000" Max="2100" />
                        </Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is6.Is3.OnDesktop">
                        <Field>
                            <FieldLabel>Effective month</FieldLabel>
                            <NumericPicker TValue="int" @bind-Value="_form.Month" Min="1" Max="12" />
                        </Field>
                    </Column>
                </Row>
            </CardBody>
            <CardFooter Background="Background.Transparent">
                <Button Color="Color.Primary" Clicked="SaveAsync" Disabled="_busy" Loading="_busy">
                    @(_editingId is null ? "Create" : "Save")
                </Button>
                <Button Color="Color.Secondary" Clicked="CancelEdit" Disabled="_busy" Margin="Margin.Is2.FromStart" Class="btn-link text-decoration-none">Cancel</Button>
            </CardFooter>
        </Card>
    }

    <Card Shadow="Shadow.Small">
        <CardHeader>
            <CardTitle Size="HeadingSize.Is5" Margin="Margin.Is0">Configured margins</CardTitle>
        </CardHeader>
        <CardBody>
            @if (_configsLoading)
            {
                <Progress Indeterminate Color="Color.Primary" Size="Size.Small" Margin="Margin.Is2.OnY" />
            }
            else if (_configs is { Count: > 0 })
            {
                <Table Narrow Hoverable Responsive Margin="Margin.Is0">
                    <TableHeader>
                        <TableRow>
                            <TableHeaderCell>Scope</TableHeaderCell>
                            <TableHeaderCell>Effective month</TableHeaderCell>
                            <TableHeaderCell TextAlignment="TextAlignment.End">Adjustment</TableHeaderCell>
                            <TableHeaderCell>Rebilling basis</TableHeaderCell>
                            <TableHeaderCell>Overrides</TableHeaderCell>
                            <TableHeaderCell>Updated</TableHeaderCell>
                            <TableHeaderCell TextAlignment="TextAlignment.End">Actions</TableHeaderCell>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @foreach (var config in _configs)
                        {
                            <TableRow>
                                <TableRowCell>@ScopeLabel(config)</TableRowCell>
                                <TableRowCell>@FormatMonth(config.EffectiveInvoiceYear, config.EffectiveInvoiceMonth)</TableRowCell>
                                <TableRowCell TextAlignment="TextAlignment.End">
                                    <Badge Color="@AdjustmentColor(config.PercentageAdjustment)">@FormatPercent(config.PercentageAdjustment)</Badge>
                                </TableRowCell>
                                <TableRowCell>@RebillingLabel(config.RebillingBasis)</TableRowCell>
                                <TableRowCell>@config.ConditionalOverrideCount</TableRowCell>
                                <TableRowCell>@(config.UpdateTime?.ToString("yyyy-MM-dd") ?? "—")</TableRowCell>
                                <TableRowCell TextAlignment="TextAlignment.End">
                                    <Div Flex="Flex.JustifyContent.End" Gap="Gap.Is1" Class="text-nowrap">
                                        <Tooltip Text="Edit" Inline>
                                            <Button Size="Size.Small" Color="Color.Light" Clicked="@(() => BeginEdit(config))" Disabled="_editing" aria-label="Edit">
                                                <Icon Name="@AppIcons.Edit" />
                                            </Button>
                                        </Tooltip>
                                        <Tooltip Text="Delete" Inline>
                                            <Button Size="Size.Small" Color="Color.Danger" Outline Clicked="@(() => DeleteAsync(config))" Disabled="_busy" aria-label="Delete">
                                                <Icon Name="@AppIcons.Delete" />
                                            </Button>
                                        </Tooltip>
                                    </Div>
                                </TableRowCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
            }
            else
            {
                <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is0">No repricing configs for this channel partner.</Paragraph>
            }
        </CardBody>
    </Card>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private ChannelPartnerLink? _link;
    private IReadOnlyList<RepricingConfig>? _configs;
    private bool _loading = true;
    private bool _configsLoading = true;
    private bool _editing;
    private bool _busy;
    private string? _editingId;
    private readonly RepricingForm _form = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _link = await Api.GetChannelPartnerLinkAsync(Id);
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load channel partner link: {ex.Message}", Severity.Error);
            _link = null;
        }
        finally
        {
            _loading = false;
        }

        if (_link is not null)
        {
            await LoadConfigsAsync();
        }
    }

    private async Task LoadConfigsAsync()
    {
        _configsLoading = true;
        StateHasChanged();
        try
        {
            var result = await Api.ListChannelPartnerRepricingConfigsAsync(Id);
            _configs = result?.Configs ?? [];
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load repricing configs: {ex.Message}", Severity.Error);
            _configs = [];
        }
        finally
        {
            _configsLoading = false;
        }
    }

    private void BeginEdit(RepricingConfig? config)
    {
        var next = NextInvoiceMonth();
        if (config is null)
        {
            _editingId = null;
            _form.Year = next.Year;
            _form.Month = next.Month;
            _form.Percentage = 0m;
            _form.RebillingBasis = RebillingBases.CostAtList;
        }
        else
        {
            _editingId = config.Id;
            _form.Year = config.EffectiveInvoiceYear > 0 ? config.EffectiveInvoiceYear : next.Year;
            _form.Month = config.EffectiveInvoiceMonth > 0 ? config.EffectiveInvoiceMonth : next.Month;
            _form.Percentage = config.PercentageAdjustment;
            _form.RebillingBasis = config.RebillingBasis ?? RebillingBases.CostAtList;
        }

        _editing = true;
    }

    private void CancelEdit()
    {
        _editing = false;
        _editingId = null;
    }

    private async Task SaveAsync()
    {
        var request = new SaveRepricingConfigRequest
        {
            EffectiveInvoiceYear = _form.Year,
            EffectiveInvoiceMonth = _form.Month,
            PercentageAdjustment = _form.Percentage,
            RebillingBasis = _form.RebillingBasis
        };

        _busy = true;
        try
        {
            if (_editingId is null)
            {
                await Api.CreateChannelPartnerRepricingConfigAsync(Id, request);
                await Snackbar.Add("Repricing config created.", Severity.Success);
            }
            else
            {
                await Api.UpdateChannelPartnerRepricingConfigAsync(Id, _editingId, request);
                await Snackbar.Add("Repricing config updated.", Severity.Success);
            }

            _editing = false;
            _editingId = null;
            await LoadConfigsAsync();
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to save repricing config: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(RepricingConfig config)
    {
        _busy = true;
        try
        {
            await Api.DeleteChannelPartnerRepricingConfigAsync(Id, config.Id);
            await Snackbar.Add("Repricing config deleted.", Severity.Success);
            await LoadConfigsAsync();
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to delete repricing config: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string ScopeLabel(RepricingConfig config) =>
        config.Granularity == RepricingGranularities.Entitlement && !string.IsNullOrEmpty(config.EntitlementId)
            ? $"Entitlement {config.EntitlementId}"
            : "Whole partner";

    private static (int Year, int Month) NextInvoiceMonth()
    {
        var next = DateTime.UtcNow.AddMonths(1);
        return (next.Year, next.Month);
    }

    private static string FormatMonth(int year, int month) =>
        year > 0 && month is >= 1 and <= 12
            ? new DateTime(year, month, 1).ToString("MMM yyyy")
            : "—";

    private static string FormatPercent(decimal value) =>
        value > 0 ? $"+{value:0.##}%" : $"{value:0.##}%";

    private static Color AdjustmentColor(decimal value) =>
        value > 0 ? Color.Success : value < 0 ? Color.Warning : Color.Secondary;

    private static string RebillingLabel(string? basis) => basis switch
    {
        RebillingBases.CostAtList => "List price",
        RebillingBases.DirectCustomerCost => "Direct customer cost",
        _ => basis ?? "—"
    };

    private sealed class RepricingForm
    {
        public int Year { get; set; }
        public int Month { get; set; }
        public decimal Percentage { get; set; }
        public string RebillingBasis { get; set; } = RebillingBases.CostAtList;
    }
}

