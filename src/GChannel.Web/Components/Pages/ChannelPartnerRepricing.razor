@page "/channel-partner-links/{Id}/repricing"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject UiNotifier Snackbar

<PageTitle>Repricing · Channel partner · GChannel</PageTitle>

@if (_loading)
{
    <LoadingPanel Title="Loading repricing configs…"
                  Hint="Fetching the channel partner link and any margin configs." />
}
else if (_link is null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">Channel partner link not found.</RadzenAlert>
    <LinkButton To="/channel-partner-links" Text="Back to links" Icon="@AppIcons.ArrowBack" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Class="rz-mt-4" />
}
else
{
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap" class="rz-mb-4">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <LinkButton To="@($"/channel-partner-links/{Id}")" Icon="@AppIcons.ArrowBack" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Title="Back to link" />
            <div>
                <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">Repricing margin</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">
                    @(_link.ChannelPartner?.PrimaryDomain ?? _link.ResellerCloudIdentityId ?? _link.Id)
                </RadzenText>
            </div>
        </RadzenStack>
        <RadzenButton Text="New config" Icon="@AppIcons.Add" ButtonStyle="ButtonStyle.Primary" Click="@(() => BeginEdit(null))" Disabled="_editing" />
    </RadzenStack>

    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-mb-4">
        A channel partner repricing config marks up (positive %) or discounts (negative %) the whole
        downstream reseller's bill, starting from the chosen invoice month. Configs can only be created
        or edited for the current or a future invoice month.
    </RadzenAlert>

    @if (_editing)
    {
        <RadzenCard Variant="Variant.Filled" class="rz-mb-4">
            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">@(_editingId is null ? "New repricing config" : "Edit repricing config")</RadzenText>
            <RadzenRow Gap="1rem" RowGap="1rem">
                <RadzenColumn Size="12" SizeLG="6">
                    <RadzenFormField Text="Rebilling basis" Variant="Variant.Outlined" Style="width:100%">
                        <ChildContent>
                            <RadzenDropDown TValue="string" @bind-Value="_form.RebillingBasis" Data="_basisOptions" ValueProperty="@nameof(SelectOption.Value)" TextProperty="@nameof(SelectOption.Text)" Name="basis" />
                        </ChildContent>
                        <End>
                            <Tip Text="The price your adjustment is applied to. List price = Google's published list price; Direct customer cost = what a direct customer would pay.">
                                <RadzenIcon Icon="@AppIcons.Info" class="rz-text-secondary-color" />
                            </Tip>
                        </End>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeLG="6">
                    <RadzenFormField Text="Adjustment" Variant="Variant.Outlined" Style="width:100%">
                        <ChildContent><RadzenNumeric TValue="decimal" @bind-Value="_form.Percentage" Step="0.5" Format="0.##" Name="percentage" /></ChildContent>
                        <End><span class="rz-text-secondary-color rz-px-2">%</span></End>
                        <Helper><RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">Positive marks up, negative discounts, 0 passes through.</RadzenText></Helper>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="6" SizeLG="3">
                    <RadzenFormField Text="Effective year" Variant="Variant.Outlined" Style="width:100%">
                        <RadzenNumeric TValue="int" @bind-Value="_form.Year" Min="2000" Max="2100" Name="year" />
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="6" SizeLG="3">
                    <RadzenFormField Text="Effective month" Variant="Variant.Outlined" Style="width:100%">
                        <RadzenNumeric TValue="int" @bind-Value="_form.Month" Min="1" Max="12" Name="month" />
                    </RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mt-4">
                <RadzenButton Text="@(_editingId is null ? "Create" : "Save")" ButtonStyle="ButtonStyle.Primary" Click="SaveAsync" IsBusy="_busy" />
                <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Click="CancelEdit" Disabled="_busy" />
            </RadzenStack>
        </RadzenCard>
    }

    <RadzenCard Variant="Variant.Filled">
        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">Configured margins</RadzenText>
        @if (_configsLoading)
        {
            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" class="rz-my-2" />
        }
        else if (_configs is { Count: > 0 })
        {
            <RadzenDataGrid TItem="RepricingConfig" Data="_configs" AllowPaging="false" AllowSorting="false" Density="Density.Compact" GridLines="DataGridGridLines.Horizontal" Responsive="true">
                <Columns>
                    <RadzenDataGridColumn TItem="RepricingConfig" Title="Scope">
                        <Template Context="config">@ScopeLabel(config)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RepricingConfig" Title="Effective month">
                        <Template Context="config">@FormatMonth(config.EffectiveInvoiceYear, config.EffectiveInvoiceMonth)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RepricingConfig" Title="Adjustment" TextAlign="TextAlign.End">
                        <Template Context="config">
                            <RadzenBadge BadgeStyle="@AdjustmentColor(config.PercentageAdjustment)" Text="@FormatPercent(config.PercentageAdjustment)" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RepricingConfig" Title="Rebilling basis">
                        <Template Context="config">@RebillingLabel(config.RebillingBasis)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RepricingConfig" Property="@nameof(RepricingConfig.ConditionalOverrideCount)" Title="Overrides" Width="100px" />
                    <RadzenDataGridColumn TItem="RepricingConfig" Title="Updated" Width="110px">
                        <Template Context="config">@(config.UpdateTime?.ToString("yyyy-MM-dd") ?? "—")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RepricingConfig" Title="Actions" TextAlign="TextAlign.End" Width="110px">
                        <Template Context="config">
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.25rem" class="rz-text-nowrap">
                                <Tip Text="Edit">
                                    <RadzenButton Icon="@AppIcons.Edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Click="@(() => BeginEdit(config))" Disabled="_editing" aria-label="Edit" />
                                </Tip>
                                <Tip Text="Delete">
                                    <RadzenButton Icon="@AppIcons.Delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="@(() => DeleteAsync(config))" Disabled="_busy" aria-label="Delete" />
                                </Tip>
                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
        else
        {
            <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-m-0">No repricing configs for this channel partner.</RadzenText>
        }
    </RadzenCard>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private ChannelPartnerLink? _link;
    private IReadOnlyList<RepricingConfig>? _configs;
    private bool _loading = true;
    private bool _configsLoading = true;
    private bool _editing;
    private bool _busy;
    private string? _editingId;
    private readonly RepricingForm _form = new();

    private static readonly SelectOption[] _basisOptions =
    [
        new(RebillingBases.CostAtList, "List price (cost at list)"),
        new(RebillingBases.DirectCustomerCost, "Direct customer cost"),
    ];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _link = await Api.GetChannelPartnerLinkAsync(Id);
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load channel partner link: {ex.Message}", Severity.Error);
            _link = null;
        }
        finally
        {
            _loading = false;
        }

        if (_link is not null)
        {
            await LoadConfigsAsync();
        }
    }

    private async Task LoadConfigsAsync()
    {
        _configsLoading = true;
        StateHasChanged();
        try
        {
            var result = await Api.ListChannelPartnerRepricingConfigsAsync(Id);
            _configs = result?.Configs ?? [];
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load repricing configs: {ex.Message}", Severity.Error);
            _configs = [];
        }
        finally
        {
            _configsLoading = false;
        }
    }

    private void BeginEdit(RepricingConfig? config)
    {
        var next = NextInvoiceMonth();
        if (config is null)
        {
            _editingId = null;
            _form.Year = next.Year;
            _form.Month = next.Month;
            _form.Percentage = 0m;
            _form.RebillingBasis = RebillingBases.CostAtList;
        }
        else
        {
            _editingId = config.Id;
            _form.Year = config.EffectiveInvoiceYear > 0 ? config.EffectiveInvoiceYear : next.Year;
            _form.Month = config.EffectiveInvoiceMonth > 0 ? config.EffectiveInvoiceMonth : next.Month;
            _form.Percentage = config.PercentageAdjustment;
            _form.RebillingBasis = config.RebillingBasis ?? RebillingBases.CostAtList;
        }

        _editing = true;
    }

    private void CancelEdit()
    {
        _editing = false;
        _editingId = null;
    }

    private async Task SaveAsync()
    {
        var request = new SaveRepricingConfigRequest
        {
            EffectiveInvoiceYear = _form.Year,
            EffectiveInvoiceMonth = _form.Month,
            PercentageAdjustment = _form.Percentage,
            RebillingBasis = _form.RebillingBasis
        };

        _busy = true;
        try
        {
            if (_editingId is null)
            {
                await Api.CreateChannelPartnerRepricingConfigAsync(Id, request);
                await Snackbar.Add("Repricing config created.", Severity.Success);
            }
            else
            {
                await Api.UpdateChannelPartnerRepricingConfigAsync(Id, _editingId, request);
                await Snackbar.Add("Repricing config updated.", Severity.Success);
            }

            _editing = false;
            _editingId = null;
            await LoadConfigsAsync();
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to save repricing config: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(RepricingConfig config)
    {
        _busy = true;
        try
        {
            await Api.DeleteChannelPartnerRepricingConfigAsync(Id, config.Id);
            await Snackbar.Add("Repricing config deleted.", Severity.Success);
            await LoadConfigsAsync();
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to delete repricing config: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string ScopeLabel(RepricingConfig config) =>
        config.Granularity == RepricingGranularities.Entitlement && !string.IsNullOrEmpty(config.EntitlementId)
            ? $"Entitlement {config.EntitlementId}"
            : "Whole partner";

    private static (int Year, int Month) NextInvoiceMonth()
    {
        var next = DateTime.UtcNow.AddMonths(1);
        return (next.Year, next.Month);
    }

    private static string FormatMonth(int year, int month) =>
        year > 0 && month is >= 1 and <= 12
            ? new DateTime(year, month, 1).ToString("MMM yyyy")
            : "—";

    private static string FormatPercent(decimal value) =>
        value > 0 ? $"+{value:0.##}%" : $"{value:0.##}%";

    private static BadgeStyle AdjustmentColor(decimal value) =>
        value > 0 ? BadgeStyle.Success : value < 0 ? BadgeStyle.Warning : BadgeStyle.Light;

    private static string RebillingLabel(string? basis) => basis switch
    {
        RebillingBases.CostAtList => "List price",
        RebillingBases.DirectCustomerCost => "Direct customer cost",
        _ => basis ?? "—"
    };

    private sealed class RepricingForm
    {
        public int Year { get; set; }
        public int Month { get; set; }
        public decimal Percentage { get; set; }
        public string RebillingBasis { get; set; } = RebillingBases.CostAtList;
    }
}

