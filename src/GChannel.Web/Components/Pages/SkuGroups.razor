@page "/catalog/sku-groups"
@attribute [Authorize]
@using Blazorise
@inject GChannelApiClient Api
@inject UiNotifier Snackbar

<PageTitle>SKU groups · GChannel</PageTitle>

<Heading Size="HeadingSize.Is3" Margin="Margin.Is2.FromBottom">SKU groups</Heading>
<Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is5.FromBottom">
    Rebilling-supported SKU groups. Expand a group to load its billable SKUs.
</Paragraph>

@if (_loading)
{
    <LoadingPanel Title="Loading SKU groups…"
                  Hint="Fetching the rebilling-supported SKU groups for your account." />
}
else if (_groups is { Count: > 0 })
{
    <Accordion>
        @foreach (var grp in _groups)
        {
            <AccordionItem Visible="_expanded.Contains(grp.Id)"
                           VisibleChanged="expanded => OnGroupExpanded(grp, expanded)">
                <AccordionHeader>
                    <Heading Size="HeadingSize.Is6" Margin="Margin.Is0">
                        <AccordionToggle>@(grp.DisplayName ?? grp.Id)</AccordionToggle>
                    </Heading>
                </AccordionHeader>
                <AccordionBody>
                    @if (_billableByGroup.TryGetValue(grp.Id, out var billables))
                    {
                        @if (billables is null)
                        {
                            <Progress Indeterminate Color="Color.Primary" Size="Size.Small" Margin="Margin.Is2.OnY" />
                        }
                        else if (billables.Count == 0)
                        {
                            <Paragraph TextColor="TextColor.Secondary">No billable SKUs found.</Paragraph>
                        }
                        else
                        {
                            <Table Narrow Hoverable Responsive>
                                <TableHeader>
                                    <TableRow>
                                        <TableHeaderCell>SKU</TableHeaderCell>
                                        <TableHeaderCell>Service</TableHeaderCell>
                                        <TableHeaderCell>Related</TableHeaderCell>
                                    </TableRow>
                                </TableHeader>
                                <TableBody>
                                    @foreach (var sku in billables)
                                    {
                                        <TableRow>
                                            <TableRowCell>
                                                <Tooltip Text="@(sku.SkuId ?? sku.Sku)" Inline>
                                                    <span>@(sku.SkuDisplayName ?? sku.SkuId ?? sku.Sku)</span>
                                                </Tooltip>
                                            </TableRowCell>
                                            <TableRowCell>@(sku.ServiceDisplayName ?? sku.Service)</TableRowCell>
                                            <TableRowCell>
                                                @if (!string.IsNullOrEmpty(sku.ProductId))
                                                {
                                                    <Button Type="ButtonType.Link" To="@($"/catalog/products?product={sku.ProductId}&sku={sku.SkuId}")"
                                                            Size="Size.Small" Color="Color.Primary" Class="btn-link text-decoration-none">
                                                        <Icon Name="@AppIcons.Inventory" Class="me-1" /> Product
                                                    </Button>
                                                }
                                                @if (!string.IsNullOrEmpty(sku.SkuId))
                                                {
                                                    <Button Type="ButtonType.Link" To="@($"/catalog/offers?sku={sku.SkuId}")"
                                                            Size="Size.Small" Color="Color.Primary" Class="btn-link text-decoration-none">
                                                        <Icon Name="@AppIcons.LocalOffer" Class="me-1" /> Offers
                                                    </Button>
                                                }
                                            </TableRowCell>
                                        </TableRow>
                                    }
                                </TableBody>
                            </Table>
                        }
                    }
                </AccordionBody>
            </AccordionItem>
        }
    </Accordion>
}
else
{
    <Alert Color="Color.Info" Visible>No SKU groups available.</Alert>
}

@code {
    private IReadOnlyList<CatalogSkuGroup>? _groups;
    private readonly Dictionary<string, IReadOnlyList<CatalogBillableSku>?> _billableByGroup = [];
    private readonly HashSet<string> _expanded = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Api.ListSkuGroupsAsync();
            _groups = result?.SkuGroups ?? [];
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load SKU groups: {ex.Message}", Severity.Error);
            _groups = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnGroupExpanded(CatalogSkuGroup group, bool expanded)
    {
        if (expanded)
        {
            _expanded.Add(group.Id);
        }
        else
        {
            _expanded.Remove(group.Id);
        }

        if (!expanded || _billableByGroup.ContainsKey(group.Id))
        {
            return;
        }

        // Mark as loading (null) so the panel shows a progress bar.
        _billableByGroup[group.Id] = null;
        try
        {
            var result = await Api.ListBillableSkusAsync(group.Id);
            _billableByGroup[group.Id] = result?.BillableSkus ?? [];
        }
        catch (Exception ex)
        {
            _billableByGroup.Remove(group.Id);
            await Snackbar.Add($"Failed to load billable SKUs: {ex.Message}", Severity.Error);
        }
    }
}
