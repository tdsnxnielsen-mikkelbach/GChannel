@page "/catalog/sku-groups"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject UiNotifier Snackbar

<PageTitle>SKU groups · GChannel</PageTitle>

<RadzenText TextStyle="TextStyle.H4" class="rz-mb-2">SKU groups</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-text-secondary-color rz-mb-6">
    Rebilling-supported SKU groups. Expand a group to load its billable SKUs.
</RadzenText>

@if (_loading)
{
    <LoadingPanel Title="Loading SKU groups…"
                  Hint="Fetching the rebilling-supported SKU groups for your account." />
}
else if (_groups is { Count: > 0 })
{
    <RadzenAccordion Multiple="true">
        <Items>
            @foreach (var grp in _groups)
            {
                <RadzenAccordionItem Text="@(grp.DisplayName ?? grp.Id)"
                                     Selected="_expanded.Contains(grp.Id)"
                                     SelectedChanged="expanded => OnGroupExpanded(grp, expanded)">
                    @if (_billableByGroup.TryGetValue(grp.Id, out var billables))
                    {
                        @if (billables is null)
                        {
                            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" class="rz-my-2" />
                        }
                        else if (billables.Count == 0)
                        {
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color">No billable SKUs found.</RadzenText>
                        }
                        else
                        {
                            <table class="gchannel-table gchannel-table-hover">
                                <thead>
                                    <tr>
                                        <th>SKU</th>
                                        <th>Service</th>
                                        <th>Related</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var sku in billables)
                                    {
                                        <tr>
                                            <td><Tip Text="@(sku.SkuId ?? sku.Sku)">@(sku.SkuDisplayName ?? sku.SkuId ?? sku.Sku)</Tip></td>
                                            <td>@(sku.ServiceDisplayName ?? sku.Service)</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(sku.ProductId))
                                                {
                                                    <LinkButton To="@($"/catalog/products?product={sku.ProductId}&sku={sku.SkuId}")" Text="Product" Icon="@AppIcons.Inventory"
                                                                Variant="Variant.Text" Size="ButtonSize.Small" />
                                                }
                                                @if (!string.IsNullOrEmpty(sku.SkuId))
                                                {
                                                    <LinkButton To="@($"/catalog/offers?sku={sku.SkuId}")" Text="Offers" Icon="@AppIcons.LocalOffer"
                                                                Variant="Variant.Text" Size="ButtonSize.Small" />
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }
                </RadzenAccordionItem>
            }
        </Items>
    </RadzenAccordion>
}
else
{
    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">No SKU groups available.</RadzenAlert>
}

@code {
    private IReadOnlyList<CatalogSkuGroup>? _groups;
    private readonly Dictionary<string, IReadOnlyList<CatalogBillableSku>?> _billableByGroup = [];
    private readonly HashSet<string> _expanded = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Api.ListSkuGroupsAsync();
            _groups = result?.SkuGroups ?? [];
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load SKU groups: {ex.Message}", Severity.Error);
            _groups = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnGroupExpanded(CatalogSkuGroup group, bool expanded)
    {
        if (expanded)
        {
            _expanded.Add(group.Id);
        }
        else
        {
            _expanded.Remove(group.Id);
        }

        if (!expanded || _billableByGroup.ContainsKey(group.Id))
        {
            return;
        }

        // Mark as loading (null) so the panel shows a progress bar.
        _billableByGroup[group.Id] = null;
        try
        {
            var result = await Api.ListBillableSkusAsync(group.Id);
            _billableByGroup[group.Id] = result?.BillableSkus ?? [];
        }
        catch (Exception ex)
        {
            _billableByGroup.Remove(group.Id);
            await Snackbar.Add($"Failed to load billable SKUs: {ex.Message}", Severity.Error);
        }
    }
}

