@page "/customers/{CustomerId}/entitlements/new"
@attribute [Authorize]
@using Blazorise
@inject GChannelApiClient Api
@inject UiNotifier Snackbar
@inject NavigationManager Nav

<PageTitle>Purchase entitlement · GChannel</PageTitle>

<Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Margin="Margin.Is2.FromBottom">
    <Div>
        <Heading Size="HeadingSize.Is3" Margin="Margin.Is0">Purchase entitlement</Heading>
        <Small TextColor="TextColor.Secondary">
            @(_customer?.OrgDisplayName ?? CustomerId)@(string.IsNullOrEmpty(_customer?.Domain) ? "" : $" · {_customer!.Domain}")
        </Small>
    </Div>
    <Button Type="ButtonType.Link" To="@($"/customers/{CustomerId}/entitlements")" Color="Color.Secondary" Outline>
        <Icon Name="@AppIcons.ArrowBack" Class="me-1" /> Back
    </Button>
</Div>

<Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Margin="Margin.Is5.FromBottom">
    <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is0">
        Pick a product, then a SKU and Offer the customer is eligible to purchase, set the seat count
        and submit. The order is provisioned asynchronously by Google.
    </Paragraph>
    <GuidedWalkthrough Id="purchase-entitlement" Steps="_walkthrough" />
</Div>

@if (_loading)
{
    <LoadingPanel Title="Loading catalog…"
                  Hint="Fetching the products this customer is eligible to purchase." />
}
else
{
    <Card Shadow="Shadow.Small" Style="max-width:640px">
        <CardBody>
            <Field data-walkthrough="pe-product">
                <FieldLabel>Product</FieldLabel>
                <Select TValue="string" Value="@_productId" ValueChanged="OnProductSelected">
                    <SelectItem TValue="string" Value="@((string?)null)">Choose a product…</SelectItem>
                    @foreach (var product in _products ?? [])
                    {
                        <SelectItem TValue="string" Value="@product.Id">@(product.DisplayName ?? product.Id)</SelectItem>
                    }
                </Select>
            </Field>

            @if (_skusLoading)
            {
                <Progress Indeterminate Color="Color.Primary" Size="Size.Small" Margin="Margin.Is2.OnY" />
            }
            else if (_skus is not null)
            {
                <Field>
                    <FieldLabel>SKU</FieldLabel>
                    <Select TValue="string" Value="@_skuId" ValueChanged="OnSkuSelected" Disabled="_skus.Count == 0">
                        <SelectItem TValue="string" Value="@((string?)null)">Choose a SKU…</SelectItem>
                        @foreach (var sku in _skus)
                        {
                            <SelectItem TValue="string" Value="@sku.SkuId">@(sku.DisplayName ?? sku.SkuId)</SelectItem>
                        }
                    </Select>
                    @if (_skus.Count == 0)
                    {
                        <FieldHelp>No purchasable SKUs for this product.</FieldHelp>
                    }
                </Field>
            }

            @if (_offersLoading)
            {
                <Progress Indeterminate Color="Color.Primary" Size="Size.Small" Margin="Margin.Is2.OnY" />
            }
            else if (_offers is not null)
            {
                <Field>
                    <FieldLabel>Offer</FieldLabel>
                    <Select TValue="string" @bind-Value="_offerId" Disabled="_offers.Count == 0">
                        <SelectItem TValue="string" Value="@((string?)null)">Choose an offer…</SelectItem>
                        @foreach (var offer in _offers)
                        {
                            <SelectItem TValue="string" Value="@OfferKey(offer)">@(offer.DisplayName ?? OfferKey(offer))</SelectItem>
                        }
                    </Select>
                    @if (_offers.Count == 0)
                    {
                        <FieldHelp>No purchasable offers for this SKU.</FieldHelp>
                    }
                </Field>
            }

            @if (_billingAccounts is { Count: > 0 })
            {
                <Field data-walkthrough="pe-billing">
                    <FieldLabel>Billing account</FieldLabel>
                    <Select TValue="string" @bind-Value="_billingAccount">
                        <SelectItem TValue="string" Value="@((string?)null)">Choose a billing account…</SelectItem>
                        @foreach (var account in _billingAccounts)
                        {
                            <SelectItem TValue="string" Value="@account.Name">
                                @(account.DisplayName ?? account.Id)@(string.IsNullOrEmpty(account.CurrencyCode) ? "" : $" · {account.CurrencyCode}")
                            </SelectItem>
                        }
                    </Select>
                    <FieldHelp>This SKU is billed against a Google Cloud billing account.</FieldHelp>
                </Field>
            }

            <Field data-walkthrough="pe-seats">
                <FieldLabel>Seats (num_units)</FieldLabel>
                <NumericPicker TValue="int" @bind-Value="_seats" Min="1" />
                <FieldHelp>Number of licensed seats to purchase.</FieldHelp>
            </Field>

            @if (SelectedOffer is { } sel && SelectedSeatPrice(sel) is { } seat)
            {
                <Alert Color="Color.Info" Visible Margin="Margin.Is4.FromBottom">
                    Est. list price: @seat.Display / seat@(string.IsNullOrEmpty(sel.PaymentCycle) ? "" : $" · {sel.PaymentCycle.ToLowerInvariant()}")
                    · @_seats seat@(_seats == 1 ? "" : "s") ≈ @($"{seat.CurrencyCode} {(seat.Value * _seats):0.00}")
                    <Small Display="Display.Block">Estimated wholesale list pricing, not an invoiced amount.</Small>
                </Alert>
            }

            <Field>
                <FieldLabel>Purchase order id (optional)</FieldLabel>
                <TextInput @bind-Value="_purchaseOrderId" />
            </Field>
        </CardBody>
        <CardFooter Background="Background.Transparent">
            <Button Color="Color.Primary" Clicked="SubmitAsync" Loading="_submitting" data-walkthrough="pe-submit"
                    Disabled="@(_submitting || string.IsNullOrEmpty(_offerId) || (_billingAccounts is { Count: > 0 } && string.IsNullOrEmpty(_billingAccount)))">
                <Icon Name="@AppIcons.ShoppingCartCheckout" Class="me-1" /> @(_submitting ? "Submitting…" : "Purchase")
            </Button>
        </CardFooter>
    </Card>
}

@code {
    [Parameter]
    public string CustomerId { get; set; } = string.Empty;

    private Customer? _customer;
    private IReadOnlyList<CatalogProduct>? _products;
    private string? _productId;

    private IReadOnlyList<PurchasableSku>? _skus;
    private string? _skuId;
    private bool _skusLoading;

    private IReadOnlyList<PurchasableOffer>? _offers;
    private string? _offerId;
    private bool _offersLoading;

    // Eligible billing accounts are only returned for GCP / n-tier billing-gated SKUs; the picker
    // renders only when the query yields at least one account. Holds the selected account resource name.
    private IReadOnlyList<EligibleBillingAccount>? _billingAccounts;
    private string? _billingAccount;

    private int _seats = 1;
    private string? _purchaseOrderId;
    private bool _loading = true;
    private bool _submitting;

    private static readonly IReadOnlyList<WalkthroughStep> _walkthrough =
    [
        new(null, "Purchase an entitlement", "This short tour shows how to assign a SKU to the customer."),
        new("[data-walkthrough=\"pe-product\"]", "1. Choose a product", "Select a product; eligible SKUs then load for it."),
        new("[data-walkthrough=\"pe-seats\"]", "2. Set the seats", "After picking a SKU and Offer, enter how many licensed seats to buy."),
        new("[data-walkthrough=\"pe-billing\"]", "Billing account (GCP SKUs)", "Some Google Cloud / n-tier SKUs are billed against a billing account. This picker appears only for those SKUs; ordinary SKUs skip it."),
        new("[data-walkthrough=\"pe-submit\"]", "3. Purchase", "Submit the order — Google provisions it asynchronously; track it under Operations."),
    ];

    // The offer resource name uniquely identifies the offer to purchase.
    private static string OfferKey(PurchasableOffer offer) => offer.OfferName;

    // The offer currently selected (by resource name) for the price summary.
    private PurchasableOffer? SelectedOffer =>
        _offers?.FirstOrDefault(o => string.Equals(OfferKey(o), _offerId, StringComparison.Ordinal));

    // Effective per-seat price: prefer SEAT resource, else the first priced resource.
    private static MoneyAmount? SelectedSeatPrice(PurchasableOffer offer) =>
        (offer.Pricing.FirstOrDefault(p => string.Equals(p.ResourceType, "SEAT", StringComparison.OrdinalIgnoreCase))
            ?? offer.Pricing.FirstOrDefault(p => p.EffectivePrice is not null))?.EffectivePrice;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _customer = await Api.GetCustomerAsync(CustomerId);
            var products = await Api.ListProductsAsync();
            _products = products?.Products ?? [];
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load catalog: {ex.Message}", Severity.Error);
            _products = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnProductSelected(string? productId)
    {
        _productId = productId;
        _skuId = null;
        _skus = null;
        _offerId = null;
        _offers = null;
        _billingAccounts = null;
        _billingAccount = null;
        if (string.IsNullOrEmpty(productId))
        {
            return;
        }

        _skusLoading = true;
        try
        {
            var result = await Api.ListPurchasableSkusAsync(CustomerId, productId);
            _skus = result?.Skus ?? [];
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load SKUs: {ex.Message}", Severity.Error);
            _skus = [];
        }
        finally
        {
            _skusLoading = false;
        }
    }

    private async Task OnSkuSelected(string? skuId)
    {
        _skuId = skuId;
        _offerId = null;
        _offers = null;
        _billingAccounts = null;
        _billingAccount = null;
        if (string.IsNullOrEmpty(skuId))
        {
            return;
        }

        _offersLoading = true;
        try
        {
            var result = await Api.ListPurchasableOffersAsync(CustomerId, _productId ?? string.Empty, skuId);
            _offers = result?.Offers ?? [];
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load offers: {ex.Message}", Severity.Error);
            _offers = [];
        }
        finally
        {
            _offersLoading = false;
        }

        await LoadEligibleBillingAccountsAsync(skuId);
    }

    // Best-effort: queryEligibleBillingAccounts only applies to GCP / n-tier billing-gated SKUs and
    // errors or returns nothing for ordinary SKUs, so failures are swallowed and the picker stays hidden.
    private async Task LoadEligibleBillingAccountsAsync(string skuId)
    {
        try
        {
            var sku = $"products/{_productId}/skus/{skuId}";
            var result = await Api.QueryEligibleBillingAccountsAsync(CustomerId, [sku]);
            _billingAccounts = result?.Groups.SelectMany(g => g.BillingAccounts).ToList() ?? [];
            _billingAccount = _billingAccounts.Count == 1 ? _billingAccounts[0].Name : null;
        }
        catch
        {
            _billingAccounts = [];
            _billingAccount = null;
        }
    }

    private async Task SubmitAsync()
    {
        if (string.IsNullOrEmpty(_offerId))
        {
            return;
        }

        _submitting = true;
        try
        {
            var request = new PurchaseEntitlementRequest
            {
                OfferId = _offerId,
                PurchaseOrderId = string.IsNullOrWhiteSpace(_purchaseOrderId) ? null : _purchaseOrderId,
                Parameters = [new EntitlementParameterInput { Name = "num_units", IntValue = _seats }],
                BillingAccount = _billingAccounts is { Count: > 0 } ? _billingAccount : null
            };

            var op = await Api.PurchaseEntitlementAsync(CustomerId, request);
            if (!string.IsNullOrEmpty(op?.Error))
            {
                await Snackbar.Add($"Purchase failed: {op!.Error}", Severity.Error);
                return;
            }

            await Snackbar.Add(op?.Done == true
                ? "Entitlement purchased."
                : "Purchase submitted — Google is provisioning it, this may take a moment.", Severity.Success);
            Nav.NavigateTo($"/customers/{CustomerId}/entitlements");
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Purchase failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }
}

