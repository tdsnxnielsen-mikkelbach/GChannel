@page "/customers/{CustomerId}/entitlements/new"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject UiNotifier Snackbar
@inject NavigationManager Nav

<PageTitle>Purchase entitlement · GChannel</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap" class="rz-mb-2">
    <div>
        <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">Purchase entitlement</RadzenText>
        <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">
            @(_customer?.OrgDisplayName ?? CustomerId)@(string.IsNullOrEmpty(_customer?.Domain) ? "" : $" · {_customer!.Domain}")
        </RadzenText>
    </div>
    <LinkButton To="@($"/customers/{CustomerId}/entitlements")" Text="Back" Icon="@AppIcons.ArrowBack" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" />
</RadzenStack>

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap" class="rz-mb-6">
    <RadzenText TextStyle="TextStyle.Body1" class="rz-text-secondary-color rz-m-0">
        Pick a product, then a SKU and Offer the customer is eligible to purchase, set the seat count
        and submit. The order is provisioned asynchronously by Google.
    </RadzenText>
    <GuidedWalkthrough Id="purchase-entitlement" Steps="_walkthrough" />
</RadzenStack>

@if (_loading)
{
    <LoadingPanel Title="Loading catalog…"
                  Hint="Fetching the products this customer is eligible to purchase." />
}
else
{
    <RadzenCard Variant="Variant.Filled" Style="max-width:640px">
        <RadzenStack Gap="1rem">
            <div data-walkthrough="pe-product">
                <RadzenFormField Text="Product" Variant="Variant.Outlined" Style="width:100%">
                    <RadzenDropDown TValue="string" Data="_products ?? []" ValueProperty="@nameof(CatalogProduct.Id)" TextProperty="@nameof(CatalogProduct.DisplayName)"
                                    Value="@_productId" ValueChanged="OnProductSelected" AllowClear="true" Placeholder="Choose a product…" Name="product">
                        <Template Context="p">@(p.DisplayName ?? p.Id)</Template>
                    </RadzenDropDown>
                </RadzenFormField>
            </div>

            @if (_skusLoading)
            {
                <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" class="rz-my-2" />
            }
            else if (_skus is not null)
            {
                <RadzenFormField Text="SKU" Variant="Variant.Outlined" Style="width:100%">
                    <ChildContent>
                        <RadzenDropDown TValue="string" Data="_skus" ValueProperty="@nameof(PurchasableSku.SkuId)" TextProperty="@nameof(PurchasableSku.DisplayName)"
                                        Value="@_skuId" ValueChanged="OnSkuSelected" Disabled="_skus.Count == 0" AllowClear="true" Placeholder="Choose a SKU…" Name="sku">
                            <Template Context="s">@(s.DisplayName ?? s.SkuId)</Template>
                        </RadzenDropDown>
                    </ChildContent>
                    <Helper>
                        @if (_skus.Count == 0)
                        {
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">No purchasable SKUs for this product.</RadzenText>
                        }
                    </Helper>
                </RadzenFormField>
            }

            @if (_offersLoading)
            {
                <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" class="rz-my-2" />
            }
            else if (_offers is not null)
            {
                <RadzenFormField Text="Offer" Variant="Variant.Outlined" Style="width:100%">
                    <ChildContent>
                        <RadzenDropDown TValue="string" Data="_offers" ValueProperty="@nameof(PurchasableOffer.OfferName)" TextProperty="@nameof(PurchasableOffer.DisplayName)"
                                        @bind-Value="_offerId" Disabled="_offers.Count == 0" AllowClear="true" Placeholder="Choose an offer…" Name="offer">
                            <Template Context="o">@(o.DisplayName ?? o.OfferName)</Template>
                        </RadzenDropDown>
                    </ChildContent>
                    <Helper>
                        @if (_offers.Count == 0)
                        {
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">No purchasable offers for this SKU.</RadzenText>
                        }
                    </Helper>
                </RadzenFormField>
            }

            @if (_billingAccounts is { Count: > 0 })
            {
                <div data-walkthrough="pe-billing">
                    <RadzenFormField Text="Billing account" Variant="Variant.Outlined" Style="width:100%">
                        <ChildContent>
                            <RadzenDropDown TValue="string" Data="_billingAccounts" ValueProperty="@nameof(EligibleBillingAccount.Name)" TextProperty="@nameof(EligibleBillingAccount.DisplayName)"
                                            @bind-Value="_billingAccount" AllowClear="true" Placeholder="Choose a billing account…" Name="billingAccount">
                                <Template Context="a">@(a.DisplayName ?? a.Id)@(string.IsNullOrEmpty(a.CurrencyCode) ? "" : $" · {a.CurrencyCode}")</Template>
                            </RadzenDropDown>
                        </ChildContent>
                        <Helper><RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">This SKU is billed against a Google Cloud billing account.</RadzenText></Helper>
                    </RadzenFormField>
                </div>
            }

            <div data-walkthrough="pe-seats">
                <RadzenFormField Text="Seats (num_units)" Variant="Variant.Outlined" Style="width:100%">
                    <ChildContent><RadzenNumeric TValue="int" @bind-Value="_seats" Min="1" Name="seats" /></ChildContent>
                    <Helper><RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">Number of licensed seats to purchase.</RadzenText></Helper>
                </RadzenFormField>
            </div>

            @if (SelectedOffer is { } sel && SelectedSeatPrice(sel) is { } seat)
            {
                <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-m-0">
                    Est. list price: @seat.Display / seat@(string.IsNullOrEmpty(sel.PaymentCycle) ? "" : $" · {sel.PaymentCycle.ToLowerInvariant()}")
                    · @_seats seat@(_seats == 1 ? "" : "s") ≈ @($"{seat.CurrencyCode} {(seat.Value * _seats):0.00}")
                    <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Div" class="rz-m-0">Estimated wholesale list pricing, not an invoiced amount.</RadzenText>
                </RadzenAlert>
            }

            <RadzenFormField Text="Purchase order id (optional)" Variant="Variant.Outlined" Style="width:100%">
                <RadzenTextBox @bind-Value="_purchaseOrderId" Name="purchaseOrder" />
            </RadzenFormField>

            <div>
                <RadzenButton Text="Purchase" Icon="@AppIcons.ShoppingCartCheckout" ButtonStyle="ButtonStyle.Primary" Click="SubmitAsync" IsBusy="_submitting" BusyText="Submitting…" data-walkthrough="pe-submit"
                              Disabled="@(string.IsNullOrEmpty(_offerId) || (_billingAccounts is { Count: > 0 } && string.IsNullOrEmpty(_billingAccount)))" />
            </div>
        </RadzenStack>
    </RadzenCard>
}

@code {
    [Parameter]
    public string CustomerId { get; set; } = string.Empty;

    private Customer? _customer;
    private IReadOnlyList<CatalogProduct>? _products;
    private string? _productId;

    private IReadOnlyList<PurchasableSku>? _skus;
    private string? _skuId;
    private bool _skusLoading;

    private IReadOnlyList<PurchasableOffer>? _offers;
    private string? _offerId;
    private bool _offersLoading;

    // Eligible billing accounts are only returned for GCP / n-tier billing-gated SKUs; the picker
    // renders only when the query yields at least one account. Holds the selected account resource name.
    private IReadOnlyList<EligibleBillingAccount>? _billingAccounts;
    private string? _billingAccount;

    private int _seats = 1;
    private string? _purchaseOrderId;
    private bool _loading = true;
    private bool _submitting;

    private static readonly IReadOnlyList<WalkthroughStep> _walkthrough =
    [
        new(null, "Purchase an entitlement", "This short tour shows how to assign a SKU to the customer."),
        new("[data-walkthrough=\"pe-product\"]", "1. Choose a product", "Select a product; eligible SKUs then load for it."),
        new("[data-walkthrough=\"pe-seats\"]", "2. Set the seats", "After picking a SKU and Offer, enter how many licensed seats to buy."),
        new("[data-walkthrough=\"pe-billing\"]", "Billing account (GCP SKUs)", "Some Google Cloud / n-tier SKUs are billed against a billing account. This picker appears only for those SKUs; ordinary SKUs skip it."),
        new("[data-walkthrough=\"pe-submit\"]", "3. Purchase", "Submit the order — Google provisions it asynchronously; track it under Operations."),
    ];

    // The offer resource name uniquely identifies the offer to purchase.
    private static string OfferKey(PurchasableOffer offer) => offer.OfferName;

    // The offer currently selected (by resource name) for the price summary.
    private PurchasableOffer? SelectedOffer =>
        _offers?.FirstOrDefault(o => string.Equals(OfferKey(o), _offerId, StringComparison.Ordinal));

    // Effective per-seat price: prefer SEAT resource, else the first priced resource.
    private static MoneyAmount? SelectedSeatPrice(PurchasableOffer offer) =>
        (offer.Pricing.FirstOrDefault(p => string.Equals(p.ResourceType, "SEAT", StringComparison.OrdinalIgnoreCase))
            ?? offer.Pricing.FirstOrDefault(p => p.EffectivePrice is not null))?.EffectivePrice;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _customer = await Api.GetCustomerAsync(CustomerId);
            var products = await Api.ListProductsAsync();
            _products = products?.Products ?? [];
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load catalog: {ex.Message}", Severity.Error);
            _products = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnProductSelected(string? productId)
    {
        _productId = productId;
        _skuId = null;
        _skus = null;
        _offerId = null;
        _offers = null;
        _billingAccounts = null;
        _billingAccount = null;
        if (string.IsNullOrEmpty(productId))
        {
            return;
        }

        _skusLoading = true;
        try
        {
            var result = await Api.ListPurchasableSkusAsync(CustomerId, productId);
            _skus = result?.Skus ?? [];
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load SKUs: {ex.Message}", Severity.Error);
            _skus = [];
        }
        finally
        {
            _skusLoading = false;
        }
    }

    private async Task OnSkuSelected(string? skuId)
    {
        _skuId = skuId;
        _offerId = null;
        _offers = null;
        _billingAccounts = null;
        _billingAccount = null;
        if (string.IsNullOrEmpty(skuId))
        {
            return;
        }

        _offersLoading = true;
        try
        {
            var result = await Api.ListPurchasableOffersAsync(CustomerId, _productId ?? string.Empty, skuId);
            _offers = result?.Offers ?? [];
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load offers: {ex.Message}", Severity.Error);
            _offers = [];
        }
        finally
        {
            _offersLoading = false;
        }

        await LoadEligibleBillingAccountsAsync(skuId);
    }

    // Best-effort: queryEligibleBillingAccounts only applies to GCP / n-tier billing-gated SKUs and
    // errors or returns nothing for ordinary SKUs, so failures are swallowed and the picker stays hidden.
    private async Task LoadEligibleBillingAccountsAsync(string skuId)
    {
        try
        {
            var sku = $"products/{_productId}/skus/{skuId}";
            var result = await Api.QueryEligibleBillingAccountsAsync(CustomerId, [sku]);
            _billingAccounts = result?.Groups.SelectMany(g => g.BillingAccounts).ToList() ?? [];
            _billingAccount = _billingAccounts.Count == 1 ? _billingAccounts[0].Name : null;
        }
        catch
        {
            _billingAccounts = [];
            _billingAccount = null;
        }
    }

    private async Task SubmitAsync()
    {
        if (string.IsNullOrEmpty(_offerId))
        {
            return;
        }

        _submitting = true;
        try
        {
            var request = new PurchaseEntitlementRequest
            {
                OfferId = _offerId,
                PurchaseOrderId = string.IsNullOrWhiteSpace(_purchaseOrderId) ? null : _purchaseOrderId,
                Parameters = [new EntitlementParameterInput { Name = "num_units", IntValue = _seats }],
                BillingAccount = _billingAccounts is { Count: > 0 } ? _billingAccount : null
            };

            var op = await Api.PurchaseEntitlementAsync(CustomerId, request);
            if (!string.IsNullOrEmpty(op?.Error))
            {
                await Snackbar.Add($"Purchase failed: {op!.Error}", Severity.Error);
                return;
            }

            await Snackbar.Add(op?.Done == true
                ? "Entitlement purchased."
                : "Purchase submitted — Google is provisioning it, this may take a moment.", Severity.Success);
            Nav.NavigateTo($"/customers/{CustomerId}/entitlements");
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Purchase failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }
}

