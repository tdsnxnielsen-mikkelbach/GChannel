@page "/customers/{CustomerId}/entitlements"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject UiNotifier Snackbar

<PageTitle>Entitlements · GChannel</PageTitle>

<Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Margin="Margin.Is2.FromBottom">
    <Div>
        <Heading Size="HeadingSize.Is3" Margin="Margin.Is0">Entitlements</Heading>
        <Small TextColor="TextColor.Secondary">
            @(_customer?.OrgDisplayName ?? CustomerId)@(string.IsNullOrEmpty(_customer?.Domain) ? "" : $" · {_customer!.Domain}")
        </Small>
    </Div>
    <Div Flex="Flex.Default" Gap="Gap.Is2">
        <Button Type="ButtonType.Link" To="@($"/customers/{CustomerId}")" Color="Color.Secondary" Outline>
            <Icon Name="@AppIcons.ArrowBack" Class="me-1" /> Customer
        </Button>
        <Button Type="ButtonType.Link" To="@($"/customers/{CustomerId}/transfer")" Color="Color.Secondary" Outline>
            <Icon Name="@AppIcons.SwapHoriz" Class="me-1" /> Transfer in
        </Button>
        <Button Type="ButtonType.Link" To="@($"/customers/{CustomerId}/entitlements/new")" Color="Color.Primary">
            <Icon Name="@AppIcons.AddShoppingCart" Class="me-1" /> Purchase
        </Button>
    </Div>
</Div>

<Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is5.FromBottom">
    The subscriptions this customer holds. Each entitlement maps to a Catalog SKU/Offer; use the
    actions menu to modify or change its lifecycle state.
</Paragraph>

@if (_loading)
{
    <LoadingPanel Title="Loading entitlements…"
                  Hint="Fetching this customer's subscriptions from the Channel API." />
}
else if (_entitlements is { Count: > 0 })
{
    <Card Shadow="Shadow.Small">
        <Table Hoverable Responsive Margin="Margin.Is0">
            <TableHeader>
                <TableRow>
                    <TableHeaderCell>Offer / SKU</TableHeaderCell>
                    <TableHeaderCell>Product</TableHeaderCell>
                    <TableHeaderCell>State</TableHeaderCell>
                    <TableHeaderCell>Seats</TableHeaderCell>
                    <TableHeaderCell>Est. monthly</TableHeaderCell>
                    <TableHeaderCell>Ion cost / margin</TableHeaderCell>
                    <TableHeaderCell>Created</TableHeaderCell>
                    <TableHeaderCell TextAlignment="TextAlignment.End">Actions</TableHeaderCell>
                </TableRow>
            </TableHeader>
            <TableBody>
                @foreach (var e in _entitlements)
                {
                    <TableRow>
                        <TableRowCell>
                            @if (!string.IsNullOrEmpty(e.SkuId))
                            {
                                <Tooltip Text="@(e.OfferId ?? e.Id)" Inline>
                                    <Anchor To="@($"/catalog/offers?sku={e.SkuId}")">@OfferLabel(e)</Anchor>
                                </Tooltip>
                            }
                            else
                            {
                                @OfferLabel(e)
                            }
                        </TableRowCell>
                        <TableRowCell>
                            @if (!string.IsNullOrEmpty(e.ProductId))
                            {
                                <Tooltip Text="@e.ProductId" Inline>
                                    <Anchor To="@($"/catalog/products?product={e.ProductId}&sku={e.SkuId}")">
                                        @(e.ProductDisplayName ?? e.ProductId)
                                    </Anchor>
                                </Tooltip>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </TableRowCell>
                        <TableRowCell>
                            <Badge Color="@StateColor(e.ProvisioningState)">@(e.ProvisioningState ?? "—")</Badge>
                            @if (e.IsTrial)
                            {
                                <Badge Color="Color.Info" Margin="Margin.Is1.FromStart">Trial</Badge>
                            }
                        </TableRowCell>
                        <TableRowCell>@(Seats(e) ?? "—")</TableRowCell>
                        <TableRowCell>
                            @if (MonthlyEstimate(e) is { } v)
                            {
                                <Tooltip Text="@EstimateBreakdown(e)" Inline>
                                    <span>@FormatMoney(v, e.PriceCurrency)</span>
                                </Tooltip>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </TableRowCell>
                        <TableRowCell>
                            @if (e.IonCostPerSeat is { } ionCost)
                            {
                                <Tooltip Text="Actual per-seat cost from Ion (TD SYNNEX StreamOne)" Inline>
                                    <span>@FormatMoney(ionCost, e.IonCurrency)</span>
                                </Tooltip>
                                @if (e.IonMarginPercent is { } mp)
                                {
                                    <Small TextColor="@(mp >= 0 ? TextColor.Success : TextColor.Danger)" Display="Display.Block">@mp.ToString("0.0")% margin</Small>
                                }
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </TableRowCell>
                        <TableRowCell>@(e.CreateTime?.ToString("yyyy-MM-dd") ?? "—")</TableRowCell>
                        <TableRowCell TextAlignment="TextAlignment.End">
                            <Div Flex="Flex.JustifyContent.End.AlignItems.Center" Gap="Gap.Is1" Class="text-nowrap">
                                <Tooltip Text="View" Inline>
                                    <Button Type="ButtonType.Link" To="@($"/customers/{CustomerId}/entitlements/{e.Id}")" Size="Size.Small" Color="Color.Light" aria-label="View">
                                        <Icon Name="@AppIcons.Visibility" />
                                    </Button>
                                </Tooltip>
                                <Dropdown EndAligned>
                                    <DropdownToggle Size="Size.Small" Color="Color.Light" ShowToggleIcon="false" aria-label="Actions">
                                        <Icon Name="@AppIcons.MoreVert" />
                                    </DropdownToggle>
                                    <DropdownMenu>
                                        @if (IsSuspended(e))
                                        {
                                            <DropdownItem Clicked="@(() => ActivateAsync(e))"><Icon Name="@AppIcons.PlayArrow" Class="me-2" />Activate</DropdownItem>
                                        }
                                        else
                                        {
                                            <DropdownItem Clicked="@(() => SuspendAsync(e))"><Icon Name="@AppIcons.Pause" Class="me-2" />Suspend</DropdownItem>
                                        }
                                        @if (e.IsTrial)
                                        {
                                            <DropdownItem Clicked="@(() => StartPaidAsync(e))"><Icon Name="@AppIcons.Paid" Class="me-2" />Start paid service</DropdownItem>
                                        }
                                        <DropdownItem Clicked="@(() => CancelAsync(e))"><Icon Name="@AppIcons.Cancel" TextColor="TextColor.Danger" Class="me-2" />Cancel</DropdownItem>
                                    </DropdownMenu>
                                </Dropdown>
                            </Div>
                        </TableRowCell>
                    </TableRow>
                }
            </TableBody>
        </Table>
    </Card>
}
else
{
    <Alert Color="Color.Info" Visible>
        No entitlements yet. Use <strong>Purchase</strong> to sell this customer their first SKU.
    </Alert>
}

@code {
    [Parameter]
    public string CustomerId { get; set; } = string.Empty;

    private Customer? _customer;
    private IReadOnlyList<Entitlement>? _entitlements;
    private bool _loading = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _customer = await Api.GetCustomerAsync(CustomerId);
            var result = await Api.ListEntitlementsAsync(CustomerId);
            _entitlements = result?.Entitlements ?? [];
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load entitlements: {ex.Message}", Severity.Error);
            _entitlements = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private static bool IsSuspended(Entitlement e) =>
        string.Equals(e.ProvisioningState, "SUSPENDED", StringComparison.OrdinalIgnoreCase);

    // Prefer the friendly SKU/offer name resolved from the Catalog; fall back to the opaque id.
    private static string OfferLabel(Entitlement e) =>
        e.SkuDisplayName ?? e.OfferDisplayName ?? e.OfferId ?? e.Id;

    private static Color StateColor(string? state) => state?.ToUpperInvariant() switch
    {
        "ACTIVE" => Color.Success,
        "SUSPENDED" => Color.Warning,
        "CANCELLED" or "CANCELED" => Color.Danger,
        "PENDING" => Color.Info,
        _ => Color.Secondary
    };

    private static string? Seats(Entitlement e) =>
        e.Parameters.FirstOrDefault(p => string.Equals(p.Name, "num_units", StringComparison.OrdinalIgnoreCase))?.Value
        ?? e.Parameters.FirstOrDefault(p => string.Equals(p.Name, "max_units", StringComparison.OrdinalIgnoreCase))?.Value;

    private static long SeatCount(Entitlement e) =>
        long.TryParse(Seats(e), System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var n) ? n : 0;

    // Estimated monthly amount = unit price × seats × (1 + repricing markup). Null when unpriced.
    private static decimal? MonthlyEstimate(Entitlement e)
    {
        if (e.UnitPrice is not { } unit || unit <= 0) return null;
        var seats = e.BillableSeats ?? SeatCount(e);
        if (seats <= 0) return null;
        var markup = 1 + ((e.RepricingPercent ?? 0m) / 100m);
        return unit * seats * markup;
    }

    private static string EstimateBreakdown(Entitlement e)
    {
        var seats = e.BillableSeats ?? SeatCount(e);
        var pct = e.RepricingPercent ?? 0m;
        var baseLine = $"{FormatMoney(e.UnitPrice ?? 0m, e.PriceCurrency)} × {seats} seat(s)";
        var markupLine = pct != 0m ? $" + {pct:0.##}% markup" : string.Empty;
        return $"Estimated from offer list pricing: {baseLine}{markupLine}. Not an invoiced figure.";
    }

    private static string FormatMoney(decimal value, string? currency) =>
        string.IsNullOrEmpty(currency)
            ? value.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)
            : $"{currency} {value.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)}";

    private Task ActivateAsync(Entitlement e) =>
        RunAsync(e, "Activate", $"Activate entitlement '{e.OfferId ?? e.Id}'?",
            () => Api.ActivateEntitlementAsync(CustomerId, e.Id));

    private Task SuspendAsync(Entitlement e) =>
        RunAsync(e, "Suspend", $"Suspend entitlement '{e.OfferId ?? e.Id}'? The customer loses access until reactivated.",
            () => Api.SuspendEntitlementAsync(CustomerId, e.Id));

    private Task StartPaidAsync(Entitlement e) =>
        RunAsync(e, "Start paid service", $"Start paid service for '{e.OfferId ?? e.Id}'? This ends the trial and begins billing.",
            () => Api.StartPaidServiceAsync(CustomerId, e.Id));

    private Task CancelAsync(Entitlement e) =>
        RunAsync(e, "Cancel", $"Cancel entitlement '{e.OfferId ?? e.Id}'? This cannot be undone.",
            () => Api.CancelEntitlementAsync(CustomerId, e.Id), destructive: true);

    private async Task RunAsync(Entitlement e, string action, string confirm, Func<Task<EntitlementOperation?>> call, bool destructive = false)
    {
        var confirmed = await Snackbar.ConfirmAsync(
            $"{action} entitlement",
            confirm,
            yesText: action,
            cancelText: "Cancel");

        if (!confirmed)
        {
            return;
        }

        try
        {
            var op = await call();
            await Snackbar.Add(OperationMessage(action, op), op?.Done == true ? Severity.Success : Severity.Info);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"{action} failed: {ex.Message}", Severity.Error);
        }
    }

    private static string OperationMessage(string action, EntitlementOperation? op)
    {
        if (op is null)
        {
            return $"{action} submitted.";
        }

        if (!string.IsNullOrEmpty(op.Error))
        {
            return $"{action} failed: {op.Error}";
        }

        return op.Done
            ? $"{action} completed."
            : $"{action} submitted — Google is processing it, this may take a moment.";
    }
}

