@page "/customers/{CustomerId}/entitlements"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject UiNotifier Snackbar
@inject ContextMenuService ContextMenus

<PageTitle>Entitlements · GChannel</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap" class="rz-mb-2">
    <div>
        <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">Entitlements</RadzenText>
        <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">
            @(_customer?.OrgDisplayName ?? CustomerId)@(string.IsNullOrEmpty(_customer?.Domain) ? "" : $" · {_customer!.Domain}")
        </RadzenText>
    </div>
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
        <LinkButton To="@($"/customers/{CustomerId}")" Text="Customer" Icon="@AppIcons.ArrowBack" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" />
        <LinkButton To="@($"/customers/{CustomerId}/transfer")" Text="Transfer in" Icon="@AppIcons.SwapHoriz" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" />
        <LinkButton To="@($"/customers/{CustomerId}/entitlements/new")" Text="Purchase" Icon="@AppIcons.AddShoppingCart" />
    </RadzenStack>
</RadzenStack>

<RadzenText TextStyle="TextStyle.Body1" class="rz-text-secondary-color rz-mb-6">
    The subscriptions this customer holds. Each entitlement maps to a Catalog SKU/Offer; use the
    actions menu to modify or change its lifecycle state.
</RadzenText>

@if (_loading)
{
    <LoadingPanel Title="Loading entitlements…"
                  Hint="Fetching this customer's subscriptions from the Channel API." />
}
else if (_entitlements is { Count: > 0 })
{
    <RadzenCard Variant="Variant.Filled">
        <RadzenDataGrid TItem="Entitlement" Data="_entitlements" AllowPaging="false" AllowSorting="false" Density="Density.Compact" GridLines="DataGridGridLines.Horizontal" Responsive="true">
            <Columns>
                <RadzenDataGridColumn TItem="Entitlement" Title="Offer / SKU">
                    <Template Context="e">
                        @if (!string.IsNullOrEmpty(e.SkuId))
                        {
                            <Tip Text="@(e.OfferId ?? e.Id)"><RadzenLink Path="@($"/catalog/offers?sku={e.SkuId}")" Text="@OfferLabel(e)" /></Tip>
                        }
                        else
                        {
                            @OfferLabel(e)
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Entitlement" Title="Product">
                    <Template Context="e">
                        @if (!string.IsNullOrEmpty(e.ProductId))
                        {
                            <Tip Text="@e.ProductId">
                                <RadzenLink Path="@($"/catalog/products?product={e.ProductId}&sku={e.SkuId}")" Text="@(e.ProductDisplayName ?? e.ProductId)" />
                            </Tip>
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Entitlement" Title="State">
                    <Template Context="e">
                        <RadzenBadge BadgeStyle="@StateColor(e.ProvisioningState)" Text="@(e.ProvisioningState ?? "—")" />
                        @if (e.IsTrial)
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="Trial" class="rz-ms-1" />
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Entitlement" Title="Seats" Width="80px">
                    <Template Context="e">@(Seats(e) ?? "—")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Entitlement" Title="Est. monthly">
                    <Template Context="e">
                        @if (MonthlyEstimate(e) is { } v)
                        {
                            <Tip Text="@EstimateBreakdown(e)">@FormatMoney(v, e.PriceCurrency)</Tip>
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Entitlement" Title="Ion cost / margin">
                    <Template Context="e">
                        @if (e.IonCostPerSeat is { } ionCost)
                        {
                            <Tip Text="Actual per-seat cost from Ion (TD SYNNEX StreamOne)">@FormatMoney(ionCost, e.IonCurrency)</Tip>
                            @if (e.IonMarginPercent is { } mp)
                            {
                                <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Div" class="@($"rz-m-0 {(mp >= 0 ? "rz-color-success" : "rz-color-danger")}")">@mp.ToString("0.0")% margin</RadzenText>
                            }
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Entitlement" Title="Created" Width="110px">
                    <Template Context="e">@(e.CreateTime?.ToString("yyyy-MM-dd") ?? "—")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Entitlement" Title="Actions" TextAlign="TextAlign.End" Width="110px">
                    <Template Context="e">
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="0.25rem" class="rz-text-nowrap">
                            <Tip Text="View">
                                <LinkButton To="@($"/customers/{CustomerId}/entitlements/{e.Id}")" Icon="@AppIcons.Visibility" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Title="View" />
                            </Tip>
                            <RadzenButton Icon="@AppIcons.MoreVert" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" aria-label="Actions"
                                          Click="@(args => OpenActionsMenu(args, e))" />
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
}
else
{
    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">
        No entitlements yet. Use <strong>Purchase</strong> to sell this customer their first SKU.
    </RadzenAlert>
}

@code {
    [Parameter]
    public string CustomerId { get; set; } = string.Empty;

    private Customer? _customer;
    private IReadOnlyList<Entitlement>? _entitlements;
    private bool _loading = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _customer = await Api.GetCustomerAsync(CustomerId);
            var result = await Api.ListEntitlementsAsync(CustomerId);
            _entitlements = result?.Entitlements ?? [];
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load entitlements: {ex.Message}", Severity.Error);
            _entitlements = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private static bool IsSuspended(Entitlement e) =>
        string.Equals(e.ProvisioningState, "SUSPENDED", StringComparison.OrdinalIgnoreCase);

    // Prefer the friendly SKU/offer name resolved from the Catalog; fall back to the opaque id.
    private static string OfferLabel(Entitlement e) =>
        e.SkuDisplayName ?? e.OfferDisplayName ?? e.OfferId ?? e.Id;

    private static BadgeStyle StateColor(string? state) => state?.ToUpperInvariant() switch
    {
        "ACTIVE" => BadgeStyle.Success,
        "SUSPENDED" => BadgeStyle.Warning,
        "CANCELLED" or "CANCELED" => BadgeStyle.Danger,
        "PENDING" => BadgeStyle.Info,
        _ => BadgeStyle.Light
    };

    private static string? Seats(Entitlement e) =>
        e.Parameters.FirstOrDefault(p => string.Equals(p.Name, "num_units", StringComparison.OrdinalIgnoreCase))?.Value
        ?? e.Parameters.FirstOrDefault(p => string.Equals(p.Name, "max_units", StringComparison.OrdinalIgnoreCase))?.Value;

    private static long SeatCount(Entitlement e) =>
        long.TryParse(Seats(e), System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var n) ? n : 0;

    // Estimated monthly amount = unit price × seats × (1 + repricing markup). Null when unpriced.
    private static decimal? MonthlyEstimate(Entitlement e)
    {
        if (e.UnitPrice is not { } unit || unit <= 0) return null;
        var seats = e.BillableSeats ?? SeatCount(e);
        if (seats <= 0) return null;
        var markup = 1 + ((e.RepricingPercent ?? 0m) / 100m);
        return unit * seats * markup;
    }

    private static string EstimateBreakdown(Entitlement e)
    {
        var seats = e.BillableSeats ?? SeatCount(e);
        var pct = e.RepricingPercent ?? 0m;
        var baseLine = $"{FormatMoney(e.UnitPrice ?? 0m, e.PriceCurrency)} × {seats} seat(s)";
        var markupLine = pct != 0m ? $" + {pct:0.##}% markup" : string.Empty;
        return $"Estimated from offer list pricing: {baseLine}{markupLine}. Not an invoiced figure.";
    }

    private static string FormatMoney(decimal value, string? currency) =>
        string.IsNullOrEmpty(currency)
            ? value.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)
            : $"{currency} {value.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)}";

    // Row "⋮" menu: Radzen context menus are service-driven, so build the items for this entitlement on click.
    private void OpenActionsMenu(MouseEventArgs args, Entitlement e)
    {
        var items = new List<ContextMenuItem>();
        if (IsSuspended(e))
        {
            items.Add(new ContextMenuItem { Text = "Activate", Value = "activate", Icon = AppIcons.PlayArrow });
        }
        else
        {
            items.Add(new ContextMenuItem { Text = "Suspend", Value = "suspend", Icon = AppIcons.Pause });
        }

        if (e.IsTrial)
        {
            items.Add(new ContextMenuItem { Text = "Start paid service", Value = "paid", Icon = AppIcons.Paid });
        }

        items.Add(new ContextMenuItem { Text = "Cancel", Value = "cancel", Icon = AppIcons.Cancel, IconColor = Colors.Danger });

        ContextMenus.Open(args, items, async menu =>
        {
            ContextMenus.Close();
            var task = menu.Value switch
            {
                "activate" => ActivateAsync(e),
                "suspend" => SuspendAsync(e),
                "paid" => StartPaidAsync(e),
                "cancel" => CancelAsync(e),
                _ => Task.CompletedTask
            };
            await task;
            await InvokeAsync(StateHasChanged);
        });
    }

    private Task ActivateAsync(Entitlement e) =>
        RunAsync(e, "Activate", $"Activate entitlement '{e.OfferId ?? e.Id}'?",
            () => Api.ActivateEntitlementAsync(CustomerId, e.Id));

    private Task SuspendAsync(Entitlement e) =>
        RunAsync(e, "Suspend", $"Suspend entitlement '{e.OfferId ?? e.Id}'? The customer loses access until reactivated.",
            () => Api.SuspendEntitlementAsync(CustomerId, e.Id));

    private Task StartPaidAsync(Entitlement e) =>
        RunAsync(e, "Start paid service", $"Start paid service for '{e.OfferId ?? e.Id}'? This ends the trial and begins billing.",
            () => Api.StartPaidServiceAsync(CustomerId, e.Id));

    private Task CancelAsync(Entitlement e) =>
        RunAsync(e, "Cancel", $"Cancel entitlement '{e.OfferId ?? e.Id}'? This cannot be undone.",
            () => Api.CancelEntitlementAsync(CustomerId, e.Id), destructive: true);

    private async Task RunAsync(Entitlement e, string action, string confirm, Func<Task<EntitlementOperation?>> call, bool destructive = false)
    {
        var confirmed = await Snackbar.ConfirmAsync(
            $"{action} entitlement",
            confirm,
            yesText: action,
            cancelText: "Cancel");

        if (!confirmed)
        {
            return;
        }

        try
        {
            var op = await call();
            await Snackbar.Add(OperationMessage(action, op), op?.Done == true ? Severity.Success : Severity.Info);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"{action} failed: {ex.Message}", Severity.Error);
        }
    }

    private static string OperationMessage(string action, EntitlementOperation? op)
    {
        if (op is null)
        {
            return $"{action} submitted.";
        }

        if (!string.IsNullOrEmpty(op.Error))
        {
            return $"{action} failed: {op.Error}";
        }

        return op.Done
            ? $"{action} completed."
            : $"{action} submitted — Google is processing it, this may take a moment.";
    }
}

