@page "/catalog/offers"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Offers · GChannel</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Offers</MudText>
<MudText Typo="Typo.body1" Class="mb-6" Color="Color.Secondary">
    The offers you can sell to customers.
</MudText>

@if (!string.IsNullOrEmpty(SkuFilter))
{
    <MudChip T="string" Color="Color.Primary" Variant="Variant.Text"
             OnClose="ClearSkuFilter" CloseIcon="@Icons.Material.Filled.Close" Class="mb-4">
        Filtered by SKU: @FilterLabel
    </MudChip>
}

@if (_loading)
{
    <LoadingPanel Title="Loading offers…"
                  Hint="Fetching the offers you can sell to customers." />
}
else if (_offers is { Count: > 0 })
{
    <MudTable Items="_offers" Dense="true" Hover="true" Elevation="2" Filter="Matches">
        <ToolBarContent>
            <MudTextField @bind-Value="_search" Placeholder="Search offers"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium" Class="mt-0" Immediate="true" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh>Offer</MudTh>
            <MudTh>SKU</MudTh>
            <MudTh>Deal code</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Offer">
                <MudTooltip Text="@(context.OfferId ?? context.Name)">
                    <span>@(context.DisplayName ?? context.OfferId ?? context.Name)</span>
                </MudTooltip>
            </MudTd>
            <MudTd DataLabel="SKU">
                @if (!string.IsNullOrEmpty(context.ProductId))
                {
                    <MudTooltip Text="@(context.SkuId ?? context.SkuName)">
                        <MudLink Href="@($"/catalog/products?product={context.ProductId}&sku={context.SkuId}")">
                            @(context.SkuDisplayName ?? context.SkuId ?? context.SkuName)
                        </MudLink>
                    </MudTooltip>
                }
                else
                {
                    @(context.SkuDisplayName ?? context.SkuName)
                }
            </MudTd>
            <MudTd DataLabel="Deal code">@context.DealCode</MudTd>
        </RowTemplate>
    </MudTable>
}
else
{
    <MudAlert Severity="Severity.Info">No offers available.</MudAlert>
}

@code {
    [SupplyParameterFromQuery(Name = "sku")]
    public string? SkuFilter { get; set; }

    private IReadOnlyList<CatalogOffer>? _offers;
    private bool _loading = true;
    private string _search = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Api.ListOffersAsync();
            _offers = result?.Offers ?? [];
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load offers: {ex.Message}", Severity.Error);
            _offers = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private void ClearSkuFilter() => Nav.NavigateTo("/catalog/offers");

    // Friendly SKU name for the active filter chip, falling back to the raw id.
    private string FilterLabel =>
        _offers?.FirstOrDefault(o => string.Equals(o.SkuId, SkuFilter, StringComparison.OrdinalIgnoreCase))?.SkuDisplayName
        ?? SkuFilter
        ?? string.Empty;

    private bool Matches(CatalogOffer offer)
    {
        if (!string.IsNullOrEmpty(SkuFilter)
            && !string.Equals(offer.SkuId, SkuFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(_search))
        {
            return true;
        }

        return (offer.DisplayName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
            || (offer.SkuDisplayName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
            || (offer.SkuName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
            || (offer.DealCode?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false);
    }
}
