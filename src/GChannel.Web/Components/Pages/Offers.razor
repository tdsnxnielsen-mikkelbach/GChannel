@page "/catalog/offers"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject UiNotifier Snackbar
@inject NavigationManager Nav

<PageTitle>Offers · GChannel</PageTitle>

<RadzenText TextStyle="TextStyle.H4" class="rz-mb-2">Offers</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-text-secondary-color rz-mb-6">
    The offers you can sell to customers. Prices shown are estimated wholesale list pricing from the
    catalog — not invoiced amounts; per-seat resource shown.
</RadzenText>

@if (!string.IsNullOrEmpty(SkuFilter))
{
    <div class="rz-mb-4">
        <RadzenChip Text="@($"Filtered by SKU: {FilterLabel}")" ChipStyle="BadgeStyle.Primary" Icon="@AppIcons.FilterAlt" Close="ClearSkuFilter" RemoveChipTitle="Clear filter" />
    </div>
}

@if (_loading)
{
    <LoadingPanel Title="Loading offers…"
                  Hint="Fetching the offers you can sell to customers." />
}
else if (_offers is { Count: > 0 })
{
    <RadzenCard Variant="Variant.Filled">
        <RadzenFormField Text="Search offers" Variant="Variant.Outlined" Style="width:100%; max-width:28rem" class="rz-mb-3">
            <Start><RadzenIcon Icon="@AppIcons.Search" /></Start>
            <ChildContent><RadzenTextBox @bind-Value="_search" Immediate="true" Name="search" /></ChildContent>
        </RadzenFormField>
        <RadzenDataGrid TItem="CatalogOffer" Data="_offers.Where(Matches)" AllowSorting="true" AllowPaging="true" PageSize="50" PageSizeOptions="_pageSizes"
                        ShowPagingSummary="true" Density="Density.Compact" GridLines="DataGridGridLines.Horizontal" Responsive="true" EmptyText="No offers match the search.">
            <Columns>
                <RadzenDataGridColumn TItem="CatalogOffer" Property="@nameof(CatalogOffer.DisplayName)" Title="Offer">
                    <Template Context="offer">
                        <Tip Text="@(offer.OfferId ?? offer.Name)">@(offer.DisplayName ?? offer.OfferId ?? offer.Name)</Tip>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CatalogOffer" Property="@nameof(CatalogOffer.SkuDisplayName)" Title="SKU">
                    <Template Context="offer">
                        @if (!string.IsNullOrEmpty(offer.ProductId))
                        {
                            <Tip Text="@(offer.SkuId ?? offer.SkuName)">
                                <RadzenLink Path="@($"/catalog/products?product={offer.ProductId}&sku={offer.SkuId}")" Text="@(offer.SkuDisplayName ?? offer.SkuId ?? offer.SkuName)" />
                            </Tip>
                        }
                        else
                        {
                            @(offer.SkuDisplayName ?? offer.SkuName)
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CatalogOffer" Title="Price (est. list)" Sortable="false">
                    <Template Context="offer">@PriceLabel(offer)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="CatalogOffer" Property="@nameof(CatalogOffer.DealCode)" Title="Deal code" />
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
}
else
{
    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">No offers available.</RadzenAlert>
}

@code {
    [SupplyParameterFromQuery(Name = "sku")]
    public string? SkuFilter { get; set; }

    private IReadOnlyList<CatalogOffer>? _offers;
    private static readonly IEnumerable<int> _pageSizes = [25, 50, 100];
    private bool _loading = true;
    private string _search = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Api.ListOffersAsync();
            _offers = result?.Offers ?? [];
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load offers: {ex.Message}", Severity.Error);
            _offers = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private void ClearSkuFilter() => Nav.NavigateTo("/catalog/offers");

    // Wholesale list price summary: effective price of the first priced resource + payment cycle.
    private static string PriceLabel(CatalogOffer offer)
    {
        var price = offer.Pricing.FirstOrDefault(p => p.EffectivePrice is not null) ?? offer.Pricing.FirstOrDefault();
        if (price?.EffectivePrice is null)
        {
            return "Varies by customer";
        }
        var cycle = string.IsNullOrEmpty(offer.PaymentCycle) ? "" : $" / {offer.PaymentCycle.ToLowerInvariant()}";
        return $"{price.EffectivePrice.Display}{cycle}";
    }

    // Friendly SKU name for the active filter badge, falling back to the raw id.
    private string FilterLabel =>
        _offers?.FirstOrDefault(o => string.Equals(o.SkuId, SkuFilter, StringComparison.OrdinalIgnoreCase))?.SkuDisplayName
        ?? SkuFilter
        ?? string.Empty;

    private bool Matches(CatalogOffer offer)
    {
        if (!string.IsNullOrEmpty(SkuFilter)
            && !string.Equals(offer.SkuId, SkuFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(_search))
        {
            return true;
        }

        return (offer.DisplayName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
            || (offer.SkuDisplayName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
            || (offer.SkuName?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
            || (offer.DealCode?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false);
    }
}

