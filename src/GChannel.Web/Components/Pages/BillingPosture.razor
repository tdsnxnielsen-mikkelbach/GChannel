@page "/billing/posture"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject UiNotifier Snackbar

<PageTitle>Security posture · GChannel</PageTitle>

<Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Margin="Margin.Is2.FromBottom">
    <Div>
        <Heading Size="HeadingSize.Is3" Margin="Margin.Is0">Billing security posture</Heading>
        <Small TextColor="TextColor.Secondary">
            Nightly scan of every billing (sub-)account's IAM members — consumer admins, 2-Step Verification,
            Advanced Protection and passkeys / security keys.
        </Small>
    </Div>
    <Div Flex="Flex.AlignItems.Center" Gap="Gap.Is3">
        @if (_summary?.AsOf is { } asOf)
        {
            <Small TextColor="TextColor.Secondary" Class="text-nowrap">Scanned @asOf.ToLocalTime().ToString("g")</Small>
        }
        <Button Color="Color.Secondary" Outline Clicked="LoadAsync" Disabled="_loading">
            <Icon Name="@AppIcons.Refresh" Class="me-1" /> Reload
        </Button>
    </Div>
</Div>

<Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is4.FromBottom">
    <strong>Best practice</strong> for every assessable member: 2SV on, Advanced Protection enrolled, and at
    least one passkey or security key. Members are <em>assessable</em> when their tenant is readable — our own
    Workspace, or a resold customer we hold reseller admin access to. Consumer Google Accounts and unreadable
    tenants are reported separately, never counted as compliant.
</Paragraph>

@if (_loading && _summary is null)
{
    <LoadingPanel Title="Loading posture…" Hint="Reading the nightly scan results." />
}
else if (_summary is null)
{
    <Alert Color="Color.Danger" Visible>Couldn't load the posture summary.</Alert>
}
else
{
    @if (_summary.Unconfigured)
    {
        <Alert Color="Color.Warning" Visible Margin="Margin.Is4.FromBottom">
            The nightly posture scan isn't configured. It needs <code>GoogleChannel:ServiceAccountKeyJson</code>,
            <code>GoogleChannel:ImpersonateUser</code> and <code>GoogleBilling:PostureScanEnabled</code>.
        </Alert>
    }
    else if (_summary.AsOf is null)
    {
        <Alert Color="Color.Info" Visible Margin="Margin.Is4.FromBottom">
            The first nightly scan hasn't completed yet (it runs at the configured UTC hour, or shortly after the
            worker starts when no scan exists). @(_summary.LastRunError is null ? "" : $"Last attempt failed: {_summary.LastRunError}")
        </Alert>
    }
    else if (_summary.LastRunError is not null)
    {
        <Alert Color="Color.Warning" Visible Margin="Margin.Is4.FromBottom">
            The most recent scan attempt failed (@_summary.LastRunError); showing the last successful scan.
        </Alert>
    }

    @* ---- Headline KPIs ---- *@
    <Row Margin="Margin.Is2.FromBottom">
        <Column ColumnSize="ColumnSize.Is6.Is3.OnDesktop">
            @Kpi("Billing accounts scanned", _summary.AccountsScanned.ToString(), TextColor.Default,
                 _summary.AccountsWithErrors > 0 ? $"{_summary.AccountsWithErrors} with unreadable IAM policy" : "all policies readable")
        </Column>
        <Column ColumnSize="ColumnSize.Is6.Is3.OnDesktop">
            @Kpi("Accounts with a direct consumer admin", _summary.AccountsWithDirectConsumerAdmin.ToString(),
                 _summary.AccountsWithDirectConsumerAdmin > 0 ? TextColor.Danger : TextColor.Success,
                 "gmail / unmanaged account holding Billing Account Administrator directly")
        </Column>
        <Column ColumnSize="ColumnSize.Is6.Is3.OnDesktop">
            @Kpi("Accounts with non-compliant direct members", _summary.AccountsWithNonCompliantDirect.ToString(),
                 _summary.AccountsWithNonCompliantDirect > 0 ? TextColor.Warning : TextColor.Success,
                 "at least one assessable direct member failing a rule")
        </Column>
        <Column ColumnSize="ColumnSize.Is6.Is3.OnDesktop">
            @Kpi("Accounts with non-compliant inherited members", _summary.AccountsWithNonCompliantInherited.ToString(),
                 _summary.AccountsWithNonCompliantInherited > 0 ? TextColor.Warning : TextColor.Success,
                 "inherited from the master billing account")
        </Column>
    </Row>

    @* ---- Member compliance, direct vs inherited ---- *@
    <Row Margin="Margin.Is4.FromBottom">
        <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop">@BucketCard("Direct members", "Granted on individual sub-accounts (distinct email + role)", _summary.Direct)</Column>
        <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop">@BucketCard("Inherited members", "Granted on master billing accounts — apply to every sub-account (distinct email + role)", _summary.Inherited)</Column>
    </Row>

    <Card Shadow="Shadow.Small">
        <Tabs @bind-SelectedTab="_selectedTab" RenderMode="TabsRenderMode.LazyLoad" Class="card-header-tabs px-3 pt-3">
            <Items>
                <Tab Name="accounts"><Icon Name="@AppIcons.AccountBalance" Class="me-1" /> Accounts</Tab>
                <Tab Name="findings"><Icon Name="@AppIcons.Checklist" Class="me-1" /> Action list</Tab>
            </Items>
            <Content>
                <TabPanel Name="accounts" Padding="Padding.Is4">
                    <Div Flex="Flex.AlignItems.Center" Gap="Gap.Is4" Margin="Margin.Is2.FromBottom">
                        <Switch TValue="bool" @bind-Value="_onlyProblems" Color="Color.Primary" Class="text-nowrap">Only accounts with findings</Switch>
                        <Addons Class="flex-grow-1">
                            <Addon AddonType="AddonType.Start"><AddonLabel><Icon Name="@AppIcons.Search" /></AddonLabel></Addon>
                            <Addon AddonType="AddonType.Body">
                                <TextInput @bind-Value="_accountSearch" Placeholder="Filter by name / id / customer" />
                            </Addon>
                        </Addons>
                    </Div>
                    <DataGrid TItem="BillingPostureAccount" Data="FilteredAccounts" Narrow Hoverable Responsive Sortable
                              ShowPager ShowPageSizes PageSize="25" PageSizes="_accountPageSizes">
                        <DataGridColumns>
                            <DataGridColumn TItem="BillingPostureAccount" Field="@nameof(BillingPostureAccount.BillingAccountId)" Caption="Billing account" SortComparer="@_accountNameComparer">
                                <DisplayTemplate>
                                    <Div Flex="Flex.Column">
                                        <span>@(context.Item.DisplayName ?? context.Item.BillingAccountId)</span>
                                        <Small TextColor="TextColor.Secondary">
                                            @context.Item.BillingAccountId
                                            @if (!context.Item.IsSubaccount) { <Badge Color="Color.Light" Class="border text-body ms-1">master</Badge> }
                                            @if (context.Item.CustomerId is not null) { <span> · </span><Anchor To="@($"/customers/{context.Item.CustomerId}")">customer</Anchor> }
                                        </Small>
                                        @if (context.Item.Error is not null)
                                        {
                                            <Small TextColor="TextColor.Danger">IAM policy unreadable: @context.Item.Error</Small>
                                        }
                                    </Div>
                                </DisplayTemplate>
                            </DataGridColumn>
                            <DataGridColumn TItem="BillingPostureAccount" Field="@nameof(BillingPostureAccount.HasDirectConsumerAdmin)" Caption="Consumer admin" SortComparer="@_consumerAdminComparer">
                                <DisplayTemplate>
                                    @if (context.Item.HasDirectConsumerAdmin)
                                    {
                                        <Badge Color="Color.Danger"><Icon Name="@AppIcons.Warning" Class="me-1" />@context.Item.Direct.ConsumerAdmins</Badge>
                                    }
                                    else { <Small TextColor="TextColor.Secondary">—</Small> }
                                </DisplayTemplate>
                            </DataGridColumn>
                            <DataGridColumn TItem="BillingPostureAccount" Field="@nameof(BillingPostureAccount.Direct)" Caption="Direct" SortComparer="@(Compare(a => a.Direct.Members))">
                                <DisplayTemplate>@context.Item.Direct.Members</DisplayTemplate>
                            </DataGridColumn>
                            <DataGridColumn TItem="BillingPostureAccount" Field="@nameof(BillingPostureAccount.Direct)" Caption="Direct non-compliant" SortComparer="@(Compare(a => -a.Direct.NonCompliant))">
                                <DisplayTemplate>@NonCompliantCell(context.Item.Direct)</DisplayTemplate>
                            </DataGridColumn>
                            <DataGridColumn TItem="BillingPostureAccount" Field="@nameof(BillingPostureAccount.Inherited)" Caption="Inherited" SortComparer="@(Compare(a => a.Inherited.Members))">
                                <DisplayTemplate>@context.Item.Inherited.Members</DisplayTemplate>
                            </DataGridColumn>
                            <DataGridColumn TItem="BillingPostureAccount" Field="@nameof(BillingPostureAccount.Inherited)" Caption="Inherited non-compliant" SortComparer="@(Compare(a => -a.Inherited.NonCompliant))">
                                <DisplayTemplate>@NonCompliantCell(context.Item.Inherited)</DisplayTemplate>
                            </DataGridColumn>
                            <DataGridColumn TItem="BillingPostureAccount" Field="@nameof(BillingPostureAccount.BillingAccountId)" Caption=" " Sortable="false" TextAlignment="TextAlignment.End">
                                <DisplayTemplate>
                                    <Button Size="Size.Small" Color="Color.Primary" Class="btn-link text-decoration-none text-nowrap" Clicked="@(() => OpenAccountAsync(context.Item))">
                                        Members <Icon Name="@AppIcons.ChevronRight" Class="ms-1" />
                                    </Button>
                                </DisplayTemplate>
                            </DataGridColumn>
                        </DataGridColumns>
                        <EmptyTemplate><Paragraph Margin="Margin.Is0">No accounts match.</Paragraph></EmptyTemplate>
                    </DataGrid>

                    @if (_openAccount is not null)
                    {
                        <Card Margin="Margin.Is4.FromTop">
                            <CardBody Padding="Padding.Is3">
                                <Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Margin="Margin.Is2.FromBottom">
                                    <Strong>@(_openAccount.DisplayName ?? _openAccount.BillingAccountId) — members</Strong>
                                    <Button Size="Size.Small" Color="Color.Light" Clicked="@(() => { _openAccount = null; _openMembers = null; })" aria-label="Close">
                                        <Icon Name="@AppIcons.Close" />
                                    </Button>
                                </Div>
                                @if (_openMembers is null)
                                {
                                    <Progress Indeterminate Color="Color.Primary" Size="Size.Small" />
                                }
                                else
                                {
                                    @MemberTable(_openMembers.Members)
                                }
                            </CardBody>
                        </Card>
                    }
                </TabPanel>

                <TabPanel Name="findings" Padding="Padding.Is4">
                    <Div Flex="Flex.AlignItems.Center" Gap="Gap.Is4" Margin="Margin.Is2.FromBottom">
                        <Select TValue="string" Value="@_findingsScope" ValueChanged="OnScopeChangedAsync" Style="max-width: 220px;" aria-label="Scope">
                            <SelectItem TValue="string" Value="@("all")">Direct + inherited</SelectItem>
                            <SelectItem TValue="string" Value="@("direct")">Direct only</SelectItem>
                            <SelectItem TValue="string" Value="@("inherited")">Inherited only</SelectItem>
                        </Select>
                        <Small TextColor="TextColor.Secondary">
                            Distinct members that are consumer admins or fail at least one best-practice rule, with the accounts they hold a role on.
                        </Small>
                    </Div>
                    @if (_findings is null)
                    {
                        <Progress Indeterminate Color="Color.Primary" Size="Size.Small" />
                    }
                    else
                    {
                        <DataGrid TItem="BillingPostureFinding" Data="_findings.Findings" Narrow Hoverable Responsive Sortable
                                  ShowPager ShowPageSizes PageSize="50" PageSizes="_findingPageSizes">
                            <DataGridColumns>
                                <DataGridColumn TItem="BillingPostureFinding" Field="@nameof(BillingPostureFinding.Member)" Caption="Member" SortComparer="@(CompareFinding(f => f.Member.Email))">
                                    <DisplayTemplate>@MemberCell(context.Item.Member)</DisplayTemplate>
                                </DataGridColumn>
                                <DataGridColumn TItem="BillingPostureFinding" Field="@nameof(BillingPostureFinding.Member)" Caption="Role" Sortable="false">
                                    <DisplayTemplate><span class="text-nowrap">@context.Item.Member.RoleDisplayName</span></DisplayTemplate>
                                </DataGridColumn>
                                <DataGridColumn TItem="BillingPostureFinding" Field="@nameof(BillingPostureFinding.Member)" Caption="Grant" SortComparer="@(CompareFinding(f => f.Member.Inherited ? 1 : 0))">
                                    <DisplayTemplate>@(context.Item.Member.Inherited ? "inherited" : "direct")</DisplayTemplate>
                                </DataGridColumn>
                                <DataGridColumn TItem="BillingPostureFinding" Field="@nameof(BillingPostureFinding.Member)" Caption="Account" Sortable="false">
                                    <DisplayTemplate>@AccountKindChip(context.Item.Member)</DisplayTemplate>
                                </DataGridColumn>
                                <DataGridColumn TItem="BillingPostureFinding" Field="@nameof(BillingPostureFinding.Member)" Caption="2SV" SortComparer="@(CompareFinding(f => TwoSvRank(f.Member)))">
                                    <DisplayTemplate>@TwoSvChip(context.Item.Member)</DisplayTemplate>
                                </DataGridColumn>
                                <DataGridColumn TItem="BillingPostureFinding" Field="@nameof(BillingPostureFinding.Member)" Caption="Adv. Protection" SortComparer="@(CompareFinding(f => AppRank(f.Member)))">
                                    <DisplayTemplate>@AppChip(context.Item.Member)</DisplayTemplate>
                                </DataGridColumn>
                                <DataGridColumn TItem="BillingPostureFinding" Field="@nameof(BillingPostureFinding.Member)" Caption="Keys" SortComparer="@(CompareFinding(f => KeysRank(f.Member)))">
                                    <DisplayTemplate>@KeysChip(context.Item.Member)</DisplayTemplate>
                                </DataGridColumn>
                                <DataGridColumn TItem="BillingPostureFinding" Field="@nameof(BillingPostureFinding.BillingAccountIds)" Caption="Billing accounts" SortComparer="@(CompareFinding(f => -f.BillingAccountIds.Count))">
                                    <DisplayTemplate>
                                        <Tooltip Text="@string.Join(", ", context.Item.BillingAccountIds)" Multiline Inline>
                                            <span>@context.Item.BillingAccountIds.Count</span>
                                        </Tooltip>
                                    </DisplayTemplate>
                                </DataGridColumn>
                            </DataGridColumns>
                            <EmptyTemplate><Paragraph Margin="Margin.Is0">No findings — every assessable member in this scope is compliant.</Paragraph></EmptyTemplate>
                        </DataGrid>
                    }
                </TabPanel>
            </Content>
        </Tabs>
    </Card>
}

@code {
    private static readonly int[] _accountPageSizes = [25, 50, 100];
    private static readonly int[] _findingPageSizes = [50, 100, 200];

    private bool _loading = true;
    private BillingPostureSummary? _summary;
    private BillingPostureFindingsResult? _findings;
    private string _findingsScope = "all";
    private string _selectedTab = "accounts";
    private bool _onlyProblems = true;
    private string _accountSearch = "";
    private BillingPostureAccount? _openAccount;
    private BillingPostureMembersResult? _openMembers;

    // In-memory DataGrid sorting over computed values (the grid can only sort declared fields on its own).
    private static IComparer<BillingPostureAccount> Compare<TKey>(Func<BillingPostureAccount, TKey> key) where TKey : IComparable<TKey> =>
        Comparer<BillingPostureAccount>.Create((a, b) => key(a).CompareTo(key(b)));

    private static IComparer<BillingPostureFinding> CompareFinding<TKey>(Func<BillingPostureFinding, TKey> key) where TKey : IComparable<TKey> =>
        Comparer<BillingPostureFinding>.Create((a, b) => key(a).CompareTo(key(b)));

    private static IComparer<BillingPostureMember> CompareMember<TKey>(Func<BillingPostureMember, TKey> key) where TKey : IComparable<TKey> =>
        Comparer<BillingPostureMember>.Create((a, b) => key(a).CompareTo(key(b)));

    private static readonly IComparer<BillingPostureAccount> _accountNameComparer =
        Comparer<BillingPostureAccount>.Create((a, b) => string.Compare(a.DisplayName ?? a.BillingAccountId, b.DisplayName ?? b.BillingAccountId, StringComparison.OrdinalIgnoreCase));

    private static readonly IComparer<BillingPostureAccount> _consumerAdminComparer = Compare(a => a.HasDirectConsumerAdmin ? 0 : 1);

    protected override Task OnInitializedAsync() => LoadAsync();

    private IEnumerable<BillingPostureAccount> FilteredAccounts =>
        (_summary?.Accounts ?? [])
            .Where(a => !_onlyProblems || a.HasDirectConsumerAdmin || a.Direct.NonCompliant > 0 || a.Inherited.NonCompliant > 0 || a.Error is not null)
            .Where(a => string.IsNullOrWhiteSpace(_accountSearch)
                        || (a.DisplayName?.Contains(_accountSearch, StringComparison.OrdinalIgnoreCase) ?? false)
                        || a.BillingAccountId.Contains(_accountSearch, StringComparison.OrdinalIgnoreCase)
                        || (a.CustomerId?.Contains(_accountSearch, StringComparison.OrdinalIgnoreCase) ?? false));

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var summaryTask = Api.GetBillingPostureAsync();
            var findingsTask = Api.GetBillingPostureFindingsAsync(_findingsScope);
            await Task.WhenAll(summaryTask, findingsTask);
            _summary = summaryTask.Result;
            _findings = findingsTask.Result;
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load posture: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnScopeChangedAsync(string scope)
    {
        _findingsScope = scope;
        _findings = null;
        try { _findings = await Api.GetBillingPostureFindingsAsync(scope); }
        catch (Exception ex) { await Snackbar.Add($"Failed to load findings: {ex.Message}", Severity.Error); _findings = new(); }
    }

    private async Task OpenAccountAsync(BillingPostureAccount account)
    {
        _openAccount = account;
        _openMembers = null;
        try { _openMembers = await Api.GetBillingPostureMembersAsync(account.BillingAccountId); }
        catch (Exception ex) { await Snackbar.Add($"Failed to load members: {ex.Message}", Severity.Error); _openMembers = new() { BillingAccountId = account.BillingAccountId }; }
    }

    // ---- render helpers ----

    private RenderFragment Kpi(string label, string value, TextColor color, string? hint) => __builder =>
    {
        <Card Shadow="Shadow.Small" Class="h-100">
            <CardBody Padding="Padding.Is3">
                <Small TextColor="TextColor.Secondary" Display="Display.Block">@label</Small>
                <Heading Size="HeadingSize.Is3" Margin="Margin.Is0" TextColor="@color">@value</Heading>
                @if (hint is not null) { <Small TextColor="TextColor.Secondary">@hint</Small> }
            </CardBody>
        </Card>
    };

    private RenderFragment BucketCard(string title, string subtitle, PostureBucket b) => __builder =>
    {
        <Card Shadow="Shadow.Small" Class="h-100">
            <CardBody Padding="Padding.Is3">
                <Heading Size="HeadingSize.Is5" Margin="Margin.Is0">@title</Heading>
                <Small TextColor="TextColor.Secondary" Display="Display.Block" Margin="Margin.Is2.FromBottom">@subtitle</Small>
                <Div Flex="Flex.AlignItems.Baseline" Gap="Gap.Is2" Margin="Margin.Is1.FromBottom">
                    <Heading Size="HeadingSize.Is3" Margin="Margin.Is0" TextColor="@(b.Assessable == 0 ? TextColor.Secondary : b.CompliancePercent >= 90 ? TextColor.Success : b.CompliancePercent >= 60 ? TextColor.Warning : TextColor.Danger)">
                        @(b.Assessable == 0 ? "—" : $"{b.CompliancePercent:0}%")
                    </Heading>
                    <Small TextColor="TextColor.Secondary">compliant · @b.Compliant of @b.Assessable assessable (@b.Members total)</Small>
                </Div>
                <Progress Value="@((int)Math.Round(b.CompliancePercent))" Color="Color.Success" Size="Size.Small" Margin="Margin.Is3.FromBottom" />
                <Table Narrow Borderless Hoverable Margin="Margin.Is0">
                    <TableBody>
                        <TableRow><TableRowCell>2SV off</TableRowCell><TableRowCell TextAlignment="TextAlignment.End">@Count(b.TwoSvOff)</TableRowCell></TableRow>
                        <TableRow><TableRowCell>Not enrolled in Advanced Protection</TableRowCell><TableRowCell TextAlignment="TextAlignment.End">@Count(b.NoAdvancedProtection)</TableRowCell></TableRow>
                        <TableRow><TableRowCell>No passkey or security key</TableRowCell><TableRowCell TextAlignment="TextAlignment.End">@Count(b.NoKeys)</TableRowCell></TableRow>
                        <TableRow><TableRowCell>Failing any rule</TableRowCell><TableRowCell TextAlignment="TextAlignment.End"><strong>@Count(b.NonCompliant)</strong></TableRowCell></TableRow>
                        <TableRow><TableRowCell>Consumer Google Accounts</TableRowCell><TableRowCell TextAlignment="TextAlignment.End">@Count(b.ConsumerAccounts, b.ConsumerAdmins > 0 ? $"{b.ConsumerAdmins} as billing admin" : null)</TableRowCell></TableRow>
                        <TableRow><TableRowCell>Managed, tenant not readable</TableRowCell><TableRowCell TextAlignment="TextAlignment.End"><span class="text-body-secondary">@b.Unassessable</span></TableRowCell></TableRow>
                    </TableBody>
                </Table>
            </CardBody>
        </Card>
    };

    private static RenderFragment Count(int n, string? note = null) => __builder =>
    {
        <span class="@(n == 0 ? "text-success" : "text-danger")" style="font-weight:600">@n</span>
        @if (note is not null) { <small class="text-body-secondary"> (@note)</small> }
    };

    private static RenderFragment NonCompliantCell(PostureBucket b) => __builder =>
    {
        if (b.Assessable == 0) { <Small TextColor="TextColor.Secondary">n/a</Small> return; }
        <Tooltip Text="@($"2SV off: {b.TwoSvOff} · no Adv. Protection: {b.NoAdvancedProtection} · no keys: {b.NoKeys} · of {b.Assessable} assessable")" Multiline Inline>
            <Badge Color="@(b.NonCompliant == 0 ? Color.Success : Color.Warning)">@b.NonCompliant / @b.Assessable</Badge>
        </Tooltip>
    };

    private RenderFragment MemberTable(IReadOnlyList<BillingPostureMember> rows) => __builder =>
    {
        <DataGrid TItem="BillingPostureMember" Data="rows" Narrow Hoverable Responsive Sortable>
            <DataGridColumns>
                <DataGridColumn TItem="BillingPostureMember" Field="@nameof(BillingPostureMember.Email)" Caption="Member">
                    <DisplayTemplate>@MemberCell(context.Item)</DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="BillingPostureMember" Field="@nameof(BillingPostureMember.RoleDisplayName)" Caption="Role" Sortable="false">
                    <DisplayTemplate><span class="text-nowrap">@context.Item.RoleDisplayName</span></DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="BillingPostureMember" Field="@nameof(BillingPostureMember.Inherited)" Caption="Grant">
                    <DisplayTemplate>@(context.Item.Inherited ? "inherited" : "direct")</DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="BillingPostureMember" Field="@nameof(BillingPostureMember.AccountKind)" Caption="Account" Sortable="false">
                    <DisplayTemplate>@AccountKindChip(context.Item)</DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="BillingPostureMember" Field="@nameof(BillingPostureMember.TwoSvOk)" Caption="2SV" SortComparer="@(CompareMember(TwoSvRank))">
                    <DisplayTemplate>@TwoSvChip(context.Item)</DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="BillingPostureMember" Field="@nameof(BillingPostureMember.AdvancedProtection)" Caption="Adv. Protection" SortComparer="@(CompareMember(AppRank))">
                    <DisplayTemplate>@AppChip(context.Item)</DisplayTemplate>
                </DataGridColumn>
                <DataGridColumn TItem="BillingPostureMember" Field="@nameof(BillingPostureMember.KeysOk)" Caption="Keys" SortComparer="@(CompareMember(KeysRank))">
                    <DisplayTemplate>@KeysChip(context.Item)</DisplayTemplate>
                </DataGridColumn>
            </DataGridColumns>
            <EmptyTemplate><Paragraph Margin="Margin.Is0">No members.</Paragraph></EmptyTemplate>
        </DataGrid>
    };

    private static RenderFragment MemberCell(BillingPostureMember m) => __builder =>
    {
        <Div Flex="Flex.AlignItems.Center" Gap="Gap.Is1">
            <Icon Name="@(m.MemberType switch { "user" => AppIcons.Person, "group" => AppIcons.Groups, "serviceAccount" => AppIcons.SmartToy, _ => AppIcons.HelpOutline })" TextColor="TextColor.Secondary" />
            <span>@m.Email</span>
            @if (m.IsConsumerAdmin) { <Badge Color="Color.Danger" Margin="Margin.Is1.FromStart">consumer admin</Badge> }
            @if (m.IsAdmin == true) { <Badge Color="Color.Info" Margin="Margin.Is1.FromStart">ws admin</Badge> }
            @if (m.Suspended == true) { <Badge Color="Color.Danger" Margin="Margin.Is1.FromStart">suspended</Badge> }
        </Div>
    };

    private static RenderFragment AccountKindChip(BillingPostureMember m) => __builder =>
    {
        var (label, color) = m.AccountKind switch
        {
            GoogleAccountKind.Managed => (m.SecurityVisible ? "Managed" : "Managed · unreadable", m.SecurityVisible ? Color.Success : Color.Secondary),
            GoogleAccountKind.ManagedTeam => ("Managed (team)", Color.Warning),
            GoogleAccountKind.Consumer => ("Consumer", Color.Danger),
            _ => ("Unknown", Color.Secondary)
        };
        <Badge Color="@color">@label</Badge>
    };

    private static RenderFragment TwoSvChip(BillingPostureMember m) => __builder =>
    {
        if (!m.Assessable) { <Small TextColor="TextColor.Secondary">n/a</Small> return; }
        var on = m.TwoSvOk;
        <Badge Color="@(on ? Color.Success : Color.Danger)">
            <Icon Name="@(on ? AppIcons.VerifiedUser : AppIcons.GppBad)" Class="me-1" />@(on ? (m.TwoStepVerificationEnforced == true ? "On · enforced" : "On") : "Off")
        </Badge>
    };

    private static RenderFragment AppChip(BillingPostureMember m) => __builder =>
    {
        if (!m.Assessable) { <Small TextColor="TextColor.Secondary">—</Small> return; }
        switch (m.AdvancedProtection)
        {
            case AdvancedProtectionStatus.Enrolled:
                <Badge Color="Color.Success"><Icon Name="@AppIcons.Shield" Class="me-1" />Enrolled</Badge>
                break;
            case AdvancedProtectionStatus.Unavailable:
                <Badge Color="Color.Secondary">Unavailable</Badge>
                break;
            default:
                <Badge Color="Color.Warning">Not enrolled</Badge>
                break;
        }
    };

    private static RenderFragment KeysChip(BillingPostureMember m) => __builder =>
    {
        if (!m.Assessable) { <Small TextColor="TextColor.Secondary">—</Small> return; }
        if (m.SecurityKeys is null && m.Passkeys is null) { <Small TextColor="TextColor.Secondary">unknown</Small> return; }
        var parts = new List<string>();
        if (m.SecurityKeys is > 0) parts.Add($"{m.SecurityKeys} key{(m.SecurityKeys == 1 ? "" : "s")}");
        if (m.Passkeys is > 0) parts.Add($"{m.Passkeys} passkey{(m.Passkeys == 1 ? "" : "s")}");
        <Badge Color="@(m.KeysOk ? Color.Success : Color.Danger)"><Icon Name="@AppIcons.Key" Class="me-1" />@(m.KeysOk ? string.Join(" · ", parts) : "none")</Badge>
    };

    // Sort ranks: ascending = weakest first.
    private static int TwoSvRank(BillingPostureMember m) => !m.Assessable ? 9 : m.TwoSvOk ? 1 : 0;
    private static int AppRank(BillingPostureMember m) => !m.Assessable ? 9 : m.AdvancedProtectionOk ? 1 : 0;
    private static int KeysRank(BillingPostureMember m) => !m.Assessable ? 9 : m.KeysOk ? 1 : 0;
}
