@page "/billing/posture"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject UiNotifier Snackbar

<PageTitle>Security posture · GChannel</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap" class="rz-mb-2">
    <div>
        <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">Billing security posture</RadzenText>
        <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">
            Nightly scan of every billing (sub-)account's IAM members — consumer admins, 2-Step Verification,
            Advanced Protection and passkeys / security keys.
        </RadzenText>
    </div>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
        @if (_summary?.AsOf is { } asOf)
        {
            <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0 rz-text-nowrap">Scanned @DisplayFormat.Timestamp(asOf)</RadzenText>
        }
        <RadzenButton Text="Reload" Icon="@AppIcons.Refresh" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Click="LoadAsync" Disabled="_loading" />
    </RadzenStack>
</RadzenStack>

<RadzenText TextStyle="TextStyle.Body1" class="rz-text-secondary-color rz-mb-4">
    <strong>Best practice</strong> for every assessable member: 2SV on, Advanced Protection enrolled, and at
    least one passkey or security key. Members are <em>assessable</em> when their tenant is readable — our own
    Workspace, or a resold customer we hold reseller admin access to. Consumer Google Accounts and unreadable
    tenants are reported separately, never counted as compliant.
</RadzenText>

@if (_loading && _summary is null)
{
    <LoadingPanel Title="Loading posture…" Hint="Reading the nightly scan results." />
}
else if (_summary is null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">Couldn't load the posture summary.</RadzenAlert>
}
else
{
    @if (_summary.Unconfigured)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-mb-4">
            The nightly posture scan isn't configured. It needs <code>GoogleChannel:ServiceAccountKeyJson</code>,
            <code>GoogleChannel:ImpersonateUser</code> and <code>GoogleBilling:PostureScanEnabled</code>.
        </RadzenAlert>
    }
    else if (_summary.AsOf is null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-mb-4">
            The first nightly scan hasn't completed yet (it runs at the configured UTC hour, or shortly after the
            worker starts when no scan exists). @(_summary.LastRunError is null ? "" : $"Last attempt failed: {_summary.LastRunError}")
        </RadzenAlert>
    }
    else if (_summary.LastRunError is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-mb-4">
            The most recent scan attempt failed (@_summary.LastRunError); showing the last successful scan.
        </RadzenAlert>
    }

    @* ---- Headline KPIs ---- *@
    <RadzenRow Gap="1rem" RowGap="1rem" class="rz-mb-2">
        <RadzenColumn Size="6" SizeLG="3">
            @Kpi("Billing accounts scanned", _summary.AccountsScanned.ToString(), null,
                 _summary.AccountsWithErrors > 0 ? $"{_summary.AccountsWithErrors} with unreadable IAM policy" : "all policies readable")
        </RadzenColumn>
        <RadzenColumn Size="6" SizeLG="3">
            @Kpi("Accounts with a direct consumer admin", _summary.AccountsWithDirectConsumerAdmin.ToString(),
                 _summary.AccountsWithDirectConsumerAdmin > 0 ? "rz-color-danger" : "rz-color-success",
                 "gmail / unmanaged account holding Billing Account Administrator directly")
        </RadzenColumn>
        <RadzenColumn Size="6" SizeLG="3">
            @Kpi("Accounts with non-compliant direct members", _summary.AccountsWithNonCompliantDirect.ToString(),
                 _summary.AccountsWithNonCompliantDirect > 0 ? "rz-color-warning" : "rz-color-success",
                 "at least one assessable direct member failing a rule")
        </RadzenColumn>
        <RadzenColumn Size="6" SizeLG="3">
            @Kpi("Accounts with non-compliant inherited members", _summary.AccountsWithNonCompliantInherited.ToString(),
                 _summary.AccountsWithNonCompliantInherited > 0 ? "rz-color-warning" : "rz-color-success",
                 "inherited from the master billing account")
        </RadzenColumn>
    </RadzenRow>

    @* ---- Member compliance, direct vs inherited ---- *@
    <RadzenRow Gap="1rem" RowGap="1rem" class="rz-mb-4">
        <RadzenColumn Size="12" SizeLG="6">@BucketCard("Direct members", "Granted on individual sub-accounts (distinct email + role)", _summary.Direct)</RadzenColumn>
        <RadzenColumn Size="12" SizeLG="6">@BucketCard("Inherited members", "Granted on master billing accounts — apply to every sub-account (distinct email + role)", _summary.Inherited)</RadzenColumn>
    </RadzenRow>

    <RadzenCard Variant="Variant.Filled">
        <RadzenTabs @bind-SelectedIndex="_selectedTab" RenderMode="TabRenderMode.Client">
            <Tabs>
                <RadzenTabsItem Text="Accounts" Icon="@AppIcons.AccountBalance">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap" class="rz-my-3">
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-text-nowrap">
                            <RadzenSwitch @bind-Value="_onlyProblems" Name="onlyProblems" />
                            <RadzenLabel Text="Only accounts with findings" Component="onlyProblems" />
                        </RadzenStack>
                        <SearchBox Value="@_accountSearch" ValueChanged="@(v => _accountSearch = v ?? "")" Label="Filter by name / id / customer" DebounceMs="200" Style="flex: 1 1 16rem" />
                    </RadzenStack>
                    <RadzenDataGrid TItem="BillingPostureAccount" Data="FilteredAccounts" AllowSorting="true" AllowPaging="true" PageSize="25" PageSizeOptions="_accountPageSizes" ShowPagingSummary="true"
                                    Density="Density.Compact" GridLines="DataGridGridLines.Horizontal" Responsive="true" EmptyText="No accounts match.">
                        <Columns>
                            <RadzenDataGridColumn TItem="BillingPostureAccount" Property="@nameof(BillingPostureAccount.DisplayName)" Title="Billing account">
                                <Template Context="a">
                                    <div>
                                        <span>@(a.DisplayName ?? a.BillingAccountId)</span>
                                        <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Div" class="rz-text-secondary-color rz-m-0">
                                            @a.BillingAccountId
                                            @if (!a.IsSubaccount) { <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="master" class="rz-ms-1" /> }
                                            @if (a.CustomerId is not null) { <span> · </span><RadzenLink Path="@($"/customers/{a.CustomerId}")" Text="customer" /> }
                                        </RadzenText>
                                        @if (a.Error is not null)
                                        {
                                            <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Div" class="rz-color-danger rz-m-0">IAM policy unreadable: @a.Error</RadzenText>
                                        }
                                    </div>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="BillingPostureAccount" Property="@nameof(BillingPostureAccount.HasDirectConsumerAdmin)" Title="Consumer admin" Width="140px">
                                <Template Context="a">
                                    @if (a.HasDirectConsumerAdmin)
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="@a.Direct.ConsumerAdmins.ToString()" />
                                    }
                                    else { <span class="rz-text-secondary-color">—</span> }
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="BillingPostureAccount" Property="Direct.Members" Title="Direct" Width="90px" />
                            <RadzenDataGridColumn TItem="BillingPostureAccount" Property="Direct.NonCompliant" Title="Direct non-compliant" Width="170px">
                                <Template Context="a">@NonCompliantCell(a.Direct)</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="BillingPostureAccount" Property="Inherited.Members" Title="Inherited" Width="100px" />
                            <RadzenDataGridColumn TItem="BillingPostureAccount" Property="Inherited.NonCompliant" Title="Inherited non-compliant" Width="190px">
                                <Template Context="a">@NonCompliantCell(a.Inherited)</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="BillingPostureAccount" Title=" " Sortable="false" TextAlign="TextAlign.End" Width="130px">
                                <Template Context="a">
                                    <RadzenButton Text="Members" Icon="@AppIcons.ChevronRight" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text" Click="@(() => OpenAccountAsync(a))" class="rz-text-nowrap" />
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>

                    @if (_openAccount is not null)
                    {
                        <RadzenCard Variant="Variant.Outlined" class="rz-mt-4">
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="1rem" class="rz-mb-2">
                                <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-m-0" Style="font-weight:600">@(_openAccount.DisplayName ?? _openAccount.BillingAccountId) — members</RadzenText>
                                <RadzenButton Icon="@AppIcons.Close" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Click="@(() => { _openAccount = null; _openMembers = null; })" aria-label="Close" />
                            </RadzenStack>
                            @if (_openMembers is null)
                            {
                                <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
                            }
                            else
                            {
                                @MemberTable(_openMembers.Members)
                            }
                        </RadzenCard>
                    }
                </RadzenTabsItem>

                <RadzenTabsItem Text="Action list" Icon="@AppIcons.Checklist">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap" class="rz-my-3">
                        <RadzenDropDown TValue="string" Data="_scopeOptions" ValueProperty="@nameof(SelectOption.Value)" TextProperty="@nameof(SelectOption.Text)"
                                        Value="@_findingsScope" ValueChanged="OnScopeChangedAsync" Style="width: 220px" aria-label="Scope" Name="findingsScope" />
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">
                            Distinct members that are consumer admins or fail at least one best-practice rule, with the accounts they hold a role on.
                        </RadzenText>
                    </RadzenStack>
                    @if (_findings is null)
                    {
                        <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
                    }
                    else
                    {
                        <RadzenDataGrid TItem="BillingPostureFinding" Data="_findings.Findings" AllowSorting="true" AllowPaging="true" PageSize="50" PageSizeOptions="_findingPageSizes" ShowPagingSummary="true"
                                        Density="Density.Compact" GridLines="DataGridGridLines.Horizontal" Responsive="true" EmptyText="No findings — every assessable member in this scope is compliant.">
                            <Columns>
                                <RadzenDataGridColumn TItem="BillingPostureFinding" Property="Member.Email" Title="Member">
                                    <Template Context="f">@MemberCell(f.Member)</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="BillingPostureFinding" Title="Role" Sortable="false">
                                    <Template Context="f"><span class="rz-text-nowrap">@f.Member.RoleDisplayName</span></Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="BillingPostureFinding" Property="Member.Inherited" Title="Grant" Width="100px">
                                    <Template Context="f">@(f.Member.Inherited ? "inherited" : "direct")</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="BillingPostureFinding" Title="Account" Sortable="false">
                                    <Template Context="f">@AccountKindChip(f.Member)</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="BillingPostureFinding" Property="Member.TwoSvOk" Title="2SV">
                                    <Template Context="f">@TwoSvChip(f.Member)</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="BillingPostureFinding" Property="Member.AdvancedProtectionOk" Title="Adv. Protection">
                                    <Template Context="f">@AppChip(f.Member)</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="BillingPostureFinding" Property="Member.KeysOk" Title="Keys">
                                    <Template Context="f">@KeysChip(f.Member)</Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn TItem="BillingPostureFinding" Property="BillingAccountIds.Count" Title="Billing accounts" Width="140px">
                                    <Template Context="f">
                                        <Tip Text="@string.Join(", ", f.BillingAccountIds)">@f.BillingAccountIds.Count</Tip>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    }
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>
    </RadzenCard>
}

@code {
    private static readonly IEnumerable<int> _accountPageSizes = [25, 50, 100];
    private static readonly IEnumerable<int> _findingPageSizes = [50, 100, 200];
    private static readonly SelectOption[] _scopeOptions =
    [
        new("all", "Direct + inherited"),
        new("direct", "Direct only"),
        new("inherited", "Inherited only"),
    ];

    private bool _loading = true;
    private BillingPostureSummary? _summary;
    private BillingPostureFindingsResult? _findings;
    private string _findingsScope = "all";
    private int _selectedTab;
    private bool _onlyProblems = true;
    private string _accountSearch = "";
    private BillingPostureAccount? _openAccount;
    private BillingPostureMembersResult? _openMembers;

    protected override Task OnInitializedAsync() => LoadAsync();

    private IEnumerable<BillingPostureAccount> FilteredAccounts =>
        (_summary?.Accounts ?? [])
            .Where(a => !_onlyProblems || a.HasDirectConsumerAdmin || a.Direct.NonCompliant > 0 || a.Inherited.NonCompliant > 0 || a.Error is not null)
            .Where(a => string.IsNullOrWhiteSpace(_accountSearch)
                        || (a.DisplayName?.Contains(_accountSearch, StringComparison.OrdinalIgnoreCase) ?? false)
                        || a.BillingAccountId.Contains(_accountSearch, StringComparison.OrdinalIgnoreCase)
                        || (a.CustomerId?.Contains(_accountSearch, StringComparison.OrdinalIgnoreCase) ?? false));

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var summaryTask = Api.GetBillingPostureAsync();
            var findingsTask = Api.GetBillingPostureFindingsAsync(_findingsScope);
            await Task.WhenAll(summaryTask, findingsTask);
            _summary = summaryTask.Result;
            _findings = findingsTask.Result;
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load posture: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnScopeChangedAsync(string scope)
    {
        _findingsScope = scope;
        _findings = null;
        try { _findings = await Api.GetBillingPostureFindingsAsync(scope); }
        catch (Exception ex) { await Snackbar.Add($"Failed to load findings: {ex.Message}", Severity.Error); _findings = new(); }
    }

    private async Task OpenAccountAsync(BillingPostureAccount account)
    {
        _openAccount = account;
        _openMembers = null;
        try { _openMembers = await Api.GetBillingPostureMembersAsync(account.BillingAccountId); }
        catch (Exception ex) { await Snackbar.Add($"Failed to load members: {ex.Message}", Severity.Error); _openMembers = new() { BillingAccountId = account.BillingAccountId }; }
    }

    // ---- render helpers ----

    private RenderFragment Kpi(string label, string value, string? colorClass, string? hint) => __builder =>
    {
        <RadzenCard Variant="Variant.Filled" class="rz-h-100">
            <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">@label</RadzenText>
            <RadzenText TextStyle="TextStyle.H4" class="@($"rz-m-0 {colorClass}")">@value</RadzenText>
            @if (hint is not null) { <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">@hint</RadzenText> }
        </RadzenCard>
    };

    private RenderFragment BucketCard(string title, string subtitle, PostureBucket b) => __builder =>
    {
        var pctClass = b.Assessable == 0 ? "rz-text-secondary-color" : b.CompliancePercent >= 90 ? "rz-color-success" : b.CompliancePercent >= 60 ? "rz-color-warning" : "rz-color-danger";
        <RadzenCard Variant="Variant.Filled" class="rz-h-100">
            <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">@title</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-mb-2">@subtitle</RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.End" Gap="0.5rem" class="rz-mb-1">
                <RadzenText TextStyle="TextStyle.H4" class="@($"rz-m-0 {pctClass}")">
                    @(b.Assessable == 0 ? "—" : $"{b.CompliancePercent:0}%")
                </RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">compliant · @b.Compliant of @b.Assessable assessable (@b.Members total)</RadzenText>
            </RadzenStack>
            <RadzenProgressBar Value="@Math.Round(b.CompliancePercent)" ShowValue="false" ProgressBarStyle="ProgressBarStyle.Success" Style="height: 6px" class="rz-mb-3" />
            <table class="gchannel-table gchannel-table-hover">
                <tbody>
                    <tr><td>2SV off</td><td class="num">@Count(b.TwoSvOff)</td></tr>
                    <tr><td>Not enrolled in Advanced Protection</td><td class="num">@Count(b.NoAdvancedProtection)</td></tr>
                    <tr><td>No passkey or security key</td><td class="num">@Count(b.NoKeys)</td></tr>
                    <tr><td>Failing any rule</td><td class="num"><strong>@Count(b.NonCompliant)</strong></td></tr>
                    <tr><td>Consumer Google Accounts</td><td class="num">@Count(b.ConsumerAccounts, b.ConsumerAdmins > 0 ? $"{b.ConsumerAdmins} as billing admin" : null)</td></tr>
                    <tr><td>Managed, tenant not readable</td><td class="num"><span class="rz-text-secondary-color">@b.Unassessable</span></td></tr>
                </tbody>
            </table>
        </RadzenCard>
    };

    private static RenderFragment Count(int n, string? note = null) => __builder =>
    {
        <span class="@(n == 0 ? "rz-color-success" : "rz-color-danger")" style="font-weight:600">@n</span>
        @if (note is not null) { <small class="rz-text-secondary-color"> (@note)</small> }
    };

    private static RenderFragment NonCompliantCell(PostureBucket b) => __builder =>
    {
        if (b.Assessable == 0) { <span class="rz-text-secondary-color">—</span> return; }
        <Tip Text="@($"2SV off: {b.TwoSvOff} · no Adv. Protection: {b.NoAdvancedProtection} · no keys: {b.NoKeys} · of {b.Assessable} assessable")">
            <RadzenBadge BadgeStyle="@(b.NonCompliant == 0 ? BadgeStyle.Success : BadgeStyle.Warning)" Text="@($"{b.NonCompliant} / {b.Assessable}")" />
        </Tip>
    };

    private RenderFragment MemberTable(IReadOnlyList<BillingPostureMember> rows) => __builder =>
    {
        <RadzenDataGrid TItem="BillingPostureMember" Data="rows" AllowSorting="true" AllowPaging="false" Density="Density.Compact" GridLines="DataGridGridLines.Horizontal" Responsive="true" EmptyText="No members.">
            <Columns>
                <RadzenDataGridColumn TItem="BillingPostureMember" Property="@nameof(BillingPostureMember.Email)" Title="Member">
                    <Template Context="m">@MemberCell(m)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="BillingPostureMember" Title="Role" Sortable="false">
                    <Template Context="m"><span class="rz-text-nowrap">@m.RoleDisplayName</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="BillingPostureMember" Property="@nameof(BillingPostureMember.Inherited)" Title="Grant" Width="100px">
                    <Template Context="m">@(m.Inherited ? "inherited" : "direct")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="BillingPostureMember" Title="Account" Sortable="false">
                    <Template Context="m">@AccountKindChip(m)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="BillingPostureMember" Property="@nameof(BillingPostureMember.TwoSvOk)" Title="2SV">
                    <Template Context="m">@TwoSvChip(m)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="BillingPostureMember" Property="@nameof(BillingPostureMember.AdvancedProtectionOk)" Title="Adv. Protection">
                    <Template Context="m">@AppChip(m)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="BillingPostureMember" Property="@nameof(BillingPostureMember.KeysOk)" Title="Keys">
                    <Template Context="m">@KeysChip(m)</Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    };

    private static RenderFragment MemberCell(BillingPostureMember m) => __builder =>
    {
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem" Wrap="FlexWrap.Wrap">
            <RadzenIcon Icon="@(m.MemberType switch { "user" => AppIcons.Person, "group" => AppIcons.Groups, "serviceAccount" => AppIcons.SmartToy, _ => AppIcons.HelpOutline })" class="rz-text-secondary-color" />
            <span>@m.Email</span>
            @if (m.IsConsumerAdmin) { <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="consumer admin" class="rz-ms-1" /> }
            @if (m.IsAdmin == true) { <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="ws admin" class="rz-ms-1" /> }
            @if (m.Suspended == true) { <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="suspended" class="rz-ms-1" /> }
        </RadzenStack>
    };

    private static RenderFragment AccountKindChip(BillingPostureMember m) => __builder =>
    {
        var (label, style) = m.AccountKind switch
        {
            GoogleAccountKind.Managed => (m.SecurityVisible ? "Managed" : "Managed · unreadable", m.SecurityVisible ? BadgeStyle.Success : BadgeStyle.Light),
            GoogleAccountKind.ManagedTeam => ("Managed (team)", BadgeStyle.Warning),
            GoogleAccountKind.Consumer => ("Consumer", BadgeStyle.Danger),
            _ => ("Unknown", BadgeStyle.Light)
        };
        <RadzenBadge BadgeStyle="@style" Text="@label" />
    };

    private static RenderFragment TwoSvChip(BillingPostureMember m) => __builder =>
    {
        if (!m.Assessable) { <span class="rz-text-secondary-color">n/a</span> return; }
        var on = m.TwoSvOk;
        <RadzenBadge BadgeStyle="@(on ? BadgeStyle.Success : BadgeStyle.Danger)" Text="@(on ? (m.TwoStepVerificationEnforced == true ? "On · enforced" : "On") : "Off")" />
    };

    private static RenderFragment AppChip(BillingPostureMember m) => __builder =>
    {
        if (!m.Assessable) { <span class="rz-text-secondary-color">—</span> return; }
        switch (m.AdvancedProtection)
        {
            case AdvancedProtectionStatus.Enrolled:
                <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Enrolled" />
                break;
            case AdvancedProtectionStatus.Unavailable:
                <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="Unavailable" />
                break;
            default:
                <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="Not enrolled" />
                break;
        }
    };

    private static RenderFragment KeysChip(BillingPostureMember m) => __builder =>
    {
        if (!m.Assessable) { <span class="rz-text-secondary-color">—</span> return; }
        if (m.SecurityKeys is null && m.Passkeys is null) { <span class="rz-text-secondary-color">unknown</span> return; }
        var parts = new List<string>();
        if (m.SecurityKeys is > 0) parts.Add($"{m.SecurityKeys} key{(m.SecurityKeys == 1 ? "" : "s")}");
        if (m.Passkeys is > 0) parts.Add($"{m.Passkeys} passkey{(m.Passkeys == 1 ? "" : "s")}");
        <RadzenBadge BadgeStyle="@(m.KeysOk ? BadgeStyle.Success : BadgeStyle.Danger)" Text="@(m.KeysOk ? string.Join(" · ", parts) : "none")" />
    };
}
