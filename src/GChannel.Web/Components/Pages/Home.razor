@page "/"
@attribute [Authorize]
@implements IDisposable
@using ApexCharts
@* ApexCharts and Radzen both export these names; the page uses the Radzen meaning except for Theme/Mode. *@
@using Orientation = Radzen.Orientation
@using Theme = ApexCharts.Theme
@inject GChannelApiClient Api
@inject UiNotifier Snackbar

<PageTitle>Dashboard · GChannel</PageTitle>

<RadzenText TextStyle="TextStyle.H4" class="rz-mb-2">Dashboard</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-text-secondary-color rz-mb-2">
    Reseller overview for your Google Cloud Channel estate.
</RadzenText>

@if (_status is not null)
{
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap" class="rz-mb-6">
        @if (_status.IsRunning)
        {
            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="Refreshing…" />
        }
        else if (!_status.Enabled)
        {
            <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="On demand" />
        }
        @if (_status.LastCompletedUtc is { } completed)
        {
            <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">
                Updated @FormatAgo(completed)@(_status.LastDurationSeconds is { } secs ? $" · took {secs}s" : "")@(NextRefreshText is { } next ? $" · {next}" : "")
            </RadzenText>
        }
        else if (_status is { Enabled: true, IsRunning: false })
        {
            <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">Awaiting first background refresh…@(NextRefreshText is { } next ? $" ({next})" : "")</RadzenText>
        }
    </RadzenStack>
}

@if (_data is { SkippedCustomerCount: > 0 })
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-mb-4">
        <div>@_data.SkippedCustomerCount customer@(_data.SkippedCustomerCount == 1 ? "" : "s") couldn't be loaded; figures may be incomplete.</div>
        @if (!string.IsNullOrWhiteSpace(_data.IncompleteReason))
        {
            <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Div" class="rz-m-0">@_data.IncompleteReason</RadzenText>
        }
        @if (_status is { Enabled: true })
        {
            <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Div" class="rz-m-0">These will be retrieved during the next background refresh; figures will fill in automatically.</RadzenText>
        }
    </RadzenAlert>
}

<OnboardingPanel CustomerCount="@(_overview?.CustomerCount ?? _data?.CustomerCount ?? 0)"
                 EntitlementCount="@EntitlementCount" />

<RadzenRow Gap="1rem" RowGap="1rem">
    @foreach (var card in Cards)
    {
        <RadzenColumn Size="12" SizeMD="6" SizeLG="3">
            <RadzenCard Variant="Variant.Filled" class="rz-h-100">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <div>
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0" Style="font-weight:600">@card.Label</RadzenText>
                        @if (card.Ready)
                        {
                            <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">@card.Value</RadzenText>
                        }
                        else
                        {
                            <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.ExtraSmall" ShowValue="false" class="rz-mt-1" />
                        }
                    </div>
                    <RadzenIcon Icon="@card.Icon" IconColor="@card.Color" Style="font-size: 2.5rem; width: auto; height: auto" />
                </RadzenStack>

                <RadzenButton Text="Details" Icon="@(IsExpanded(card.Key) ? AppIcons.ExpandLess : AppIcons.ExpandMore)" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text"
                              Disabled="@(!card.Ready)" Click="@(() => ToggleDetails(card.Key))" class="rz-mt-1" />

                @if (IsExpanded(card.Key))
                {
                    <div class="rz-mt-2">
                        @switch (card.Key)
                        {
                            case "customers":
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">
                                    <b>Direct</b> = a reseller buying from us for their own use (a direct sale).
                                    <b>Indirect</b> = your resellers' downstream end customers. Together they
                                    make up your total customer estate.
                                </RadzenText>
                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" class="rz-mt-2">
                                    <span>Direct (reseller own use)</span>
                                    <b>@DirectEstate</b>
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                                    <span>Reseller end customers</span>
                                    @if (IndirectLoaded)
                                    {
                                        <b>@IndirectEstate</b>
                                    }
                                    else
                                    {
                                        <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.ExtraSmall" ShowValue="false" />
                                    }
                                </RadzenStack>
                                @if (IndirectLoaded)
                                {
                                    <hr class="rz-my-1" />
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                                        <b>Total estate</b>
                                        <b>@TotalEstate</b>
                                    </RadzenStack>
                                }
                                break;

                            case "skus":
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">
                                    Active entitlements (purchased SKUs) currently provisioned across all customers — direct and via resellers (indirect).
                                </RadzenText>
                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" class="rz-mt-2">
                                    <span>Active seats</span>
                                    <b>@(_data?.ActiveSeats ?? 0)</b>
                                </RadzenStack>
                                @if (_products.Count > 0)
                                {
                                    <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-mt-2 rz-mb-0">Top products</RadzenText>
                                    @foreach (var slice in _products.Take(4))
                                    {
                                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                                            <span class="rz-text-truncate" style="max-width: 70%;">@slice.Product</span>
                                            <b>@slice.Count</b>
                                        </RadzenStack>
                                    }
                                }
                                break;

                            case "links":
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">
                                    Your linked indirect resellers (channel partners), grouped by link state.
                                </RadzenText>
                                @if (_overview?.ChannelLinkStates is { Count: > 0 } states)
                                {
                                    @foreach (var state in states)
                                    {
                                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" class="rz-mt-1">
                                            <span>@Humanize(state.State)</span>
                                            <b>@state.Count</b>
                                        </RadzenStack>
                                    }
                                }
                                else
                                {
                                    <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-mt-1 rz-mb-0">No channel partner links yet.</RadzenText>
                                }
                                break;

                            case "suspended":
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">
                                    Entitlements that are paused (e.g. billing or admin action) and may need attention.
                                    Shown alongside the rest of the entitlement lifecycle for context.
                                    Numbers link to the matching entitlements across your whole estate.
                                </RadzenText>
                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" class="rz-mt-2">
                                    <span>Active</span>
                                    <a href="/entitlements?state=active&scope=all"><b>@(_data?.ActiveEntitlementCount ?? 0)</b></a>
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                                    <span>Trial</span>
                                    <a href="/entitlements?state=trial&scope=all"><b>@(_data?.TrialEntitlementCount ?? 0)</b></a>
                                </RadzenStack>
                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                                    <span>Suspended</span>
                                    <a href="/entitlements?state=suspended&scope=all"><b>@(_data?.SuspendedEntitlementCount ?? 0)</b></a>
                                </RadzenStack>
                                break;
                        }
                    </div>
                }
            </RadzenCard>
        </RadzenColumn>
    }

    @if (_data?.EstateValue is { } estate)
    {
        <RadzenColumn Size="12">
            <RadzenCard Variant="Variant.Filled">
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                    <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">Estimated estate value (monthly)</RadzenText>
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" Wrap="FlexWrap.Wrap">
                        @foreach (var cur in estate.Currencies)
                        {
                            <RadzenBadge BadgeStyle="@(cur.Currency == estate.Currency ? BadgeStyle.Primary : BadgeStyle.Light)" Text="@cur.Currency" />
                        }
                    </RadzenStack>
                </RadzenStack>
                <RadzenRow Gap="1rem" RowGap="1rem" class="rz-mt-1">
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0" Style="font-weight:600">Wholesale cost</RadzenText>
                        @if (estate.Currencies.Count > 0)
                        {
                            @foreach (var cur in estate.Currencies)
                            {
                                <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">@cur.Currency @cur.WholesaleMonthly.ToString("N2")</RadzenText>
                            }
                        }
                        else
                        {
                            <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">@estate.Currency @estate.WholesaleMonthly.ToString("N2")</RadzenText>
                        }
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">What you pay Google</RadzenText>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0" Style="font-weight:600">Repriced revenue</RadzenText>
                        @if (estate.Currencies.Count > 0)
                        {
                            @foreach (var cur in estate.Currencies)
                            {
                                <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">@cur.Currency @cur.RevenueMonthly.ToString("N2")</RadzenText>
                            }
                        }
                        else
                        {
                            <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">@estate.Currency @estate.RevenueMonthly.ToString("N2")</RadzenText>
                        }
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">What end customers are billed</RadzenText>
                    </RadzenColumn>
                    <RadzenColumn Size="12" SizeMD="4">
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0" Style="font-weight:600">Margin</RadzenText>
                        @if (estate.Currencies.Count > 0)
                        {
                            @foreach (var cur in estate.Currencies)
                            {
                                <RadzenText TextStyle="TextStyle.H5" class="@($"rz-m-0 {MarginClass(cur.MarginMonthly)}")">@cur.Currency @cur.MarginMonthly.ToString("N2")</RadzenText>
                            }
                        }
                        else
                        {
                            <RadzenText TextStyle="TextStyle.H5" class="@($"rz-m-0 {MarginClass(estate.MarginMonthly)}")">@estate.Currency @estate.MarginMonthly.ToString("N2")</RadzenText>
                        }
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">Revenue − wholesale</RadzenText>
                    </RadzenColumn>
                </RadzenRow>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-mt-3 rz-mb-0" Style="font-weight:600">
                    By source@(estate.MixedCurrencies ? " & currency" : "")
                </RadzenText>
                <table class="gchannel-table gchannel-table-hover rz-mt-1">
                    <thead>
                        <tr>
                            @if (estate.MixedCurrencies)
                            {
                                <th>Currency</th>
                            }
                            <th>Source</th>
                            <th class="num">Wholesale cost</th>
                            <th class="num">Repriced revenue</th>
                            <th class="num">Margin</th>
                            <th class="num">Subscriptions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cur in estate.Currencies)
                        {
                            <tr>
                                @if (estate.MixedCurrencies)
                                {
                                    <td>@cur.Currency</td>
                                }
                                <td>Direct (reseller own use)</td>
                                <td class="num">@cur.Direct.WholesaleMonthly.ToString("N2")</td>
                                <td class="num">@cur.Direct.RevenueMonthly.ToString("N2")</td>
                                <td class="@($"num {MarginClass(cur.Direct.MarginMonthly)}")">@cur.Direct.MarginMonthly.ToString("N2")</td>
                                <td class="num">@cur.Direct.PricedEntitlementCount</td>
                            </tr>
                            <tr>
                                @if (estate.MixedCurrencies)
                                {
                                    <td></td>
                                }
                                <td>Via resellers (indirect)</td>
                                <td class="num">@cur.Indirect.WholesaleMonthly.ToString("N2")</td>
                                <td class="num">@cur.Indirect.RevenueMonthly.ToString("N2")</td>
                                <td class="@($"num {MarginClass(cur.Indirect.MarginMonthly)}")">@cur.Indirect.MarginMonthly.ToString("N2")</td>
                                <td class="num">@cur.Indirect.PricedEntitlementCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (estate.Currencies.Count > 1)
                {
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-mt-3 rz-mb-0" Style="font-weight:600">By currency (total)</RadzenText>
                    <table class="gchannel-table gchannel-table-hover rz-mt-1">
                        <thead>
                            <tr>
                                <th>Currency</th>
                                <th class="num">Wholesale cost</th>
                                <th class="num">Repriced revenue</th>
                                <th class="num">Margin</th>
                                <th class="num">Subscriptions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cur in estate.Currencies)
                            {
                                <tr>
                                    <td>@cur.Currency</td>
                                    <td class="num">@cur.WholesaleMonthly.ToString("N2")</td>
                                    <td class="num">@cur.RevenueMonthly.ToString("N2")</td>
                                    <td class="@($"num {MarginClass(cur.MarginMonthly)}")">@cur.MarginMonthly.ToString("N2")</td>
                                    <td class="num">@cur.PricedEntitlementCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" class="rz-text-secondary-color rz-mt-2 rz-mb-0">
                    Estimates from offer <b>list</b> pricing × seats and configured repricing mark-ups — not invoiced amounts.
                    Based on @estate.PricedEntitlementCount priced active entitlement(s)@(estate.UnpricedEntitlementCount > 0 ? $"; {estate.UnpricedEntitlementCount} have no resolved offer price and are excluded" : "").@(estate.MixedCurrencies ? " Each currency is listed separately; the source split is broken out below." : "")
                </RadzenText>
            </RadzenCard>
        </RadzenColumn>
    }

    <RadzenColumn Size="12" SizeLG="8">
        <RadzenCard Variant="Variant.Filled" class="rz-h-100">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap" class="rz-mb-2">
                <div>
                    <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">Customers onboarded</RadzenText>
                    @if (_monthly.Count > 0 && MonthlyRangeTitle is { Length: > 0 } title)
                    {
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">@title</RadzenText>
                    }
                </div>
                @if (_allMonthly.Count > 1)
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                        <RadzenDropDown TValue="string" Data="_allMonthly" ValueProperty="@nameof(MonthlyPoint.Key)" TextProperty="@nameof(MonthlyPoint.Label)"
                                        Value="@_rangeFrom" ValueChanged="OnRangeFromChanged" Style="min-width:130px" aria-label="From" Name="rangeFrom" />
                        <RadzenDropDown TValue="string" Data="_allMonthly" ValueProperty="@nameof(MonthlyPoint.Key)" TextProperty="@nameof(MonthlyPoint.Label)"
                                        Value="@_rangeTo" ValueChanged="OnRangeToChanged" Style="min-width:130px" aria-label="To" Name="rangeTo" />
                        <Tip Text="Show the whole available period">
                            <RadzenButton Text="All" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Click="ResetRangeToAll" />
                        </Tip>
                    </RadzenStack>
                }
            </RadzenStack>
            @if (_monthly.Count > 0)
            {
                <ApexChart TItem="MonthlyPoint" Options="_monthlyOptions" @ref="_monthlyChart">
                    <ApexPointSeries TItem="MonthlyPoint"
                                     Items="_monthly"
                                     Name="@(HasIndirectOnboarding ? "Direct" : "Customers")"
                                     SeriesType="SeriesType.Line"
                                     XValue="@(p => p.Label)"
                                     YValue="@(p => p.Direct)" />
                    @if (HasIndirectOnboarding)
                    {
                        <ApexPointSeries TItem="MonthlyPoint"
                                         Items="_monthly"
                                         Name="Via resellers (indirect)"
                                         SeriesType="SeriesType.Line"
                                         XValue="@(p => p.Label)"
                                         YValue="@(p => p.Indirect)" />
                    }
                </ApexChart>
            }
            else if (_overviewLoading)
            {
                <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Style="height: 200px;">
                    <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" ShowValue="false" aria-label="Loading" />
                </RadzenStack>
            }
            else
            {
                <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-m-0">No customer history yet.</RadzenText>
            }
        </RadzenCard>
    </RadzenColumn>

    <RadzenColumn Size="12" SizeLG="4">
        <RadzenCard Variant="Variant.Filled" class="rz-h-100">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem" class="rz-mb-2">
                <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">Product mix</RadzenText>
                <Tip Text="Slices are grouped by their catalog product name. A few entries may appear as a raw SKU or product ID when the marketing display name isn't available from the catalog — typically custom/negotiated offers, SKU groups, or products missing from the public catalog.">
                    <RadzenIcon Icon="@AppIcons.Info" class="rz-text-secondary-color" />
                </Tip>
            </RadzenStack>
            @if (_indirectProducts.Count > 0)
            {
                @* Both direct and reseller (indirect) business exists — show a donut for each so the
                   split is clear rather than blending them into one whole-estate chart. *@
                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0" Style="font-weight:600">Direct (reseller own use)</RadzenText>
                @if (_directProducts.Count > 0)
                {
                    <ApexChart TItem="ProductSlice" Title="Active SKUs" Options="_directProductOptions" @ref="_directProductChart">
                        <ApexPointSeries TItem="ProductSlice"
                                         Items="_directProducts"
                                         Name="SKUs"
                                         SeriesType="SeriesType.Donut"
                                         XValue="@(p => p.Product)"
                                         YValue="@(p => p.Count)" />
                    </ApexChart>
                }
                else
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-mb-2">No direct active entitlements.</RadzenText>
                }
                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-mt-3 rz-mb-0" Style="font-weight:600">Via resellers (indirect)</RadzenText>
                <ApexChart TItem="ProductSlice" Title="Active SKUs" Options="_indirectProductOptions" @ref="_indirectProductChart">
                    <ApexPointSeries TItem="ProductSlice"
                                     Items="_indirectProducts"
                                     Name="SKUs"
                                     SeriesType="SeriesType.Donut"
                                     XValue="@(p => p.Product)"
                                     YValue="@(p => p.Count)" />
                </ApexChart>
            }
            else if (_directProducts.Count > 0)
            {
                @* Direct-only distributor (no reseller estate): the direct mix is the whole estate. *@
                <ApexChart TItem="ProductSlice" Title="Active SKUs" Options="_directProductOptions" @ref="_directProductChart">
                    <ApexPointSeries TItem="ProductSlice"
                                     Items="_directProducts"
                                     Name="SKUs"
                                     SeriesType="SeriesType.Donut"
                                     XValue="@(p => p.Product)"
                                     YValue="@(p => p.Count)" />
                </ApexChart>
            }
            else if (_entitlementsLoading)
            {
                <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Style="height: 200px;">
                    <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" ShowValue="false" aria-label="Loading" />
                </RadzenStack>
            }
            else
            {
                <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-m-0">No active entitlements yet.</RadzenText>
            }
        </RadzenCard>
    </RadzenColumn>

    <RadzenColumn Size="12" SizeLG="6">
        <RadzenCard Variant="Variant.Filled" class="rz-h-100">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Start" Gap="0.5rem" Wrap="FlexWrap.Wrap" class="rz-mb-2">
                <div>
                    <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">Onboarding by reseller</RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">
                        Which reseller onboarded which customers in the selected month. "Direct" = account-owned.
                    </RadzenText>
                </div>
                @if (_onboardMonths.Count > 0)
                {
                    <RadzenDropDown TValue="string" Data="MonthOptions(_onboardMonths)" ValueProperty="@nameof(SelectOption.Value)" TextProperty="@nameof(SelectOption.Text)"
                                    Value="@_onboardMonth" ValueChanged="OnOnboardMonthChanged" Style="max-width:170px" aria-label="Month" Name="onboardMonth" />
                }
            </RadzenStack>
            @if (_onboardBars.Count > 0)
            {
                <ApexChart TItem="OnboardBar" Options="_onboardOptions" @ref="_onboardChart">
                    <ApexPointSeries TItem="OnboardBar" Items="_onboardBars" Name="Customers"
                                     SeriesType="SeriesType.Bar"
                                     XValue="@(b => b.Reseller)" YValue="@(b => b.Count)" />
                </ApexChart>
                <div style="max-height:150px; overflow:auto" class="rz-mt-2">
                    @foreach (var g in OnboardDetail())
                    {
                        <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Div" class="rz-m-0">
                            <strong>@g.Key</strong>: @string.Join(", ", g.Select(o => o.CustomerName))
                        </RadzenText>
                    }
                </div>
            }
            else if (_entitlementsLoading)
            {
                <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Style="height:200px;">
                    <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" ShowValue="false" aria-label="Loading" />
                </RadzenStack>
            }
            else
            {
                <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-m-0">
                    No onboarding data yet. Attribution appears once the background read-model has synced.
                </RadzenText>
            }
        </RadzenCard>
    </RadzenColumn>

    <RadzenColumn Size="12" SizeLG="6">
        <RadzenCard Variant="Variant.Filled" class="rz-h-100">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Start" Gap="0.5rem" Wrap="FlexWrap.Wrap" class="rz-mb-2">
                <div>
                    <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">Partner links established</RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">
                        When channel partner links were created, month by month. Pick a month to see with whom.
                    </RadzenText>
                </div>
                @if (_linkMonths.Count > 0)
                {
