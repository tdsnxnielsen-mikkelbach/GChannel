@page "/"
@attribute [Authorize]
@implements IDisposable
@inject GChannelApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Dashboard · GChannel</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Dashboard</MudText>
<MudText Typo="Typo.body1" Class="mb-6" Color="Color.Secondary">
    Reseller overview for your Google Cloud Channel estate.
</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
}

<MudGrid>
    @foreach (var card in Cards)
    {
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent>
                    <div class="d-flex justify-space-between align-center">
                        <div>
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@card.Label</MudText>
                            <MudText Typo="Typo.h5">@card.Value</MudText>
                        </div>
                        <MudIcon Icon="@card.Icon" Color="@card.Color" Size="Size.Large" />
                    </div>
                </MudCardContent>
            </MudCard>
        </MudItem>
    }

    <MudItem xs="12" md="8">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" GutterBottom="true">Customers onboarded</MudText>
            @if (_monthly.Count > 0)
            {
                <ApexChart TItem="MonthlyPoint" Title="Last 6 months">
                    <ApexPointSeries TItem="MonthlyPoint"
                                     Items="_monthly"
                                     Name="Customers"
                                     SeriesType="SeriesType.Area"
                                     XValue="@(p => p.Month)"
                                     YValue="@(p => p.Customers)" />
                </ApexChart>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No customer history yet.</MudText>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" GutterBottom="true">Product mix</MudText>
            @if (_products.Count > 0)
            {
                <ApexChart TItem="ProductSlice" Title="Active SKUs">
                    <ApexPointSeries TItem="ProductSlice"
                                     Items="_products"
                                     Name="SKUs"
                                     SeriesType="SeriesType.Donut"
                                     XValue="@(p => p.Product)"
                                     YValue="@(p => p.Count)" />
                </ApexChart>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No active entitlements yet.</MudText>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private record SummaryCard(string Label, string Value, string Icon, Color Color);
    private record MonthlyPoint(string Month, decimal Customers);
    private record ProductSlice(string Product, decimal Count);

    private DashboardSummary? _data;
    private bool _loading = true;
    private readonly List<MonthlyPoint> _monthly = [];
    private readonly List<ProductSlice> _products = [];
    private readonly CancellationTokenSource _cts = new();

    // Cards derive from the loaded summary; before load they show zeros.
    private SummaryCard[] Cards =>
    [
        new("Customers", (_data?.CustomerCount ?? 0).ToString(), Icons.Material.Filled.Business, Color.Primary),
        new("Active SKUs", (_data?.ActiveEntitlementCount ?? 0).ToString(), Icons.Material.Filled.Inventory2, Color.Success),
        new("Trials", (_data?.TrialEntitlementCount ?? 0).ToString(), Icons.Material.Filled.Schedule, Color.Info),
        new("Suspended", (_data?.SuspendedEntitlementCount ?? 0).ToString(), Icons.Material.Filled.PauseCircle, Color.Warning),
    ];

    // Load after the first interactive render so the API call runs once on the live circuit
    // (avoiding a canceled prerender request), mirroring the other data-heavy pages.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _data = await Api.GetDashboardSummaryAsync(_cts.Token);

            _monthly.Clear();
            foreach (var point in _data?.CustomersOnboarded ?? [])
            {
                _monthly.Add(new MonthlyPoint(point.Month, point.Customers));
            }

            _products.Clear();
            foreach (var slice in _data?.ProductMix ?? [])
            {
                _products.Add(new ProductSlice(slice.Product, slice.Count));
            }
        }
        catch (OperationCanceledException)
        {
            // Benign: the dashboard aggregation is slow and the request was canceled
            // (navigation away or circuit teardown). Nothing to surface to the user.
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load dashboard: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
