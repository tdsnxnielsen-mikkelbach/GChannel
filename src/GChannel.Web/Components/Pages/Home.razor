@page "/"
@attribute [Authorize]
@implements IDisposable
@using ApexCharts
@* ApexCharts and Blazorise both export these names; the page uses the Blazorise meaning except for Theme. *@
@using Color = Blazorise.Color
@using Size = Blazorise.Size
@using Padding = Blazorise.Padding
@using Tooltip = Blazorise.Tooltip
@using Label = Blazorise.Label
@using Orientation = Blazorise.Orientation
@using Theme = ApexCharts.Theme
@inject GChannelApiClient Api
@inject UiNotifier Snackbar

<PageTitle>Dashboard · GChannel</PageTitle>

<Heading Size="HeadingSize.Is3" Margin="Margin.Is2.FromBottom">Dashboard</Heading>
<Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is2.FromBottom">
    Reseller overview for your Google Cloud Channel estate.
</Paragraph>

@if (_status is not null)
{
    <Div Flex="Flex.AlignItems.Center" Gap="Gap.Is2" Margin="Margin.Is5.FromBottom">
        @if (_status.IsRunning)
        {
            <Badge Color="Color.Info"><Icon Name="@AppIcons.Sync" Class="me-1 fa-spin" />Refreshing…</Badge>
        }
        else if (!_status.Enabled)
        {
            <Badge Color="Color.Light" Class="border text-body"><Icon Name="@AppIcons.Bolt" Class="me-1" />On demand</Badge>
        }
        @if (_status.LastCompletedUtc is { } completed)
        {
            <Small TextColor="TextColor.Secondary">
                Updated @FormatAgo(completed)@(_status.LastDurationSeconds is { } secs ? $" · took {secs}s" : "")@(NextRefreshText is { } next ? $" · {next}" : "")
            </Small>
        }
        else if (_status is { Enabled: true, IsRunning: false })
        {
            <Small TextColor="TextColor.Secondary">Awaiting first background refresh…@(NextRefreshText is { } next ? $" ({next})" : "")</Small>
        }
    </Div>
}

@if (_data is { SkippedCustomerCount: > 0 })
{
    <Alert Color="Color.Warning" Visible Margin="Margin.Is4.FromBottom">
        <div>@_data.SkippedCustomerCount customer@(_data.SkippedCustomerCount == 1 ? "" : "s") couldn't be loaded; figures may be incomplete.</div>
        @if (!string.IsNullOrWhiteSpace(_data.IncompleteReason))
        {
            <Small Display="Display.Block">@_data.IncompleteReason</Small>
        }
        @if (_status is { Enabled: true })
        {
            <Small Display="Display.Block">These will be retrieved during the next background refresh; figures will fill in automatically.</Small>
        }
    </Alert>
}

<OnboardingPanel CustomerCount="@(_overview?.CustomerCount ?? _data?.CustomerCount ?? 0)"
                 EntitlementCount="@EntitlementCount" />

<Row>
    @foreach (var card in Cards)
    {
        <Column ColumnSize="ColumnSize.Is12.Is6.OnTablet.Is3.OnDesktop" Margin="Margin.Is3.FromBottom">
            <Card Shadow="Shadow.Small" Class="h-100">
                <CardBody>
                    <Div Flex="Flex.JustifyContent.Between.AlignItems.Center">
                        <Div>
                            <Small TextColor="TextColor.Secondary" Display="Display.Block" Class="fw-semibold">@card.Label</Small>
                            @if (card.Ready)
                            {
                                <Heading Size="HeadingSize.Is4" Margin="Margin.Is0">@card.Value</Heading>
                            }
                            else
                            {
                                <div class="spinner-border spinner-border-sm text-secondary mt-1" role="status"><span class="visually-hidden">Loading…</span></div>
                            }
                        </Div>
                        <Icon Name="@card.Icon" TextColor="@card.Color" IconSize="IconSize.x2" />
                    </Div>

                    <Button Size="Size.Small" Color="Color.Primary" Class="btn-link text-decoration-none px-1 mt-1"
                            Disabled="@(!card.Ready)" Clicked="@(() => ToggleDetails(card.Key))">
                        Details <Icon Name="@(IsExpanded(card.Key) ? AppIcons.ExpandLess : AppIcons.ExpandMore)" Class="ms-1" />
                    </Button>

                    <Collapse Visible="@IsExpanded(card.Key)">
                        <Div Margin="Margin.Is2.FromTop">
                            @switch (card.Key)
                            {
                                case "customers":
                                    <Small TextColor="TextColor.Secondary" Display="Display.Block">
                                        <b>Direct</b> = a reseller buying from us for their own use (a direct sale).
                                        <b>Indirect</b> = your resellers' downstream end customers. Together they
                                        make up your total customer estate.
                                    </Small>
                                    <Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Margin="Margin.Is2.FromTop">
                                        <span>Direct (reseller own use)</span>
                                        <b>@DirectEstate</b>
                                    </Div>
                                    <Div Flex="Flex.JustifyContent.Between.AlignItems.Center">
                                        <span>Reseller end customers</span>
                                        @if (IndirectLoaded)
                                        {
                                            <b>@IndirectEstate</b>
                                        }
                                        else
                                        {
                                            <div class="spinner-border spinner-border-sm text-secondary" role="status"></div>
                                        }
                                    </Div>
                                    @if (IndirectLoaded)
                                    {
                                        <Divider Margin="Margin.Is1.OnY" />
                                        <Div Flex="Flex.JustifyContent.Between.AlignItems.Center">
                                            <b>Total estate</b>
                                            <b>@TotalEstate</b>
                                        </Div>
                                    }
                                    break;

                                case "skus":
                                    <Small TextColor="TextColor.Secondary" Display="Display.Block">
                                        Active entitlements (purchased SKUs) currently provisioned across all customers — direct and via resellers (indirect).
                                    </Small>
                                    <Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Margin="Margin.Is2.FromTop">
                                        <span>Active seats</span>
                                        <b>@(_data?.ActiveSeats ?? 0)</b>
                                    </Div>
                                    @if (_products.Count > 0)
                                    {
                                        <Small TextColor="TextColor.Secondary" Display="Display.Block" Margin="Margin.Is2.FromTop">Top products</Small>
                                        @foreach (var slice in _products.Take(4))
                                        {
                                            <Div Flex="Flex.JustifyContent.Between.AlignItems.Center">
                                                <span class="text-truncate" style="max-width: 70%;">@slice.Product</span>
                                                <b>@slice.Count</b>
                                            </Div>
                                        }
                                    }
                                    break;

                                case "links":
                                    <Small TextColor="TextColor.Secondary" Display="Display.Block">
                                        Your linked indirect resellers (channel partners), grouped by link state.
                                    </Small>
                                    @if (_overview?.ChannelLinkStates is { Count: > 0 } states)
                                    {
                                        @foreach (var state in states)
                                        {
                                            <Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Margin="Margin.Is1.FromTop">
                                                <span>@Humanize(state.State)</span>
                                                <b>@state.Count</b>
                                            </Div>
                                        }
                                    }
                                    else
                                    {
                                        <Small TextColor="TextColor.Secondary" Display="Display.Block" Margin="Margin.Is1.FromTop">No channel partner links yet.</Small>
                                    }
                                    break;

                                case "suspended":
                                    <Small TextColor="TextColor.Secondary" Display="Display.Block">
                                        Entitlements that are paused (e.g. billing or admin action) and may need attention.
                                        Shown alongside the rest of the entitlement lifecycle for context.
                                        Numbers link to the matching entitlements across your whole estate.
                                    </Small>
                                    <Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Margin="Margin.Is2.FromTop">
                                        <span>Active</span>
                                        <Anchor To="/entitlements?state=active&scope=all"><b>@(_data?.ActiveEntitlementCount ?? 0)</b></Anchor>
                                    </Div>
                                    <Div Flex="Flex.JustifyContent.Between.AlignItems.Center">
                                        <span>Trial</span>
                                        <Anchor To="/entitlements?state=trial&scope=all"><b>@(_data?.TrialEntitlementCount ?? 0)</b></Anchor>
                                    </Div>
                                    <Div Flex="Flex.JustifyContent.Between.AlignItems.Center">
                                        <span>Suspended</span>
                                        <Anchor To="/entitlements?state=suspended&scope=all"><b>@(_data?.SuspendedEntitlementCount ?? 0)</b></Anchor>
                                    </Div>
                                    break;
                            }
                        </Div>
                    </Collapse>
                </CardBody>
            </Card>
        </Column>
    }

    @if (_data?.EstateValue is { } estate)
    {
        <Column ColumnSize="ColumnSize.Is12" Margin="Margin.Is3.FromBottom">
            <Card Shadow="Shadow.Small">
                <CardBody>
                    <Div Flex="Flex.JustifyContent.Between.AlignItems.Center">
                        <Heading Size="HeadingSize.Is5" Margin="Margin.Is0">Estimated estate value (monthly)</Heading>
                        <Div Flex="Flex.Wrap" Gap="Gap.Is1">
                            @foreach (var cur in estate.Currencies)
                            {
                                <Badge Color="@(cur.Currency == estate.Currency ? Color.Primary : Color.Light)" Class="@(cur.Currency == estate.Currency ? null : "border text-body")">@cur.Currency</Badge>
                            }
                        </Div>
                    </Div>
                    <Row Margin="Margin.Is1.FromTop">
                        <Column ColumnSize="ColumnSize.Is12.Is4.OnTablet">
                            <Small TextColor="TextColor.Secondary" Display="Display.Block" Class="fw-semibold">Wholesale cost</Small>
                            @if (estate.Currencies.Count > 0)
                            {
                                @foreach (var cur in estate.Currencies)
                                {
                                    <Heading Size="HeadingSize.Is4" Margin="Margin.Is0">@cur.Currency @cur.WholesaleMonthly.ToString("N2")</Heading>
                                }
                            }
                            else
                            {
                                <Heading Size="HeadingSize.Is4" Margin="Margin.Is0">@estate.Currency @estate.WholesaleMonthly.ToString("N2")</Heading>
                            }
                            <Small TextColor="TextColor.Secondary">What you pay Google</Small>
                        </Column>
                        <Column ColumnSize="ColumnSize.Is12.Is4.OnTablet">
                            <Small TextColor="TextColor.Secondary" Display="Display.Block" Class="fw-semibold">Repriced revenue</Small>
                            @if (estate.Currencies.Count > 0)
                            {
                                @foreach (var cur in estate.Currencies)
                                {
                                    <Heading Size="HeadingSize.Is4" Margin="Margin.Is0">@cur.Currency @cur.RevenueMonthly.ToString("N2")</Heading>
                                }
                            }
                            else
                            {
                                <Heading Size="HeadingSize.Is4" Margin="Margin.Is0">@estate.Currency @estate.RevenueMonthly.ToString("N2")</Heading>
                            }
                            <Small TextColor="TextColor.Secondary">What end customers are billed</Small>
                        </Column>
                        <Column ColumnSize="ColumnSize.Is12.Is4.OnTablet">
                            <Small TextColor="TextColor.Secondary" Display="Display.Block" Class="fw-semibold">Margin</Small>
                            @if (estate.Currencies.Count > 0)
                            {
                                @foreach (var cur in estate.Currencies)
                                {
                                    <Heading Size="HeadingSize.Is4" Margin="Margin.Is0" TextColor="@(cur.MarginMonthly >= 0 ? TextColor.Success : TextColor.Danger)">@cur.Currency @cur.MarginMonthly.ToString("N2")</Heading>
                                }
                            }
                            else
                            {
                                <Heading Size="HeadingSize.Is4" Margin="Margin.Is0" TextColor="@(estate.MarginMonthly >= 0 ? TextColor.Success : TextColor.Danger)">@estate.Currency @estate.MarginMonthly.ToString("N2")</Heading>
                            }
                            <Small TextColor="TextColor.Secondary">Revenue − wholesale</Small>
                        </Column>
                    </Row>
                    <Small TextColor="TextColor.Secondary" Display="Display.Block" Margin="Margin.Is3.FromTop" Class="fw-semibold">
                        By source@(estate.MixedCurrencies ? " & currency" : "")
                    </Small>
                    <Table Narrow Hoverable Borderless Margin="Margin.Is1.FromTop">
                        <TableHeader>
                            <TableRow>
                                @if (estate.MixedCurrencies)
                                {
                                    <TableHeaderCell>Currency</TableHeaderCell>
                                }
                                <TableHeaderCell>Source</TableHeaderCell>
                                <TableHeaderCell TextAlignment="TextAlignment.End">Wholesale cost</TableHeaderCell>
                                <TableHeaderCell TextAlignment="TextAlignment.End">Repriced revenue</TableHeaderCell>
                                <TableHeaderCell TextAlignment="TextAlignment.End">Margin</TableHeaderCell>
                                <TableHeaderCell TextAlignment="TextAlignment.End">Subscriptions</TableHeaderCell>
                            </TableRow>
                        </TableHeader>
                        <TableBody>
                            @foreach (var cur in estate.Currencies)
                            {
                                <TableRow>
                                    @if (estate.MixedCurrencies)
                                    {
                                        <TableRowCell>@cur.Currency</TableRowCell>
                                    }
                                    <TableRowCell>Direct (reseller own use)</TableRowCell>
                                    <TableRowCell TextAlignment="TextAlignment.End">@cur.Direct.WholesaleMonthly.ToString("N2")</TableRowCell>
                                    <TableRowCell TextAlignment="TextAlignment.End">@cur.Direct.RevenueMonthly.ToString("N2")</TableRowCell>
                                    <TableRowCell TextAlignment="TextAlignment.End" TextColor="@(cur.Direct.MarginMonthly >= 0 ? TextColor.Success : TextColor.Danger)">@cur.Direct.MarginMonthly.ToString("N2")</TableRowCell>
                                    <TableRowCell TextAlignment="TextAlignment.End">@cur.Direct.PricedEntitlementCount</TableRowCell>
                                </TableRow>
                                <TableRow>
                                    @if (estate.MixedCurrencies)
                                    {
                                        <TableRowCell></TableRowCell>
                                    }
                                    <TableRowCell>Via resellers (indirect)</TableRowCell>
                                    <TableRowCell TextAlignment="TextAlignment.End">@cur.Indirect.WholesaleMonthly.ToString("N2")</TableRowCell>
                                    <TableRowCell TextAlignment="TextAlignment.End">@cur.Indirect.RevenueMonthly.ToString("N2")</TableRowCell>
                                    <TableRowCell TextAlignment="TextAlignment.End" TextColor="@(cur.Indirect.MarginMonthly >= 0 ? TextColor.Success : TextColor.Danger)">@cur.Indirect.MarginMonthly.ToString("N2")</TableRowCell>
                                    <TableRowCell TextAlignment="TextAlignment.End">@cur.Indirect.PricedEntitlementCount</TableRowCell>
                                </TableRow>
                            }
                        </TableBody>
                    </Table>
                    @if (estate.Currencies.Count > 1)
                    {
                        <Small TextColor="TextColor.Secondary" Display="Display.Block" Margin="Margin.Is3.FromTop" Class="fw-semibold">By currency (total)</Small>
                        <Table Narrow Hoverable Borderless Margin="Margin.Is1.FromTop">
                            <TableHeader>
                                <TableRow>
                                    <TableHeaderCell>Currency</TableHeaderCell>
                                    <TableHeaderCell TextAlignment="TextAlignment.End">Wholesale cost</TableHeaderCell>
                                    <TableHeaderCell TextAlignment="TextAlignment.End">Repriced revenue</TableHeaderCell>
                                    <TableHeaderCell TextAlignment="TextAlignment.End">Margin</TableHeaderCell>
                                    <TableHeaderCell TextAlignment="TextAlignment.End">Subscriptions</TableHeaderCell>
                                </TableRow>
                            </TableHeader>
                            <TableBody>
                                @foreach (var cur in estate.Currencies)
                                {
                                    <TableRow>
                                        <TableRowCell>@cur.Currency</TableRowCell>
                                        <TableRowCell TextAlignment="TextAlignment.End">@cur.WholesaleMonthly.ToString("N2")</TableRowCell>
                                        <TableRowCell TextAlignment="TextAlignment.End">@cur.RevenueMonthly.ToString("N2")</TableRowCell>
                                        <TableRowCell TextAlignment="TextAlignment.End" TextColor="@(cur.MarginMonthly >= 0 ? TextColor.Success : TextColor.Danger)">@cur.MarginMonthly.ToString("N2")</TableRowCell>
                                        <TableRowCell TextAlignment="TextAlignment.End">@cur.PricedEntitlementCount</TableRowCell>
                                    </TableRow>
                                }
                            </TableBody>
                        </Table>
                    }
                    <Small TextColor="TextColor.Secondary" Display="Display.Block" Margin="Margin.Is2.FromTop">
                        Estimates from offer <b>list</b> pricing × seats and configured repricing mark-ups — not invoiced amounts.
                        Based on @estate.PricedEntitlementCount priced active entitlement(s)@(estate.UnpricedEntitlementCount > 0 ? $"; {estate.UnpricedEntitlementCount} have no resolved offer price and are excluded" : "").@(estate.MixedCurrencies ? " Each currency is listed separately; the source split is broken out below." : "")
                    </Small>
                </CardBody>
            </Card>
        </Column>
    }

    <Column ColumnSize="ColumnSize.Is12.Is8.OnDesktop" Margin="Margin.Is3.FromBottom">
        <Card Shadow="Shadow.Small" Class="h-100">
            <CardBody>
                <Div Flex="Flex.JustifyContent.Between.AlignItems.Center.Wrap" Gap="Gap.Is2" Margin="Margin.Is2.FromBottom">
                    <Div>
                        <Heading Size="HeadingSize.Is5" Margin="Margin.Is0">Customers onboarded</Heading>
                        @if (_monthly.Count > 0 && MonthlyRangeTitle is { Length: > 0 } title)
                        {
                            <Small TextColor="TextColor.Secondary">@title</Small>
                        }
                    </Div>
                    @if (_allMonthly.Count > 1)
                    {
                        <Div Flex="Flex.AlignItems.Center.Wrap" Gap="Gap.Is2">
                            <Select TValue="string" Value="@_rangeFrom" ValueChanged="OnRangeFromChanged" Size="Size.Small" Style="min-width:130px" aria-label="From">
                                @foreach (var m in _allMonthly)
                                {
                                    <SelectItem TValue="string" Value="@m.Key">@m.Label</SelectItem>
                                }
                            </Select>
                            <Select TValue="string" Value="@_rangeTo" ValueChanged="OnRangeToChanged" Size="Size.Small" Style="min-width:130px" aria-label="To">
                                @foreach (var m in _allMonthly)
                                {
                                    <SelectItem TValue="string" Value="@m.Key">@m.Label</SelectItem>
                                }
                            </Select>
                            <Tooltip Text="Show the whole available period" Inline>
                                <Button Size="Size.Small" Color="Color.Secondary" Outline Clicked="ResetRangeToAll">All</Button>
                            </Tooltip>
                        </Div>
                    }
                </Div>
                @if (_monthly.Count > 0)
                {
                    <ApexChart TItem="MonthlyPoint" Options="_monthlyOptions" @ref="_monthlyChart">
                        <ApexPointSeries TItem="MonthlyPoint"
                                         Items="_monthly"
                                         Name="@(HasIndirectOnboarding ? "Direct" : "Customers")"
                                         SeriesType="SeriesType.Line"
                                         XValue="@(p => p.Label)"
                                         YValue="@(p => p.Direct)" />
                        @if (HasIndirectOnboarding)
                        {
                            <ApexPointSeries TItem="MonthlyPoint"
                                             Items="_monthly"
                                             Name="Via resellers (indirect)"
                                             SeriesType="SeriesType.Line"
                                             XValue="@(p => p.Label)"
                                             YValue="@(p => p.Indirect)" />
                        }
                    </ApexChart>
                }
                else if (_overviewLoading)
                {
                    <Div Flex="Flex.AlignItems.Center.JustifyContent.Center" Style="height: 200px;">
                        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading…</span></div>
                    </Div>
                }
                else
                {
                    <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is0">No customer history yet.</Paragraph>
                }
            </CardBody>
        </Card>
    </Column>

    <Column ColumnSize="ColumnSize.Is12.Is4.OnDesktop" Margin="Margin.Is3.FromBottom">
        <Card Shadow="Shadow.Small" Class="h-100">
            <CardBody>
                <Div Flex="Flex.AlignItems.Center" Gap="Gap.Is1" Margin="Margin.Is2.FromBottom">
                    <Heading Size="HeadingSize.Is5" Margin="Margin.Is0">Product mix</Heading>
                    <Tooltip Placement="TooltipPlacement.Top" Multiline Inline
                             Text="Slices are grouped by their catalog product name. A few entries may appear as a raw SKU or product ID when the marketing display name isn't available from the catalog — typically custom/negotiated offers, SKU groups, or products missing from the public catalog.">
                        <Icon Name="@AppIcons.Info" TextColor="TextColor.Secondary" />
                    </Tooltip>
                </Div>
                @if (_indirectProducts.Count > 0)
                {
                    @* Both direct and reseller (indirect) business exists — show a donut for each so the
                       split is clear rather than blending them into one whole-estate chart. *@
                    <Small TextColor="TextColor.Secondary" Display="Display.Block" Class="fw-semibold">Direct (reseller own use)</Small>
                    @if (_directProducts.Count > 0)
                    {
                        <ApexChart TItem="ProductSlice" Title="Active SKUs" Options="_directProductOptions" @ref="_directProductChart">
                            <ApexPointSeries TItem="ProductSlice"
                                             Items="_directProducts"
                                             Name="SKUs"
                                             SeriesType="SeriesType.Donut"
                                             XValue="@(p => p.Product)"
                                             YValue="@(p => p.Count)" />
                        </ApexChart>
                    }
                    else
                    {
                        <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is2.FromBottom">No direct active entitlements.</Paragraph>
                    }
                    <Small TextColor="TextColor.Secondary" Display="Display.Block" Margin="Margin.Is3.FromTop" Class="fw-semibold">Via resellers (indirect)</Small>
                    <ApexChart TItem="ProductSlice" Title="Active SKUs" Options="_indirectProductOptions" @ref="_indirectProductChart">
                        <ApexPointSeries TItem="ProductSlice"
                                         Items="_indirectProducts"
                                         Name="SKUs"
                                         SeriesType="SeriesType.Donut"
                                         XValue="@(p => p.Product)"
                                         YValue="@(p => p.Count)" />
                    </ApexChart>
                }
                else if (_directProducts.Count > 0)
                {
                    @* Direct-only distributor (no reseller estate): the direct mix is the whole estate. *@
                    <ApexChart TItem="ProductSlice" Title="Active SKUs" Options="_directProductOptions" @ref="_directProductChart">
                        <ApexPointSeries TItem="ProductSlice"
                                         Items="_directProducts"
                                         Name="SKUs"
                                         SeriesType="SeriesType.Donut"
                                         XValue="@(p => p.Product)"
                                         YValue="@(p => p.Count)" />
                    </ApexChart>
                }
                else if (_entitlementsLoading)
                {
                    <Div Flex="Flex.AlignItems.Center.JustifyContent.Center" Style="height: 200px;">
                        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading…</span></div>
                    </Div>
                }
                else
                {
                    <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is0">No active entitlements yet.</Paragraph>
                }
            </CardBody>
        </Card>
    </Column>

    <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop" Margin="Margin.Is3.FromBottom">
        <Card Shadow="Shadow.Small" Class="h-100">
            <CardBody>
                <Div Flex="Flex.JustifyContent.Between.AlignItems.Start.Wrap" Gap="Gap.Is2" Margin="Margin.Is2.FromBottom">
                    <Div>
                        <Heading Size="HeadingSize.Is5" Margin="Margin.Is0">Onboarding by reseller</Heading>
                        <Small TextColor="TextColor.Secondary" Display="Display.Block">
                            Which reseller onboarded which customers in the selected month. "Direct" = account-owned.
                        </Small>
                    </Div>
                    @if (_onboardMonths.Count > 0)
                    {
                        <Select TValue="string" Value="@_onboardMonth" ValueChanged="OnOnboardMonthChanged" Size="Size.Small" Style="max-width:170px" aria-label="Month">
                            @foreach (var m in _onboardMonths)
                            {
                                <SelectItem TValue="string" Value="@m">@MonthLabel(m)</SelectItem>
                            }
                        </Select>
                    }
                </Div>
                @if (_onboardBars.Count > 0)
                {
                    <ApexChart TItem="OnboardBar" Options="_onboardOptions" @ref="_onboardChart">
                        <ApexPointSeries TItem="OnboardBar" Items="_onboardBars" Name="Customers"
                                         SeriesType="SeriesType.Bar"
                                         XValue="@(b => b.Reseller)" YValue="@(b => b.Count)" />
                    </ApexChart>
                    <div style="max-height:150px; overflow:auto" class="mt-2">
                        @foreach (var g in OnboardDetail())
                        {
                            <Small Display="Display.Block">
                                <strong>@g.Key</strong>: @string.Join(", ", g.Select(o => o.CustomerName))
                            </Small>
                        }
                    </div>
                }
                else if (_entitlementsLoading)
                {
                    <Div Flex="Flex.AlignItems.Center.JustifyContent.Center" Style="height:200px;">
                        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading…</span></div>
                    </Div>
                }
                else
                {
                    <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is0">
                        No onboarding data yet. Attribution appears once the background read-model has synced.
                    </Paragraph>
                }
            </CardBody>
        </Card>
    </Column>

    <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop" Margin="Margin.Is3.FromBottom">
        <Card Shadow="Shadow.Small" Class="h-100">
            <CardBody>
                <Div Flex="Flex.JustifyContent.Between.AlignItems.Start.Wrap" Gap="Gap.Is2" Margin="Margin.Is2.FromBottom">
                    <Div>
                        <Heading Size="HeadingSize.Is5" Margin="Margin.Is0">Partner links established</Heading>
                        <Small TextColor="TextColor.Secondary" Display="Display.Block">
                            When channel partner links were created, month by month. Pick a month to see with whom.
                        </Small>
                    </Div>
                    @if (_linkMonths.Count > 0)
                    {
                        <Select TValue="string" Value="@_linkMonth" ValueChanged="OnLinkMonthChanged" Size="Size.Small" Style="max-width:170px" aria-label="Month">
                            @foreach (var m in _linkMonths)
                            {
                                <SelectItem TValue="string" Value="@m">@MonthLabel(m)</SelectItem>
                            }
                        </Select>
                    }
                </Div>
                @if (_linkSeries.Count > 0)
                {
                    <ApexChart TItem="LinkMonthPoint" Options="_linkOptions" @ref="_linkChart">
                        <ApexPointSeries TItem="LinkMonthPoint" Items="_linkSeries" Name="Links established"
                                         SeriesType="SeriesType.Bar"
                                         XValue="@(p => p.Label)" YValue="@(p => p.Count)" />
                    </ApexChart>
                    <div style="max-height:150px; overflow:auto" class="mt-2">
                        <Small TextColor="TextColor.Secondary" Display="Display.Block" Margin="Margin.Is1.FromBottom">
                            Established in @(_linkMonth is null ? "—" : MonthLabel(_linkMonth)):
                        </Small>
                        @{
                            var linkDetail = LinkDetail();
                        }
                        @if (linkDetail.Count > 0)
                        {
                            @foreach (var l in linkDetail)
                            {
                                <Badge Color="@LinkStateColor(l.LinkState)" Margin="Margin.Is1">@l.Reseller</Badge>
                            }
                        }
                        else
                        {
                            <Small TextColor="TextColor.Secondary">No links established this month.</Small>
                        }
                    </div>
                }
                else if (_entitlementsLoading)
                {
                    <Div Flex="Flex.AlignItems.Center.JustifyContent.Center" Style="height:200px;">
                        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading…</span></div>
                    </Div>
                }
                else
                {
                    <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is0">
                        No channel partner links established yet.
                    </Paragraph>
                }
            </CardBody>
        </Card>
    </Column>

    <Column ColumnSize="ColumnSize.Is12" Margin="Margin.Is3.FromBottom">
        <Card Shadow="Shadow.Small">
            <CardBody>
                <Div Flex="Flex.JustifyContent.Between.AlignItems.Start.Wrap" Gap="Gap.Is2" Margin="Margin.Is2.FromBottom">
                    <Div>
                        <Heading Size="HeadingSize.Is5" Margin="Margin.Is0">Top indirect resellers</Heading>
                        <Small TextColor="TextColor.Secondary" Display="Display.Block">
                            @(_resellerMetric switch
                            {
                                "avg" => "Ranked by average active seats per customer — a fairer comparison when one reseller dwarfs the rest. Parentheses show the customer count; each bar is labelled with its exact figure.",
                                "revenue" => "Ranked by estimated monthly revenue (repriced end-customer billing, from list pricing + repricing mark-ups). Parentheses show the customer count; each bar is labelled with its exact figure.",
                                _ => "Ranked by total active seats. Parentheses show the customer count; each bar is labelled with its exact seat count."
                            })
                        </Small>
                    </Div>
                    @if (_resellers.Count > 0)
                    {
                        <Select TValue="string" Value="@_resellerMetric" ValueChanged="OnResellerMetricChanged" Size="Size.Small" Style="max-width:220px" aria-label="Rank by">
                            <SelectItem TValue="string" Value="@("seats")">Total seats</SelectItem>
                            <SelectItem TValue="string" Value="@("avg")">Avg seats / customer</SelectItem>
                            <SelectItem TValue="string" Value="@("revenue")">Monthly revenue</SelectItem>
                        </Select>
                    }
                </Div>
                @if (_resellers.Count > 0)
                {
                    <ApexChart TItem="ResellerSlice" Title="@_resellerTitle" Options="_resellerOptions" @ref="_resellerChart">
                        <ApexPointSeries TItem="ResellerSlice"
                                         Items="_resellerView"
                                         Name="@_resellerSeriesName"
                                         SeriesType="SeriesType.Bar"
                                         XValue="@(r => $"{r.Reseller} ({r.Customers:0})")"
                                         YValue="@(r => _resellerMetric switch { "avg" => r.AvgSeats, "revenue" => r.Revenue, _ => r.Seats })" />
                    </ApexChart>
                }
                else if (_entitlementsLoading)
                {
                    <Div Flex="Flex.AlignItems.Center.JustifyContent.Center" Style="height: 200px;">
                        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading…</span></div>
                    </Div>
                }
                else
                {
                    <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is0">
                        No indirect resellers with customers yet. When a linked reseller owns downstream
                        customers, they'll appear here ranked by total active seats.
                    </Paragraph>
                }
            </CardBody>
        </Card>
    </Column>

    <Column ColumnSize="ColumnSize.Is12" Margin="Margin.Is3.FromBottom">
        <Card Shadow="Shadow.Small">
            <CardBody>
                <Div Flex="Flex.JustifyContent.Between.AlignItems.Center.Wrap" Gap="Gap.Is2" Margin="Margin.Is2.FromBottom">
                    <Div>
                        <Heading Size="HeadingSize.Is5" Margin="Margin.Is0">GCP &amp; Marketplace consumption (billed)</Heading>
                        <Small TextColor="TextColor.Secondary">
                            Actual spend from the Cloud Billing → BigQuery export (last month) — real billed
                            figures, distinct from the list-price estimate above.
                        </Small>
                    </Div>
                    <Button Type="ButtonType.Link" To="/billing/spend" Size="Size.Small" Color="Color.Primary" Class="btn-link text-decoration-none">
                        Spend trends <Icon Name="@AppIcons.ArrowForward" Class="ms-1" />
                    </Button>
                </Div>

                @if (_spendUnconfigured)
                {
                    <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is0">The BigQuery billing-export sync isn't configured.</Paragraph>
                }
                else if (_spendLoading)
                {
                    <Div Flex="Flex.AlignItems.Center.JustifyContent.Center" Style="height: 200px;">
                        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading…</span></div>
                    </Div>
                }
                else if (_spendBars.Count > 0)
                {
                    <Div Flex="Flex.Wrap" Gap="Gap.Is5" Margin="Margin.Is2.FromBottom">
                        @foreach (var t in _spendTotals)
                        {
                            <Div>
                                <Small TextColor="TextColor.Secondary" Display="Display.Block" Class="fw-semibold">Total billed (@t.Currency)</Small>
                                <Heading Size="HeadingSize.Is4" Margin="Margin.Is0">@t.Currency @t.Total.ToString("N2")</Heading>
                            </Div>
                        }
                    </Div>
                    <ApexChart TItem="SpendBar" Title="@_spendChartTitle" Options="_spendOptions" @ref="_spendChart">
                        <ApexPointSeries TItem="SpendBar"
                                         Items="_spendBars"
                                         Name="Billed spend"
                                         SeriesType="SeriesType.Bar"
                                         XValue="@(b => b.Reseller)"
                                         YValue="@(b => b.Cost)" />
                    </ApexChart>
                    <Small TextColor="TextColor.Secondary" Display="Display.Block" Margin="Margin.Is2.FromTop">
                        Billed spend attributed to each customer's owning channel partner (Direct = account-owned).
                        @if (_spendAsOf is { } asOf)
                        {
                            <span>As of @asOf.LocalDateTime.ToString("g").</span>
                        }
                    </Small>
                }
                else
                {
                    <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is0">No billed spend recorded yet.</Paragraph>
                }
            </CardBody>
        </Card>
    </Column>
</Row>

@code {
    private record SummaryCard(string Key, string Label, string Value, string Icon, TextColor Color, bool Ready);
    private record MonthlyPoint(string Key, string Label, decimal Direct, decimal Indirect);
    private record ProductSlice(string Product, decimal Count);
    private record ResellerSlice(string Reseller, decimal Customers, decimal Seats, decimal AvgSeats, decimal Revenue);
    private record OnboardBar(string Reseller, decimal Count);
    private record LinkMonthPoint(string Key, string Label, decimal Count);
    private record SpendBar(string Reseller, decimal Cost);
    private record SpendTotal(string Currency, decimal Total);

    // Cascaded from MainLayout so the charts can follow the app's light/dark theme. ApexCharts renders
    // its own axis/legend/title text in a fixed colour that ignores the Bootstrap colour mode, so without this
    // the labels stay dark and become invisible on the dark background.
    [CascadingParameter(Name = "IsDarkMode")]
    private bool IsDarkMode { get; set; }

    private bool? _appliedDarkMode;
    private ApexChart<MonthlyPoint>? _monthlyChart;
    private ApexChart<ProductSlice>? _directProductChart;
    private ApexChart<ProductSlice>? _indirectProductChart;
    private ApexChart<ResellerSlice>? _resellerChart;
    private readonly ApexChartOptions<MonthlyPoint> _monthlyOptions = new();
    private readonly ApexChartOptions<ProductSlice> _directProductOptions = new();
    private readonly ApexChartOptions<ProductSlice> _indirectProductOptions = new();
    private readonly ApexChartOptions<ResellerSlice> _resellerOptions = new()
    {
        PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { Horizontal = true } },
        // Print the exact figure on every bar so the tiny resellers stay readable even when a single
        // reseller (e.g. a large EDU tenant) is orders of magnitude bigger and dwarfs the bar lengths.
        DataLabels = new DataLabels
        {
            Enabled = true,
            Formatter = "function (val) { return val === null ? '' : Number(val).toLocaleString(undefined, { maximumFractionDigits: 1 }); }"
        }
    };

    // "seats" = rank by total active seats; "avg" = rank by average active seats per customer;
    // "revenue" = rank by estimated monthly repriced revenue.
    private string _resellerMetric = "seats";
    private string _resellerTitle => _resellerMetric switch
    {
        "avg" => "Avg seats per customer",
        "revenue" => "Monthly revenue per reseller",
        _ => "Seats per reseller"
    };
    private string _resellerSeriesName => _resellerMetric switch
    {
        "avg" => "Avg seats / customer",
        "revenue" => "Monthly revenue",
        _ => "Seats"
    };

    // The metric-ordered slice the chart actually renders (mirrors the _allMonthly/_monthly pattern so
    // ApexChart.UpdateSeriesAsync picks up the change without a full data reload).
    private readonly List<ResellerSlice> _resellerView = [];

    private DashboardOverview? _overview;
    private DashboardSummary? _data;
    private DashboardRefreshStatus? _status;
    private bool _overviewLoading = true;
    private bool _entitlementsLoading = true;
    // The full onboarding history from the backend (oldest first) and the range-filtered subset the
    // chart renders. The From/To selectors narrow the visible window without another backend call.
    private readonly List<MonthlyPoint> _allMonthly = [];
    private readonly List<MonthlyPoint> _monthly = [];
    private string? _rangeFrom;
    private string? _rangeTo;
    private readonly List<ProductSlice> _products = [];
    private readonly List<ProductSlice> _directProducts = [];
    private readonly List<ProductSlice> _indirectProducts = [];
    private readonly List<ResellerSlice> _resellers = [];

    // "Onboarding by reseller" (left) + "Partner links established" (right) visualizations.
    private readonly List<DashboardOnboardedCustomer> _onboarded = [];
    private readonly List<DashboardEstablishedLink> _links = [];
    private readonly List<string> _onboardMonths = [];
    private readonly List<string> _linkMonths = [];
    private string? _onboardMonth;
    private string? _linkMonth;
    private ApexChart<OnboardBar>? _onboardChart;
    private ApexChart<LinkMonthPoint>? _linkChart;
    private readonly List<OnboardBar> _onboardBars = [];
    private readonly List<LinkMonthPoint> _linkSeries = [];
    private readonly ApexChartOptions<OnboardBar> _onboardOptions = new()
    {
        PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { Horizontal = true } },
        DataLabels = new DataLabels { Enabled = true }
    };
    private readonly ApexChartOptions<LinkMonthPoint> _linkOptions = new()
    {
        DataLabels = new DataLabels { Enabled = true }
    };

    // Actual billed GCP/Marketplace spend (BigQuery cost export) rolled up per owning reseller.
    private ApexChart<SpendBar>? _spendChart;
    private readonly ApexChartOptions<SpendBar> _spendOptions = new()
    {
        PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { Horizontal = true } },
        DataLabels = new DataLabels
        {
            Enabled = true,
            Formatter = "function (val) { return val === null ? '' : Number(val).toLocaleString(undefined, { maximumFractionDigits: 0 }); }"
        }
    };
    private IReadOnlyList<ResellerSpend> _spendResellers = [];
    private readonly List<SpendBar> _spendBars = [];
    private readonly List<SpendTotal> _spendTotals = [];
    private DateTimeOffset? _spendAsOf;
    private bool _spendLoading = true;
    private bool _spendUnconfigured;
    // The bar chart plots one currency (the largest by total); the headline lists every currency's total.
    private string _spendChartTitle => _spendTotals.Count > 0
        ? $"Billed spend by reseller ({_spendTotals[0].Currency})"
        : "Billed spend by reseller";

    private readonly CancellationTokenSource _cts = new();

    // How often to poll the background-refresh status (and, while a run is in progress, re-pull the
    // summary so the figures update live). Cheap: status is a tiny cached object and the summary is
    // served straight from Redis.
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(30);

    // The customer count + onboarding chart come from the cheap overview (phase 1); the entitlement
    // cards + product mix come from the slower summary (phase 2). Each shows a spinner until ready.
    private SummaryCard[] Cards =>
    [
        new("customers", "Customers", (_overview?.CustomerCount ?? _data?.CustomerCount ?? 0).ToString(),
            AppIcons.Business, TextColor.Primary, _overview is not null || _data is not null),
        new("skus", "Active SKUs", (_data?.ActiveEntitlementCount ?? 0).ToString(),
            AppIcons.Inventory, TextColor.Success, _data is not null),
        new("links", "Channel links", (_overview?.ChannelLinkCount ?? 0).ToString(),
            AppIcons.Hub, TextColor.Info, _overview is not null),
        new("suspended", "Suspended", (_data?.SuspendedEntitlementCount ?? 0).ToString(),
            AppIcons.PauseCircle, TextColor.Warning, _data is not null),
    ];

    // Tracks which KPI cards have their details panel expanded (keyed by SummaryCard.Key).
    private readonly HashSet<string> _expanded = [];

    // Customer estate figures for the KPI details. Direct customers come from the cheap overview; the
    // indirect (reseller-owned) estate is a separate set surfaced by the slower, background-computed
    // summary, so the total is the two added together (they never overlap).
    private bool IndirectLoaded => _data is not null;
    private int DirectEstate => _overview?.CustomerCount ?? _data?.CustomerCount ?? 0;
    private int IndirectEstate => _data?.IndirectCustomerCount ?? 0;
    private int TotalEstate => DirectEstate + IndirectEstate;

    private bool IsExpanded(string key) => _expanded.Contains(key);

    private void ToggleDetails(string key)
    {
        if (!_expanded.Add(key))
        {
            _expanded.Remove(key);
        }
    }

    // Title-cases a Channel API enum value (e.g. "ACTIVE" -> "Active") for the link-state breakdown.
    private static string Humanize(string value) =>
        string.IsNullOrEmpty(value) ? value : char.ToUpperInvariant(value[0]) + value[1..].ToLowerInvariant();

    // Total entitlements across states — drives the onboarding checklist's "purchase" step.
    private int EntitlementCount =>
        (_data?.ActiveEntitlementCount ?? 0)
        + (_data?.TrialEntitlementCount ?? 0)
        + (_data?.SuspendedEntitlementCount ?? 0);

    // Keep the ApexCharts theme in step with the app's light/dark mode. Runs whenever the cascaded
    // IsDarkMode flips; the options carry the right mode up front too, so charts created later (once
    // their data lands) render correctly without a toggle.
    protected override async Task OnParametersSetAsync()
    {
        if (_appliedDarkMode == IsDarkMode)
        {
            return;
        }

        _appliedDarkMode = IsDarkMode;
        var mode = IsDarkMode ? Mode.Dark : Mode.Light;
        _monthlyOptions.Theme = new Theme { Mode = mode };
        _directProductOptions.Theme = new Theme { Mode = mode };
        _indirectProductOptions.Theme = new Theme { Mode = mode };
        _resellerOptions.Theme = new Theme { Mode = mode };
        _onboardOptions.Theme = new Theme { Mode = mode };
        _linkOptions.Theme = new Theme { Mode = mode };
        _spendOptions.Theme = new Theme { Mode = mode };

        if (_monthlyChart is not null)
        {
            await _monthlyChart.UpdateOptionsAsync(redrawPaths: true, animate: false, updateSyncedCharts: false);
        }

        if (_directProductChart is not null)
        {
            await _directProductChart.UpdateOptionsAsync(redrawPaths: true, animate: false, updateSyncedCharts: false);
        }

        if (_indirectProductChart is not null)
        {
            await _indirectProductChart.UpdateOptionsAsync(redrawPaths: true, animate: false, updateSyncedCharts: false);
        }

        if (_resellerChart is not null)
        {
            await _resellerChart.UpdateOptionsAsync(redrawPaths: true, animate: false, updateSyncedCharts: false);
        }

        if (_onboardChart is not null)
        {
            await _onboardChart.UpdateOptionsAsync(redrawPaths: true, animate: false, updateSyncedCharts: false);
        }

        if (_linkChart is not null)
        {
            await _linkChart.UpdateOptionsAsync(redrawPaths: true, animate: false, updateSyncedCharts: false);
        }

        if (_spendChart is not null)
        {
            await _spendChart.UpdateOptionsAsync(redrawPaths: true, animate: false, updateSyncedCharts: false);
        }
    }

    // Load after the first interactive render so the API calls run once on the live circuit
    // (avoiding a canceled prerender request), mirroring the other data-heavy pages.
    protected override async Task OnAfterRenderAsync(bool firstRender)    {
        if (!firstRender)
        {
            return;
        }

        // Capture the token once up front: the two-phase load can run for tens of seconds, and if the
        // circuit/component tears down meanwhile the source is disposed — reading _cts.Token again (or
        // letting HttpClient register on it) would then throw ObjectDisposedException.
        CancellationToken token;
        try
        {
            token = _cts.Token;
        }
        catch (ObjectDisposedException)
        {
            return;
        }

        // Phase 1 then phase 2: the cheap overview renders the customer count + onboarding chart
        // immediately while the quota-bound entitlement aggregation streams in afterwards.
        await LoadOverviewAsync(token);
        StateHasChanged();
        await LoadSummaryAsync(token);
        StateHasChanged();
        await LoadSpendAsync(token);
        StateHasChanged();

        // Pull the initial refresh status, then keep the page live: poll every 30s so the figures
        // (and the "Updated X ago" / "Refreshing…" indicator) track the background refresher.
        await LoadStatusAsync(token);
        StateHasChanged();
        _ = PollLoopAsync(token);
    }

    // Polls the refresh status on a fixed cadence and, while a background run is in progress or one
    // has just finished, re-pulls the summary so the product mix + cards redraw without a page reload.
    private async Task PollLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(PollInterval);
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                DashboardRefreshStatus? status;
                try
                {
                    status = await Api.GetDashboardStatusAsync(cancellationToken);
                }
                catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
                {
                    break;
                }
                catch
                {
                    // Transient; keep the last status and try again next tick.
                    continue;
                }

                var previous = _status;
                _status = status;

                // Re-pull the (cache-served) summary while a run is in progress to show partials
                // filling in, and once more when a run completes to land on the final figures.
                var completedChanged = status?.LastCompletedUtc != previous?.LastCompletedUtc;
                if (status is { IsRunning: true } || completedChanged)
                {
                    await RefreshSummaryAsync(cancellationToken);
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            // Circuit/component torn down — stop polling.
        }
    }

    // Loads the full onboarding history into _allMonthly, initialises/repairs the selected From–To
    // range against the available months (defaulting to the whole period), then applies the filter.
    private void SetMonthlySeries(IReadOnlyList<DashboardMonthlyPoint> points)
    {
        _allMonthly.Clear();
        foreach (var p in points)
        {
            var key = string.IsNullOrEmpty(p.MonthKey) ? p.Month : p.MonthKey;
            var label = p.Year > 0 ? $"{p.Month} {p.Year}" : p.Month;
            _allMonthly.Add(new MonthlyPoint(key, label, p.DirectCustomers, p.IndirectCustomers));
        }

        var keys = _allMonthly.Select(m => m.Key).ToList();
        if (keys.Count == 0)
        {
            _rangeFrom = _rangeTo = null;
        }
        else
        {
            // Keep any user-chosen range if it's still valid; otherwise default to the whole period.
            if (_rangeFrom is null || !keys.Contains(_rangeFrom)) _rangeFrom = keys[0];
            if (_rangeTo is null || !keys.Contains(_rangeTo)) _rangeTo = keys[^1];
            if (string.CompareOrdinal(_rangeFrom, _rangeTo) > 0) (_rangeFrom, _rangeTo) = (keys[0], keys[^1]);
        }

        ApplyMonthlyRange();
    }

    // Filters _allMonthly into _monthly (the chart's series) by the selected From–To month keys.
    private void ApplyMonthlyRange()
    {
        _monthly.Clear();
        foreach (var m in _allMonthly)
        {
            if ((_rangeFrom is null || string.CompareOrdinal(m.Key, _rangeFrom) >= 0)
                && (_rangeTo is null || string.CompareOrdinal(m.Key, _rangeTo) <= 0))
            {
                _monthly.Add(m);
            }
        }
    }

    // Caption under the chart title, e.g. "Feb 2023 – Jul 2026" (or a single month).
    private string MonthlyRangeTitle =>
        _monthly.Count == 0 ? ""
        : _monthly[0].Label == _monthly[^1].Label ? _monthly[0].Label
        : $"{_monthly[0].Label} – {_monthly[^1].Label}";

    // Show a second (indirect) onboarding line only when there is reseller-owned onboarding history, so a
    // direct-only distributor keeps a single clean line. Based on the whole dataset, not the filtered
    // range, so the series set stays stable as the user narrows From/To.
    private bool HasIndirectOnboarding => _allMonthly.Any(m => m.Indirect > 0);

    private Task OnRangeFromChanged(string? value)
    {
        _rangeFrom = value;
        if (_rangeFrom is not null && _rangeTo is not null && string.CompareOrdinal(_rangeFrom, _rangeTo) > 0)
        {
            _rangeTo = _rangeFrom;
        }
        return UpdateMonthlyRangeAsync();
    }

    private Task OnRangeToChanged(string? value)
    {
        _rangeTo = value;
        if (_rangeFrom is not null && _rangeTo is not null && string.CompareOrdinal(_rangeTo, _rangeFrom) < 0)
        {
            _rangeFrom = _rangeTo;
        }
        return UpdateMonthlyRangeAsync();
    }

    private Task ResetRangeToAll()
    {
        var keys = _allMonthly.Select(m => m.Key).ToList();
        if (keys.Count > 0)
        {
            _rangeFrom = keys[0];
            _rangeTo = keys[^1];
        }
        return UpdateMonthlyRangeAsync();
    }

    private async Task UpdateMonthlyRangeAsync()
    {
        ApplyMonthlyRange();
        if (_monthlyChart is not null)
        {
            await _monthlyChart.UpdateSeriesAsync();
        }
    }

    private static ResellerSlice ToResellerSlice(DashboardResellerCustomers reseller) =>
        new(reseller.Reseller, reseller.CustomerCount, reseller.SeatCount,
            reseller.CustomerCount > 0 ? (decimal)reseller.SeatCount / reseller.CustomerCount : 0,
            // Revenue = wholesale cost + rebilling margin (what the reseller's end customers are billed).
            reseller.WholesaleMonthly + reseller.MarginMonthly);

    // Re-populate the chart's bound list ordered by the selected metric (highest first).
    private void ApplyResellerMetric()
    {
        _resellerView.Clear();
        var ordered = _resellerMetric switch
        {
            "avg" => _resellers.OrderByDescending(r => r.AvgSeats).ThenBy(r => r.Reseller),
            "revenue" => _resellers.OrderByDescending(r => r.Revenue).ThenBy(r => r.Reseller),
            _ => _resellers.OrderByDescending(r => r.Seats).ThenBy(r => r.Reseller)
        };
        _resellerView.AddRange(ordered);
    }

    private async Task OnResellerMetricChanged(string metric)
    {
        _resellerMetric = metric;
        ApplyResellerMetric();
        if (_resellerChart is not null)
        {
            await _resellerChart.UpdateSeriesAsync();
        }
    }

    // --- Onboarding by reseller (left card) ---

    private void SetOnboardingByReseller(IReadOnlyList<DashboardOnboardedCustomer> data)
    {
        _onboarded.Clear();
        _onboarded.AddRange(data);
        _onboardMonths.Clear();
        _onboardMonths.AddRange(_onboarded.Select(o => o.MonthKey).Distinct()
            .OrderByDescending(m => m, StringComparer.Ordinal));
        if (_onboardMonth is null || !_onboardMonths.Contains(_onboardMonth))
        {
            _onboardMonth = _onboardMonths.FirstOrDefault();
        }
        ApplyOnboardMonth();
    }

    // Bars = customers each reseller onboarded in the selected month (highest first).
    private void ApplyOnboardMonth()
    {
        _onboardBars.Clear();
        if (_onboardMonth is null)
        {
            return;
        }
        _onboardBars.AddRange(_onboarded
            .Where(o => o.MonthKey == _onboardMonth)
            .GroupBy(o => o.Reseller)
            .Select(g => new OnboardBar(g.Key, g.Count()))
            .OrderByDescending(b => b.Count).ThenBy(b => b.Reseller));
    }

    // Per-reseller customer names for the selected month (the "which customer" detail under the chart).
    private IEnumerable<IGrouping<string, DashboardOnboardedCustomer>> OnboardDetail() =>
        _onboardMonth is null
            ? []
            : _onboarded.Where(o => o.MonthKey == _onboardMonth)
                .GroupBy(o => o.Reseller)
                .OrderByDescending(g => g.Count()).ThenBy(g => g.Key);

    private async Task OnOnboardMonthChanged(string month)
    {
        _onboardMonth = month;
        ApplyOnboardMonth();
        if (_onboardChart is not null)
        {
            await _onboardChart.UpdateSeriesAsync();
        }
    }

    // --- Partner links established (right card) ---

    private void SetEstablishedLinks(IReadOnlyList<DashboardEstablishedLink> data)
    {
        _links.Clear();
        _links.AddRange(data);
        _linkMonths.Clear();
        _linkMonths.AddRange(_links.Select(l => l.MonthKey).Distinct()
            .OrderByDescending(m => m, StringComparer.Ordinal));
        if (_linkMonth is null || !_linkMonths.Contains(_linkMonth))
        {
            _linkMonth = _linkMonths.FirstOrDefault();
        }

        // Column series: links established per month across the full contiguous span (fills empty months).
        _linkSeries.Clear();
        var byMonth = _links.GroupBy(l => l.MonthKey).ToDictionary(g => g.Key, g => g.Count());
        if (byMonth.Count > 0)
        {
            var keys = byMonth.Keys.OrderBy(k => k, StringComparer.Ordinal).ToList();
            if (TryParseMonth(keys[0], out var start) && TryParseMonth(keys[^1], out var end))
            {
                for (var m = start; m <= end; m = m.AddMonths(1))
                {
                    var key = m.ToString("yyyy-MM", System.Globalization.CultureInfo.InvariantCulture);
                    _linkSeries.Add(new LinkMonthPoint(
                        key,
                        m.ToString("MMM yyyy", System.Globalization.CultureInfo.InvariantCulture),
                        byMonth.GetValueOrDefault(key)));
                }
            }
        }
    }

    // The resellers whose partner link was established in the selected month (the "with whom" detail).
    private List<DashboardEstablishedLink> LinkDetail() =>
        _linkMonth is null
            ? []
            : _links.Where(l => l.MonthKey == _linkMonth).OrderBy(l => l.Reseller).ToList();

    private void OnLinkMonthChanged(string month) => _linkMonth = month;

    private static bool TryParseMonth(string key, out DateTime firstOfMonth) =>
        DateTime.TryParseExact(key + "-01", "yyyy-MM-dd",
            System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out firstOfMonth);

    private static string MonthLabel(string key) =>
        TryParseMonth(key, out var d)
            ? d.ToString("MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)
            : key;

    private static Color LinkStateColor(string? state) => state?.ToUpperInvariant() switch
    {
        "ACTIVE" => Color.Success,
        "SUSPENDED" => Color.Warning,
        "INVITED" => Color.Info,
        _ => Color.Secondary
    };

    private async Task LoadOverviewAsync(CancellationToken cancellationToken)
    {
        _overviewLoading = true;
        try
        {
            _overview = await Api.GetDashboardOverviewAsync(cancellationToken);

            SetMonthlySeries(_overview?.CustomersOnboarded ?? []);
        }
        catch (Exception)
        {
            // The overview is only a fast-path optimisation: the summary (phase 2) carries the same
            // customer count + onboarding data, so a failure here (e.g. a transient quota 429) is
            // swallowed silently and phase 2 fills everything in.
        }
        finally
        {
            _overviewLoading = false;
        }
    }

    private async Task LoadSummaryAsync(CancellationToken cancellationToken)
    {
        _entitlementsLoading = true;
        try
        {
            _data = await Api.GetDashboardSummaryAsync(cancellationToken);

            // The summary carries authoritative onboarding data too; refresh the chart from it in
            // case the overview cache lagged behind.
            SetMonthlySeries(_data?.CustomersOnboarded ?? []);

            _products.Clear();
            foreach (var slice in _data?.ProductMix ?? [])
            {
                _products.Add(new ProductSlice(slice.Product, slice.Count));
            }

            _directProducts.Clear();
            foreach (var slice in _data?.DirectProductMix ?? [])
            {
                _directProducts.Add(new ProductSlice(slice.Product, slice.Count));
            }

            _indirectProducts.Clear();
            foreach (var slice in _data?.IndirectProductMix ?? [])
            {
                _indirectProducts.Add(new ProductSlice(slice.Product, slice.Count));
            }

            _resellers.Clear();
            foreach (var reseller in _data?.TopIndirectResellers ?? [])
            {
                _resellers.Add(ToResellerSlice(reseller));
            }
            ApplyResellerMetric();
            SetOnboardingByReseller(_data?.OnboardedByReseller ?? []);
            SetEstablishedLinks(_data?.EstablishedLinks ?? []);
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            // Benign: the entitlement aggregation is slow and the request was cancelled/disposed.
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load dashboard: {ex.Message}", Severity.Error);
        }
        finally
        {
            _entitlementsLoading = false;
        }
    }

    // Loads actual billed GCP/Marketplace spend (BigQuery cost export) rolled up per reseller. The
    // headline lists every currency's total; the bar chart plots the largest currency by total.
    private async Task LoadSpendAsync(CancellationToken cancellationToken)
    {
        try
        {
            var result = await Api.GetResellerSpendAsync(1, cancellationToken);
            _spendUnconfigured = result?.Unconfigured ?? false;
            _spendResellers = result?.Resellers ?? [];
            _spendAsOf = result?.AsOf;

            _spendTotals.Clear();
            _spendTotals.AddRange(_spendResellers
                .GroupBy(r => r.Currency)
                .Select(g => new SpendTotal(g.Key, g.Sum(x => x.Cost)))
                .OrderByDescending(t => t.Total));

            _spendBars.Clear();
            if (_spendTotals.Count > 0)
            {
                var primary = _spendTotals[0].Currency;
                _spendBars.AddRange(_spendResellers
                    .Where(r => r.Currency == primary)
                    .OrderByDescending(r => r.Cost)
                    .Select(r => new SpendBar(
                        string.IsNullOrEmpty(r.OwningLinkId) ? "Direct" : (r.ResellerName ?? r.OwningLinkId!),
                        r.Cost)));
            }
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            // Circuit torn down mid-load — leave the panel in its loading/empty state.
        }
        catch
        {
            _spendResellers = [];
        }
        finally
        {
            _spendLoading = false;
        }
    }

    // Quiet re-pull used by the polling loop: updates the cards/charts from the cached summary without
    // toggling the loading spinners or showing error snackbars (polling is best-effort).
    private async Task RefreshSummaryAsync(CancellationToken cancellationToken)
    {
        try
        {
            var data = await Api.GetDashboardSummaryAsync(cancellationToken);
            if (data is null)
            {
                return;
            }

            _data = data;

            SetMonthlySeries(data.CustomersOnboarded);

            _products.Clear();
            foreach (var slice in data.ProductMix)
            {
                _products.Add(new ProductSlice(slice.Product, slice.Count));
            }

            _directProducts.Clear();
            foreach (var slice in data.DirectProductMix)
            {
                _directProducts.Add(new ProductSlice(slice.Product, slice.Count));
            }

            _indirectProducts.Clear();
            foreach (var slice in data.IndirectProductMix)
            {
                _indirectProducts.Add(new ProductSlice(slice.Product, slice.Count));
            }

            _resellers.Clear();
            foreach (var reseller in data.TopIndirectResellers)
            {
                _resellers.Add(ToResellerSlice(reseller));
            }
            ApplyResellerMetric();
            SetOnboardingByReseller(data.OnboardedByReseller);
            SetEstablishedLinks(data.EstablishedLinks);
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            // Benign teardown.
        }
        catch
        {
            // Keep the last good render; the next tick will try again.
        }
    }

    private async Task LoadStatusAsync(CancellationToken cancellationToken)
    {
        try
        {
            _status = await Api.GetDashboardStatusAsync(cancellationToken);
        }
        catch
        {
            // The status indicator is purely informational; ignore failures.
        }
    }

    // Renders "just now" / "5 min ago" / "2 h ago" / "3 d ago" from a UTC timestamp.
    private static string FormatAgo(DateTimeOffset whenUtc)
    {
        var delta = DateTimeOffset.UtcNow - whenUtc;
        if (delta < TimeSpan.Zero)
        {
            delta = TimeSpan.Zero;
        }

        if (delta.TotalSeconds < 60)
        {
            return "just now";
        }
        if (delta.TotalMinutes < 60)
        {
            return $"{(int)delta.TotalMinutes} min ago";
        }
        if (delta.TotalHours < 24)
        {
            return $"{(int)delta.TotalHours} h ago";
        }
        return $"{(int)delta.TotalDays} d ago";
    }

    // "next refresh in X" caption — only while the background refresher is enabled and idle (during a
    // run we already show "Refreshing…"). Null when disabled / unknown so the caller appends nothing.
    private string? NextRefreshText
    {
        get
        {
            if (_status is not { Enabled: true, IsRunning: false } || _status.NextRefreshUtc is not { } next)
            {
                return null;
            }
            var delta = next - DateTimeOffset.UtcNow;
            return delta <= TimeSpan.Zero ? "next refresh due" : $"next refresh in {FormatIn(delta)}";
        }
    }

    private static string FormatIn(TimeSpan delta)
    {
        if (delta.TotalSeconds < 60)
        {
            return "under a min";
        }
        if (delta.TotalMinutes < 60)
        {
            return $"{(int)delta.TotalMinutes} min";
        }
        if (delta.TotalHours < 24)
        {
            return $"{(int)delta.TotalHours} h";
        }
        return $"{(int)delta.TotalDays} d";
    }

    public void Dispose()
    {
        try
        {
            _cts.Cancel();
        }
        catch (ObjectDisposedException)
        {
            // Already disposed (e.g. Dispose called twice during teardown) — nothing to cancel.
        }
        _cts.Dispose();
    }
}

