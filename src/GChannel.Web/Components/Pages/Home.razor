@page "/"
@attribute [Authorize]
@implements IDisposable
@inject GChannelApiClient Api
@inject ISnackbar Snackbar

<PageTitle>Dashboard · GChannel</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Dashboard</MudText>
<MudText Typo="Typo.body1" Class="mb-2" Color="Color.Secondary">
    Reseller overview for your Google Cloud Channel estate.
</MudText>

@if (_status is not null)
{
    <div class="d-flex align-center mb-6" style="gap: 8px;">
        @if (_status.IsRunning)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined"
                     Icon="@Icons.Material.Filled.Sync">Refreshing…</MudChip>
        }
        else if (!_status.Enabled)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined"
                     Icon="@Icons.Material.Filled.Bolt">On demand</MudChip>
        }
        @if (_status.LastCompletedUtc is { } completed)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Updated @FormatAgo(completed)@(_status.LastDurationSeconds is { } secs ? $" · took {secs}s" : "")@(NextRefreshText is { } next ? $" · {next}" : "")
            </MudText>
        }
        else if (_status is { Enabled: true, IsRunning: false })
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">Awaiting first background refresh…@(NextRefreshText is { } next ? $" ({next})" : "")</MudText>
        }
    </div>
}

@if (_data is { SkippedCustomerCount: > 0 })
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4">
        <div>@_data.SkippedCustomerCount customer@(_data.SkippedCustomerCount == 1 ? "" : "s") couldn't be loaded; figures may be incomplete.</div>
        @if (!string.IsNullOrWhiteSpace(_data.IncompleteReason))
        {
            <MudText Typo="Typo.caption">@_data.IncompleteReason</MudText>
        }
        @if (_status is { Enabled: true })
        {
            <MudText Typo="Typo.caption">These will be retrieved during the next background refresh; figures will fill in automatically.</MudText>
        }
    </MudAlert>
}

<OnboardingPanel CustomerCount="@(_overview?.CustomerCount ?? _data?.CustomerCount ?? 0)"
                 EntitlementCount="@EntitlementCount" />

<MudGrid>
    @foreach (var card in Cards)
    {
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="2">
                <MudCardContent>
                    <div class="d-flex justify-space-between align-center">
                        <div>
                            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@card.Label</MudText>
                            @if (card.Ready)
                            {
                                <MudText Typo="Typo.h5">@card.Value</MudText>
                            }
                            else
                            {
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="@card.Color" Class="mt-1" />
                            }
                        </div>
                        <MudIcon Icon="@card.Icon" Color="@card.Color" Size="Size.Large" />
                    </div>

                    <MudButton Variant="Variant.Text" Size="Size.Small" Class="mt-1 px-1"
                               Disabled="@(!card.Ready)"
                               OnClick="@(() => ToggleDetails(card.Key))"
                               EndIcon="@(IsExpanded(card.Key) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)">
                        Details
                    </MudButton>

                    <MudCollapse Expanded="@IsExpanded(card.Key)">
                        <div class="mt-2">
                            @switch (card.Key)
                            {
                                case "customers":
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        <b>Direct</b> = end customers your account owns directly.
                                        <b>Indirect</b> = downstream end customers owned by your linked resellers
                                        (customers that carry a channel partner id). Together they make up your
                                        total customer estate.
                                    </MudText>
                                    <div class="d-flex justify-space-between align-center mt-2">
                                        <MudText Typo="Typo.body2">Direct (your account)</MudText>
                                        <MudText Typo="Typo.body2"><b>@DirectEstate</b></MudText>
                                    </div>
                                    <div class="d-flex justify-space-between align-center">
                                        <MudText Typo="Typo.body2">Via indirect resellers</MudText>
                                        @if (IndirectLoaded)
                                        {
                                            <MudText Typo="Typo.body2"><b>@IndirectEstate</b></MudText>
                                        }
                                        else
                                        {
                                            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                                        }
                                    </div>
                                    @if (IndirectLoaded)
                                    {
                                        <MudDivider Class="my-1" />
                                        <div class="d-flex justify-space-between align-center">
                                            <MudText Typo="Typo.body2"><b>Total estate</b></MudText>
                                            <MudText Typo="Typo.body2"><b>@TotalEstate</b></MudText>
                                        </div>
                                    }
                                    break;

                                case "skus":
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        Active entitlements (purchased SKUs) currently provisioned across all customers — direct and via resellers (indirect).
                                    </MudText>
                                    <div class="d-flex justify-space-between align-center mt-2">
                                        <MudText Typo="Typo.body2">Active seats</MudText>
                                        <MudText Typo="Typo.body2"><b>@(_data?.ActiveSeats ?? 0)</b></MudText>
                                    </div>
                                    @if (_products.Count > 0)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">Top products</MudText>
                                        @foreach (var slice in _products.Take(4))
                                        {
                                            <div class="d-flex justify-space-between align-center">
                                                <MudText Typo="Typo.body2" Class="text-truncate" Style="max-width: 70%;">@slice.Product</MudText>
                                                <MudText Typo="Typo.body2"><b>@slice.Count</b></MudText>
                                            </div>
                                        }
                                    }
                                    break;

                                case "links":
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        Your linked indirect resellers (channel partners), grouped by link state.
                                    </MudText>
                                    @if (_overview?.ChannelLinkStates is { Count: > 0 } states)
                                    {
                                        @foreach (var state in states)
                                        {
                                            <div class="d-flex justify-space-between align-center mt-1">
                                                <MudText Typo="Typo.body2">@Humanize(state.State)</MudText>
                                                <MudText Typo="Typo.body2"><b>@state.Count</b></MudText>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">No channel partner links yet.</MudText>
                                    }
                                    break;

                                case "suspended":
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        Entitlements that are paused (e.g. billing or admin action) and may need attention.
                                        Shown alongside the rest of the entitlement lifecycle for context.
                                        Numbers link to the matching entitlements across your whole estate.
                                    </MudText>
                                    <div class="d-flex justify-space-between align-center mt-2">
                                        <MudText Typo="Typo.body2">Active</MudText>
                                        <MudLink Href="/entitlements?state=active&amp;scope=all" Typo="Typo.body2"><b>@(_data?.ActiveEntitlementCount ?? 0)</b></MudLink>
                                    </div>
                                    <div class="d-flex justify-space-between align-center">
                                        <MudText Typo="Typo.body2">Trial</MudText>
                                        <MudLink Href="/entitlements?state=trial&amp;scope=all" Typo="Typo.body2"><b>@(_data?.TrialEntitlementCount ?? 0)</b></MudLink>
                                    </div>
                                    <div class="d-flex justify-space-between align-center">
                                        <MudText Typo="Typo.body2">Suspended</MudText>
                                        <MudLink Href="/entitlements?state=suspended&amp;scope=all" Typo="Typo.body2"><b>@(_data?.SuspendedEntitlementCount ?? 0)</b></MudLink>
                                    </div>
                                    break;
                            }
                        </div>
                    </MudCollapse>
                </MudCardContent>
            </MudCard>
        </MudItem>
    }

    @if (_data?.EstateValue is { } estate)
    {
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="2">
                <div class="d-flex justify-space-between align-center">
                    <MudText Typo="Typo.h6">Estimated estate value (monthly)</MudText>
                    <div class="d-flex" style="gap: 4px; flex-wrap: wrap;">
                        @foreach (var cur in estate.Currencies)
                        {
                            <MudChip T="string" Size="Size.Small"
                                     Color="@(cur.Currency == estate.Currency ? Color.Primary : Color.Default)"
                                     Variant="Variant.Outlined">@cur.Currency</MudChip>
                        }
                    </div>
                </div>
                <MudGrid Class="mt-1">
                    <MudItem xs="12" sm="4">
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Wholesale cost</MudText>
                        @if (estate.Currencies.Count > 0)
                        {
                            @foreach (var cur in estate.Currencies)
                            {
                                <MudText Typo="Typo.h5">@cur.Currency @cur.WholesaleMonthly.ToString("N2")</MudText>
                            }
                        }
                        else
                        {
                            <MudText Typo="Typo.h5">@estate.Currency @estate.WholesaleMonthly.ToString("N2")</MudText>
                        }
                        <MudText Typo="Typo.caption" Color="Color.Secondary">What you pay Google</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Repriced revenue</MudText>
                        @if (estate.Currencies.Count > 0)
                        {
                            @foreach (var cur in estate.Currencies)
                            {
                                <MudText Typo="Typo.h5">@cur.Currency @cur.RevenueMonthly.ToString("N2")</MudText>
                            }
                        }
                        else
                        {
                            <MudText Typo="Typo.h5">@estate.Currency @estate.RevenueMonthly.ToString("N2")</MudText>
                        }
                        <MudText Typo="Typo.caption" Color="Color.Secondary">What end customers are billed</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Margin</MudText>
                        @if (estate.Currencies.Count > 0)
                        {
                            @foreach (var cur in estate.Currencies)
                            {
                                <MudText Typo="Typo.h5" Color="@(cur.MarginMonthly >= 0 ? Color.Success : Color.Error)">@cur.Currency @cur.MarginMonthly.ToString("N2")</MudText>
                            }
                        }
                        else
                        {
                            <MudText Typo="Typo.h5" Color="@(estate.MarginMonthly >= 0 ? Color.Success : Color.Error)">@estate.Currency @estate.MarginMonthly.ToString("N2")</MudText>
                        }
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Revenue − wholesale</MudText>
                    </MudItem>
                </MudGrid>
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mt-3">
                    By source@(estate.MixedCurrencies ? " & currency" : "")
                </MudText>
                <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="mt-1">
                    <thead>
                        <tr>
                            @if (estate.MixedCurrencies)
                            {
                                <th>Currency</th>
                            }
                            <th>Source</th>
                            <th style="text-align:right">Wholesale cost</th>
                            <th style="text-align:right">Repriced revenue</th>
                            <th style="text-align:right">Margin</th>
                            <th style="text-align:right">Subscriptions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cur in estate.Currencies)
                        {
                            <tr>
                                @if (estate.MixedCurrencies)
                                {
                                    <td>@cur.Currency</td>
                                }
                                <td>Direct (your customers)</td>
                                <td style="text-align:right">@cur.Direct.WholesaleMonthly.ToString("N2")</td>
                                <td style="text-align:right">@cur.Direct.RevenueMonthly.ToString("N2")</td>
                                <td style="text-align:right" class="@(cur.Direct.MarginMonthly >= 0 ? "mud-success-text" : "mud-error-text")">@cur.Direct.MarginMonthly.ToString("N2")</td>
                                <td style="text-align:right">@cur.Direct.PricedEntitlementCount</td>
                            </tr>
                            <tr>
                                @if (estate.MixedCurrencies)
                                {
                                    <td></td>
                                }
                                <td>Via resellers (indirect)</td>
                                <td style="text-align:right">@cur.Indirect.WholesaleMonthly.ToString("N2")</td>
                                <td style="text-align:right">@cur.Indirect.RevenueMonthly.ToString("N2")</td>
                                <td style="text-align:right" class="@(cur.Indirect.MarginMonthly >= 0 ? "mud-success-text" : "mud-error-text")">@cur.Indirect.MarginMonthly.ToString("N2")</td>
                                <td style="text-align:right">@cur.Indirect.PricedEntitlementCount</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
                @if (estate.Currencies.Count > 1)
                {
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mt-3">By currency (total)</MudText>
                    <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="mt-1">
                        <thead>
                            <tr>
                                <th>Currency</th>
                                <th style="text-align:right">Wholesale cost</th>
                                <th style="text-align:right">Repriced revenue</th>
                                <th style="text-align:right">Margin</th>
                                <th style="text-align:right">Subscriptions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cur in estate.Currencies)
                            {
                                <tr>
                                    <td>@cur.Currency</td>
                                    <td style="text-align:right">@cur.WholesaleMonthly.ToString("N2")</td>
                                    <td style="text-align:right">@cur.RevenueMonthly.ToString("N2")</td>
                                    <td style="text-align:right" class="@(cur.MarginMonthly >= 0 ? "mud-success-text" : "mud-error-text")">@cur.MarginMonthly.ToString("N2")</td>
                                    <td style="text-align:right">@cur.PricedEntitlementCount</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 d-block">
                    Estimates from offer <b>list</b> pricing × seats and configured repricing mark-ups — not invoiced amounts.
                    Based on @estate.PricedEntitlementCount priced active entitlement(s)@(estate.UnpricedEntitlementCount > 0 ? $"; {estate.UnpricedEntitlementCount} have no resolved offer price and are excluded" : "").@(estate.MixedCurrencies ? " Each currency is listed separately; the source split is broken out below." : "")
                </MudText>
            </MudPaper>
        </MudItem>
    }

    <MudItem xs="12" md="8">
        <MudPaper Class="pa-4" Elevation="2">
            <div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-2">
                <div>
                    <MudText Typo="Typo.h6">Customers onboarded</MudText>
                    @if (_monthly.Count > 0 && MonthlyRangeTitle is { Length: > 0 } title)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@title</MudText>
                    }
                </div>
                @if (_allMonthly.Count > 1)
                {
                    <div class="d-flex align-center gap-2 flex-wrap">
                        <MudSelect T="string" Value="_rangeFrom" ValueChanged="OnRangeFromChanged" Label="From"
                                   Dense="true" Margin="Margin.Dense" Style="min-width:130px">
                            @foreach (var m in _allMonthly)
                            {
                                <MudSelectItem Value="@m.Key">@m.Label</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSelect T="string" Value="_rangeTo" ValueChanged="OnRangeToChanged" Label="To"
                                   Dense="true" Margin="Margin.Dense" Style="min-width:130px">
                            @foreach (var m in _allMonthly)
                            {
                                <MudSelectItem Value="@m.Key">@m.Label</MudSelectItem>
                            }
                        </MudSelect>
                        <MudTooltip Text="Show the whole available period">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="ResetRangeToAll">All</MudButton>
                        </MudTooltip>
                    </div>
                }
            </div>
            @if (_monthly.Count > 0)
            {
                <ApexChart TItem="MonthlyPoint" Options="_monthlyOptions" @ref="_monthlyChart">
                    <ApexPointSeries TItem="MonthlyPoint"
                                     Items="_monthly"
                                     Name="@(HasIndirectOnboarding ? "Direct" : "Customers")"
                                     SeriesType="SeriesType.Line"
                                     XValue="@(p => p.Label)"
                                     YValue="@(p => p.Direct)" />
                    @if (HasIndirectOnboarding)
                    {
                        <ApexPointSeries TItem="MonthlyPoint"
                                         Items="_monthly"
                                         Name="Via resellers (indirect)"
                                         SeriesType="SeriesType.Line"
                                         XValue="@(p => p.Label)"
                                         YValue="@(p => p.Indirect)" />
                    }
                </ApexChart>
            }
            else if (_overviewLoading)
            {
                <div class="d-flex align-center" style="height: 200px;">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="mx-auto" />
                </div>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No customer history yet.</MudText>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Elevation="2">
            <div class="d-flex align-center gap-1">
                <MudText Typo="Typo.h6" GutterBottom="true">Product mix</MudText>
                <MudTooltip Arrow="true" Placement="Placement.Top"
                            Text="Slices are grouped by their catalog product name. A few entries may appear as a raw SKU or product ID when the marketing display name isn't available from the catalog — typically custom/negotiated offers, SKU groups, or products missing from the cached catalog.">
                    <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" Color="Color.Secondary" Class="mb-1" />
                </MudTooltip>
            </div>
            @if (_indirectProducts.Count > 0)
            {
                @* Both direct and reseller (indirect) business exists — show a donut for each so the
                   split is clear rather than blending them into one whole-estate chart. *@
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Direct (your customers)</MudText>
                @if (_directProducts.Count > 0)
                {
                    <ApexChart TItem="ProductSlice" Title="Active SKUs" Options="_directProductOptions" @ref="_directProductChart">
                        <ApexPointSeries TItem="ProductSlice"
                                         Items="_directProducts"
                                         Name="SKUs"
                                         SeriesType="SeriesType.Donut"
                                         XValue="@(p => p.Product)"
                                         YValue="@(p => p.Count)" />
                    </ApexChart>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">No direct active entitlements.</MudText>
                }
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mt-3">Via resellers (indirect)</MudText>
                <ApexChart TItem="ProductSlice" Title="Active SKUs" Options="_indirectProductOptions" @ref="_indirectProductChart">
                    <ApexPointSeries TItem="ProductSlice"
                                     Items="_indirectProducts"
                                     Name="SKUs"
                                     SeriesType="SeriesType.Donut"
                                     XValue="@(p => p.Product)"
                                     YValue="@(p => p.Count)" />
                </ApexChart>
            }
            else if (_directProducts.Count > 0)
            {
                @* Direct-only distributor (no reseller estate): the direct mix is the whole estate. *@
                <ApexChart TItem="ProductSlice" Title="Active SKUs" Options="_directProductOptions" @ref="_directProductChart">
                    <ApexPointSeries TItem="ProductSlice"
                                     Items="_directProducts"
                                     Name="SKUs"
                                     SeriesType="SeriesType.Donut"
                                     XValue="@(p => p.Product)"
                                     YValue="@(p => p.Count)" />
                </ApexChart>
            }
            else if (_entitlementsLoading)
            {
                <div class="d-flex align-center" style="height: 200px;">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="mx-auto" />
                </div>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No active entitlements yet.</MudText>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6">Top indirect resellers</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-2">
                Ranked by total active seats. The number in parentheses after each reseller is its customer count.
            </MudText>
            @if (_resellers.Count > 0)
            {
                <ApexChart TItem="ResellerSlice" Title="Seats per reseller" Options="_resellerOptions" @ref="_resellerChart">
                    <ApexPointSeries TItem="ResellerSlice"
                                     Items="_resellers"
                                     Name="Seats"
                                     SeriesType="SeriesType.Bar"
                                     XValue="@(r => $"{r.Reseller} ({r.Customers:0})")"
                                     YValue="@(r => r.Seats)" />
                </ApexChart>
            }
            else if (_entitlementsLoading)
            {
                <div class="d-flex align-center" style="height: 200px;">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="mx-auto" />
                </div>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    No indirect resellers with customers yet. When a linked reseller owns downstream
                    customers, they'll appear here ranked by total active seats.
                </MudText>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private record SummaryCard(string Key, string Label, string Value, string Icon, Color Color, bool Ready);
    private record MonthlyPoint(string Key, string Label, decimal Direct, decimal Indirect);
    private record ProductSlice(string Product, decimal Count);
    private record ResellerSlice(string Reseller, decimal Customers, decimal Seats);

    // Cascaded from MainLayout so the charts can follow the app's light/dark theme. ApexCharts renders
    // its own axis/legend/title text in a fixed colour that ignores MudBlazor's theme, so without this
    // the labels stay dark and become invisible on the dark background.
    [CascadingParameter(Name = "IsDarkMode")]
    private bool IsDarkMode { get; set; }

    private bool? _appliedDarkMode;
    private ApexChart<MonthlyPoint>? _monthlyChart;
    private ApexChart<ProductSlice>? _directProductChart;
    private ApexChart<ProductSlice>? _indirectProductChart;
    private ApexChart<ResellerSlice>? _resellerChart;
    private readonly ApexChartOptions<MonthlyPoint> _monthlyOptions = new();
    private readonly ApexChartOptions<ProductSlice> _directProductOptions = new();
    private readonly ApexChartOptions<ProductSlice> _indirectProductOptions = new();
    private readonly ApexChartOptions<ResellerSlice> _resellerOptions = new()
    {
        PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { Horizontal = true } }
    };

    private DashboardOverview? _overview;
    private DashboardSummary? _data;
    private DashboardRefreshStatus? _status;
    private bool _overviewLoading = true;
    private bool _entitlementsLoading = true;
    // The full onboarding history from the backend (oldest first) and the range-filtered subset the
    // chart renders. The From/To selectors narrow the visible window without another backend call.
    private readonly List<MonthlyPoint> _allMonthly = [];
    private readonly List<MonthlyPoint> _monthly = [];
    private string? _rangeFrom;
    private string? _rangeTo;
    private readonly List<ProductSlice> _products = [];
    private readonly List<ProductSlice> _directProducts = [];
    private readonly List<ProductSlice> _indirectProducts = [];
    private readonly List<ResellerSlice> _resellers = [];
    private readonly CancellationTokenSource _cts = new();

    // How often to poll the background-refresh status (and, while a run is in progress, re-pull the
    // summary so the figures update live). Cheap: status is a tiny cached object and the summary is
    // served straight from Redis.
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(30);

    // The customer count + onboarding chart come from the cheap overview (phase 1); the entitlement
    // cards + product mix come from the slower summary (phase 2). Each shows a spinner until ready.
    private SummaryCard[] Cards =>
    [
        new("customers", "Customers", (_overview?.CustomerCount ?? _data?.CustomerCount ?? 0).ToString(),
            Icons.Material.Filled.Business, Color.Primary, _overview is not null || _data is not null),
        new("skus", "Active SKUs", (_data?.ActiveEntitlementCount ?? 0).ToString(),
            Icons.Material.Filled.Inventory2, Color.Success, _data is not null),
        new("links", "Channel links", (_overview?.ChannelLinkCount ?? 0).ToString(),
            Icons.Material.Filled.Hub, Color.Tertiary, _overview is not null),
        new("suspended", "Suspended", (_data?.SuspendedEntitlementCount ?? 0).ToString(),
            Icons.Material.Filled.PauseCircle, Color.Warning, _data is not null),
    ];

    // Tracks which KPI cards have their details panel expanded (keyed by SummaryCard.Key).
    private readonly HashSet<string> _expanded = [];

    // Customer estate figures for the KPI details. Direct customers come from the cheap overview; the
    // indirect (reseller-owned) estate is a separate set surfaced by the slower, background-computed
    // summary, so the total is the two added together (they never overlap).
    private bool IndirectLoaded => _data is not null;
    private int DirectEstate => _overview?.CustomerCount ?? _data?.CustomerCount ?? 0;
    private int IndirectEstate => _data?.IndirectCustomerCount ?? 0;
    private int TotalEstate => DirectEstate + IndirectEstate;

    private bool IsExpanded(string key) => _expanded.Contains(key);

    private void ToggleDetails(string key)
    {
        if (!_expanded.Add(key))
        {
            _expanded.Remove(key);
        }
    }

    // Title-cases a Channel API enum value (e.g. "ACTIVE" -> "Active") for the link-state breakdown.
    private static string Humanize(string value) =>
        string.IsNullOrEmpty(value) ? value : char.ToUpperInvariant(value[0]) + value[1..].ToLowerInvariant();

    // Total entitlements across states — drives the onboarding checklist's "purchase" step.
    private int EntitlementCount =>
        (_data?.ActiveEntitlementCount ?? 0)
        + (_data?.TrialEntitlementCount ?? 0)
        + (_data?.SuspendedEntitlementCount ?? 0);

    // Keep the ApexCharts theme in step with the app's light/dark mode. Runs whenever the cascaded
    // IsDarkMode flips; the options carry the right mode up front too, so charts created later (once
    // their data lands) render correctly without a toggle.
    protected override async Task OnParametersSetAsync()
    {
        if (_appliedDarkMode == IsDarkMode)
        {
            return;
        }

        _appliedDarkMode = IsDarkMode;
        var mode = IsDarkMode ? Mode.Dark : Mode.Light;
        _monthlyOptions.Theme = new Theme { Mode = mode };
        _directProductOptions.Theme = new Theme { Mode = mode };
        _indirectProductOptions.Theme = new Theme { Mode = mode };
        _resellerOptions.Theme = new Theme { Mode = mode };

        if (_monthlyChart is not null)
        {
            await _monthlyChart.UpdateOptionsAsync(redrawPaths: true, animate: false, updateSyncedCharts: false);
        }

        if (_directProductChart is not null)
        {
            await _directProductChart.UpdateOptionsAsync(redrawPaths: true, animate: false, updateSyncedCharts: false);
        }

        if (_indirectProductChart is not null)
        {
            await _indirectProductChart.UpdateOptionsAsync(redrawPaths: true, animate: false, updateSyncedCharts: false);
        }

        if (_resellerChart is not null)
        {
            await _resellerChart.UpdateOptionsAsync(redrawPaths: true, animate: false, updateSyncedCharts: false);
        }
    }

    // Load after the first interactive render so the API calls run once on the live circuit
    // (avoiding a canceled prerender request), mirroring the other data-heavy pages.
    protected override async Task OnAfterRenderAsync(bool firstRender)    {
        if (!firstRender)
        {
            return;
        }

        // Capture the token once up front: the two-phase load can run for tens of seconds, and if the
        // circuit/component tears down meanwhile the source is disposed — reading _cts.Token again (or
        // letting HttpClient register on it) would then throw ObjectDisposedException.
        CancellationToken token;
        try
        {
            token = _cts.Token;
        }
        catch (ObjectDisposedException)
        {
            return;
        }

        // Phase 1 then phase 2: the cheap overview renders the customer count + onboarding chart
        // immediately while the quota-bound entitlement aggregation streams in afterwards.
        await LoadOverviewAsync(token);
        StateHasChanged();
        await LoadSummaryAsync(token);
        StateHasChanged();

        // Pull the initial refresh status, then keep the page live: poll every 30s so the figures
        // (and the "Updated X ago" / "Refreshing…" indicator) track the background refresher.
        await LoadStatusAsync(token);
        StateHasChanged();
        _ = PollLoopAsync(token);
    }

    // Polls the refresh status on a fixed cadence and, while a background run is in progress or one
    // has just finished, re-pulls the summary so the product mix + cards redraw without a page reload.
    private async Task PollLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(PollInterval);
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                DashboardRefreshStatus? status;
                try
                {
                    status = await Api.GetDashboardStatusAsync(cancellationToken);
                }
                catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
                {
                    break;
                }
                catch
                {
                    // Transient; keep the last status and try again next tick.
                    continue;
                }

                var previous = _status;
                _status = status;

                // Re-pull the (cache-served) summary while a run is in progress to show partials
                // filling in, and once more when a run completes to land on the final figures.
                var completedChanged = status?.LastCompletedUtc != previous?.LastCompletedUtc;
                if (status is { IsRunning: true } || completedChanged)
                {
                    await RefreshSummaryAsync(cancellationToken);
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            // Circuit/component torn down — stop polling.
        }
    }

    // Loads the full onboarding history into _allMonthly, initialises/repairs the selected From–To
    // range against the available months (defaulting to the whole period), then applies the filter.
    private void SetMonthlySeries(IReadOnlyList<DashboardMonthlyPoint> points)
    {
        _allMonthly.Clear();
        foreach (var p in points)
        {
            var key = string.IsNullOrEmpty(p.MonthKey) ? p.Month : p.MonthKey;
            var label = p.Year > 0 ? $"{p.Month} {p.Year}" : p.Month;
            _allMonthly.Add(new MonthlyPoint(key, label, p.DirectCustomers, p.IndirectCustomers));
        }

        var keys = _allMonthly.Select(m => m.Key).ToList();
        if (keys.Count == 0)
        {
            _rangeFrom = _rangeTo = null;
        }
        else
        {
            // Keep any user-chosen range if it's still valid; otherwise default to the whole period.
            if (_rangeFrom is null || !keys.Contains(_rangeFrom)) _rangeFrom = keys[0];
            if (_rangeTo is null || !keys.Contains(_rangeTo)) _rangeTo = keys[^1];
            if (string.CompareOrdinal(_rangeFrom, _rangeTo) > 0) (_rangeFrom, _rangeTo) = (keys[0], keys[^1]);
        }

        ApplyMonthlyRange();
    }

    // Filters _allMonthly into _monthly (the chart's series) by the selected From–To month keys.
    private void ApplyMonthlyRange()
    {
        _monthly.Clear();
        foreach (var m in _allMonthly)
        {
            if ((_rangeFrom is null || string.CompareOrdinal(m.Key, _rangeFrom) >= 0)
                && (_rangeTo is null || string.CompareOrdinal(m.Key, _rangeTo) <= 0))
            {
                _monthly.Add(m);
            }
        }
    }

    // Caption under the chart title, e.g. "Feb 2023 – Jul 2026" (or a single month).
    private string MonthlyRangeTitle =>
        _monthly.Count == 0 ? ""
        : _monthly[0].Label == _monthly[^1].Label ? _monthly[0].Label
        : $"{_monthly[0].Label} – {_monthly[^1].Label}";

    // Show a second (indirect) onboarding line only when there is reseller-owned onboarding history, so a
    // direct-only distributor keeps a single clean line. Based on the whole dataset, not the filtered
    // range, so the series set stays stable as the user narrows From/To.
    private bool HasIndirectOnboarding => _allMonthly.Any(m => m.Indirect > 0);

    private Task OnRangeFromChanged(string? value)
    {
        _rangeFrom = value;
        if (_rangeFrom is not null && _rangeTo is not null && string.CompareOrdinal(_rangeFrom, _rangeTo) > 0)
        {
            _rangeTo = _rangeFrom;
        }
        return UpdateMonthlyRangeAsync();
    }

    private Task OnRangeToChanged(string? value)
    {
        _rangeTo = value;
        if (_rangeFrom is not null && _rangeTo is not null && string.CompareOrdinal(_rangeTo, _rangeFrom) < 0)
        {
            _rangeFrom = _rangeTo;
        }
        return UpdateMonthlyRangeAsync();
    }

    private Task ResetRangeToAll()
    {
        var keys = _allMonthly.Select(m => m.Key).ToList();
        if (keys.Count > 0)
        {
            _rangeFrom = keys[0];
            _rangeTo = keys[^1];
        }
        return UpdateMonthlyRangeAsync();
    }

    private async Task UpdateMonthlyRangeAsync()
    {
        ApplyMonthlyRange();
        if (_monthlyChart is not null)
        {
            await _monthlyChart.UpdateSeriesAsync();
        }
    }

    private async Task LoadOverviewAsync(CancellationToken cancellationToken)
    {
        _overviewLoading = true;
        try
        {
            _overview = await Api.GetDashboardOverviewAsync(cancellationToken);

            SetMonthlySeries(_overview?.CustomersOnboarded ?? []);
        }
        catch (Exception)
        {
            // The overview is only a fast-path optimisation: the summary (phase 2) carries the same
            // customer count + onboarding data, so a failure here (e.g. a transient quota 429) is
            // swallowed silently and phase 2 fills everything in.
        }
        finally
        {
            _overviewLoading = false;
        }
    }

    private async Task LoadSummaryAsync(CancellationToken cancellationToken)
    {
        _entitlementsLoading = true;
        try
        {
            _data = await Api.GetDashboardSummaryAsync(cancellationToken);

            // The summary carries authoritative onboarding data too; refresh the chart from it in
            // case the overview cache lagged behind.
            SetMonthlySeries(_data?.CustomersOnboarded ?? []);

            _products.Clear();
            foreach (var slice in _data?.ProductMix ?? [])
            {
                _products.Add(new ProductSlice(slice.Product, slice.Count));
            }

            _directProducts.Clear();
            foreach (var slice in _data?.DirectProductMix ?? [])
            {
                _directProducts.Add(new ProductSlice(slice.Product, slice.Count));
            }

            _indirectProducts.Clear();
            foreach (var slice in _data?.IndirectProductMix ?? [])
            {
                _indirectProducts.Add(new ProductSlice(slice.Product, slice.Count));
            }

            _resellers.Clear();
            foreach (var reseller in _data?.TopIndirectResellers ?? [])
            {
                _resellers.Add(new ResellerSlice(reseller.Reseller, reseller.CustomerCount, reseller.SeatCount));
            }
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            // Benign: the entitlement aggregation is slow and the request was cancelled/disposed.
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load dashboard: {ex.Message}", Severity.Error);
        }
        finally
        {
            _entitlementsLoading = false;
        }
    }

    // Quiet re-pull used by the polling loop: updates the cards/charts from the cached summary without
    // toggling the loading spinners or showing error snackbars (polling is best-effort).
    private async Task RefreshSummaryAsync(CancellationToken cancellationToken)
    {
        try
        {
            var data = await Api.GetDashboardSummaryAsync(cancellationToken);
            if (data is null)
            {
                return;
            }

            _data = data;

            SetMonthlySeries(data.CustomersOnboarded);

            _products.Clear();
            foreach (var slice in data.ProductMix)
            {
                _products.Add(new ProductSlice(slice.Product, slice.Count));
            }

            _directProducts.Clear();
            foreach (var slice in data.DirectProductMix)
            {
                _directProducts.Add(new ProductSlice(slice.Product, slice.Count));
            }

            _indirectProducts.Clear();
            foreach (var slice in data.IndirectProductMix)
            {
                _indirectProducts.Add(new ProductSlice(slice.Product, slice.Count));
            }

            _resellers.Clear();
            foreach (var reseller in data.TopIndirectResellers)
            {
                _resellers.Add(new ResellerSlice(reseller.Reseller, reseller.CustomerCount, reseller.SeatCount));
            }
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            // Benign teardown.
        }
        catch
        {
            // Keep the last good render; the next tick will try again.
        }
    }

    private async Task LoadStatusAsync(CancellationToken cancellationToken)
    {
        try
        {
            _status = await Api.GetDashboardStatusAsync(cancellationToken);
        }
        catch
        {
            // The status indicator is purely informational; ignore failures.
        }
    }

    // Renders "just now" / "5 min ago" / "2 h ago" / "3 d ago" from a UTC timestamp.
    private static string FormatAgo(DateTimeOffset whenUtc)
    {
        var delta = DateTimeOffset.UtcNow - whenUtc;
        if (delta < TimeSpan.Zero)
        {
            delta = TimeSpan.Zero;
        }

        if (delta.TotalSeconds < 60)
        {
            return "just now";
        }
        if (delta.TotalMinutes < 60)
        {
            return $"{(int)delta.TotalMinutes} min ago";
        }
        if (delta.TotalHours < 24)
        {
            return $"{(int)delta.TotalHours} h ago";
        }
        return $"{(int)delta.TotalDays} d ago";
    }

    // "next refresh in X" caption — only while the background refresher is enabled and idle (during a
    // run we already show "Refreshing…"). Null when disabled / unknown so the caller appends nothing.
    private string? NextRefreshText
    {
        get
        {
            if (_status is not { Enabled: true, IsRunning: false } || _status.NextRefreshUtc is not { } next)
            {
                return null;
            }
            var delta = next - DateTimeOffset.UtcNow;
            return delta <= TimeSpan.Zero ? "next refresh due" : $"next refresh in {FormatIn(delta)}";
        }
    }

    private static string FormatIn(TimeSpan delta)
    {
        if (delta.TotalSeconds < 60)
        {
            return "under a min";
        }
        if (delta.TotalMinutes < 60)
        {
            return $"{(int)delta.TotalMinutes} min";
        }
        if (delta.TotalHours < 24)
        {
            return $"{(int)delta.TotalHours} h";
        }
        return $"{(int)delta.TotalDays} d";
    }

    public void Dispose()
    {
        try
        {
            _cts.Cancel();
        }
        catch (ObjectDisposedException)
        {
            // Already disposed (e.g. Dispose called twice during teardown) — nothing to cancel.
        }
        _cts.Dispose();
    }
}
