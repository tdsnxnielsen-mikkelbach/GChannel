@page "/notifications"
@attribute [Authorize]
@implements IDisposable
@inject GChannelApiClient Api
@inject UiNotifier Snackbar

<PageTitle>Notifications · GChannel</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="1rem" class="rz-mb-2">
    <div>
        <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">Notifications</RadzenText>
        <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">Pub/Sub change events</RadzenText>
    </div>
    <RadzenButton Text="Refresh" Icon="@AppIcons.Refresh" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Click="RefreshFeedAsync" Disabled="_feedLoading" />
</RadzenStack>

<RadzenText TextStyle="TextStyle.Body1" class="rz-text-secondary-color rz-mb-6">
    Google publishes entitlement and customer change events to a Cloud Pub/Sub topic. A background
    subscriber in the worker records them into a live feed so the console reacts to changes without
    polling. Each event deep-links to the customer or entitlement it concerns.
    <Tip Text="When the read-model is enabled, each change event also triggers a targeted refresh of the affected customer's synced data (seats, subscriptions, renewal, pricing) within seconds — so lists and dashboards update in near-real-time, with the periodic background sync as a backstop.">
        <RadzenIcon Icon="@AppIcons.Info" Style="font-size: 1.1rem; width: auto; height: auto; vertical-align: text-bottom" class="rz-ms-1" />
    </Tip>
</RadzenText>

@if (!_feedLoading && _feed is not null && !_feed.SubscriberEnabled)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-mb-4">
        The background Pub/Sub subscriber isn't running. Configure <code>GoogleChannel:PubSubProjectId</code>,
        <code>GoogleChannel:PubSubSubscriptionId</code> and a service-account key to start receiving events.
        Subscriber registration below still works.
    </RadzenAlert>
}

<RadzenRow Gap="1rem" RowGap="1rem">
    <RadzenColumn Size="12" SizeLG="7">
        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Event feed</RadzenText>
        @if (_feedLoading)
        {
            <LoadingPanel Title="Loading notifications…" Hint="Reading the recent Channel event feed." />
        }
        else if (_feed is { Notifications.Count: > 0 })
        {
            <RadzenCard Variant="Variant.Filled">
                <RadzenDataGrid TItem="ChannelNotification" Data="_feed.Notifications" AllowPaging="false" AllowSorting="false" Density="Density.Compact" GridLines="DataGridGridLines.Horizontal" Responsive="true">
                    <Columns>
                        <RadzenDataGridColumn TItem="ChannelNotification" Title="Kind" Width="120px">
                            <Template Context="n"><RadzenBadge BadgeStyle="@KindColor(n.Kind)" Text="@n.Kind" /></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ChannelNotification" Title="Customer">
                            <Template Context="n">
                                @if (!string.IsNullOrEmpty(n.CustomerId))
                                {
                                    <div>@CustomerLabel(n.CustomerId)</div>
                                    <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Div" class="rz-text-secondary-color rz-m-0">@n.CustomerId</RadzenText>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ChannelNotification" Title="Event">
                            <Template Context="n">
                                <div>@(n.EventType ?? "—")</div>
                                <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Div" class="rz-text-secondary-color rz-m-0" Style="overflow-wrap: anywhere">@n.ResourceName</RadzenText>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ChannelNotification" Title="Received" Width="150px">
                            <Template Context="n">@DisplayFormat.Timestamp(n.ReceivedAt)</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ChannelNotification" Title="Open" TextAlign="TextAlign.End" Width="110px">
                            <Template Context="n">
                                @if (!string.IsNullOrEmpty(n.CustomerId) && !string.IsNullOrEmpty(n.EntitlementId))
                                {
                                    <RadzenLink Path="@($"/customers/{n.CustomerId}/entitlements/{n.EntitlementId}")" Text="Entitlement" />
                                }
                                else if (!string.IsNullOrEmpty(n.CustomerId))
                                {
                                    <RadzenLink Path="@($"/customers/{n.CustomerId}")" Text="Customer" />
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </RadzenCard>
        }
        else
        {
            <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">No notifications received yet.</RadzenAlert>
        }
    </RadzenColumn>

    <RadzenColumn Size="12" SizeLG="5">
        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Subscriber registration</RadzenText>
        <RadzenCard Variant="Variant.Filled">
            @if (_registrationLoading)
            {
                <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" class="rz-my-2" />
            }
            else
            {
                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">Topic</RadzenText>
                <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-3" Style="overflow-wrap: anywhere">@(_registration?.Topic ?? "— none registered —")</RadzenText>

                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">Registered service accounts</RadzenText>
                @if (_registration is { ServiceAccounts.Count: > 0 })
                {
                    <RadzenStack Gap="0">
                        @foreach (var account in _registration.ServiceAccounts)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-py-2 rz-border-bottom rz-border-color-base-200">
                                <span style="overflow-wrap: anywhere">@account</span>
                                <RadzenButton Icon="@AppIcons.Delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="@(() => UnregisterAsync(account))" Disabled="_saving" aria-label="Unregister" />
                            </RadzenStack>
                        }
                    </RadzenStack>
                }
                else
                {
                    <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-2">None.</RadzenText>
                }

                <hr class="rz-my-3" />
                <RadzenFormField Text="Service account email" Variant="Variant.Outlined" Style="width:100%" class="rz-mb-3">
                    <RadzenTextBox @bind-Value="_newServiceAccount" Placeholder="name@project.iam.gserviceaccount.com" Name="serviceAccount" />
                </RadzenFormField>
                <RadzenButton Text="Register subscriber" Icon="@AppIcons.Add" ButtonStyle="ButtonStyle.Primary" Click="RegisterAsync" Disabled="@(string.IsNullOrWhiteSpace(_newServiceAccount) || _saving)" />
            }
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

@code {
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(20);

    private readonly CancellationTokenSource _cts = new();

    private ChannelNotificationsResult? _feed;
    private bool _feedLoading = true;

    private readonly Dictionary<string, string?> _customerNames = new(StringComparer.Ordinal);

    private SubscriberRegistration? _registration;
    private bool _registrationLoading = true;
    private string _newServiceAccount = string.Empty;
    private bool _saving;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await RefreshFeedAsync();
        await LoadRegistrationAsync();
        _ = PollLoopAsync(_cts.Token);
    }

    private async Task RefreshFeedAsync()
    {
        _feedLoading = true;
        StateHasChanged();
        try
        {
            _feed = await Api.ListNotificationsAsync(_cts.Token);
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            return;
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load notifications: {ex.Message}", Severity.Error);
            _feed = new ChannelNotificationsResult();
        }
        finally
        {
            _feedLoading = false;
            StateHasChanged();
        }

        await ResolveCustomerNamesAsync();
        StateHasChanged();
    }

    private async Task ResolveCustomerNamesAsync()
    {
        if (_feed is not { Notifications.Count: > 0 })
        {
            return;
        }

        var ids = _feed.Notifications
            .Select(n => n.CustomerId)
            .Where(id => !string.IsNullOrEmpty(id) && !_customerNames.ContainsKey(id!))
            .Distinct(StringComparer.Ordinal)
            .ToList();

        foreach (var id in ids)
        {
            try
            {
                var customer = await Api.GetCustomerAsync(id!, _cts.Token);
                _customerNames[id!] = customer?.OrgDisplayName;
            }
            catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
            {
                return;
            }
            catch
            {
                // Leave unresolved; the row falls back to the raw id.
                _customerNames[id!] = null;
            }
        }
    }

    private string CustomerLabel(string? customerId) =>
        customerId is not null && _customerNames.TryGetValue(customerId, out var name) && !string.IsNullOrWhiteSpace(name)
            ? name
            : customerId ?? "—";

    private async Task LoadRegistrationAsync()
    {
        _registrationLoading = true;
        StateHasChanged();
        try
        {
            _registration = await Api.ListSubscribersAsync(_cts.Token);
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            return;
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load subscriber registration: {ex.Message}", Severity.Error);
            _registration = new SubscriberRegistration();
        }
        finally
        {
            _registrationLoading = false;
            StateHasChanged();
        }
    }

    private async Task RegisterAsync()
    {
        var serviceAccount = _newServiceAccount.Trim();
        if (string.IsNullOrWhiteSpace(serviceAccount))
        {
            return;
        }

        _saving = true;
        try
        {
            _registration = await Api.RegisterSubscriberAsync(new RegisterSubscriberRequest { ServiceAccount = serviceAccount }, _cts.Token);
            _newServiceAccount = string.Empty;
            await Snackbar.Add("Subscriber registered.", Severity.Success);
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to register subscriber: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task UnregisterAsync(string serviceAccount)
    {
        _saving = true;
        try
        {
            _registration = await Api.UnregisterSubscriberAsync(serviceAccount, _cts.Token);
            await Snackbar.Add("Subscriber unregistered.", Severity.Success);
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to unregister subscriber: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task PollLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(PollInterval);
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                try
                {
                    _feed = await Api.ListNotificationsAsync(cancellationToken);
                }
                catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
                {
                    break;
                }
                catch
                {
                    continue;
                }

                await ResolveCustomerNamesAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            // Circuit torn down.
        }
    }

    private static BadgeStyle KindColor(string kind) => kind switch
    {
        "Entitlement" => BadgeStyle.Primary,
        "Customer" => BadgeStyle.Info,
        _ => BadgeStyle.Light
    };

    public void Dispose()
    {
        try
        {
            _cts.Cancel();
        }
        catch (ObjectDisposedException)
        {
        }

        _cts.Dispose();
    }
}

