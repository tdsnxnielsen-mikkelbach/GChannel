@page "/notifications"
@attribute [Authorize]
@implements IDisposable
@inject GChannelApiClient Api
@inject UiNotifier Snackbar

<PageTitle>Notifications · GChannel</PageTitle>

<Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Margin="Margin.Is2.FromBottom">
    <Div>
        <Heading Size="HeadingSize.Is3" Margin="Margin.Is0">Notifications</Heading>
        <Small TextColor="TextColor.Secondary">Pub/Sub change events</Small>
    </Div>
    <Button Color="Color.Secondary" Outline Clicked="RefreshFeedAsync" Disabled="_feedLoading">
        <Icon Name="@AppIcons.Refresh" Class="me-1" /> Refresh
    </Button>
</Div>

<Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is5.FromBottom">
    Google publishes entitlement and customer change events to a Cloud Pub/Sub topic. A background
    subscriber in the worker records them into a live feed so the console reacts to changes without
    polling. Each event deep-links to the customer or entitlement it concerns.
    <Tooltip Text="When the read-model is enabled, each change event also triggers a targeted refresh of the affected customer's synced data (seats, subscriptions, renewal, pricing) within seconds — so lists and dashboards update in near-real-time, with the periodic background sync as a backstop." Multiline Inline>
        <Icon Name="@AppIcons.Info" Class="ms-1" />
    </Tooltip>
</Paragraph>

@if (!_feedLoading && _feed is not null && !_feed.SubscriberEnabled)
{
    <Alert Color="Color.Warning" Visible Margin="Margin.Is4.FromBottom">
        The background Pub/Sub subscriber isn't running. Configure <code>GoogleChannel:PubSubProjectId</code>,
        <code>GoogleChannel:PubSubSubscriptionId</code> and a service-account key to start receiving events.
        Subscriber registration below still works.
    </Alert>
}

<Row>
    <Column ColumnSize="ColumnSize.Is12.Is7.OnDesktop">
        <Heading Size="HeadingSize.Is5" Margin="Margin.Is2.FromBottom">Event feed</Heading>
        @if (_feedLoading)
        {
            <LoadingPanel Title="Loading notifications…" Hint="Reading the recent Channel event feed." />
        }
        else if (_feed is { Notifications.Count: > 0 })
        {
            <Card Shadow="Shadow.Small">
                <Table Narrow Hoverable Responsive Margin="Margin.Is0">
                    <TableHeader>
                        <TableRow>
                            <TableHeaderCell>Kind</TableHeaderCell>
                            <TableHeaderCell>Customer</TableHeaderCell>
                            <TableHeaderCell>Event</TableHeaderCell>
                            <TableHeaderCell>Received</TableHeaderCell>
                            <TableHeaderCell TextAlignment="TextAlignment.End">Open</TableHeaderCell>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @foreach (var n in _feed.Notifications)
                        {
                            <TableRow>
                                <TableRowCell><Badge Color="@KindColor(n.Kind)">@n.Kind</Badge></TableRowCell>
                                <TableRowCell>
                                    @if (!string.IsNullOrEmpty(n.CustomerId))
                                    {
                                        <div>@CustomerLabel(n.CustomerId)</div>
                                        <Small TextColor="TextColor.Secondary">@n.CustomerId</Small>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </TableRowCell>
                                <TableRowCell>
                                    <div>@(n.EventType ?? "—")</div>
                                    <Small TextColor="TextColor.Secondary">@n.ResourceName</Small>
                                </TableRowCell>
                                <TableRowCell>@n.ReceivedAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</TableRowCell>
                                <TableRowCell TextAlignment="TextAlignment.End">
                                    @if (!string.IsNullOrEmpty(n.CustomerId) && !string.IsNullOrEmpty(n.EntitlementId))
                                    {
                                        <Anchor To="@($"/customers/{n.CustomerId}/entitlements/{n.EntitlementId}")">Entitlement</Anchor>
                                    }
                                    else if (!string.IsNullOrEmpty(n.CustomerId))
                                    {
                                        <Anchor To="@($"/customers/{n.CustomerId}")">Customer</Anchor>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </TableRowCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
            </Card>
        }
        else
        {
            <Alert Color="Color.Info" Visible>No notifications received yet.</Alert>
        }
    </Column>

    <Column ColumnSize="ColumnSize.Is12.Is5.OnDesktop">
        <Heading Size="HeadingSize.Is5" Margin="Margin.Is2.FromBottom">Subscriber registration</Heading>
        <Card Shadow="Shadow.Small">
            <CardBody>
                @if (_registrationLoading)
                {
                    <Progress Indeterminate Color="Color.Primary" Size="Size.Small" Margin="Margin.Is2.OnY" />
                }
                else
                {
                    <Small TextColor="TextColor.Secondary" Display="Display.Block">Topic</Small>
                    <Paragraph Margin="Margin.Is3.FromBottom">@(_registration?.Topic ?? "— none registered —")</Paragraph>

                    <Small TextColor="TextColor.Secondary" Display="Display.Block">Registered service accounts</Small>
                    @if (_registration is { ServiceAccounts.Count: > 0 })
                    {
                        <ListGroup Flush>
                            @foreach (var account in _registration.ServiceAccounts)
                            {
                                <ListGroupItem Padding="Padding.Is0.OnX.Is2.OnY">
                                    <Div Flex="Flex.JustifyContent.Between.AlignItems.Center">
                                        <span class="text-break">@account</span>
                                        <Button Color="Color.Danger" Outline Size="Size.Small" Clicked="@(() => UnregisterAsync(account))" Disabled="_saving" aria-label="Unregister">
                                            <Icon Name="@AppIcons.Delete" />
                                        </Button>
                                    </Div>
                                </ListGroupItem>
                            }
                        </ListGroup>
                    }
                    else
                    {
                        <Paragraph Margin="Margin.Is2.FromBottom">None.</Paragraph>
                    }

                    <Divider Margin="Margin.Is3.OnY" />
                    <Field>
                        <FieldLabel>Service account email</FieldLabel>
                        <TextInput @bind-Value="_newServiceAccount" Placeholder="name@project.iam.gserviceaccount.com" />
                    </Field>
                    <Button Color="Color.Primary" Clicked="RegisterAsync" Disabled="@(string.IsNullOrWhiteSpace(_newServiceAccount) || _saving)">
                        <Icon Name="@AppIcons.Add" Class="me-1" /> Register subscriber
                    </Button>
                }
            </CardBody>
        </Card>
    </Column>
</Row>

@code {
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(20);

    private readonly CancellationTokenSource _cts = new();

    private ChannelNotificationsResult? _feed;
    private bool _feedLoading = true;

    private readonly Dictionary<string, string?> _customerNames = new(StringComparer.Ordinal);

    private SubscriberRegistration? _registration;
    private bool _registrationLoading = true;
    private string _newServiceAccount = string.Empty;
    private bool _saving;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await RefreshFeedAsync();
        await LoadRegistrationAsync();
        _ = PollLoopAsync(_cts.Token);
    }

    private async Task RefreshFeedAsync()
    {
        _feedLoading = true;
        StateHasChanged();
        try
        {
            _feed = await Api.ListNotificationsAsync(_cts.Token);
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            return;
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load notifications: {ex.Message}", Severity.Error);
            _feed = new ChannelNotificationsResult();
        }
        finally
        {
            _feedLoading = false;
            StateHasChanged();
        }

        await ResolveCustomerNamesAsync();
        StateHasChanged();
    }

    private async Task ResolveCustomerNamesAsync()
    {
        if (_feed is not { Notifications.Count: > 0 })
        {
            return;
        }

        var ids = _feed.Notifications
            .Select(n => n.CustomerId)
            .Where(id => !string.IsNullOrEmpty(id) && !_customerNames.ContainsKey(id!))
            .Distinct(StringComparer.Ordinal)
            .ToList();

        foreach (var id in ids)
        {
            try
            {
                var customer = await Api.GetCustomerAsync(id!, _cts.Token);
                _customerNames[id!] = customer?.OrgDisplayName;
            }
            catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
            {
                return;
            }
            catch
            {
                // Leave unresolved; the row falls back to the raw id.
                _customerNames[id!] = null;
            }
        }
    }

    private string CustomerLabel(string? customerId) =>
        customerId is not null && _customerNames.TryGetValue(customerId, out var name) && !string.IsNullOrWhiteSpace(name)
            ? name
            : customerId ?? "—";

    private async Task LoadRegistrationAsync()
    {
        _registrationLoading = true;
        StateHasChanged();
        try
        {
            _registration = await Api.ListSubscribersAsync(_cts.Token);
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            return;
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load subscriber registration: {ex.Message}", Severity.Error);
            _registration = new SubscriberRegistration();
        }
        finally
        {
            _registrationLoading = false;
            StateHasChanged();
        }
    }

    private async Task RegisterAsync()
    {
        var serviceAccount = _newServiceAccount.Trim();
        if (string.IsNullOrWhiteSpace(serviceAccount))
        {
            return;
        }

        _saving = true;
        try
        {
            _registration = await Api.RegisterSubscriberAsync(new RegisterSubscriberRequest { ServiceAccount = serviceAccount }, _cts.Token);
            _newServiceAccount = string.Empty;
            await Snackbar.Add("Subscriber registered.", Severity.Success);
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to register subscriber: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task UnregisterAsync(string serviceAccount)
    {
        _saving = true;
        try
        {
            _registration = await Api.UnregisterSubscriberAsync(serviceAccount, _cts.Token);
            await Snackbar.Add("Subscriber unregistered.", Severity.Success);
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to unregister subscriber: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task PollLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(PollInterval);
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                try
                {
                    _feed = await Api.ListNotificationsAsync(cancellationToken);
                }
                catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
                {
                    break;
                }
                catch
                {
                    continue;
                }

                await ResolveCustomerNamesAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            // Circuit torn down.
        }
    }

    private static Color KindColor(string kind) => kind switch
    {
        "Entitlement" => Color.Primary,
        "Customer" => Color.Info,
        _ => Color.Secondary
    };

    public void Dispose()
    {
        try
        {
            _cts.Cancel();
        }
        catch (ObjectDisposedException)
        {
        }

        _cts.Dispose();
    }
}

