@page "/channel-partner-links/{Id}"
@attribute [Authorize]
@using Blazorise
@inject GChannelApiClient Api
@inject UiNotifier Snackbar
@inject NavigationManager Nav

<PageTitle>@(_link?.PublicId ?? "Channel partner link") · GChannel</PageTitle>

@if (_loading)
{
    <LoadingPanel Title="Loading channel partner link…"
                  Hint="Fetching the link details and the customers it owns." />
}
else if (_link is null)
{
    <Alert Color="Color.Danger" Visible>Channel partner link not found.</Alert>
    <Button Type="ButtonType.Link" To="/channel-partner-links" Color="Color.Secondary" Outline Margin="Margin.Is4.FromTop">
        <Icon Name="@AppIcons.ArrowBack" Class="me-1" /> Back to links
    </Button>
}
else
{
    <Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Margin="Margin.Is4.FromBottom">
        <Div Flex="Flex.AlignItems.Center" Gap="Gap.Is2">
            <Button Type="ButtonType.Link" To="/channel-partner-links" Color="Color.Light" aria-label="Back to links">
                <Icon Name="@AppIcons.ArrowBack" />
            </Button>
            <Div>
                <Heading Size="HeadingSize.Is3" Margin="Margin.Is0">@(_link.ChannelPartner?.PrimaryDomain ?? _link.ResellerCloudIdentityId ?? _link.Id)</Heading>
                <Badge Color="@StateColor(_link.LinkState)">@(_link.LinkState ?? "—")</Badge>
            </Div>
        </Div>
        <Div Flex="Flex.Default" Gap="Gap.Is2">
            <Button Color="Color.Success" Outline Clicked="@(() => ChangeStateAsync("ACTIVE"))" Disabled="@(_busy || IsState("ACTIVE"))">
                <Icon Name="@AppIcons.PlayArrow" Class="me-1" /> Activate
            </Button>
            <Button Color="Color.Warning" Outline Clicked="@(() => ChangeStateAsync("SUSPENDED"))" Disabled="@(_busy || IsState("SUSPENDED"))">
                <Icon Name="@AppIcons.PauseCircle" Class="me-1" /> Suspend
            </Button>
            <Button Type="ButtonType.Link" To="@($"/channel-partner-links/{_link.Id}/repricing")" Color="Color.Secondary" Outline>
                <Icon Name="@AppIcons.Percent" Class="me-1" /> Repricing
            </Button>
        </Div>
    </Div>

    <Row>
        <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop">
            <Card Shadow="Shadow.Small" Margin="Margin.Is4.FromBottom">
                <CardHeader><CardTitle Size="HeadingSize.Is5" Margin="Margin.Is0">Details</CardTitle></CardHeader>
                <CardBody>
                    <Table Narrow Borderless Margin="Margin.Is0">
                        <TableBody>
                            <TableRow><TableRowCell><strong>Link id</strong></TableRowCell><TableRowCell>@_link.Id</TableRowCell></TableRow>
                            <TableRow><TableRowCell><strong>Reseller Cloud Identity</strong></TableRowCell><TableRowCell>@(_link.ResellerCloudIdentityId ?? "—")</TableRowCell></TableRow>
                            <TableRow><TableRowCell><strong>Public id</strong></TableRowCell><TableRowCell>@(_link.PublicId ?? "—")</TableRowCell></TableRow>
                            <TableRow><TableRowCell><strong>State</strong></TableRowCell><TableRowCell>@(_link.LinkState ?? "—")</TableRowCell></TableRow>
                            <TableRow><TableRowCell><strong>Created</strong></TableRowCell><TableRowCell>@(_link.CreateTime?.ToString("u") ?? "—")</TableRowCell></TableRow>
                            <TableRow><TableRowCell><strong>Updated</strong></TableRowCell><TableRowCell>@(_link.UpdateTime?.ToString("u") ?? "—")</TableRowCell></TableRow>
                            <TableRow>
                                <TableRowCell><strong>Invitation</strong></TableRowCell>
                                <TableRowCell>
                                    @if (!string.IsNullOrEmpty(_link.InviteLinkUri))
                                    {
                                        <Anchor To="@_link.InviteLinkUri" Target="Target.Blank">Open invitation</Anchor>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </TableRowCell>
                            </TableRow>
                        </TableBody>
                    </Table>
                </CardBody>
            </Card>
        </Column>

        <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop">
            <Card Shadow="Shadow.Small" Margin="Margin.Is4.FromBottom">
                <CardHeader><CardTitle Size="HeadingSize.Is5" Margin="Margin.Is0">Partner Cloud Identity</CardTitle></CardHeader>
                <CardBody>
                    @if (_link.ChannelPartner is { } ci)
                    {
                        <Table Narrow Borderless Margin="Margin.Is0">
                            <TableBody>
                                <TableRow><TableRowCell><strong>Type</strong></TableRowCell><TableRowCell>@(ci.CustomerType ?? "—")</TableRowCell></TableRow>
                                <TableRow><TableRowCell><strong>Primary domain</strong></TableRowCell><TableRowCell>@(ci.PrimaryDomain ?? "—")</TableRowCell></TableRow>
                                <TableRow>
                                    <TableRowCell><strong>Domain verified</strong></TableRowCell>
                                    <TableRowCell>
                                        <Badge Color="@(ci.IsDomainVerified ? Color.Success : Color.Warning)">@(ci.IsDomainVerified ? "Verified" : "Unverified")</Badge>
                                    </TableRowCell>
                                </TableRow>
                                <TableRow><TableRowCell><strong>Alternate email</strong></TableRowCell><TableRowCell>@(ci.AlternateEmail ?? "—")</TableRowCell></TableRow>
                            </TableBody>
                        </Table>
                    }
                    else
                    {
                        <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is0">
                            No Cloud Identity info yet (the partner may not have accepted the invitation).
                        </Paragraph>
                    }
                </CardBody>
            </Card>
        </Column>
    </Row>

    <Card Shadow="Shadow.Small" Margin="Margin.Is2.OnY">
        <CardHeader>
            <CardTitle Size="HeadingSize.Is5" Margin="Margin.Is0">Estimated business value (monthly)</CardTitle>
            <Small TextColor="TextColor.Secondary">
                Wholesale cost, repriced revenue and your margin across all of this reseller's
                customers' active subscriptions — estimated from list pricing, not invoiced amounts.
            </Small>
        </CardHeader>
        <CardBody>
            @if (_valueLoading)
            {
                <Progress Indeterminate Color="Color.Primary" Size="Size.Small" Margin="Margin.Is2.OnY" />
            }
            else if (_value is { PricedEntitlementCount: > 0 } v)
            {
                <Row>
                    <Column ColumnSize="ColumnSize.Is12.Is4.OnTablet">
                        <Small TextColor="TextColor.Secondary" Display="Display.Block" Class="text-uppercase">Wholesale cost</Small>
                        <Heading Size="HeadingSize.Is4" Margin="Margin.Is0">@FormatMoney(v.WholesaleMonthly, v.Currency)</Heading>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.Is4.OnTablet">
                        <Small TextColor="TextColor.Secondary" Display="Display.Block" Class="text-uppercase">Repriced revenue</Small>
                        <Heading Size="HeadingSize.Is4" Margin="Margin.Is0">@FormatMoney(v.RevenueMonthly, v.Currency)</Heading>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.Is4.OnTablet">
                        <Small TextColor="TextColor.Secondary" Display="Display.Block" Class="text-uppercase">Margin</Small>
                        <Heading Size="HeadingSize.Is4" Margin="Margin.Is0" TextColor="@(v.MarginMonthly >= 0 ? TextColor.Success : TextColor.Danger)">@FormatMoney(v.MarginMonthly, v.Currency)</Heading>
                    </Column>
                </Row>
                <Small TextColor="TextColor.Secondary" Display="Display.Block" Margin="Margin.Is1.FromTop">
                    @v.CustomerCount customer(s) · @v.ActiveSeats active seat(s) · @v.PricedEntitlementCount priced subscription(s)@(v.UnpricedEntitlementCount > 0 ? $"; {v.UnpricedEntitlementCount} unpriced (excluded)" : "").@(v.MixedCurrencies ? $" Headline shows the dominant currency ({v.Currency}); every currency is broken out below." : "")
                </Small>
                @if (v.MixedCurrencies)
                {
                    <Table Narrow Hoverable Borderless Margin="Margin.Is2.FromTop">
                        <TableHeader>
                            <TableRow>
                                <TableHeaderCell>Currency</TableHeaderCell>
                                <TableHeaderCell TextAlignment="TextAlignment.End">Wholesale cost</TableHeaderCell>
                                <TableHeaderCell TextAlignment="TextAlignment.End">Repriced revenue</TableHeaderCell>
                                <TableHeaderCell TextAlignment="TextAlignment.End">Margin</TableHeaderCell>
                                <TableHeaderCell TextAlignment="TextAlignment.End">Seats</TableHeaderCell>
                                <TableHeaderCell TextAlignment="TextAlignment.End">Subscriptions</TableHeaderCell>
                            </TableRow>
                        </TableHeader>
                        <TableBody>
                            @foreach (var cur in v.Currencies)
                            {
                                <TableRow>
                                    <TableRowCell>@cur.Currency</TableRowCell>
                                    <TableRowCell TextAlignment="TextAlignment.End">@cur.WholesaleMonthly.ToString("N2")</TableRowCell>
                                    <TableRowCell TextAlignment="TextAlignment.End">@cur.RevenueMonthly.ToString("N2")</TableRowCell>
                                    <TableRowCell TextAlignment="TextAlignment.End" TextColor="@(cur.MarginMonthly >= 0 ? TextColor.Success : TextColor.Danger)">@cur.MarginMonthly.ToString("N2")</TableRowCell>
                                    <TableRowCell TextAlignment="TextAlignment.End">@cur.ActiveSeats</TableRowCell>
                                    <TableRowCell TextAlignment="TextAlignment.End">@cur.PricedEntitlementCount</TableRowCell>
                                </TableRow>
                            }
                        </TableBody>
                    </Table>
                }
            }
            else
            {
                <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is0">
                    No priced subscriptions for this reseller yet@(_value is { UnpricedEntitlementCount: > 0 } u ? $" ({u.UnpricedEntitlementCount} unpriced)" : "") — values appear once the background read-model has priced this reseller's entitlements.
                </Paragraph>
            }
        </CardBody>
    </Card>

    @if (_spend is { Unconfigured: false })
    {
        <Card Shadow="Shadow.Small" Margin="Margin.Is2.FromTop">
            <CardHeader>
                <Div Flex="Flex.JustifyContent.Between.AlignItems.Start">
                    <Div>
                        <CardTitle Size="HeadingSize.Is5" Margin="Margin.Is0">Billed spend (actual)</CardTitle>
                        <Small TextColor="TextColor.Secondary">
                            Actual GCP/Marketplace spend across this partner's customers from the Cloud Billing → BigQuery
                            cost export — real billed figures, not the list-price estimate above.
                        </Small>
                    </Div>
                    @if (_spend.AsOf is { } asOf)
                    {
                        <Small TextColor="TextColor.Secondary" Class="text-nowrap">as of @asOf.LocalDateTime.ToString("g")</Small>
                    }
                </Div>
            </CardHeader>
            <CardBody>
                @if (_spendLoading)
                {
                    <Progress Indeterminate Color="Color.Primary" Size="Size.Small" Margin="Margin.Is2.OnY" />
                }
                else if (_spend.Months is { Count: > 0 })
                {
                    <Table Narrow Hoverable Borderless Margin="Margin.Is0">
                        <TableHeader>
                            <TableRow>
                                <TableHeaderCell>Invoice month</TableHeaderCell>
                                <TableHeaderCell TextAlignment="TextAlignment.End">Net cost</TableHeaderCell>
                                <TableHeaderCell TextAlignment="TextAlignment.End">Gross</TableHeaderCell>
                                <TableHeaderCell TextAlignment="TextAlignment.End">Credits</TableHeaderCell>
                                <TableHeaderCell>Currency</TableHeaderCell>
                            </TableRow>
                        </TableHeader>
                        <TableBody>
                            @foreach (var m in _spend.Months.OrderByDescending(m => m.InvoiceMonth).ThenBy(m => m.Currency))
                            {
                                <TableRow>
                                    <TableRowCell>@FormatMonth(m.InvoiceMonth)</TableRowCell>
                                    <TableRowCell TextAlignment="TextAlignment.End">@m.Cost.ToString("N2")</TableRowCell>
                                    <TableRowCell TextAlignment="TextAlignment.End">@m.GrossCost.ToString("N2")</TableRowCell>
                                    <TableRowCell TextAlignment="TextAlignment.End">@m.Credits.ToString("N2")</TableRowCell>
                                    <TableRowCell>@m.Currency</TableRowCell>
                                </TableRow>
                            }
                        </TableBody>
                    </Table>
                }
                else
                {
                    <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is0">
                        No billed spend recorded for this partner's customers yet.
                    </Paragraph>
                }
            </CardBody>
        </Card>
    }

    <Card Shadow="Shadow.Small" Margin="Margin.Is2.FromTop">
        <CardHeader>
            <Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Gap="Gap.Is2" Class="flex-wrap">
                <Div>
                    <CardTitle Size="HeadingSize.Is5" Margin="Margin.Is0">Customers owned by this partner</CardTitle>
                    <Small TextColor="TextColor.Secondary">Customers whose <code>ChannelPartnerId</code> resolves to this link.</Small>
                </Div>
                <Div Flex="Flex.AlignItems.Center" Gap="Gap.Is2">
                    <GuidedWalkthrough Id="partner-customers" Steps="_walkthrough" />
                    <Button Color="Color.Secondary" Outline Size="Size.Small" Clicked="OpenImportDialog" Disabled="@_busy" data-walkthrough="pc-import">
                        <Icon Name="@AppIcons.CloudDownload" Class="me-1" /> Import customer
                    </Button>
                    <Button Color="Color.Primary" Size="Size.Small" Clicked="AddCustomer" Disabled="@_busy" data-walkthrough="pc-add">
                        <Icon Name="@AppIcons.PersonAdd" Class="me-1" /> Add customer
                    </Button>
                </Div>
            </Div>
        </CardHeader>
        <CardBody>
            @if (_customersLoading)
            {
                <Progress Indeterminate Color="Color.Primary" Size="Size.Small" Margin="Margin.Is2.OnY" />
            }
            else if (_customers is { Count: > 0 })
            {
                <Table Narrow Hoverable Responsive Margin="Margin.Is0" data-walkthrough="pc-table">
                    <TableHeader>
                        <TableRow>
                            <TableHeaderCell>Organization</TableHeaderCell>
                            <TableHeaderCell>Domain</TableHeaderCell>
                            <TableHeaderCell>Subscriptions</TableHeaderCell>
                            <TableHeaderCell>Renewal</TableHeaderCell>
                            <TableHeaderCell>Auto-renew</TableHeaderCell>
                            <TableHeaderCell TextAlignment="TextAlignment.End">Est. monthly</TableHeaderCell>
                            <TableHeaderCell>Created</TableHeaderCell>
                            <TableHeaderCell TextAlignment="TextAlignment.End">Actions</TableHeaderCell>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @foreach (var customer in _customers)
                        {
                            var est = EstateFor(customer.Id);
                            <TableRow>
                                <TableRowCell>@(customer.OrgDisplayName ?? customer.Id)</TableRowCell>
                                <TableRowCell>@customer.Domain</TableRowCell>
                                <TableRowCell>
                                    @if (est is not null)
                                    {
                                        <span>@est.ActiveSubscriptions Active</span>
                                        @if (est.SuspendedSubscriptions > 0)
                                        {
                                            <span class="text-body-secondary"> · @est.SuspendedSubscriptions Suspended</span>
                                        }
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </TableRowCell>
                                <TableRowCell>
                                    @if (est?.NextRenewalUtc is { } r)
                                    {
                                        <Tooltip Text="@(est.NextRenewalOfferName ?? "Next commitment renewal")" Inline>
                                            <div>
                                                <div>@r.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</div>
                                                @if (!string.IsNullOrEmpty(est.NextRenewalOfferName))
                                                {
                                                    <Small TextColor="TextColor.Secondary">@est.NextRenewalOfferName</Small>
                                                }
                                            </div>
                                        </Tooltip>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </TableRowCell>
                                <TableRowCell>
                                    @if (est?.NextRenewalAutoRenew is true)
                                    {
                                        <Tooltip Text="Auto-renewal is on for the next renewing subscription." Inline>
                                            <Badge Color="Color.Success"><Icon Name="@AppIcons.Autorenew" Class="me-1" />On</Badge>
                                        </Tooltip>
                                    }
                                    else if (est?.NextRenewalAutoRenew is false)
                                    {
                                        <Tooltip Text="Auto-renewal is off — the next renewing subscription will not renew automatically." Inline>
                                            <Badge Color="Color.Warning"><Icon Name="@AppIcons.Block" Class="me-1" />Off</Badge>
                                        </Tooltip>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </TableRowCell>
                                <TableRowCell TextAlignment="TextAlignment.End">
                                    @if (est?.EstimatedMonthlyTotal is { } v)
                                    {
                                        <Tooltip Text="Estimated from offer list pricing with repricing applied — not invoiced." Inline>
                                            <span>@FormatMoney(v, est.Currency)</span>
                                        </Tooltip>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </TableRowCell>
                                <TableRowCell>@(customer.CreateTime?.ToString("yyyy-MM-dd") ?? "—")</TableRowCell>
                                <TableRowCell TextAlignment="TextAlignment.End">
                                    <Div Flex="Flex.JustifyContent.End" Gap="Gap.Is1" Class="text-nowrap">
                                        <Tooltip Text="View customer" Inline>
                                            <Button Type="ButtonType.Link" To="@($"/customers/{customer.Id}")" Size="Size.Small" Color="Color.Light" aria-label="View customer"><Icon Name="@AppIcons.Visibility" /></Button>
                                        </Tooltip>
                                        <Tooltip Text="Edit customer" Inline>
                                            <Button Type="ButtonType.Link" To="@($"/customers/edit/{customer.Id}?linkId={Id}")" Size="Size.Small" Color="Color.Light" aria-label="Edit customer"><Icon Name="@AppIcons.Edit" /></Button>
                                        </Tooltip>
                                        <Tooltip Text="Delete customer" Inline>
                                            <Button Size="Size.Small" Color="Color.Danger" Outline Clicked="@(() => DeleteCustomerAsync(customer))" Disabled="@_busy" aria-label="Delete customer"><Icon Name="@AppIcons.Delete" /></Button>
                                        </Tooltip>
                                    </Div>
                                </TableRowCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
            }
            else
            {
                <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is0">No customers owned by this partner.</Paragraph>
            }
        </CardBody>
    </Card>

    <Modal @bind-Visible="_importOpen">
        <ModalContent Centered>
            <ModalHeader>
                <ModalTitle>Import existing customer</ModalTitle>
                <CloseButton />
            </ModalHeader>
            <ModalBody>
                <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is3.FromBottom">
                    Import a customer that already has a Cloud Identity into this partner. Provide one
                    identifier (domain, Cloud Identity id, or primary admin email).
                </Paragraph>
                <Field>
                    <FieldLabel>Primary domain</FieldLabel>
                    <TextInput @bind-Value="_import.Domain" />
                    <FieldHelp>e.g. contoso.com</FieldHelp>
                </Field>
                <Field>
                    <FieldLabel>Cloud Identity id</FieldLabel>
                    <TextInput @bind-Value="_import.CloudIdentityId" />
                </Field>
                <Field>
                    <FieldLabel>Primary admin email</FieldLabel>
                    <TextInput @bind-Value="_import.PrimaryAdminEmail" Role="TextRole.Email" />
                </Field>
                <Field>
                    <Check TValue="bool" @bind-Value="_import.OverwriteIfExists">Overwrite if the customer is already imported</Check>
                </Field>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary" Clicked="@(() => _importOpen = false)" Disabled="@_busy">Cancel</Button>
                <Button Color="Color.Primary" Clicked="ImportAsync" Disabled="@_busy" Loading="@_busy">
                    @(_busy ? "Importing…" : "Import")
                </Button>
            </ModalFooter>
        </ModalContent>
    </Modal>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private ChannelPartnerLink? _link;
    private IReadOnlyList<Customer>? _customers;
    private ResellerEstateValue? _value;
    private ResellerSpendDetailResult? _spend;
    private bool _loading = true;
    private bool _customersLoading = true;
    private bool _valueLoading = true;
    private bool _spendLoading = true;
    private bool _busy;

    // §9 onboarding: walkthrough for the §12.1 n-tier customer CRUD on this page.
    private static readonly IReadOnlyList<WalkthroughStep> _walkthrough =
    [
        new(null, "Manage this partner's customers", "You can create, import, edit and remove customers that sit directly under this channel partner (n-tier)."),
        new("[data-walkthrough=\"pc-add\"]", "Add a customer", "Create a brand-new customer owned by this partner — same form as a direct customer, but attributed to this link."),
        new("[data-walkthrough=\"pc-import\"]", "Import a customer", "Bring in a customer that already has a Cloud Identity (by domain, Cloud Identity id, or admin email)."),
        new("[data-walkthrough=\"pc-table\"]", "Edit or remove", "Each row deep-links to the customer and offers Edit / Delete actions scoped to this partner."),
    ];

    private bool _importOpen;
    private readonly ImportCustomerModel _import = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _link = await Api.GetChannelPartnerLinkAsync(Id);
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load channel partner link: {ex.Message}", Severity.Error);
            _link = null;
        }
        finally
        {
            _loading = false;
        }

        if (_link is not null)
        {
            await LoadCustomersAsync();
            await LoadValueAsync();
            await LoadSpendAsync();
        }
    }

    private async Task LoadSpendAsync()
    {
        _spendLoading = true;
        try
        {
            _spend = await Api.GetResellerSpendDetailAsync(Id, 13);
        }
        catch
        {
            // Billed spend is best-effort (export may be unconfigured); ignore so the page renders.
            _spend = null;
        }
        finally
        {
            _spendLoading = false;
        }
    }

    private async Task LoadValueAsync()
    {
        _valueLoading = true;
        try
        {
            _value = await Api.GetResellerValueAsync(Id);
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load reseller value: {ex.Message}", Severity.Error);
            _value = null;
        }
        finally
        {
            _valueLoading = false;
        }
    }

    private async Task LoadCustomersAsync()
    {
        _customersLoading = true;
        try
        {
            var result = await Api.ListChannelPartnerCustomersAsync(Id);
            _customers = result?.Customers ?? [];
            await LoadEstateRollupsAsync();
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load partner customers: {ex.Message}", Severity.Error);
            _customers = [];
        }
        finally
        {
            _customersLoading = false;
        }
    }

    // Per-customer read-model rollups (subscription counts, next renewal, auto-renew, estimated
    // monthly value) keyed by customer id, so the roster can show the same columns as the Customers
    // page. Best-effort: rows not yet in the read-model simply show "—".
    private readonly Dictionary<string, EstateCustomer> _estate = new(StringComparer.OrdinalIgnoreCase);

    private EstateCustomer? EstateFor(string customerId) =>
        _estate.TryGetValue(customerId, out var e) ? e : null;

    private async Task LoadEstateRollupsAsync()
    {
        _estate.Clear();
        try
        {
            var page = 0;
            while (true)
            {
                var result = await Api.ListEstateCustomersAsync(page, 200, "org", false, null, Id);
                var items = result?.Items;
                if (items is null || items.Count == 0)
                {
                    break;
                }

                foreach (var e in items)
                {
                    _estate[e.CustomerId] = e;
                }

                if (items.Count < 200 || _estate.Count >= result!.Total)
                {
                    break;
                }

                page++;
            }
        }
        catch
        {
            // Best-effort enrichment — the extra columns fall back to "—" if this fails.
        }
    }

    private bool IsState(string state) =>
        string.Equals(_link?.LinkState, state, StringComparison.OrdinalIgnoreCase);

    private static string FormatMoney(decimal value, string? currency) =>
        string.IsNullOrEmpty(currency)
            ? value.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)
            : $"{currency} {value.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)}";

    private void AddCustomer() =>
        Nav.NavigateTo($"/customers/new?linkId={Id}");

    private void OpenImportDialog()
    {
        _import.Reset();
        _importOpen = true;
    }

    private async Task ImportAsync()
    {
        if (string.IsNullOrWhiteSpace(_import.Domain)
            && string.IsNullOrWhiteSpace(_import.CloudIdentityId)
            && string.IsNullOrWhiteSpace(_import.PrimaryAdminEmail))
        {
            await Snackbar.Add("Provide a domain, Cloud Identity id, or primary admin email to import.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var imported = await Api.ImportChannelPartnerCustomerAsync(Id, new ImportCustomerRequest
            {
                Domain = _import.Domain,
                CloudIdentityId = _import.CloudIdentityId,
                PrimaryAdminEmail = _import.PrimaryAdminEmail,
                OverwriteIfExists = _import.OverwriteIfExists
            });

            await Snackbar.Add($"Imported {imported?.OrgDisplayName ?? imported?.Domain ?? "customer"}.", Severity.Success);
            _importOpen = false;
            await LoadCustomersAsync();
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to import customer: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteCustomerAsync(Customer customer)
    {
        var confirmed = await Snackbar.ConfirmAsync(
            "Delete customer",
            $"Delete {customer.OrgDisplayName ?? customer.Domain ?? customer.Id}? This cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");
        if (!confirmed)
        {
            return;
        }

        _busy = true;
        try
        {
            await Api.DeleteChannelPartnerCustomerAsync(Id, customer.Id);
            await Snackbar.Add("Customer deleted.", Severity.Success);
            await LoadCustomersAsync();
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to delete customer: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class ImportCustomerModel
    {
        public string? Domain { get; set; }
        public string? CloudIdentityId { get; set; }
        public string? PrimaryAdminEmail { get; set; }
        public bool OverwriteIfExists { get; set; }

        public void Reset()
        {
            Domain = null;
            CloudIdentityId = null;
            PrimaryAdminEmail = null;
            OverwriteIfExists = false;
        }
    }

    private async Task ChangeStateAsync(string state)
    {
        _busy = true;
        try
        {
            var updated = await Api.UpdateChannelPartnerLinkStateAsync(Id, new UpdateChannelPartnerLinkRequest
            {
                LinkState = state
            });

            if (updated is not null)
            {
                _link = updated;
            }
            await Snackbar.Add($"Link set to {state}.", Severity.Success);
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to update link state: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private static Color StateColor(string? state) => state?.ToUpperInvariant() switch
    {
        "ACTIVE" => Color.Success,
        "INVITED" => Color.Info,
        "SUSPENDED" => Color.Warning,
        "REVOKED" => Color.Danger,
        _ => Color.Secondary
    };

    private static string FormatMonth(string invoiceMonth) =>
        DateTime.TryParseExact(invoiceMonth, "yyyyMM", System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var d)
            ? d.ToString("MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)
            : invoiceMonth;
}

