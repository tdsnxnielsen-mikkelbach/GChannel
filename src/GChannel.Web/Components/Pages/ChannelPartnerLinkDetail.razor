@page "/channel-partner-links/{Id}"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject UiNotifier Snackbar
@inject NavigationManager Nav
@inject DialogService Dialogs

<PageTitle>@(_link?.PublicId ?? "Channel partner link") · GChannel</PageTitle>

@if (_loading)
{
    <LoadingPanel Title="Loading channel partner link…"
                  Hint="Fetching the link details and the customers it owns." />
}
else if (_link is null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">Channel partner link not found.</RadzenAlert>
    <LinkButton To="/channel-partner-links" Text="Back to links" Icon="@AppIcons.ArrowBack" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Class="rz-mt-4" />
}
else
{
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap" class="rz-mb-4">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
            <LinkButton To="/channel-partner-links" Icon="@AppIcons.ArrowBack" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Title="Back to links" />
            <div>
                <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">@(_link.ChannelPartner?.PrimaryDomain ?? _link.ResellerCloudIdentityId ?? _link.Id)</RadzenText>
                <RadzenBadge BadgeStyle="@StateColor(_link.LinkState)" Text="@(_link.LinkState ?? "—")" />
            </div>
        </RadzenStack>
        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <RadzenButton Text="Activate" Icon="@AppIcons.PlayArrow" ButtonStyle="ButtonStyle.Success" Variant="Variant.Outlined" Click="@(() => ChangeStateAsync("ACTIVE"))" Disabled="@(_busy || IsState("ACTIVE"))" />
            <RadzenButton Text="Suspend" Icon="@AppIcons.PauseCircle" ButtonStyle="ButtonStyle.Warning" Variant="Variant.Outlined" Click="@(() => ChangeStateAsync("SUSPENDED"))" Disabled="@(_busy || IsState("SUSPENDED"))" />
            <LinkButton To="@($"/channel-partner-links/{_link.Id}/repricing")" Text="Repricing" Icon="@AppIcons.Percent" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" />
        </RadzenStack>
    </RadzenStack>

    <RadzenRow Gap="1rem" RowGap="1rem" class="rz-mb-4">
        <RadzenColumn Size="12" SizeLG="6">
            <RadzenCard Variant="Variant.Filled" class="rz-h-100">
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">Details</RadzenText>
                <RadzenStack Gap="0.5rem">
                    <DetailRow Label="Link id">@_link.Id</DetailRow>
                    <DetailRow Label="Reseller Cloud Identity">@(_link.ResellerCloudIdentityId ?? "—")</DetailRow>
                    <DetailRow Label="Public id">@(_link.PublicId ?? "—")</DetailRow>
                    <DetailRow Label="State">@(_link.LinkState ?? "—")</DetailRow>
                    <DetailRow Label="Created">@DisplayFormat.Timestamp(_link.CreateTime)</DetailRow>
                    <DetailRow Label="Updated">@DisplayFormat.Timestamp(_link.UpdateTime)</DetailRow>
                    <DetailRow Label="Invitation">
                        @if (!string.IsNullOrEmpty(_link.InviteLinkUri))
                        {
                            <RadzenLink Path="@_link.InviteLinkUri" Target="_blank" Text="Open invitation" />
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </DetailRow>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeLG="6">
            <RadzenCard Variant="Variant.Filled" class="rz-h-100">
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">Partner Cloud Identity</RadzenText>
                @if (_link.ChannelPartner is { } ci)
                {
                    <RadzenStack Gap="0.5rem">
                        <DetailRow Label="Type">@(ci.CustomerType ?? "—")</DetailRow>
                        <DetailRow Label="Primary domain">@(ci.PrimaryDomain ?? "—")</DetailRow>
                        <DetailRow Label="Domain verified">
                            <RadzenBadge BadgeStyle="@(ci.IsDomainVerified ? BadgeStyle.Success : BadgeStyle.Warning)" Text="@(ci.IsDomainVerified ? "Verified" : "Unverified")" />
                        </DetailRow>
                        <DetailRow Label="Alternate email">@(ci.AlternateEmail ?? "—")</DetailRow>
                    </RadzenStack>
                }
                else
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-m-0">
                        No Cloud Identity info yet (the partner may not have accepted the invitation).
                    </RadzenText>
                }
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>

    <RadzenCard Variant="Variant.Filled" class="rz-my-2">
        <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">Estimated business value (monthly)</RadzenText>
        <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-mb-3">
            Wholesale cost, repriced revenue and your margin across all of this reseller's
            customers' active subscriptions — estimated from list pricing, not invoiced amounts.
        </RadzenText>
        @if (_valueLoading)
        {
            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" class="rz-my-2" />
        }
        else if (_value is { PricedEntitlementCount: > 0 } v)
        {
            <RadzenRow Gap="1rem" RowGap="1rem">
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenText TextStyle="TextStyle.Overline" class="rz-text-secondary-color rz-m-0">Wholesale cost</RadzenText>
                    <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">@FormatMoney(v.WholesaleMonthly, v.Currency)</RadzenText>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenText TextStyle="TextStyle.Overline" class="rz-text-secondary-color rz-m-0">Repriced revenue</RadzenText>
                    <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">@FormatMoney(v.RevenueMonthly, v.Currency)</RadzenText>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenText TextStyle="TextStyle.Overline" class="rz-text-secondary-color rz-m-0">Margin</RadzenText>
                    <RadzenText TextStyle="TextStyle.H5" class="@($"rz-m-0 {(v.MarginMonthly >= 0 ? "rz-color-success" : "rz-color-danger")}")">@FormatMoney(v.MarginMonthly, v.Currency)</RadzenText>
                </RadzenColumn>
            </RadzenRow>
            <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" class="rz-text-secondary-color rz-mt-1 rz-mb-0">
                @v.CustomerCount customer(s) · @v.ActiveSeats active seat(s) · @v.PricedEntitlementCount priced subscription(s)@(v.UnpricedEntitlementCount > 0 ? $"; {v.UnpricedEntitlementCount} unpriced (excluded)" : "").@(v.MixedCurrencies ? $" Headline shows the dominant currency ({v.Currency}); every currency is broken out below." : "")
            </RadzenText>
            @if (v.MixedCurrencies)
            {
                <table class="gchannel-table gchannel-table-hover rz-mt-2">
                    <thead>
                        <tr>
                            <th>Currency</th>
                            <th class="num">Wholesale cost</th>
                            <th class="num">Repriced revenue</th>
                            <th class="num">Margin</th>
                            <th class="num">Seats</th>
                            <th class="num">Subscriptions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cur in v.Currencies)
                        {
                            <tr>
                                <td>@cur.Currency</td>
                                <td class="num">@cur.WholesaleMonthly.ToString("N2")</td>
                                <td class="num">@cur.RevenueMonthly.ToString("N2")</td>
                                <td class="@($"num {(cur.MarginMonthly >= 0 ? "rz-color-success" : "rz-color-danger")}")">@cur.MarginMonthly.ToString("N2")</td>
                                <td class="num">@cur.ActiveSeats</td>
                                <td class="num">@cur.PricedEntitlementCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
        else
        {
            <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-m-0">
                No priced subscriptions for this reseller yet@(_value is { UnpricedEntitlementCount: > 0 } u ? $" ({u.UnpricedEntitlementCount} unpriced)" : "") — values appear once the background read-model has priced this reseller's entitlements.
            </RadzenText>
        }
    </RadzenCard>

    @if (_spend is { Unconfigured: false })
    {
        <RadzenCard Variant="Variant.Filled" class="rz-mt-2">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Start" Gap="1rem" class="rz-mb-3">
                <div>
                    <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">Billed spend (actual)</RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">
                        Actual GCP/Marketplace spend across this partner's customers from the Cloud Billing → BigQuery
                        cost export — real billed figures, not the list-price estimate above.
                    </RadzenText>
                </div>
                @if (_spend.AsOf is { } asOf)
                {
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0 rz-text-nowrap">as of @DisplayFormat.Timestamp(asOf)</RadzenText>
                }
            </RadzenStack>
            @if (_spendLoading)
            {
                <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" class="rz-my-2" />
            }
            else if (_spend.Months is { Count: > 0 })
            {
                <table class="gchannel-table gchannel-table-hover">
                    <thead>
                        <tr>
                            <th>Invoice month</th>
                            <th class="num">Net cost</th>
                            <th class="num">Gross</th>
                            <th class="num">Credits</th>
                            <th>Currency</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in _spend.Months.OrderByDescending(m => m.InvoiceMonth).ThenBy(m => m.Currency))
                        {
                            <tr>
                                <td>@FormatMonth(m.InvoiceMonth)</td>
                                <td class="num">@m.Cost.ToString("N2")</td>
                                <td class="num">@m.GrossCost.ToString("N2")</td>
                                <td class="num">@m.Credits.ToString("N2")</td>
                                <td>@m.Currency</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-m-0">
                    No billed spend recorded for this partner's customers yet.
                </RadzenText>
            }
        </RadzenCard>
    }

    <RadzenCard Variant="Variant.Filled" class="rz-mt-2">
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap" class="rz-mb-3">
            <div>
                <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">Customers owned by this partner</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">Customers whose <code>ChannelPartnerId</code> resolves to this link.</RadzenText>
            </div>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <GuidedWalkthrough Id="partner-customers" Steps="_walkthrough" />
                <RadzenButton Text="Import customer" Icon="@AppIcons.CloudDownload" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="OpenImportDialogAsync" Disabled="@_busy" data-walkthrough="pc-import" />
                <RadzenButton Text="Add customer" Icon="@AppIcons.PersonAdd" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="AddCustomer" Disabled="@_busy" data-walkthrough="pc-add" />
            </RadzenStack>
        </RadzenStack>
        @if (_customersLoading)
        {
            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" class="rz-my-2" />
        }
        else if (_customers is { Count: > 0 })
        {
            <div data-walkthrough="pc-table">
                <RadzenDataGrid TItem="Customer" Data="_customers" AllowPaging="false" AllowSorting="false" Density="Density.Compact" GridLines="DataGridGridLines.Horizontal" Responsive="true">
                    <Columns>
                        <RadzenDataGridColumn TItem="Customer" Title="Organization">
                            <Template Context="customer">@(customer.OrgDisplayName ?? customer.Id)</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Customer" Property="@nameof(Customer.Domain)" Title="Domain" />
                        <RadzenDataGridColumn TItem="Customer" Title="Subscriptions">
                            <Template Context="customer">
                                @if (EstateFor(customer.Id) is { } est)
                                {
                                    <span>@est.ActiveSubscriptions Active</span>
                                    @if (est.SuspendedSubscriptions > 0)
                                    {
                                        <span class="rz-text-secondary-color"> · @est.SuspendedSubscriptions Suspended</span>
                                    }
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Customer" Title="Renewal">
                            <Template Context="customer">
                                @if (EstateFor(customer.Id) is { NextRenewalUtc: { } r } est)
                                {
                                    <Tip Text="@(est.NextRenewalOfferName ?? "Next commitment renewal")">
                                        <div>
                                            <div>@DisplayFormat.Date(r)</div>
                                            @if (!string.IsNullOrEmpty(est.NextRenewalOfferName))
                                            {
                                                <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Div" class="rz-text-secondary-color rz-m-0">@est.NextRenewalOfferName</RadzenText>
                                            }
                                        </div>
                                    </Tip>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Customer" Title="Auto-renew">
                            <Template Context="customer">
                                @{ var est = EstateFor(customer.Id); }
                                @if (est?.NextRenewalAutoRenew is true)
                                {
                                    <Tip Text="Auto-renewal is on for the next renewing subscription.">
                                        <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="On" />
                                    </Tip>
                                }
                                else if (est?.NextRenewalAutoRenew is false)
                                {
                                    <Tip Text="Auto-renewal is off — the next renewing subscription will not renew automatically.">
                                        <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="Off" />
                                    </Tip>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Customer" Title="Est. monthly" TextAlign="TextAlign.End">
                            <Template Context="customer">
                                @if (EstateFor(customer.Id) is { EstimatedMonthlyTotal: { } v } est)
                                {
                                    <Tip Text="Estimated from offer list pricing with repricing applied — not invoiced.">@FormatMoney(v, est.Currency)</Tip>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Customer" Title="Created" Width="110px">
                            <Template Context="customer">@DisplayFormat.Date(customer.CreateTime)</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Customer" Title="Actions" TextAlign="TextAlign.End" Width="140px">
                            <Template Context="customer">
                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.25rem" class="rz-text-nowrap">
                                    <Tip Text="View customer">
                                        <LinkButton To="@($"/customers/{customer.Id}")" Icon="@AppIcons.Visibility" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Title="View customer" />
                                    </Tip>
                                    <Tip Text="Edit customer">
                                        <LinkButton To="@($"/customers/edit/{customer.Id}?linkId={Id}")" Icon="@AppIcons.Edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Title="Edit customer" />
                                    </Tip>
                                    <Tip Text="Delete customer">
                                        <RadzenButton Icon="@AppIcons.Delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="@(() => DeleteCustomerAsync(customer))" Disabled="@_busy" aria-label="Delete customer" />
                                    </Tip>
                                </RadzenStack>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </div>
        }
        else
        {
            <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-m-0">No customers owned by this partner.</RadzenText>
        }
    </RadzenCard>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private ChannelPartnerLink? _link;
    private IReadOnlyList<Customer>? _customers;
    private ResellerEstateValue? _value;
    private ResellerSpendDetailResult? _spend;
    private bool _loading = true;
    private bool _customersLoading = true;
    private bool _valueLoading = true;
    private bool _spendLoading = true;
    private bool _busy;

    // §9 onboarding: walkthrough for the §12.1 n-tier customer CRUD on this page.
    private static readonly IReadOnlyList<WalkthroughStep> _walkthrough =
    [
        new(null, "Manage this partner's customers", "You can create, import, edit and remove customers that sit directly under this channel partner (n-tier)."),
        new("[data-walkthrough=\"pc-add\"]", "Add a customer", "Create a brand-new customer owned by this partner — same form as a direct customer, but attributed to this link."),
        new("[data-walkthrough=\"pc-import\"]", "Import a customer", "Bring in a customer that already has a Cloud Identity (by domain, Cloud Identity id, or admin email)."),
        new("[data-walkthrough=\"pc-table\"]", "Edit or remove", "Each row deep-links to the customer and offers Edit / Delete actions scoped to this partner."),
    ];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _link = await Api.GetChannelPartnerLinkAsync(Id);
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load channel partner link: {ex.Message}", Severity.Error);
            _link = null;
        }
        finally
        {
            _loading = false;
        }

        if (_link is not null)
        {
            await LoadCustomersAsync();
            await LoadValueAsync();
            await LoadSpendAsync();
        }
    }

    private async Task LoadSpendAsync()
    {
        _spendLoading = true;
        try
        {
            _spend = await Api.GetResellerSpendDetailAsync(Id, 13);
        }
        catch
        {
            // Billed spend is best-effort (export may be unconfigured); ignore so the page renders.
            _spend = null;
        }
        finally
        {
            _spendLoading = false;
        }
    }

    private async Task LoadValueAsync()
    {
        _valueLoading = true;
        try
        {
            _value = await Api.GetResellerValueAsync(Id);
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load reseller value: {ex.Message}", Severity.Error);
            _value = null;
        }
        finally
        {
            _valueLoading = false;
        }
    }

    private async Task LoadCustomersAsync()
    {
        _customersLoading = true;
        try
        {
            var result = await Api.ListChannelPartnerCustomersAsync(Id);
            _customers = result?.Customers ?? [];
            await LoadEstateRollupsAsync();
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load partner customers: {ex.Message}", Severity.Error);
            _customers = [];
        }
        finally
        {
            _customersLoading = false;
        }
    }

    // Per-customer read-model rollups (subscription counts, next renewal, auto-renew, estimated
    // monthly value) keyed by customer id, so the roster can show the same columns as the Customers
    // page. Best-effort: rows not yet in the read-model simply show "—".
    private readonly Dictionary<string, EstateCustomer> _estate = new(StringComparer.OrdinalIgnoreCase);

    private EstateCustomer? EstateFor(string customerId) =>
        _estate.TryGetValue(customerId, out var e) ? e : null;

    private async Task LoadEstateRollupsAsync()
    {
        _estate.Clear();
        try
        {
            var page = 0;
            while (true)
            {
                var result = await Api.ListEstateCustomersAsync(page, 200, "org", false, null, Id);
                var items = result?.Items;
                if (items is null || items.Count == 0)
                {
                    break;
                }

                foreach (var e in items)
                {
                    _estate[e.CustomerId] = e;
                }

                if (items.Count < 200 || _estate.Count >= result!.Total)
                {
                    break;
                }

                page++;
            }
        }
        catch
        {
            // Best-effort enrichment — the extra columns fall back to "—" if this fails.
        }
    }

    private bool IsState(string state) =>
        string.Equals(_link?.LinkState, state, StringComparison.OrdinalIgnoreCase);

    private static string FormatMoney(decimal value, string? currency) =>
        string.IsNullOrEmpty(currency)
            ? value.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)
            : $"{currency} {value.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)}";

    private void AddCustomer() =>
        Nav.NavigateTo($"/customers/new?linkId={Id}");

    private async Task OpenImportDialogAsync()
    {
        var linkId = Id;
        var imported = await Dialogs.OpenAsync<ImportCustomerDialog>("Import existing customer", new Dictionary<string, object?>
        {
            [nameof(ImportCustomerDialog.Description)] = "Import a customer that already has a Cloud Identity into this partner. Provide one identifier (domain, Cloud Identity id, or primary admin email).",
            [nameof(ImportCustomerDialog.Import)] = new Func<ImportCustomerRequest, Task<Customer?>>(request => Api.ImportChannelPartnerCustomerAsync(linkId, request))
        }, new DialogOptions { Width = "min(34rem, 95vw)", CloseDialogOnOverlayClick = false });

        if (imported is Customer)
        {
            await LoadCustomersAsync();
        }
    }

    private async Task DeleteCustomerAsync(Customer customer)
    {
        var confirmed = await Snackbar.ConfirmAsync(
            "Delete customer",
            $"Delete {customer.OrgDisplayName ?? customer.Domain ?? customer.Id}? This cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");
        if (!confirmed)
        {
            return;
        }

        _busy = true;
        try
        {
            await Api.DeleteChannelPartnerCustomerAsync(Id, customer.Id);
            await Snackbar.Add("Customer deleted.", Severity.Success);
            await LoadCustomersAsync();
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to delete customer: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ChangeStateAsync(string state)
    {
        _busy = true;
        try
        {
            var updated = await Api.UpdateChannelPartnerLinkStateAsync(Id, new UpdateChannelPartnerLinkRequest
            {
                LinkState = state
            });

            if (updated is not null)
            {
                _link = updated;
            }
            await Snackbar.Add($"Link set to {state}.", Severity.Success);
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to update link state: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private static BadgeStyle StateColor(string? state) => state?.ToUpperInvariant() switch
    {
        "ACTIVE" => BadgeStyle.Success,
        "INVITED" => BadgeStyle.Info,
        "SUSPENDED" => BadgeStyle.Warning,
        "REVOKED" => BadgeStyle.Danger,
        _ => BadgeStyle.Light
    };

    private static string FormatMonth(string invoiceMonth) =>
        DateTime.TryParseExact(invoiceMonth, "yyyyMM", System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var d)
            ? d.ToString("MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)
            : invoiceMonth;
}
