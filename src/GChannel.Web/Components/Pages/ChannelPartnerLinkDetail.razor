@page "/channel-partner-links/{Id}"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav

<PageTitle>@(_link?.PublicId ?? "Channel partner link") · GChannel</PageTitle>

@if (_loading)
{
    <LoadingPanel Title="Loading channel partner link…"
                  Hint="Fetching the link details and the customers it owns." />
}
else if (_link is null)
{
    <MudAlert Severity="Severity.Error">Channel partner link not found.</MudAlert>
    <MudButton Class="mt-4" Variant="Variant.Outlined" Href="/channel-partner-links" StartIcon="@Icons.Material.Filled.ArrowBack">
        Back to links
    </MudButton>
}
else
{
    <div class="d-flex justify-space-between align-center mb-4">
        <div class="d-flex align-center" style="gap: 8px;">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/channel-partner-links" />
            <div>
                <MudText Typo="Typo.h4">@(_link.ChannelPartner?.PrimaryDomain ?? _link.ResellerCloudIdentityId ?? _link.Id)</MudText>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@StateColor(_link.LinkState)">
                    @(_link.LinkState ?? "—")
                </MudChip>
            </div>
        </div>
        <div class="d-flex gap-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.PlayArrow"
                       OnClick="@(() => ChangeStateAsync("ACTIVE"))"
                       Disabled="@(_busy || IsState("ACTIVE"))">Activate</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.PauseCircle"
                       OnClick="@(() => ChangeStateAsync("SUSPENDED"))"
                       Disabled="@(_busy || IsState("SUSPENDED"))">Suspend</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Percent"
                       Href="@($"/channel-partner-links/{_link.Id}/repricing")">Repricing</MudButton>
        </div>
    </div>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Details</MudText></CardHeaderContent></MudCardHeader>
                <MudCardContent>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            <tr><td><strong>Link id</strong></td><td>@_link.Id</td></tr>
                            <tr><td><strong>Reseller Cloud Identity</strong></td><td>@(_link.ResellerCloudIdentityId ?? "—")</td></tr>
                            <tr><td><strong>Public id</strong></td><td>@(_link.PublicId ?? "—")</td></tr>
                            <tr><td><strong>State</strong></td><td>@(_link.LinkState ?? "—")</td></tr>
                            <tr><td><strong>Created</strong></td><td>@(_link.CreateTime?.ToString("u") ?? "—")</td></tr>
                            <tr><td><strong>Updated</strong></td><td>@(_link.UpdateTime?.ToString("u") ?? "—")</td></tr>
                            <tr>
                                <td><strong>Invitation</strong></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(_link.InviteLinkUri))
                                    {
                                        <MudLink Href="@_link.InviteLinkUri" Target="_blank">Open invitation</MudLink>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Partner Cloud Identity</MudText></CardHeaderContent></MudCardHeader>
                <MudCardContent>
                    @if (_link.ChannelPartner is { } ci)
                    {
                        <MudSimpleTable Dense="true" Elevation="0">
                            <tbody>
                                <tr><td><strong>Type</strong></td><td>@(ci.CustomerType ?? "—")</td></tr>
                                <tr><td><strong>Primary domain</strong></td><td>@(ci.PrimaryDomain ?? "—")</td></tr>
                                <tr>
                                    <td><strong>Domain verified</strong></td>
                                    <td>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                                 Color="@(ci.IsDomainVerified ? Color.Success : Color.Warning)">
                                            @(ci.IsDomainVerified ? "Verified" : "Unverified")
                                        </MudChip>
                                    </td>
                                </tr>
                                <tr><td><strong>Alternate email</strong></td><td>@(ci.AlternateEmail ?? "—")</td></tr>
                            </tbody>
                        </MudSimpleTable>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            No Cloud Identity info yet (the partner may not have accepted the invitation).
                        </MudText>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <MudCard Elevation="2" Class="mt-2 mb-2">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">Estimated business value (monthly)</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Wholesale cost, repriced revenue and your margin across all of this reseller's
                    customers' active subscriptions — estimated from list pricing, not invoiced amounts.
                </MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            @if (_valueLoading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-2" />
            }
            else if (_value is { PricedEntitlementCount: > 0 } v)
            {
                <MudGrid>
                    <MudItem xs="12" sm="4">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Wholesale cost</MudText>
                        <MudText Typo="Typo.h5">@FormatMoney(v.WholesaleMonthly, v.Currency)</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Repriced revenue</MudText>
                        <MudText Typo="Typo.h5">@FormatMoney(v.RevenueMonthly, v.Currency)</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">Margin</MudText>
                        <MudText Typo="Typo.h5" Class="@(v.MarginMonthly >= 0 ? "mud-success-text" : "mud-error-text")">@FormatMoney(v.MarginMonthly, v.Currency)</MudText>
                    </MudItem>
                </MudGrid>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 d-block">
                    @v.CustomerCount customer(s) · @v.ActiveSeats active seat(s) · @v.PricedEntitlementCount priced subscription(s)@(v.UnpricedEntitlementCount > 0 ? $"; {v.UnpricedEntitlementCount} unpriced (excluded)" : "").@(v.MixedCurrencies ? $" Headline shows the dominant currency ({v.Currency}); every currency is broken out below." : "")
                </MudText>
                @if (v.MixedCurrencies)
                {
                    <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="mt-2">
                        <thead>
                            <tr>
                                <th>Currency</th>
                                <th style="text-align:right">Wholesale cost</th>
                                <th style="text-align:right">Repriced revenue</th>
                                <th style="text-align:right">Margin</th>
                                <th style="text-align:right">Seats</th>
                                <th style="text-align:right">Subscriptions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cur in v.Currencies)
                            {
                                <tr>
                                    <td>@cur.Currency</td>
                                    <td style="text-align:right">@cur.WholesaleMonthly.ToString("N2")</td>
                                    <td style="text-align:right">@cur.RevenueMonthly.ToString("N2")</td>
                                    <td style="text-align:right" class="@(cur.MarginMonthly >= 0 ? "mud-success-text" : "mud-error-text")">@cur.MarginMonthly.ToString("N2")</td>
                                    <td style="text-align:right">@cur.ActiveSeats</td>
                                    <td style="text-align:right">@cur.PricedEntitlementCount</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    No priced subscriptions for this reseller yet@(_value is { UnpricedEntitlementCount: > 0 } u ? $" ({u.UnpricedEntitlementCount} unpriced)" : "") — values appear once the background read-model has priced this reseller's entitlements.
                </MudText>
            }
        </MudCardContent>
    </MudCard>

    <MudCard Elevation="2" Class="mt-2">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">Customers owned by this partner</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Customers whose <code>ChannelPartnerId</code> resolves to this link.
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="mr-2"
                           StartIcon="@Icons.Material.Filled.CloudDownload"
                           OnClick="OpenImportDialog" Disabled="@_busy">Import customer</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.PersonAdd"
                           OnClick="AddCustomer" Disabled="@_busy">Add customer</MudButton>
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent>
            @if (_customersLoading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-2" />
            }
            else if (_customers is { Count: > 0 })
            {
                <MudTable Items="_customers" Hover="true" Elevation="0" Dense="true">
                    <HeaderContent>
                        <MudTh>Organization</MudTh>
                        <MudTh>Domain</MudTh>
                        <MudTh>Created</MudTh>
                        <MudTh Style="text-align:right">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Organization">@(context.OrgDisplayName ?? context.Id)</MudTd>
                        <MudTd DataLabel="Domain">@context.Domain</MudTd>
                        <MudTd DataLabel="Created">@(context.CreateTime?.ToString("yyyy-MM-dd") ?? "—")</MudTd>
                        <MudTd DataLabel="Actions" Style="text-align:right">
                            <MudTooltip Text="View customer">
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                               Href="@($"/customers/{context.Id}")" />
                            </MudTooltip>
                            <MudTooltip Text="Edit customer">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                               Href="@($"/customers/edit/{context.Id}?linkId={Id}")" />
                            </MudTooltip>
                            <MudTooltip Text="Delete customer">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="@(() => DeleteCustomerAsync(context))" Disabled="@_busy" />
                            </MudTooltip>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No customers owned by this partner.</MudText>
            }
        </MudCardContent>
    </MudCard>

    <MudDialog @bind-Visible="_importOpen" Options="_importDialogOptions">
        <TitleContent>
            <MudText Typo="Typo.h6">Import existing customer</MudText>
        </TitleContent>
        <DialogContent>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                Import a customer that already has a Cloud Identity into this partner. Provide one
                identifier (domain, Cloud Identity id, or primary admin email).
            </MudText>
            <MudTextField @bind-Value="_import.Domain" Label="Primary domain" HelperText="e.g. contoso.com" Class="mb-3" />
            <MudTextField @bind-Value="_import.CloudIdentityId" Label="Cloud Identity id" Class="mb-3" />
            <MudTextField @bind-Value="_import.PrimaryAdminEmail" Label="Primary admin email" InputType="InputType.Email" Class="mb-3" />
            <MudCheckBox @bind-Value="_import.OverwriteIfExists" Label="Overwrite if the customer is already imported" />
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => _importOpen = false)" Disabled="@_busy">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ImportAsync" Disabled="@_busy">
                @(_busy ? "Importing…" : "Import")
            </MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private ChannelPartnerLink? _link;
    private IReadOnlyList<Customer>? _customers;
    private ResellerEstateValue? _value;
    private bool _loading = true;
    private bool _customersLoading = true;
    private bool _valueLoading = true;
    private bool _busy;

    private bool _importOpen;
    private readonly ImportCustomerModel _import = new();
    private static readonly DialogOptions _importDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _link = await Api.GetChannelPartnerLinkAsync(Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load channel partner link: {ex.Message}", Severity.Error);
            _link = null;
        }
        finally
        {
            _loading = false;
        }

        if (_link is not null)
        {
            await LoadCustomersAsync();
            await LoadValueAsync();
        }
    }

    private async Task LoadValueAsync()
    {
        _valueLoading = true;
        try
        {
            _value = await Api.GetResellerValueAsync(Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load reseller value: {ex.Message}", Severity.Error);
            _value = null;
        }
        finally
        {
            _valueLoading = false;
        }
    }

    private async Task LoadCustomersAsync()
    {
        _customersLoading = true;
        try
        {
            var result = await Api.ListChannelPartnerCustomersAsync(Id);
            _customers = result?.Customers ?? [];
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load partner customers: {ex.Message}", Severity.Error);
            _customers = [];
        }
        finally
        {
            _customersLoading = false;
        }
    }

    private bool IsState(string state) =>
        string.Equals(_link?.LinkState, state, StringComparison.OrdinalIgnoreCase);

    private static string FormatMoney(decimal value, string? currency) =>
        string.IsNullOrEmpty(currency)
            ? value.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)
            : $"{currency} {value.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)}";

    private void AddCustomer() =>
        Nav.NavigateTo($"/customers/new?linkId={Id}");

    private void OpenImportDialog()
    {
        _import.Reset();
        _importOpen = true;
    }

    private async Task ImportAsync()
    {
        if (string.IsNullOrWhiteSpace(_import.Domain)
            && string.IsNullOrWhiteSpace(_import.CloudIdentityId)
            && string.IsNullOrWhiteSpace(_import.PrimaryAdminEmail))
        {
            Snackbar.Add("Provide a domain, Cloud Identity id, or primary admin email to import.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var imported = await Api.ImportChannelPartnerCustomerAsync(Id, new ImportCustomerRequest
            {
                Domain = _import.Domain,
                CloudIdentityId = _import.CloudIdentityId,
                PrimaryAdminEmail = _import.PrimaryAdminEmail,
                OverwriteIfExists = _import.OverwriteIfExists
            });

            Snackbar.Add($"Imported {imported?.OrgDisplayName ?? imported?.Domain ?? "customer"}.", Severity.Success);
            _importOpen = false;
            await LoadCustomersAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to import customer: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteCustomerAsync(Customer customer)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete customer",
            $"Delete {customer.OrgDisplayName ?? customer.Domain ?? customer.Id}? This cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        _busy = true;
        try
        {
            await Api.DeleteChannelPartnerCustomerAsync(Id, customer.Id);
            Snackbar.Add("Customer deleted.", Severity.Success);
            await LoadCustomersAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to delete customer: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class ImportCustomerModel
    {
        public string? Domain { get; set; }
        public string? CloudIdentityId { get; set; }
        public string? PrimaryAdminEmail { get; set; }
        public bool OverwriteIfExists { get; set; }

        public void Reset()
        {
            Domain = null;
            CloudIdentityId = null;
            PrimaryAdminEmail = null;
            OverwriteIfExists = false;
        }
    }

    private async Task ChangeStateAsync(string state)
    {
        _busy = true;
        try
        {
            var updated = await Api.UpdateChannelPartnerLinkStateAsync(Id, new UpdateChannelPartnerLinkRequest
            {
                LinkState = state
            });

            if (updated is not null)
            {
                _link = updated;
            }
            Snackbar.Add($"Link set to {state}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to update link state: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private static Color StateColor(string? state) => state?.ToUpperInvariant() switch
    {
        "ACTIVE" => Color.Success,
        "INVITED" => Color.Info,
        "SUSPENDED" => Color.Warning,
        "REVOKED" => Color.Error,
        _ => Color.Default
    };
}
