@page "/accounts/cloud-identity"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject UiNotifier Snackbar
@inject NavigationManager Nav

<PageTitle>Cloud Identity check · GChannel</PageTitle>

<Div Flex="Flex.JustifyContent.Between.AlignItems.Center">
    <Heading Size="HeadingSize.Is3" Margin="Margin.Is2.FromBottom">Cloud Identity check</Heading>
    <GuidedWalkthrough Id="cloud-identity" Steps="_walkthrough" AutoStart="true" />
</Div>
<Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is5.FromBottom">
    Verify whether a customer domain already has a Google Cloud Identity account before you
    start provisioning.
</Paragraph>

<Row>
    <Column ColumnSize="ColumnSize.Is12.Is5.OnDesktop">
        <Card Shadow="Shadow.Small">
            <CardBody>
                <EditForm Model="_model" OnValidSubmit="CheckAsync">
                    <DataAnnotationsValidator />
                    <Field data-walkthrough="ci-domain">
                        <FieldLabel>Customer domain</FieldLabel>
                        <Addons>
                            <Addon AddonType="AddonType.Start"><AddonLabel><Icon Name="@AppIcons.Language" /></AddonLabel></Addon>
                            <Addon AddonType="AddonType.Body">
                                <TextInput @bind-Value="_model.Domain" Placeholder="example.com" />
                            </Addon>
                        </Addons>
                        <ValidationMessage For="() => _model.Domain" />
                    </Field>
                    <Field>
                        <FieldLabel>Primary admin email (optional)</FieldLabel>
                        <Addons>
                            <Addon AddonType="AddonType.Start"><AddonLabel><Icon Name="@AppIcons.Email" /></AddonLabel></Addon>
                            <Addon AddonType="AddonType.Body">
                                <TextInput @bind-Value="_model.PrimaryAdminEmail" Placeholder="admin@example.com" />
                            </Addon>
                        </Addons>
                    </Field>
                    <Button Type="ButtonType.Submit" Color="Color.Primary" Disabled="_busy" data-walkthrough="ci-check">
                        <Icon Name="@AppIcons.Search" Class="me-1" /> @(_busy ? "Checking…" : "Check")
                    </Button>
                </EditForm>
            </CardBody>
        </Card>

        <Card Shadow="Shadow.Small" Margin="Margin.Is4.FromTop" data-walkthrough="ci-history">
            <CardBody>
                <Heading Size="HeadingSize.Is6" Margin="Margin.Is2.FromBottom">Recently checked</Heading>
                @if (_history.Count == 0)
                {
                    <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is0">No checks yet.</Paragraph>
                }
                else
                {
                    <ListGroup Flush>
                        @foreach (var item in _history)
                        {
                            <ListGroupItem Padding="Padding.Is0.OnX.Is2.OnY">
                                <Div Flex="Flex.AlignItems.Center.JustifyContent.Between" Width="Width.Is100">
                                    <Div>
                                        <Strong Display="Display.Block">@item.Domain</Strong>
                                        <Small TextColor="TextColor.Secondary">
                                            @(item.Exists ? "Exists" : "Available") · @item.PerformedAt.LocalDateTime.ToString("g")
                                        </Small>
                                    </Div>
                                    <Tooltip Text="Recheck (bypass cache)" Inline>
                                        <Button Color="Color.Primary" Size="Size.Small" Outline Disabled="_busy"
                                                Clicked="() => RecheckAsync(item)" aria-label="Recheck">
                                            <Icon Name="@AppIcons.Refresh" />
                                        </Button>
                                    </Tooltip>
                                </Div>
                            </ListGroupItem>
                        }
                    </ListGroup>
                }
            </CardBody>
        </Card>
    </Column>

    <Column ColumnSize="ColumnSize.Is12.Is7.OnDesktop">
        @if (_busy)
        {
            <LoadingPanel Title="Checking Cloud Identity…"
                          Hint="Asking Google whether a Cloud Identity account already exists for this domain." />
        }
        else if (_result is not null)
        {
            <Alert Color="@(_result.Exists ? Color.Warning : Color.Success)" Visible Margin="Margin.Is4.FromBottom">
                <Div Flex="Flex.AlignItems.Center.JustifyContent.Between" Gap="Gap.Is3" Width="Width.Is100">
                    @if (_result.Exists)
                    {
                        <span>A Cloud Identity account already exists for <b>@_result.Domain</b>.</span>
                        <Div Flex="Flex.AlignItems.Center" Gap="Gap.Is2" Class="text-nowrap">
                            <Button Color="Color.Primary" Outline Size="Size.Small" Clicked="OpenImportDialog">
                                <Icon Name="@AppIcons.MoveToInbox" Class="me-1" /> Import existing customer
                            </Button>
                            <Button Color="Color.Primary" Size="Size.Small" Clicked="ViewCustomers">
                                <Icon Name="@AppIcons.People" Class="me-1" /> View customers
                            </Button>
                        </Div>
                    }
                    else
                    {
                        <span>No Cloud Identity account exists for <b>@_result.Domain</b>. You can provision it.</span>
                        <Button Color="Color.Primary" Size="Size.Small" Clicked="ProvisionAsync" Class="text-nowrap">
                            <Icon Name="@AppIcons.AddBusiness" Class="me-1" /> Provision customer
                        </Button>
                    }
                </Div>
            </Alert>

            @if (_result.PartnerLink is not null)
            {
                var link = _result.PartnerLink;
                var invited = string.Equals(link.LinkState, "INVITED", StringComparison.OrdinalIgnoreCase);
                <Alert Color="@(invited ? Color.Warning : Color.Info)" Visible Margin="Margin.Is4.FromBottom">
                    <Div Flex="Flex.AlignItems.Center.JustifyContent.Between" Gap="Gap.Is3" Width="Width.Is100">
                        <span>
                            This domain matches a channel partner link
                            (<b>@(link.ChannelPartner?.PrimaryDomain ?? _result.Domain)</b>) with state
                            <Badge Color="@(invited ? Color.Warning : Color.Secondary)" Margin="Margin.Is1.FromStart">@(link.LinkState ?? "UNKNOWN")</Badge>.
                            @if (invited)
                            {
                                <text>The partner has not accepted our invitation yet.</text>
                            }
                        </span>
                        <Button Color="Color.Primary" Size="Size.Small" Clicked="@(() => ViewPartnerLink(link.Id))" Class="text-nowrap">
                            <Icon Name="@AppIcons.Hub" Class="me-1" /> View partner link
                        </Button>
                    </Div>
                </Alert>
            }

            @if (_result.HasNonDomainAccounts)
            {
                <Alert Color="Color.Info" Visible Margin="Margin.Is4.FromBottom">
                    One or more matches are not domain-verified (<b>DOMAIN</b>) accounts. These cannot be
                    used for reseller actions such as customer creation, transfers or entitlements.
                </Alert>
            }

            @if (_result.Accounts.Count > 0)
            {
                <Card Shadow="Shadow.Small">
                    <Table Narrow Hoverable Responsive Margin="Margin.Is0">
                        <TableHeader>
                            <TableRow>
                                <TableHeaderCell>Customer</TableHeaderCell>
                                <TableHeaderCell>Type</TableHeaderCell>
                                <TableHeaderCell>Existing</TableHeaderCell>
                                <TableHeaderCell>Owned</TableHeaderCell>
                                <TableHeaderCell>Cloud Identity ID</TableHeaderCell>
                            </TableRow>
                        </TableHeader>
                        <TableBody>
                            @foreach (var account in _result.Accounts)
                            {
                                <TableRow>
                                    <TableRowCell>@account.CustomerName</TableRowCell>
                                    <TableRowCell>
                                        @if (account.IsDomain)
                                        {
                                            <Badge Color="Color.Success">@account.CustomerType</Badge>
                                        }
                                        else
                                        {
                                            <Badge Color="Color.Warning"><Icon Name="@AppIcons.Warning" Class="me-1" />@account.CustomerType — not usable</Badge>
                                        }
                                    </TableRowCell>
                                    <TableRowCell>
                                        <Icon Name="@(account.Existing ? AppIcons.Check : AppIcons.Close)"
                                              TextColor="@(account.Existing ? TextColor.Success : TextColor.Secondary)" />
                                    </TableRowCell>
                                    <TableRowCell>
                                        <Icon Name="@(account.Owned ? AppIcons.Check : AppIcons.Close)"
                                              TextColor="@(account.Owned ? TextColor.Success : TextColor.Secondary)" />
                                    </TableRowCell>
                                    <TableRowCell>@account.CustomerCloudIdentityId</TableRowCell>
                                </TableRow>
                            }
                        </TableBody>
                    </Table>
                </Card>
            }
        }
    </Column>
</Row>

<Modal @bind-Visible="_importOpen">
    <ModalContent Centered>
        <ModalHeader>
            <ModalTitle>Import existing customer</ModalTitle>
            <CloseButton />
        </ModalHeader>
        <ModalBody>
            <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is3.FromBottom">
                Bring a customer that already has a Cloud Identity into this reseller account (a pre-transfer
                step). Provide one identifier — the checked domain is prefilled.
            </Paragraph>
            <Field>
                <FieldLabel>Primary domain</FieldLabel>
                <TextInput @bind-Value="_import.Domain" />
                <FieldHelp>e.g. contoso.com</FieldHelp>
            </Field>
            <Field>
                <FieldLabel>Cloud Identity id</FieldLabel>
                <TextInput @bind-Value="_import.CloudIdentityId" />
            </Field>
            <Field>
                <FieldLabel>Primary admin email</FieldLabel>
                <TextInput @bind-Value="_import.PrimaryAdminEmail" Role="TextRole.Email" />
            </Field>
            <Field>
                <Check TValue="bool" @bind-Value="_import.OverwriteIfExists">Overwrite if the customer is already imported</Check>
            </Field>
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Secondary" Clicked="@(() => _importOpen = false)" Disabled="@_importing">Cancel</Button>
            <Button Color="Color.Primary" Clicked="ImportExistingAsync" Disabled="@_importing" Loading="@_importing">
                @(_importing ? "Importing…" : "Import")
            </Button>
        </ModalFooter>
    </ModalContent>
</Modal>

@code {
    [SupplyParameterFromQuery(Name = "domain")]
    public string? Domain { get; set; }

    private readonly InputModel _model = new();
    private CheckCloudIdentityResult? _result;
    private IReadOnlyList<IdentityCheckHistoryItem> _history = [];
    private bool _busy;
    private bool _autoChecked;

    private bool _importOpen;
    private bool _importing;
    private readonly ImportModel _import = new();

    private static readonly IReadOnlyList<WalkthroughStep> _walkthrough =
    [
        new("[data-walkthrough=\"ci-domain\"]", "Enter a domain", "Type the customer's primary domain (e.g. contoso.com) to check."),
        new("[data-walkthrough=\"ci-check\"]", "Run the check", "Click Check to see if the domain already has a Google Cloud Identity."),
        new("[data-walkthrough=\"ci-history\"]", "Recent checks", "Previously checked domains appear here — re-check any to bypass the cache."),
    ];

    protected override async Task OnInitializedAsync() => await LoadHistoryAsync();

    protected override async Task OnParametersSetAsync()
    {
        // Deep link from the Customers page: /accounts/cloud-identity?domain={domain} —
        // prefill the form and run the check once.
        if (_autoChecked || string.IsNullOrWhiteSpace(Domain))
        {
            return;
        }

        _autoChecked = true;
        _model.Domain = Domain;
        await RunCheckAsync(forceRefresh: false);
    }

    private Task CheckAsync() => RunCheckAsync(forceRefresh: false);

    private void ProvisionAsync()
    {
        var domain = _result?.Domain ?? _model.Domain;
        Nav.NavigateTo($"/customers/new?domain={Uri.EscapeDataString(domain)}");
    }

    private void ViewCustomers() => Nav.NavigateTo("/customers");

    private void OpenImportDialog()
    {
        _import.Reset();
        _import.Domain = _result?.Domain ?? _model.Domain;
        _import.PrimaryAdminEmail = string.IsNullOrWhiteSpace(_model.PrimaryAdminEmail) ? null : _model.PrimaryAdminEmail;
        _importOpen = true;
    }

    private async Task ImportExistingAsync()
    {
        if (string.IsNullOrWhiteSpace(_import.Domain)
            && string.IsNullOrWhiteSpace(_import.CloudIdentityId)
            && string.IsNullOrWhiteSpace(_import.PrimaryAdminEmail))
        {
            await Snackbar.Add("Provide a domain, Cloud Identity id, or primary admin email to import.", Severity.Warning);
            return;
        }

        _importing = true;
        try
        {
            var imported = await Api.ImportCustomerAsync(new ImportCustomerRequest
            {
                Domain = _import.Domain,
                CloudIdentityId = _import.CloudIdentityId,
                PrimaryAdminEmail = _import.PrimaryAdminEmail,
                OverwriteIfExists = _import.OverwriteIfExists
            });

            _importOpen = false;
            await Snackbar.Add($"Imported {imported?.OrgDisplayName ?? imported?.Domain ?? "customer"}.", Severity.Success);
            if (imported is not null)
            {
                Nav.NavigateTo($"/customers/{imported.Id}");
            }
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to import customer: {ex.Message}", Severity.Error);
        }
        finally
        {
            _importing = false;
        }
    }

    private void ViewPartnerLink(string id) => Nav.NavigateTo($"/channel-partner-links/{id}");

    private async Task RecheckAsync(IdentityCheckHistoryItem item)
    {
        _model.Domain = item.Domain;
        _model.PrimaryAdminEmail = null;
        await RunCheckAsync(forceRefresh: true);
    }

    private async Task RunCheckAsync(bool forceRefresh)
    {
        _busy = true;
        _result = null;
        try
        {
            _result = await Api.CheckCloudIdentityAsync(
                new CheckCloudIdentityRequest
                {
                    Domain = _model.Domain,
                    PrimaryAdminEmail = string.IsNullOrWhiteSpace(_model.PrimaryAdminEmail) ? null : _model.PrimaryAdminEmail
                },
                forceRefresh);

            await LoadHistoryAsync();
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Check failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadHistoryAsync()
    {
        try
        {
            var result = await Api.GetIdentityCheckHistoryAsync();
            _history = result?.Items ?? [];
        }
        catch
        {
            // History is a convenience; ignore load failures so the check form still works.
        }
    }

    private sealed class InputModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string Domain { get; set; } = string.Empty;
        public string? PrimaryAdminEmail { get; set; }
    }

    private sealed class ImportModel
    {
        public string? Domain { get; set; }
        public string? CloudIdentityId { get; set; }
        public string? PrimaryAdminEmail { get; set; }
        public bool OverwriteIfExists { get; set; }

        public void Reset()
        {
            Domain = null;
            CloudIdentityId = null;
            PrimaryAdminEmail = null;
            OverwriteIfExists = false;
        }
    }
}
