@page "/accounts/cloud-identity"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject UiNotifier Snackbar
@inject NavigationManager Nav
@inject DialogService Dialogs

<PageTitle>Cloud Identity check · GChannel</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="1rem" class="rz-mb-2">
    <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">Cloud Identity check</RadzenText>
    <GuidedWalkthrough Id="cloud-identity" Steps="_walkthrough" AutoStart="true" />
</RadzenStack>
<RadzenText TextStyle="TextStyle.Body1" class="rz-text-secondary-color rz-mb-6">
    Verify whether a customer domain already has a Google Cloud Identity account before you
    start provisioning.
</RadzenText>

<RadzenRow Gap="1.5rem">
    <RadzenColumn Size="12" SizeLG="5">
        <RadzenCard Variant="Variant.Filled">
            <RadzenTemplateForm TItem="InputModel" Data="_model" Submit="CheckAsync">
                <RadzenStack Gap="1rem">
                    <div data-walkthrough="ci-domain">
                        <RadzenFormField Text="Customer domain" Variant="Variant.Outlined" Style="width:100%">
                            <Start><RadzenIcon Icon="@AppIcons.Language" /></Start>
                            <ChildContent><RadzenTextBox @bind-Value="_model.Domain" Name="Domain" Placeholder="example.com" /></ChildContent>
                            <Helper><RadzenRequiredValidator Component="Domain" Text="A domain is required." /></Helper>
                        </RadzenFormField>
                    </div>
                    <RadzenFormField Text="Primary admin email (optional)" Variant="Variant.Outlined" Style="width:100%">
                        <Start><RadzenIcon Icon="@AppIcons.Email" /></Start>
                        <ChildContent><RadzenTextBox @bind-Value="_model.PrimaryAdminEmail" Name="PrimaryAdminEmail" Placeholder="admin@example.com" /></ChildContent>
                    </RadzenFormField>
                    <div>
                        <RadzenButton ButtonType="ButtonType.Submit" Text="@(_busy ? "Checking…" : "Check")" Icon="@AppIcons.Search" ButtonStyle="ButtonStyle.Primary" Disabled="_busy" data-walkthrough="ci-check" />
                    </div>
                </RadzenStack>
            </RadzenTemplateForm>
        </RadzenCard>

        <RadzenCard Variant="Variant.Filled" class="rz-mt-4" data-walkthrough="ci-history">
            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Recently checked</RadzenText>
            @if (_history.Count == 0)
            {
                <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-m-0">No checks yet.</RadzenText>
            }
            else
            {
                <RadzenStack Gap="0">
                    @foreach (var item in _history)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.75rem" class="rz-py-2 rz-border-bottom rz-border-color-base-200">
                            <div>
                                <RadzenText TextStyle="TextStyle.Body1" class="rz-m-0" Style="font-weight:600">@item.Domain</RadzenText>
                                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">
                                    @(item.Exists ? "Exists" : "Available") · @item.PerformedAt.LocalDateTime.ToString("g")
                                </RadzenText>
                            </div>
                            <Tip Text="Recheck (bypass cache)">
                                <RadzenButton Icon="@AppIcons.Refresh" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Size="ButtonSize.Small" Disabled="_busy"
                                              Click="() => RecheckAsync(item)" aria-label="Recheck" />
                            </Tip>
                        </RadzenStack>
                    }
                </RadzenStack>
            }
        </RadzenCard>
    </RadzenColumn>

    <RadzenColumn Size="12" SizeLG="7">
        @if (_busy)
        {
            <LoadingPanel Title="Checking Cloud Identity…"
                          Hint="Asking Google whether a Cloud Identity account already exists for this domain." />
        }
        else if (_result is not null)
        {
            <RadzenAlert AlertStyle="@(_result.Exists ? AlertStyle.Warning : AlertStyle.Success)" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-mb-4">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.75rem" Wrap="FlexWrap.Wrap">
                    @if (_result.Exists)
                    {
                        <span>A Cloud Identity account already exists for <b>@_result.Domain</b>.</span>
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-text-nowrap">
                            <RadzenButton Text="Import existing customer" Icon="@AppIcons.MoveToInbox" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Size="ButtonSize.Small" Click="OpenImportDialogAsync" />
                            <RadzenButton Text="View customers" Icon="@AppIcons.People" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="ViewCustomers" />
                        </RadzenStack>
                    }
                    else
                    {
                        <span>No Cloud Identity account exists for <b>@_result.Domain</b>. You can provision it.</span>
                        <RadzenButton Text="Provision customer" Icon="@AppIcons.AddBusiness" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="ProvisionAsync" class="rz-text-nowrap" />
                    }
                </RadzenStack>
            </RadzenAlert>

            @if (_result.PartnerLink is not null)
            {
                var link = _result.PartnerLink;
                var invited = string.Equals(link.LinkState, "INVITED", StringComparison.OrdinalIgnoreCase);
                <RadzenAlert AlertStyle="@(invited ? AlertStyle.Warning : AlertStyle.Info)" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-mb-4">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.75rem" Wrap="FlexWrap.Wrap">
                        <span>
                            This domain matches a channel partner link
                            (<b>@(link.ChannelPartner?.PrimaryDomain ?? _result.Domain)</b>) with state
                            <RadzenBadge BadgeStyle="@(invited ? BadgeStyle.Warning : BadgeStyle.Light)" Text="@(link.LinkState ?? "UNKNOWN")" class="rz-ms-1" />.
                            @if (invited)
                            {
                                <text>The partner has not accepted our invitation yet.</text>
                            }
                        </span>
                        <RadzenButton Text="View partner link" Icon="@AppIcons.Hub" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small" Click="@(() => ViewPartnerLink(link.Id))" class="rz-text-nowrap" />
                    </RadzenStack>
                </RadzenAlert>
            }

            @if (_result.HasNonDomainAccounts)
            {
                <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-mb-4">
                    One or more matches are not domain-verified (<b>DOMAIN</b>) accounts. These cannot be
                    used for reseller actions such as customer creation, transfers or entitlements.
                </RadzenAlert>
            }

            @if (_result.Accounts.Count > 0)
            {
                <RadzenCard Variant="Variant.Filled">
                    <RadzenDataGrid TItem="CloudIdentityAccount" Data="_result.Accounts" AllowPaging="false" AllowSorting="false" Density="Density.Compact" GridLines="DataGridGridLines.Horizontal" Responsive="true">
                        <Columns>
                            <RadzenDataGridColumn TItem="CloudIdentityAccount" Property="@nameof(CloudIdentityAccount.CustomerName)" Title="Customer" />
                            <RadzenDataGridColumn TItem="CloudIdentityAccount" Title="Type">
                                <Template Context="account">
                                    @if (account.IsDomain)
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="@account.CustomerType" />
                                    }
                                    else
                                    {
                                        <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="@($"{account.CustomerType} — not usable")" />
                                    }
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="CloudIdentityAccount" Title="Existing" Width="90px">
                                <Template Context="account">
                                    <RadzenIcon Icon="@(account.Existing ? AppIcons.Check : AppIcons.Close)" IconColor="@(account.Existing ? Colors.Success : Colors.Base500)" />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="CloudIdentityAccount" Title="Owned" Width="90px">
                                <Template Context="account">
                                    <RadzenIcon Icon="@(account.Owned ? AppIcons.Check : AppIcons.Close)" IconColor="@(account.Owned ? Colors.Success : Colors.Base500)" />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="CloudIdentityAccount" Property="@nameof(CloudIdentityAccount.CustomerCloudIdentityId)" Title="Cloud Identity ID" />
                        </Columns>
                    </RadzenDataGrid>
                </RadzenCard>
            }
        }
    </RadzenColumn>
</RadzenRow>

@code {
    [SupplyParameterFromQuery(Name = "domain")]
    public string? Domain { get; set; }

    private readonly InputModel _model = new();
    private CheckCloudIdentityResult? _result;
    private IReadOnlyList<IdentityCheckHistoryItem> _history = [];
    private bool _busy;
    private bool _autoChecked;

    private static readonly IReadOnlyList<WalkthroughStep> _walkthrough =
    [
        new("[data-walkthrough=\"ci-domain\"]", "Enter a domain", "Type the customer's primary domain (e.g. contoso.com) to check."),
        new("[data-walkthrough=\"ci-check\"]", "Run the check", "Click Check to see if the domain already has a Google Cloud Identity."),
        new("[data-walkthrough=\"ci-history\"]", "Recent checks", "Previously checked domains appear here — re-check any to bypass the cache."),
    ];

    protected override async Task OnInitializedAsync() => await LoadHistoryAsync();

    protected override async Task OnParametersSetAsync()
    {
        // Deep link from the Customers page: /accounts/cloud-identity?domain={domain} —
        // prefill the form and run the check once.
        if (_autoChecked || string.IsNullOrWhiteSpace(Domain))
        {
            return;
        }

        _autoChecked = true;
        _model.Domain = Domain;
        await RunCheckAsync(forceRefresh: false);
    }

    private Task CheckAsync() => RunCheckAsync(forceRefresh: false);

    private void ProvisionAsync()
    {
        var domain = _result?.Domain ?? _model.Domain;
        Nav.NavigateTo($"/customers/new?domain={Uri.EscapeDataString(domain)}");
    }

    private void ViewCustomers() => Nav.NavigateTo("/customers");

    private async Task OpenImportDialogAsync()
    {
        var parameters = new Dictionary<string, object?>
        {
            [nameof(ImportCustomerDialog.Description)] = "Bring a customer that already has a Cloud Identity into this reseller account (a pre-transfer step). Provide one identifier — the checked domain is prefilled.",
            [nameof(ImportCustomerDialog.Domain)] = _result?.Domain ?? _model.Domain,
            [nameof(ImportCustomerDialog.Import)] = new Func<ImportCustomerRequest, Task<Customer?>>(request => Api.ImportCustomerAsync(request))
        };
        if (!string.IsNullOrWhiteSpace(_model.PrimaryAdminEmail))
        {
            parameters[nameof(ImportCustomerDialog.PrimaryAdminEmail)] = _model.PrimaryAdminEmail;
        }

        var imported = await Dialogs.OpenAsync<ImportCustomerDialog>("Import existing customer", parameters,
            new DialogOptions { Width = "min(34rem, 95vw)", CloseDialogOnOverlayClick = false });

        if (imported is Customer customer)
        {
            Nav.NavigateTo($"/customers/{customer.Id}");
        }
    }

    private void ViewPartnerLink(string id) => Nav.NavigateTo($"/channel-partner-links/{id}");

    private async Task RecheckAsync(IdentityCheckHistoryItem item)
    {
        _model.Domain = item.Domain;
        _model.PrimaryAdminEmail = null;
        await RunCheckAsync(forceRefresh: true);
    }

    private async Task RunCheckAsync(bool forceRefresh)
    {
        _busy = true;
        _result = null;
        try
        {
            _result = await Api.CheckCloudIdentityAsync(
                new CheckCloudIdentityRequest
                {
                    Domain = _model.Domain,
                    PrimaryAdminEmail = string.IsNullOrWhiteSpace(_model.PrimaryAdminEmail) ? null : _model.PrimaryAdminEmail
                },
                forceRefresh);

            await LoadHistoryAsync();
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Check failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadHistoryAsync()
    {
        try
        {
            var result = await Api.GetIdentityCheckHistoryAsync();
            _history = result?.Items ?? [];
        }
        catch
        {
            // History is a convenience; ignore load failures so the check form still works.
        }
    }

    private sealed class InputModel
    {
        public string Domain { get; set; } = string.Empty;
        public string? PrimaryAdminEmail { get; set; }
    }
}
