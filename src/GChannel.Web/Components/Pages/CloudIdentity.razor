@page "/accounts/cloud-identity"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Cloud Identity check · GChannel</PageTitle>

<div class="d-flex justify-space-between align-center">
    <MudText Typo="Typo.h4" GutterBottom="true">Cloud Identity check</MudText>
    <GuidedWalkthrough Id="cloud-identity" Steps="_walkthrough" AutoStart="true" />
</div>
<MudText Typo="Typo.body1" Class="mb-6" Color="Color.Secondary">
    Verify whether a customer domain already has a Google Cloud Identity account before you
    start provisioning.
</MudText>

<MudGrid>
    <MudItem xs="12" md="5">
        <MudPaper Class="pa-4" Elevation="2">
            <EditForm Model="_model" OnValidSubmit="CheckAsync">
                <DataAnnotationsValidator />
                <MudTextField @bind-Value="_model.Domain"
                              Label="Customer domain"
                              Placeholder="example.com"
                              Required="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Language"
                              Class="mb-4" data-walkthrough="ci-domain" />
                <MudTextField @bind-Value="_model.PrimaryAdminEmail"
                              Label="Primary admin email (optional)"
                              Placeholder="admin@example.com"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Email"
                              Class="mb-4" />
                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Search"
                           Disabled="_busy" data-walkthrough="ci-check">
                    @(_busy ? "Checking…" : "Check")
                </MudButton>
            </EditForm>
        </MudPaper>

        <MudPaper Class="pa-4 mt-4" Elevation="2" data-walkthrough="ci-history">
            <MudText Typo="Typo.subtitle1" GutterBottom="true">Recently checked</MudText>
            @if (_history.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No checks yet.</MudText>
            }
            else
            {
                <MudList T="string" Dense="true">
                    @foreach (var item in _history)
                    {
                        <MudListItem T="string">
                            <div class="d-flex align-center justify-space-between" style="width:100%">
                                <div>
                                    <MudText Typo="Typo.body2"><b>@item.Domain</b></MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @(item.Exists ? "Exists" : "Available") · @item.PerformedAt.LocalDateTime.ToString("g")
                                    </MudText>
                                </div>
                                <MudTooltip Text="Recheck (bypass cache)">
                                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"
                                                   Color="Color.Primary" Disabled="_busy"
                                                   OnClick="() => RecheckAsync(item)" />
                                </MudTooltip>
                            </div>
                        </MudListItem>
                    }
                </MudList>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="7">
        @if (_busy)
        {
            <LoadingPanel Title="Checking Cloud Identity…"
                          Hint="Asking Google whether a Cloud Identity account already exists for this domain." />
        }
        else if (_result is not null)
        {
            <MudAlert Severity="@(_result.Exists ? Severity.Warning : Severity.Success)" Class="mb-4">
                <div class="d-flex align-center justify-space-between" style="width:100%; gap:16px">
                    @if (_result.Exists)
                    {
                        <span>A Cloud Identity account already exists for <b>@_result.Domain</b>.</span>
                        <div class="d-flex align-center" style="gap:8px">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.MoveToInbox"
                                       OnClick="OpenImportDialog">Import existing customer</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.People"
                                       OnClick="ViewCustomers">View customers</MudButton>
                        </div>
                    }
                    else
                    {
                        <span>No Cloud Identity account exists for <b>@_result.Domain</b>. You can provision it.</span>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.AddBusiness"
                                   OnClick="ProvisionAsync">Provision customer</MudButton>
                    }
                </div>
            </MudAlert>

            @if (_result.PartnerLink is not null)
            {
                var link = _result.PartnerLink;
                var invited = string.Equals(link.LinkState, "INVITED", StringComparison.OrdinalIgnoreCase);
                <MudAlert Severity="@(invited ? Severity.Warning : Severity.Info)" Class="mb-4">
                    <div class="d-flex align-center justify-space-between" style="width:100%; gap:16px">
                        <span>
                            This domain matches a channel partner link
                            (<b>@(link.ChannelPartner?.PrimaryDomain ?? _result.Domain)</b>) with state
                            <MudChip T="string" Size="Size.Small" Class="ml-1"
                                     Color="@(invited ? Color.Warning : Color.Default)"
                                     Variant="Variant.Text">@(link.LinkState ?? "UNKNOWN")</MudChip>.
                            @if (invited)
                            {
                                <text>The partner has not accepted our invitation yet.</text>
                            }
                        </span>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Hub"
                                   OnClick="@(() => ViewPartnerLink(link.Id))">View partner link</MudButton>
                    </div>
                </MudAlert>
            }

            @if (_result.HasNonDomainAccounts)
            {
                <MudAlert Severity="Severity.Info" Class="mb-4">
                    One or more matches are not domain-verified (<b>DOMAIN</b>) accounts. These cannot be
                    used for reseller actions such as customer creation, transfers or entitlements.
                </MudAlert>
            }

            @if (_result.Accounts.Count > 0)
            {
                <MudTable Items="_result.Accounts" Dense="true" Hover="true" Elevation="2">
                    <HeaderContent>
                        <MudTh>Customer</MudTh>
                        <MudTh>Type</MudTh>
                        <MudTh>Existing</MudTh>
                        <MudTh>Owned</MudTh>
                        <MudTh>Cloud Identity ID</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Customer">@context.CustomerName</MudTd>
                        <MudTd DataLabel="Type">
                            @if (context.IsDomain)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">@context.CustomerType</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text"
                                         Icon="@Icons.Material.Filled.Warning">@context.CustomerType — not usable</MudChip>
                            }
                        </MudTd>
                        <MudTd DataLabel="Existing">
                            <MudIcon Icon="@(context.Existing ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)"
                                     Color="@(context.Existing ? Color.Success : Color.Default)" Size="Size.Small" />
                        </MudTd>
                        <MudTd DataLabel="Owned">
                            <MudIcon Icon="@(context.Owned ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)"
                                     Color="@(context.Owned ? Color.Success : Color.Default)" Size="Size.Small" />
                        </MudTd>
                        <MudTd DataLabel="Cloud Identity ID">@context.CustomerCloudIdentityId</MudTd>
                    </RowTemplate>
                </MudTable>
            }
        }
    </MudItem>
</MudGrid>

<MudDialog @bind-Visible="_importOpen" Options="_importDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Import existing customer</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Bring a customer that already has a Cloud Identity into this reseller account (a pre-transfer
            step). Provide one identifier — the checked domain is prefilled.
        </MudText>
        <MudTextField @bind-Value="_import.Domain" Label="Primary domain" HelperText="e.g. contoso.com" Class="mb-3" />
        <MudTextField @bind-Value="_import.CloudIdentityId" Label="Cloud Identity id" Class="mb-3" />
        <MudTextField @bind-Value="_import.PrimaryAdminEmail" Label="Primary admin email" InputType="InputType.Email" Class="mb-3" />
        <MudCheckBox @bind-Value="_import.OverwriteIfExists" Label="Overwrite if the customer is already imported" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _importOpen = false)" Disabled="@_importing">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ImportExistingAsync" Disabled="@_importing">
            @(_importing ? "Importing…" : "Import")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [SupplyParameterFromQuery(Name = "domain")]
    public string? Domain { get; set; }

    private readonly InputModel _model = new();
    private CheckCloudIdentityResult? _result;
    private IReadOnlyList<IdentityCheckHistoryItem> _history = [];
    private bool _busy;
    private bool _autoChecked;

    private bool _importOpen;
    private bool _importing;
    private readonly ImportModel _import = new();
    private static readonly DialogOptions _importDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    private static readonly IReadOnlyList<WalkthroughStep> _walkthrough =
    [
        new("[data-walkthrough=\"ci-domain\"]", "Enter a domain", "Type the customer's primary domain (e.g. contoso.com) to check."),
        new("[data-walkthrough=\"ci-check\"]", "Run the check", "Click Check to see if the domain already has a Google Cloud Identity."),
        new("[data-walkthrough=\"ci-history\"]", "Recent checks", "Previously checked domains appear here — re-check any to bypass the cache."),
    ];

    protected override async Task OnInitializedAsync() => await LoadHistoryAsync();

    protected override async Task OnParametersSetAsync()
    {
        // Deep link from the Customers page: /accounts/cloud-identity?domain={domain} —
        // prefill the form and run the check once.
        if (_autoChecked || string.IsNullOrWhiteSpace(Domain))
        {
            return;
        }

        _autoChecked = true;
        _model.Domain = Domain;
        await RunCheckAsync(forceRefresh: false);
    }

    private Task CheckAsync() => RunCheckAsync(forceRefresh: false);

    private void ProvisionAsync()
    {
        var domain = _result?.Domain ?? _model.Domain;
        Nav.NavigateTo($"/customers/new?domain={Uri.EscapeDataString(domain)}");
    }

    private void ViewCustomers() => Nav.NavigateTo("/customers");

    private void OpenImportDialog()
    {
        _import.Reset();
        _import.Domain = _result?.Domain ?? _model.Domain;
        _import.PrimaryAdminEmail = string.IsNullOrWhiteSpace(_model.PrimaryAdminEmail) ? null : _model.PrimaryAdminEmail;
        _importOpen = true;
    }

    private async Task ImportExistingAsync()
    {
        if (string.IsNullOrWhiteSpace(_import.Domain)
            && string.IsNullOrWhiteSpace(_import.CloudIdentityId)
            && string.IsNullOrWhiteSpace(_import.PrimaryAdminEmail))
        {
            Snackbar.Add("Provide a domain, Cloud Identity id, or primary admin email to import.", Severity.Warning);
            return;
        }

        _importing = true;
        try
        {
            var imported = await Api.ImportCustomerAsync(new ImportCustomerRequest
            {
                Domain = _import.Domain,
                CloudIdentityId = _import.CloudIdentityId,
                PrimaryAdminEmail = _import.PrimaryAdminEmail,
                OverwriteIfExists = _import.OverwriteIfExists
            });

            _importOpen = false;
            Snackbar.Add($"Imported {imported?.OrgDisplayName ?? imported?.Domain ?? "customer"}.", Severity.Success);
            if (imported is not null)
            {
                Nav.NavigateTo($"/customers/{imported.Id}");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to import customer: {ex.Message}", Severity.Error);
        }
        finally
        {
            _importing = false;
        }
    }

    private void ViewPartnerLink(string id) => Nav.NavigateTo($"/channel-partner-links/{id}");

    private async Task RecheckAsync(IdentityCheckHistoryItem item)
    {
        _model.Domain = item.Domain;
        _model.PrimaryAdminEmail = null;
        await RunCheckAsync(forceRefresh: true);
    }

    private async Task RunCheckAsync(bool forceRefresh)
    {
        _busy = true;
        _result = null;
        try
        {
            _result = await Api.CheckCloudIdentityAsync(
                new CheckCloudIdentityRequest
                {
                    Domain = _model.Domain,
                    PrimaryAdminEmail = string.IsNullOrWhiteSpace(_model.PrimaryAdminEmail) ? null : _model.PrimaryAdminEmail
                },
                forceRefresh);

            await LoadHistoryAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Check failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadHistoryAsync()
    {
        try
        {
            var result = await Api.GetIdentityCheckHistoryAsync();
            _history = result?.Items ?? [];
        }
        catch
        {
            // History is a convenience; ignore load failures so the check form still works.
        }
    }

    private sealed class InputModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string Domain { get; set; } = string.Empty;
        public string? PrimaryAdminEmail { get; set; }
    }

    private sealed class ImportModel
    {
        public string? Domain { get; set; }
        public string? CloudIdentityId { get; set; }
        public string? PrimaryAdminEmail { get; set; }
        public bool OverwriteIfExists { get; set; }

        public void Reset()
        {
            Domain = null;
            CloudIdentityId = null;
            PrimaryAdminEmail = null;
            OverwriteIfExists = false;
        }
    }
}
