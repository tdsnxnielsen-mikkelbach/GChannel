@page "/customers"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IDialogService DialogService

<PageTitle>Customers · GChannel</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h4">Customers</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.PersonAdd"
               Href="/customers/new">
        New customer
    </MudButton>
</div>

<MudText Typo="Typo.body1" Class="mb-6" Color="Color.Secondary">
    Customers linked to your reseller account. Open a customer to view details and the catalog they
    are eligible to purchase.
</MudText>

@if (_loading)
{
    <LoadingPanel Title="Loading customers…"
                  Hint="Fetching the customers linked to your reseller account." />
}
else if (_customers is { Count: > 0 })
{
    <MudTable Items="_customers" Hover="true" Elevation="2" Dense="false">
        <HeaderContent>
            <MudTh>Organization</MudTh>
            <MudTh>Domain</MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<Customer, object>(x => string.IsNullOrEmpty(x.CloudIdentityId) ? 1 : 0)">
                    Cloud Identity
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortBy="new Func<Customer, object>(x => x.CreateTime ?? DateTimeOffset.MinValue)">
                    Created
                </MudTableSortLabel>
            </MudTh>
            <MudTh Style="text-align:right">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Organization">@(context.OrgDisplayName ?? context.Id)</MudTd>
            <MudTd DataLabel="Domain">@context.Domain</MudTd>
            <MudTd DataLabel="Cloud Identity">
                @if (!string.IsNullOrEmpty(context.CloudIdentityId))
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">Linked</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">Not linked</MudChip>
                }
                @if (!string.IsNullOrEmpty(context.Domain))
                {
                    <MudTooltip Text="Check Cloud Identity for this domain">
                        <MudIconButton Icon="@Icons.Material.Filled.VerifiedUser" Size="Size.Small" Color="Color.Primary"
                                       Href="@($"/accounts/cloud-identity?domain={Uri.EscapeDataString(context.Domain)}")" />
                    </MudTooltip>
                }
            </MudTd>
            <MudTd DataLabel="Created">@(context.CreateTime?.ToString("yyyy-MM-dd") ?? "—")</MudTd>
            <MudTd DataLabel="Actions" Style="text-align:right">
                <MudTooltip Text="View">
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                   Href="@($"/customers/{context.Id}")" />
                </MudTooltip>
                <MudTooltip Text="Entitlements">
                    <MudIconButton Icon="@Icons.Material.Filled.Subscriptions" Size="Size.Small"
                                   Href="@($"/customers/{context.Id}/entitlements")" />
                </MudTooltip>
                <MudTooltip Text="Edit">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   Href="@($"/customers/edit/{context.Id}")" />
                </MudTooltip>
                <MudTooltip Text="Delete">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                   OnClick="@(() => DeleteAsync(context))" />
                </MudTooltip>
            </MudTd>
        </RowTemplate>
    </MudTable>
}
else
{
    <MudAlert Severity="Severity.Info">
        No customers yet. Use <strong>New customer</strong> to create one.
    </MudAlert>
}

@code {
    private IReadOnlyList<Customer>? _customers;
    private bool _loading = true;

    // Load after the first interactive render rather than in OnInitializedAsync, so the API call
    // runs once on the live circuit instead of being issued (and canceled) during prerendering.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var result = await Api.ListCustomersAsync();
            _customers = result?.Customers ?? [];
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load customers: {ex.Message}", Severity.Error);
            _customers = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DeleteAsync(Customer customer)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete customer",
            $"Delete '{customer.OrgDisplayName ?? customer.Id}'? This cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Api.DeleteCustomerAsync(customer.Id);
            Snackbar.Add("Customer deleted.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to delete customer: {ex.Message}", Severity.Error);
        }
    }
}
