@page "/customers"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject UiNotifier Snackbar
@inject NavigationManager Nav
@inject DialogService Dialogs

<PageTitle>Customers · GChannel</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap" class="rz-mb-4">
    <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">Customers</RadzenText>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <div style="position:relative; display:inline-flex">
            <RadzenButton Text="Import customer" Icon="@AppIcons.MoveToInbox" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Click="OpenImportDialogAsync" />
            <FeatureBeacon Id="import-customer-v1" Tooltip="New: import a customer that already has a Cloud Identity" />
        </div>
        <LinkButton To="/customers/new" Text="New customer" Icon="@AppIcons.PersonAdd" />
    </RadzenStack>
</RadzenStack>

<RadzenText TextStyle="TextStyle.Body1" class="rz-text-secondary-color rz-mb-4">
    Customers linked to your reseller account. Paging, sorting and search run server-side against the
    synced read-model. Open a customer to view details and the catalog they are eligible to purchase.
</RadzenText>

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap" class="rz-mb-2">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Wrap="FlexWrap.Wrap">
        <SearchBox Value="@_search" ValueChanged="OnSearchChanged" Label="Search org, domain, id…" />
        <RadzenDropDown TValue="string" Data="_scopes" TextProperty="@nameof(SelectOption.Text)" ValueProperty="@nameof(SelectOption.Value)"
                        Value="@_scope" ValueChanged="OnScopeChanged" Style="width: 180px" aria-label="Source" Name="scope" />
    </RadzenStack>
    <AsOfBadge AsOf="_asOf" />
</RadzenStack>

<RadzenCard Variant="Variant.Filled">
    <RadzenDataGrid @ref="_grid" TItem="EstateCustomer" Data="_items" Count="_total" LoadData="OnLoadData" IsLoading="_loading"
                    AllowPaging="true" PageSize="25" PageSizeOptions="_pageSizes" ShowPagingSummary="true"
                    AllowSorting="true" Density="Density.Compact" GridLines="DataGridGridLines.Horizontal" Responsive="true"
                    ExpandMode="DataGridExpandMode.Multiple" RowExpand="OnRowExpandAsync">
        <Columns>
            <RadzenDataGridColumn TItem="EstateCustomer" Property="@nameof(EstateCustomer.OrgName)" SortProperty="org" Title="Organization">
                <Template Context="c">@(c.OrgName ?? c.CustomerId)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="EstateCustomer" Property="@nameof(EstateCustomer.Domain)" SortProperty="domain" Title="Domain" />
            <RadzenDataGridColumn TItem="EstateCustomer" Title="Source" Sortable="false">
                <Template Context="c">
                    @if (c.IsResellerSelf)
                    {
                        <Tip Text="A reseller buying for their own use — a direct sale from us.">
                            <RadzenBadge BadgeStyle="BadgeStyle.Primary" Text="Direct (reseller own use)" />
                        </Tip>
                    }
                    else
                    {
                        <Tip Text="@($"End customer of reseller {c.ResellerName ?? c.OwningLinkId}")">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                                @if (c.OwningLinkId is not null)
                                {
                                    <a href="@($"/channel-partner-links/{c.OwningLinkId}")"><RadzenBadge BadgeStyle="BadgeStyle.Info" Text="Reseller" /></a>
                                }
                                else
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="Reseller" />
                                }
                                <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Span" class="rz-text-secondary-color rz-m-0">@(c.ResellerName ?? c.OwningLinkId)</RadzenText>
                            </RadzenStack>
                        </Tip>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="EstateCustomer" Title="Cloud Identity" Sortable="false">
                <Template Context="c">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                        @if (!string.IsNullOrEmpty(c.CloudIdentityId))
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Linked" />
                        }
                        else
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="Not linked" />
                        }
                        @if (!string.IsNullOrEmpty(c.Domain))
                        {
                            <Tip Text="Check Cloud Identity for this domain">
                                <LinkButton To="@($"/accounts/cloud-identity?domain={Uri.EscapeDataString(c.Domain)}")" Icon="@AppIcons.VerifiedUser"
                                            Variant="Variant.Text" Size="ButtonSize.Small" Title="Check Cloud Identity" />
                            </Tip>
                        }
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="EstateCustomer" Property="@nameof(EstateCustomer.SeatCount)" SortProperty="seats" Title="Seats" Width="80px" />
            <RadzenDataGridColumn TItem="EstateCustomer" Title="Subscriptions" Sortable="false">
                <Template Context="c">
                    <span>@c.ActiveSubscriptions Active</span>
                    @if (c.SuspendedSubscriptions > 0)
                    {
                        <span class="rz-text-secondary-color"> · @c.SuspendedSubscriptions Suspended</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="EstateCustomer" Title="Renewal" Sortable="false">
                <Template Context="c">
                    @if (c.NextRenewalUtc is { } r)
                    {
                        <Tip Text="@(c.NextRenewalOfferName ?? "Next commitment renewal")">
                            <div>
                                <div>@r.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</div>
                                @if (!string.IsNullOrEmpty(c.NextRenewalOfferName))
                                {
                                    <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Div" class="rz-text-secondary-color rz-m-0">@c.NextRenewalOfferName</RadzenText>
                                }
                            </div>
                        </Tip>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="EstateCustomer" Title="Auto-renew" Sortable="false">
                <Template Context="c">
                    @if (c.NextRenewalAutoRenew is true)
                    {
                        <Tip Text="Auto-renewal is on for the next renewing subscription.">
                            <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="On" />
                        </Tip>
                    }
                    else if (c.NextRenewalAutoRenew is false)
                    {
                        <Tip Text="Auto-renewal is off — the next renewing subscription will not renew automatically.">
                            <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="Off" />
                        </Tip>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="EstateCustomer" Title="Est. monthly" Sortable="false">
                <Template Context="c">
                    @if (c.EstimatedMonthlyTotal is { } v)
                    {
                        <Tip Text="Estimated from offer list pricing with repricing applied — not invoiced.">@FormatMoney(v, c.Currency)</Tip>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="EstateCustomer" Title="Billed (last month)" Sortable="false">
                <Template Context="c">
                    @if (BilledLabel(c.CustomerId) is { } billed)
                    {
                        <Tip Text="Actual billed GCP/Marketplace spend from the BigQuery cost export — real invoiced-style figure.">@billed</Tip>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="EstateCustomer" Property="@nameof(EstateCustomer.CreateTime)" SortProperty="created" Title="Created" Width="110px">
                <Template Context="c">@(c.CreateTime?.ToString("yyyy-MM-dd") ?? "—")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="EstateCustomer" Title="Actions" Sortable="false" TextAlign="TextAlign.End" Width="230px">
                <Template Context="c">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.25rem" class="rz-text-nowrap">
                        <Tip Text="Refresh now">
                            <RadzenButton Icon="@AppIcons.Sync" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Click="@(() => ResyncAsync(c))" aria-label="Refresh now" />
                        </Tip>
                        <Tip Text="View">
                            <LinkButton To="@($"/customers/{c.CustomerId}")" Icon="@AppIcons.Visibility" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Title="View" />
                        </Tip>
                        <Tip Text="Entitlements">
                            <LinkButton To="@($"/customers/{c.CustomerId}/entitlements")" Icon="@AppIcons.Subscriptions" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Title="Entitlements" />
                        </Tip>
                        <Tip Text="Edit">
                            <LinkButton To="@($"/customers/edit/{c.CustomerId}")" Icon="@AppIcons.Edit" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Title="Edit" />
                        </Tip>
                        <Tip Text="Delete">
                            <RadzenButton Icon="@AppIcons.Delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="@(() => DeleteAsync(c))" aria-label="Delete" />
                        </Tip>
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
        <Template Context="customer">
            <div class="rz-p-3 rz-background-color-base-50">
                @if (!_subscriptions.TryGetValue(customer.CustomerId, out var subs))
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-my-2">
                        <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.ExtraSmall" ShowValue="false" />
                        <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">Loading subscriptions…</RadzenText>
                    </RadzenStack>
                }
                else if (subs is null)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-m-0">Couldn't load this customer's subscriptions.</RadzenAlert>
                }
                else if (subs.Count == 0)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-m-0">No subscriptions for this customer yet.</RadzenAlert>
                }
                else
                {
                    <RadzenRow Gap="1rem" RowGap="1rem">
                        @foreach (var e in subs)
                        {
                            <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
                                <RadzenCard Variant="Variant.Outlined" class="rz-h-100">
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Start" Gap="0.5rem" class="rz-mb-1">
                                        <div>
                                            <RadzenText TextStyle="TextStyle.Body1" class="rz-m-0" Style="font-weight:600">@OfferTitle(e)</RadzenText>
                                            @if (!string.IsNullOrWhiteSpace(e.ProductDisplayName) && e.ProductDisplayName != OfferTitle(e))
                                            {
                                                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">@e.ProductDisplayName</RadzenText>
                                            }
                                        </div>
                                        <RadzenBadge BadgeStyle="@StateColor(e.ProvisioningState)" Text="@StateLabel(e.ProvisioningState)" />
                                    </RadzenStack>
                                    <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-mb-2">
                                        @(e.PlanDescription ?? e.Commitment?.PaymentPlan ?? e.OfferDisplayName ?? "Plan not available")
                                    </RadzenText>
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-1">
                                        <RadzenIcon Icon="@AppIcons.Event" class="rz-text-secondary-color" />
                                        <span>Renewal @RenewalText(e)</span>
                                    </RadzenStack>
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-2">
                                        <RadzenIcon Icon="@AppIcons.People" class="rz-text-secondary-color" />
                                        <Tip Text="Assigned-seat counts aren't available from the Channel API; total licenses shown.">— / @SeatCount(e) licenses</Tip>
                                    </RadzenStack>
                                    <LinkButton To="@($"/customers/{customer.CustomerId}/entitlements/{e.Id}")" Text="Details" Variant="Variant.Text" Size="ButtonSize.Small" />
                                </RadzenCard>
                            </RadzenColumn>
                        }
                    </RadzenRow>
                }
            </div>
        </Template>
        <EmptyTemplate>
            @if (_loading)
            {
                <LoadingPanel Title="Loading customers…" Hint="Querying the synced read-model." />
            }
            else
            {
                <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-m-3">No customers yet. Use <strong>New customer</strong> to create one.</RadzenAlert>
            }
        </EmptyTemplate>
    </RadzenDataGrid>
</RadzenCard>

@code {
    private static readonly IEnumerable<int> _pageSizes = [25, 50, 100];
    private static readonly SelectOption[] _scopes =
    [
        new("all", "All customers"),
        new("direct", "Direct only"),
        new("indirect", "Via resellers"),
    ];

    private RadzenDataGrid<EstateCustomer>? _grid;
    // Must start null: RadzenDataGrid only invokes LoadData on first render while Data is null.
    private List<EstateCustomer>? _items;
    private int _total;
    private bool _loading = true;
    private string? _search;
    private string _scope = "all";
    private DateTimeOffset? _asOf;

    // Lazily-loaded subscription cards per expanded customer (null value = load failed).
    private readonly Dictionary<string, List<Entitlement>?> _subscriptions = new(StringComparer.OrdinalIgnoreCase);

    private async Task OnRowExpandAsync(EstateCustomer customer)
    {
        if (_subscriptions.ContainsKey(customer.CustomerId))
        {
            return; // already loaded (or loading) — keep the cached cards
        }

        try
        {
            var result = await Api.ListEntitlementsAsync(customer.CustomerId);
            _subscriptions[customer.CustomerId] = result?.Entitlements?.ToList() ?? [];
        }
        catch
        {
            _subscriptions[customer.CustomerId] = null;
        }
    }

    private static string OfferTitle(Entitlement e) =>
        e.SkuDisplayName ?? e.ProductDisplayName ?? e.OfferDisplayName ?? e.OfferId ?? e.Id;

    private static string StateLabel(string? state) =>
        string.IsNullOrEmpty(state) ? "Unknown" : char.ToUpperInvariant(state[0]) + state[1..].ToLowerInvariant();

    private static BadgeStyle StateColor(string? state) => state?.ToUpperInvariant() switch
    {
        "ACTIVE" => BadgeStyle.Success,
        "SUSPENDED" => BadgeStyle.Warning,
        "CANCELLED" or "CANCELED" => BadgeStyle.Danger,
        "PENDING" => BadgeStyle.Info,
        _ => BadgeStyle.Light,
    };

    private static string RenewalText(Entitlement e) =>
        e.Commitment?.EndTime is { } end
            ? end.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)
            : "—";

    private static long SeatCount(Entitlement e)
    {
        var raw = e.Parameters.FirstOrDefault(p =>
            string.Equals(p.Name, "num_units", StringComparison.OrdinalIgnoreCase))?.Value;
        return long.TryParse(raw, out var n) ? n : 0;
    }

    private static string FormatMoney(decimal value, string? currency) =>
        string.IsNullOrEmpty(currency)
            ? value.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)
            : $"{currency} {value.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)}";

    // Bulk billed (actual) spend per customer for the list column — loaded once, best-effort.
    private readonly Dictionary<string, (decimal Cost, string Currency)> _billed = new(StringComparer.OrdinalIgnoreCase);
    private bool _billedLoaded;

    private async Task EnsureBilledAsync(CancellationToken token)
    {
        if (_billedLoaded) { return; }
        _billedLoaded = true;
        try
        {
            var result = await Api.GetCustomerBilledSummariesAsync(1, token);
            foreach (var g in (result?.Customers ?? []).GroupBy(c => c.CustomerId, StringComparer.OrdinalIgnoreCase))
            {
                var top = g.OrderByDescending(x => x.Cost).First();
                _billed[g.Key] = (top.Cost, top.Currency);
            }
        }
        catch
        {
            // Best-effort column; leave blanks if the billed lookup fails.
        }
    }

    private string? BilledLabel(string customerId) =>
        _billed.TryGetValue(customerId, out var v) ? FormatMoney(v.Cost, v.Currency) : null;

    // Server-side read: Radzen gives Skip/Top, the API takes a 0-based page; sort keys come from SortProperty.
    private async Task OnLoadData(LoadDataArgs args)
    {
        _loading = true;
        var pageSize = args.Top ?? 25;
        var page = pageSize == 0 ? 0 : (args.Skip ?? 0) / pageSize;
        var sort = args.Sorts?.FirstOrDefault();
        try
        {
            await EnsureBilledAsync(CancellationToken.None);
            var result = await Api.ListEstateCustomersAsync(
                page, pageSize, sort?.Property,
                sort?.SortOrder == SortOrder.Descending,
                _search, linkId: _scope == "all" ? null : _scope, CancellationToken.None);

            _items = result?.Items?.ToList() ?? [];
            _total = result?.Total ?? 0;
            _asOf = result?.AsOf;
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load customers: {ex.Message}", Severity.Error);
            _items = [];
            _total = 0;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSearchChanged(string? value)
    {
        _search = value;
        await ReloadFirstPageAsync();
    }

    private async Task OnScopeChanged(string value)
    {
        _scope = value;
        await ReloadFirstPageAsync();
    }

    private async Task ReloadFirstPageAsync()
    {
        if (_grid is null)
        {
            return;
        }

        await _grid.FirstPage(true);
    }

    private async Task ResyncAsync(EstateCustomer customer)
    {
        try
        {
            await Api.ResyncCustomerAsync(customer.CustomerId);
            await Snackbar.Add("Queued for refresh — data updates on the next sync cycle.", Severity.Info);
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to queue refresh: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteAsync(EstateCustomer customer)
    {
        var confirmed = await Snackbar.ConfirmAsync(
            "Delete customer",
            $"Delete '{customer.OrgName ?? customer.CustomerId}'? This cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (!confirmed)
        {
            return;
        }

        try
        {
            await Api.DeleteCustomerAsync(customer.CustomerId);
            await Snackbar.Add("Customer deleted.", Severity.Success);
            if (_grid is not null) await _grid.Reload();
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to delete customer: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenImportDialogAsync()
    {
        var imported = await Dialogs.OpenAsync<ImportCustomerDialog>("Import existing customer", new Dictionary<string, object?>
        {
            [nameof(ImportCustomerDialog.Import)] = new Func<ImportCustomerRequest, Task<Customer?>>(request => Api.ImportCustomerAsync(request))
        }, new DialogOptions { Width = "min(34rem, 95vw)", CloseDialogOnOverlayClick = false });

        if (imported is Customer customer)
        {
            Nav.NavigateTo($"/customers/{customer.Id}");
        }
    }
}
