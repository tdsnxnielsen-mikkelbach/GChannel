@page "/customers"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IDialogService DialogService

<PageTitle>Customers · GChannel</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h4">Customers</MudText>
    <div class="d-flex align-center" style="gap:8px">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.MoveToInbox"
                   OnClick="OpenImportDialog">
            Import customer
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.PersonAdd"
                   Href="/customers/new">
            New customer
        </MudButton>
    </div>
</div>

<MudText Typo="Typo.body1" Class="mb-4" Color="Color.Secondary">
    Customers linked to your reseller account. Paging, sorting and search run server-side against the
    synced read-model. Open a customer to view details and the catalog they are eligible to purchase.
</MudText>

<div class="d-flex justify-space-between align-center mb-2">
    <div class="d-flex align-center gap-2" style="gap:12px">
        <MudTextField T="string" @bind-Value="_search" Immediate="false" DebounceInterval="400"
                      OnDebounceIntervalElapsed="OnSearchChanged" Placeholder="Search org, domain, id…"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:360px" />
        <MudSelect T="string" Value="_scope" Label="Source" Dense="true" Margin="Margin.Dense"
                   Variant="Variant.Outlined" Style="max-width:180px" ValueChanged="OnScopeChanged">
            <MudSelectItem Value="@("all")">All customers</MudSelectItem>
            <MudSelectItem Value="@("direct")">Direct only</MudSelectItem>
            <MudSelectItem Value="@("indirect")">Via resellers</MudSelectItem>
        </MudSelect>
    </div>
    <AsOfBadge AsOf="_asOf" />
</div>

<MudTable @ref="_table" ServerData="LoadServerData" Hover="true" Elevation="2" Dense="false" RowsPerPage="25">
    <HeaderContent>
        <MudTh Style="width:1px"></MudTh>
        <MudTh><MudTableSortLabel SortLabel="org" T="EstateCustomer">Organization</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortLabel="domain" T="EstateCustomer">Domain</MudTableSortLabel></MudTh>
        <MudTh>Source</MudTh>
        <MudTh>Cloud Identity</MudTh>
        <MudTh><MudTableSortLabel SortLabel="seats" T="EstateCustomer">Seats</MudTableSortLabel></MudTh>
        <MudTh>Subscriptions</MudTh>
        <MudTh>Renewal</MudTh>
        <MudTh>Auto-renew</MudTh>
        <MudTh>Est. monthly</MudTh>
        <MudTh><MudTableSortLabel SortLabel="created" T="EstateCustomer">Created</MudTableSortLabel></MudTh>
        <MudTh Style="text-align:right">Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd Style="width:1px">
            <MudTooltip Text="@(IsExpanded(context) ? "Hide subscriptions" : "Show subscriptions")">
                <MudIconButton Size="Size.Small"
                               Icon="@(IsExpanded(context) ? Icons.Material.Filled.KeyboardArrowUp : Icons.Material.Filled.KeyboardArrowDown)"
                               OnClick="@(() => ToggleExpandAsync(context))" />
            </MudTooltip>
        </MudTd>
        <MudTd DataLabel="Organization">@(context.OrgName ?? context.CustomerId)</MudTd>
        <MudTd DataLabel="Domain">@context.Domain</MudTd>
        <MudTd DataLabel="Source">
            @if (context.OwningLinkId is null)
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">Direct</MudChip>
            }
            else
            {
                <MudTooltip Text="@($"Indirect customer owned by reseller link {context.OwningLinkId}")">
                    <div class="d-flex align-center">
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text"
                                 Href="@($"/channel-partner-links/{context.OwningLinkId}")">Reseller</MudChip>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@(context.ResellerName ?? context.OwningLinkId)</MudText>
                    </div>
                </MudTooltip>
            }
        </MudTd>
        <MudTd DataLabel="Cloud Identity">
            @if (!string.IsNullOrEmpty(context.CloudIdentityId))
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">Linked</MudChip>
            }
            else
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">Not linked</MudChip>
            }
            @if (!string.IsNullOrEmpty(context.Domain))
            {
                <MudTooltip Text="Check Cloud Identity for this domain">
                    <MudIconButton Icon="@Icons.Material.Filled.VerifiedUser" Size="Size.Small" Color="Color.Primary"
                                   Href="@($"/accounts/cloud-identity?domain={Uri.EscapeDataString(context.Domain)}")" />
                </MudTooltip>
            }
        </MudTd>
        <MudTd DataLabel="Seats">@context.SeatCount</MudTd>
        <MudTd DataLabel="Subscriptions">
            <span>@context.ActiveSubscriptions Active</span>
            @if (context.SuspendedSubscriptions > 0)
            {
                <span class="mud-text-secondary"> · @context.SuspendedSubscriptions Suspended</span>
            }
        </MudTd>
        <MudTd DataLabel="Renewal">
            @if (context.NextRenewalUtc is { } r)
            {
                <MudTooltip Text="@(context.NextRenewalOfferName ?? "Next commitment renewal")">
                    <div>
                        <div>@r.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</div>
                        @if (!string.IsNullOrEmpty(context.NextRenewalOfferName))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.NextRenewalOfferName</MudText>
                        }
                    </div>
                </MudTooltip>
            }
            else
            {
                <span>—</span>
            }
        </MudTd>
        <MudTd DataLabel="Auto-renew">
            @if (context.NextRenewalAutoRenew is true)
            {
                <MudTooltip Text="Auto-renewal is on for the next renewing subscription.">
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text"
                             Icon="@Icons.Material.Filled.Autorenew">On</MudChip>
                </MudTooltip>
            }
            else if (context.NextRenewalAutoRenew is false)
            {
                <MudTooltip Text="Auto-renewal is off — the next renewing subscription will not renew automatically.">
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text"
                             Icon="@Icons.Material.Filled.Block">Off</MudChip>
                </MudTooltip>
            }
            else
            {
                <span>—</span>
            }
        </MudTd>
        <MudTd DataLabel="Est. monthly">
            @if (context.EstimatedMonthlyTotal is { } v)
            {
                <MudTooltip Text="Estimated from offer list pricing with repricing applied — not invoiced.">
                    <span>@FormatMoney(v, context.Currency)</span>
                </MudTooltip>
            }
            else
            {
                <span>—</span>
            }
        </MudTd>
        <MudTd DataLabel="Created">@(context.CreateTime?.ToString("yyyy-MM-dd") ?? "—")</MudTd>
        <MudTd DataLabel="Actions" Style="text-align:right">
            <MudTooltip Text="Refresh now">
                <MudIconButton Icon="@Icons.Material.Filled.Sync" Size="Size.Small"
                               OnClick="@(() => ResyncAsync(context))" />
            </MudTooltip>
            <MudTooltip Text="View">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                               Href="@($"/customers/{context.CustomerId}")" />
            </MudTooltip>
            <MudTooltip Text="Entitlements">
                <MudIconButton Icon="@Icons.Material.Filled.Subscriptions" Size="Size.Small"
                               Href="@($"/customers/{context.CustomerId}/entitlements")" />
            </MudTooltip>
            <MudTooltip Text="Edit">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               Href="@($"/customers/edit/{context.CustomerId}")" />
            </MudTooltip>
            <MudTooltip Text="Delete">
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => DeleteAsync(context))" />
            </MudTooltip>
        </MudTd>
    </RowTemplate>
    <ChildRowContent>
        @if (IsExpanded(context))
        {
            <MudTr>
                <td colspan="12" class="pa-4" style="background-color:var(--mud-palette-background-grey)">
                    @if (!_subscriptions.TryGetValue(context.CustomerId, out var subs))
                    {
                        <div class="d-flex align-center my-2">
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Loading subscriptions…</MudText>
                        </div>
                    }
                    else if (subs is null)
                    {
                        <MudAlert Severity="Severity.Error" Dense="true">Couldn't load this customer's subscriptions.</MudAlert>
                    }
                    else if (subs.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">No subscriptions for this customer yet.</MudAlert>
                    }
                    else
                    {
                        <MudGrid Spacing="3">
                            @foreach (var e in subs)
                            {
                                <MudItem xs="12" sm="6" md="4">
                                    <MudCard Elevation="1" Class="h-100">
                                        <MudCardContent>
                                            <div class="d-flex justify-space-between align-start mb-1">
                                                <MudText Typo="Typo.subtitle2">@OfferTitle(e)</MudText>
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                                         Color="@StateColor(e.ProvisioningState)">@StateLabel(e.ProvisioningState)</MudChip>
                                            </div>
                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                                                @(e.PlanDescription ?? e.Commitment?.PaymentPlan ?? "Plan not available")
                                            </MudText>
                                            <div class="d-flex align-center mb-1">
                                                <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" Class="mr-2" Color="Color.Secondary" />
                                                <MudText Typo="Typo.body2">Renewal @RenewalText(e)</MudText>
                                            </div>
                                            <div class="d-flex align-center">
                                                <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Class="mr-2" Color="Color.Secondary" />
                                                <MudTooltip Text="Assigned-seat counts aren't available from the Channel API; total licenses shown.">
                                                    <MudText Typo="Typo.body2">— / @SeatCount(e) licenses</MudText>
                                                </MudTooltip>
                                            </div>
                                        </MudCardContent>
                                        <MudCardActions>
                                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                                       Href="@($"/customers/{context.CustomerId}/entitlements/{e.Id}")">Details</MudButton>
                                        </MudCardActions>
                                    </MudCard>
                                </MudItem>
                            }
                        </MudGrid>
                    }
                </td>
            </MudTr>
        }
    </ChildRowContent>
    <NoRecordsContent>
        <MudAlert Severity="Severity.Info">No customers yet. Use <strong>New customer</strong> to create one.</MudAlert>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" />
    </PagerContent>
</MudTable>

<MudDialog @bind-Visible="_importOpen" Options="_importDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Import existing customer</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Bring a customer that already has a Cloud Identity into your reseller account — a pre-transfer
            step. Provide one identifier (domain, Cloud Identity id, or primary admin email).
        </MudText>
        <MudTextField @bind-Value="_import.Domain" Label="Primary domain" HelperText="e.g. contoso.com" Class="mb-3" />
        <MudTextField @bind-Value="_import.CloudIdentityId" Label="Cloud Identity id" Class="mb-3" />
        <MudTextField @bind-Value="_import.PrimaryAdminEmail" Label="Primary admin email" InputType="InputType.Email" Class="mb-3" />
        <MudCheckBox @bind-Value="_import.OverwriteIfExists" Label="Overwrite if the customer is already imported" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _importOpen = false)" Disabled="@_importing">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ImportAsync" Disabled="@_importing">
            @(_importing ? "Importing…" : "Import")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudTable<EstateCustomer>? _table;
    private string? _search;
    private string _scope = "all";
    private DateTimeOffset? _asOf;

    private bool _importOpen;
    private bool _importing;
    private readonly ImportModel _import = new();
    private static readonly DialogOptions _importDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true };

    // Per-customer expansion state + lazily-loaded subscription cards (null value = load failed).
    private readonly HashSet<string> _expanded = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, List<Entitlement>?> _subscriptions = new(StringComparer.OrdinalIgnoreCase);

    private bool IsExpanded(EstateCustomer c) => _expanded.Contains(c.CustomerId);

    private async Task ToggleExpandAsync(EstateCustomer customer)
    {
        if (!_expanded.Add(customer.CustomerId))
        {
            _expanded.Remove(customer.CustomerId);
            return;
        }

        if (_subscriptions.ContainsKey(customer.CustomerId))
        {
            return; // already loaded (or loading) — keep the cached cards
        }

        try
        {
            var result = await Api.ListEntitlementsAsync(customer.CustomerId);
            _subscriptions[customer.CustomerId] = result?.Entitlements?.ToList() ?? [];
        }
        catch
        {
            _subscriptions[customer.CustomerId] = null;
        }
    }

    private static string OfferTitle(Entitlement e) =>
        e.OfferDisplayName ?? e.SkuDisplayName ?? e.ProductDisplayName ?? e.OfferId ?? e.Id;

    private static string StateLabel(string? state) =>
        string.IsNullOrEmpty(state) ? "Unknown" : char.ToUpperInvariant(state[0]) + state[1..].ToLowerInvariant();

    private static Color StateColor(string? state) => state?.ToUpperInvariant() switch
    {
        "ACTIVE" => Color.Success,
        "SUSPENDED" => Color.Warning,
        "CANCELLED" or "CANCELED" => Color.Error,
        "PENDING" => Color.Info,
        _ => Color.Default,
    };

    private static string RenewalText(Entitlement e) =>
        e.Commitment?.EndTime is { } end
            ? end.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)
            : "—";

    private static long SeatCount(Entitlement e)
    {
        var raw = e.Parameters.FirstOrDefault(p =>
            string.Equals(p.Name, "num_units", StringComparison.OrdinalIgnoreCase))?.Value;
        return long.TryParse(raw, out var n) ? n : 0;
    }

    private static string FormatMoney(decimal value, string? currency) =>
        string.IsNullOrEmpty(currency)
            ? value.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)
            : $"{currency} {value.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)}";

    private async Task<TableData<EstateCustomer>> LoadServerData(TableState state, CancellationToken token)
    {
        try
        {
            var result = await Api.ListEstateCustomersAsync(
                state.Page, state.PageSize, state.SortLabel,
                state.SortDirection == SortDirection.Descending,
                _search, linkId: _scope == "all" ? null : _scope, token);

            _asOf = result?.AsOf;
            return new TableData<EstateCustomer> { Items = result?.Items ?? [], TotalItems = result?.Total ?? 0 };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load customers: {ex.Message}", Severity.Error);
            return new TableData<EstateCustomer> { Items = [], TotalItems = 0 };
        }
    }

    private async Task OnSearchChanged(string _) => await (_table?.ReloadServerData() ?? Task.CompletedTask);

    private async Task OnScopeChanged(string value)
    {
        _scope = value;
        await (_table?.ReloadServerData() ?? Task.CompletedTask);
    }

    private async Task ResyncAsync(EstateCustomer customer)
    {
        try
        {
            await Api.ResyncCustomerAsync(customer.CustomerId);
            Snackbar.Add("Queued for refresh — data updates on the next sync cycle.", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to queue refresh: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteAsync(EstateCustomer customer)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete customer",
            $"Delete '{customer.OrgName ?? customer.CustomerId}'? This cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Api.DeleteCustomerAsync(customer.CustomerId);
            Snackbar.Add("Customer deleted.", Severity.Success);
            if (_table is not null) await _table.ReloadServerData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to delete customer: {ex.Message}", Severity.Error);
        }
    }

    private void OpenImportDialog()
    {
        _import.Reset();
        _importOpen = true;
    }

    private async Task ImportAsync()
    {
        if (string.IsNullOrWhiteSpace(_import.Domain)
            && string.IsNullOrWhiteSpace(_import.CloudIdentityId)
            && string.IsNullOrWhiteSpace(_import.PrimaryAdminEmail))
        {
            Snackbar.Add("Provide a domain, Cloud Identity id, or primary admin email to import.", Severity.Warning);
            return;
        }

        _importing = true;
        try
        {
            var imported = await Api.ImportCustomerAsync(new ImportCustomerRequest
            {
                Domain = _import.Domain,
                CloudIdentityId = _import.CloudIdentityId,
                PrimaryAdminEmail = _import.PrimaryAdminEmail,
                OverwriteIfExists = _import.OverwriteIfExists
            });

            _importOpen = false;
            Snackbar.Add($"Imported {imported?.OrgDisplayName ?? imported?.Domain ?? "customer"}.", Severity.Success);
            if (imported is not null)
            {
                Nav.NavigateTo($"/customers/{imported.Id}");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to import customer: {ex.Message}", Severity.Error);
        }
        finally
        {
            _importing = false;
        }
    }

    private sealed class ImportModel
    {
        public string? Domain { get; set; }
        public string? CloudIdentityId { get; set; }
        public string? PrimaryAdminEmail { get; set; }
        public bool OverwriteIfExists { get; set; }

        public void Reset()
        {
            Domain = null;
            CloudIdentityId = null;
            PrimaryAdminEmail = null;
            OverwriteIfExists = false;
        }
    }
}
