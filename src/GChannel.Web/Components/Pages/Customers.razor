@page "/customers"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject UiNotifier Snackbar
@inject NavigationManager Nav

<PageTitle>Customers · GChannel</PageTitle>

<Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Margin="Margin.Is4.FromBottom">
    <Heading Size="HeadingSize.Is3" Margin="Margin.Is0">Customers</Heading>
    <Div Flex="Flex.AlignItems.Center" Gap="Gap.Is2">
        <div style="position:relative; display:inline-flex">
            <Button Color="Color.Primary" Outline Clicked="OpenImportDialog">
                <Icon Name="@AppIcons.MoveToInbox" Class="me-1" /> Import customer
            </Button>
            <FeatureBeacon Id="import-customer-v1" Tooltip="New: import a customer that already has a Cloud Identity" />
        </div>
        <Button Type="ButtonType.Link" To="/customers/new" Color="Color.Primary">
            <Icon Name="@AppIcons.PersonAdd" Class="me-1" /> New customer
        </Button>
    </Div>
</Div>

<Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is4.FromBottom">
    Customers linked to your reseller account. Paging, sorting and search run server-side against the
    synced read-model. Open a customer to view details and the catalog they are eligible to purchase.
</Paragraph>

<Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Margin="Margin.Is2.FromBottom">
    <Div Flex="Flex.AlignItems.Center" Gap="Gap.Is3">
        <Addons Style="max-width:360px">
            <Addon AddonType="AddonType.Start"><AddonLabel><Icon Name="@AppIcons.Search" /></AddonLabel></Addon>
            <Addon AddonType="AddonType.Body">
                <TextInput Value="@_search" ValueChanged="OnSearchChanged" Debounce="true" DebounceInterval="400"
                           Placeholder="Search org, domain, id…" />
            </Addon>
        </Addons>
        <Select TValue="string" Value="@_scope" ValueChanged="OnScopeChanged" Style="max-width:180px" aria-label="Source">
            <SelectItem Value="@("all")">All customers</SelectItem>
            <SelectItem Value="@("direct")">Direct only</SelectItem>
            <SelectItem Value="@("indirect")">Via resellers</SelectItem>
        </Select>
    </Div>
    <AsOfBadge AsOf="_asOf" />
</Div>

<Card Shadow="Shadow.Small">
    <DataGrid @ref="_grid" TItem="EstateCustomer" Data="_items" ReadData="OnReadData" TotalItems="_total"
              ShowPager ShowPageSizes PageSize="25" PageSizes="_pageSizes" Hoverable Responsive Sortable
              SortMode="DataGridSortMode.Single" DetailRowStartsVisible="false" DetailRowTrigger="@(e => IsExpanded(e.Item))">
        <DataGridColumns>
            <DataGridColumn TItem="EstateCustomer" Field="@nameof(EstateCustomer.CustomerId)" Caption=" " Sortable="false">
                <DisplayTemplate>
                    <Tooltip Text="@(IsExpanded(context.Item) ? "Hide subscriptions" : "Show subscriptions")" Inline>
                        <Button Size="Size.Small" Color="Color.Light" Clicked="@(() => ToggleExpandAsync(context.Item))" aria-label="Toggle subscriptions">
                            <Icon Name="@(IsExpanded(context.Item) ? AppIcons.KeyboardArrowUp : AppIcons.KeyboardArrowDown)" />
                        </Button>
                    </Tooltip>
                </DisplayTemplate>
            </DataGridColumn>
            <DataGridColumn TItem="EstateCustomer" Field="@nameof(EstateCustomer.OrgName)" SortField="org" Caption="Organization">
                <DisplayTemplate>@(context.Item.OrgName ?? context.Item.CustomerId)</DisplayTemplate>
            </DataGridColumn>
            <DataGridColumn TItem="EstateCustomer" Field="@nameof(EstateCustomer.Domain)" SortField="domain" Caption="Domain" />
            <DataGridColumn TItem="EstateCustomer" Field="@nameof(EstateCustomer.IsResellerSelf)" Caption="Source" Sortable="false">
                <DisplayTemplate>
                    @if (context.Item.IsResellerSelf)
                    {
                        <Tooltip Text="A reseller buying for their own use — a direct sale from us." Inline>
                            <Badge Color="Color.Primary">Direct (reseller own use)</Badge>
                        </Tooltip>
                    }
                    else
                    {
                        <Tooltip Text="@($"End customer of reseller {context.Item.ResellerName ?? context.Item.OwningLinkId}")" Inline>
                            <Div Flex="Flex.AlignItems.Center" Gap="Gap.Is1">
                                @if (context.Item.OwningLinkId is not null)
                                {
                                    <Badge Color="Color.Info" Link="@($"/channel-partner-links/{context.Item.OwningLinkId}")">Reseller</Badge>
                                }
                                else
                                {
                                    <Badge Color="Color.Info">Reseller</Badge>
                                }
                                <Small TextColor="TextColor.Secondary">@(context.Item.ResellerName ?? context.Item.OwningLinkId)</Small>
                            </Div>
                        </Tooltip>
                    }
                </DisplayTemplate>
            </DataGridColumn>
            <DataGridColumn TItem="EstateCustomer" Field="@nameof(EstateCustomer.CloudIdentityId)" Caption="Cloud Identity" Sortable="false">
                <DisplayTemplate>
                    @if (!string.IsNullOrEmpty(context.Item.CloudIdentityId))
                    {
                        <Badge Color="Color.Success">Linked</Badge>
                    }
                    else
                    {
                        <Badge Color="Color.Secondary">Not linked</Badge>
                    }
                    @if (!string.IsNullOrEmpty(context.Item.Domain))
                    {
                        <Tooltip Text="Check Cloud Identity for this domain" Inline>
                            <Button Type="ButtonType.Link" To="@($"/accounts/cloud-identity?domain={Uri.EscapeDataString(context.Item.Domain)}")"
                                    Size="Size.Small" Color="Color.Primary" Class="btn-link" aria-label="Check Cloud Identity">
                                <Icon Name="@AppIcons.VerifiedUser" />
                            </Button>
                        </Tooltip>
                    }
                </DisplayTemplate>
            </DataGridColumn>
            <DataGridColumn TItem="EstateCustomer" Field="@nameof(EstateCustomer.SeatCount)" SortField="seats" Caption="Seats" />
            <DataGridColumn TItem="EstateCustomer" Field="@nameof(EstateCustomer.ActiveSubscriptions)" Caption="Subscriptions" Sortable="false">
                <DisplayTemplate>
                    <span>@context.Item.ActiveSubscriptions Active</span>
                    @if (context.Item.SuspendedSubscriptions > 0)
                    {
                        <span class="text-body-secondary"> · @context.Item.SuspendedSubscriptions Suspended</span>
                    }
                </DisplayTemplate>
            </DataGridColumn>
            <DataGridColumn TItem="EstateCustomer" Field="@nameof(EstateCustomer.NextRenewalUtc)" Caption="Renewal" Sortable="false">
                <DisplayTemplate>
                    @if (context.Item.NextRenewalUtc is { } r)
                    {
                        <Tooltip Text="@(context.Item.NextRenewalOfferName ?? "Next commitment renewal")" Inline>
                            <div>
                                <div>@r.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</div>
                                @if (!string.IsNullOrEmpty(context.Item.NextRenewalOfferName))
                                {
                                    <Small TextColor="TextColor.Secondary">@context.Item.NextRenewalOfferName</Small>
                                }
                            </div>
                        </Tooltip>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </DisplayTemplate>
            </DataGridColumn>
            <DataGridColumn TItem="EstateCustomer" Field="@nameof(EstateCustomer.NextRenewalAutoRenew)" Caption="Auto-renew" Sortable="false">
                <DisplayTemplate>
                    @if (context.Item.NextRenewalAutoRenew is true)
                    {
                        <Tooltip Text="Auto-renewal is on for the next renewing subscription." Inline>
                            <Badge Color="Color.Success"><Icon Name="@AppIcons.Autorenew" Class="me-1" />On</Badge>
                        </Tooltip>
                    }
                    else if (context.Item.NextRenewalAutoRenew is false)
                    {
                        <Tooltip Text="Auto-renewal is off — the next renewing subscription will not renew automatically." Inline>
                            <Badge Color="Color.Warning"><Icon Name="@AppIcons.Block" Class="me-1" />Off</Badge>
                        </Tooltip>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </DisplayTemplate>
            </DataGridColumn>
            <DataGridColumn TItem="EstateCustomer" Field="@nameof(EstateCustomer.EstimatedMonthlyTotal)" Caption="Est. monthly" Sortable="false">
                <DisplayTemplate>
                    @if (context.Item.EstimatedMonthlyTotal is { } v)
                    {
                        <Tooltip Text="Estimated from offer list pricing with repricing applied — not invoiced." Inline>
                            <span>@FormatMoney(v, context.Item.Currency)</span>
                        </Tooltip>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </DisplayTemplate>
            </DataGridColumn>
            <DataGridColumn TItem="EstateCustomer" Field="@nameof(EstateCustomer.Currency)" Caption="Billed (last month)" Sortable="false">
                <DisplayTemplate>
                    @if (BilledLabel(context.Item.CustomerId) is { } billed)
                    {
                        <Tooltip Text="Actual billed GCP/Marketplace spend from the BigQuery cost export — real invoiced-style figure." Inline>
                            <span>@billed</span>
                        </Tooltip>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </DisplayTemplate>
            </DataGridColumn>
            <DataGridColumn TItem="EstateCustomer" Field="@nameof(EstateCustomer.CreateTime)" SortField="created" Caption="Created">
                <DisplayTemplate>@(context.Item.CreateTime?.ToString("yyyy-MM-dd") ?? "—")</DisplayTemplate>
            </DataGridColumn>
            <DataGridColumn TItem="EstateCustomer" Field="@nameof(EstateCustomer.CustomerId)" Caption="Actions" Sortable="false" TextAlignment="TextAlignment.End" HeaderTextAlignment="TextAlignment.End">
                <DisplayTemplate>
                    <Div Flex="Flex.JustifyContent.End" Gap="Gap.Is1" Class="text-nowrap">
                        <Tooltip Text="Refresh now" Inline>
                            <Button Size="Size.Small" Color="Color.Light" Clicked="@(() => ResyncAsync(context.Item))" aria-label="Refresh now"><Icon Name="@AppIcons.Sync" /></Button>
                        </Tooltip>
                        <Tooltip Text="View" Inline>
                            <Button Type="ButtonType.Link" To="@($"/customers/{context.Item.CustomerId}")" Size="Size.Small" Color="Color.Light" aria-label="View"><Icon Name="@AppIcons.Visibility" /></Button>
                        </Tooltip>
                        <Tooltip Text="Entitlements" Inline>
                            <Button Type="ButtonType.Link" To="@($"/customers/{context.Item.CustomerId}/entitlements")" Size="Size.Small" Color="Color.Light" aria-label="Entitlements"><Icon Name="@AppIcons.Subscriptions" /></Button>
                        </Tooltip>
                        <Tooltip Text="Edit" Inline>
                            <Button Type="ButtonType.Link" To="@($"/customers/edit/{context.Item.CustomerId}")" Size="Size.Small" Color="Color.Light" aria-label="Edit"><Icon Name="@AppIcons.Edit" /></Button>
                        </Tooltip>
                        <Tooltip Text="Delete" Inline>
                            <Button Size="Size.Small" Color="Color.Danger" Outline Clicked="@(() => DeleteAsync(context.Item))" aria-label="Delete"><Icon Name="@AppIcons.Delete" /></Button>
                        </Tooltip>
                    </Div>
                </DisplayTemplate>
            </DataGridColumn>
        </DataGridColumns>
        <DetailRowTemplate>
            <Div Padding="Padding.Is3" Background="Background.Light">
                @if (!_subscriptions.TryGetValue(context.Item.CustomerId, out var subs))
                {
                    <Div Flex="Flex.AlignItems.Center" Margin="Margin.Is2.OnY">
                        <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                        <Small TextColor="TextColor.Secondary">Loading subscriptions…</Small>
                    </Div>
                }
                else if (subs is null)
                {
                    <Alert Color="Color.Danger" Visible Margin="Margin.Is0">Couldn't load this customer's subscriptions.</Alert>
                }
                else if (subs.Count == 0)
                {
                    <Alert Color="Color.Info" Visible Margin="Margin.Is0">No subscriptions for this customer yet.</Alert>
                }
                else
                {
                    <Row Gutter="Gutter.Is3">
                        @foreach (var e in subs)
                        {
                            <Column ColumnSize="ColumnSize.Is12.Is6.OnTablet.Is4.OnDesktop">
                                <Card Class="h-100">
                                    <CardBody>
                                        <Div Flex="Flex.JustifyContent.Between.AlignItems.Start" Margin="Margin.Is1.FromBottom">
                                            <Div>
                                                <Strong Display="Display.Block">@OfferTitle(e)</Strong>
                                                @if (!string.IsNullOrWhiteSpace(e.ProductDisplayName) && e.ProductDisplayName != OfferTitle(e))
                                                {
                                                    <Small TextColor="TextColor.Secondary">@e.ProductDisplayName</Small>
                                                }
                                            </Div>
                                            <Badge Color="@StateColor(e.ProvisioningState)">@StateLabel(e.ProvisioningState)</Badge>
                                        </Div>
                                        <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is2.FromBottom">
                                            @(e.PlanDescription ?? e.Commitment?.PaymentPlan ?? e.OfferDisplayName ?? "Plan not available")
                                        </Paragraph>
                                        <Div Flex="Flex.AlignItems.Center" Margin="Margin.Is1.FromBottom">
                                            <Icon Name="@AppIcons.Event" TextColor="TextColor.Secondary" Class="me-2" />
                                            <span>Renewal @RenewalText(e)</span>
                                        </Div>
                                        <Div Flex="Flex.AlignItems.Center">
                                            <Icon Name="@AppIcons.People" TextColor="TextColor.Secondary" Class="me-2" />
                                            <Tooltip Text="Assigned-seat counts aren't available from the Channel API; total licenses shown." Inline>
                                                <span>— / @SeatCount(e) licenses</span>
                                            </Tooltip>
                                        </Div>
                                    </CardBody>
                                    <CardFooter Background="Background.Transparent" Border="Border.Is0">
                                        <Button Type="ButtonType.Link" To="@($"/customers/{context.Item.CustomerId}/entitlements/{e.Id}")"
                                                Size="Size.Small" Color="Color.Primary" Class="btn-link text-decoration-none">Details</Button>
                                    </CardFooter>
                                </Card>
                            </Column>
                        }
                    </Row>
                }
            </Div>
        </DetailRowTemplate>
        <EmptyTemplate>
            <Alert Color="Color.Info" Visible Margin="Margin.Is0">No customers yet. Use <strong>New customer</strong> to create one.</Alert>
        </EmptyTemplate>
        <LoadingTemplate>
            <LoadingPanel Title="Loading customers…" Hint="Querying the synced read-model." />
        </LoadingTemplate>
    </DataGrid>
</Card>

<Modal @bind-Visible="_importOpen">
    <ModalContent Centered>
        <ModalHeader>
            <ModalTitle>Import existing customer</ModalTitle>
            <CloseButton />
        </ModalHeader>
        <ModalBody>
            <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is3.FromBottom">
                Bring a customer that already has a Cloud Identity into your reseller account — a pre-transfer
                step. Provide one identifier (domain, Cloud Identity id, or primary admin email).
            </Paragraph>
            <Field>
                <FieldLabel>Primary domain</FieldLabel>
                <TextInput @bind-Value="_import.Domain" />
                <FieldHelp>e.g. contoso.com</FieldHelp>
            </Field>
            <Field>
                <FieldLabel>Cloud Identity id</FieldLabel>
                <TextInput @bind-Value="_import.CloudIdentityId" />
            </Field>
            <Field>
                <FieldLabel>Primary admin email</FieldLabel>
                <TextInput @bind-Value="_import.PrimaryAdminEmail" Role="TextRole.Email" />
            </Field>
            <Field>
                <Check TValue="bool" @bind-Value="_import.OverwriteIfExists">Overwrite if the customer is already imported</Check>
            </Field>
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Secondary" Clicked="@(() => _importOpen = false)" Disabled="@_importing">Cancel</Button>
            <Button Color="Color.Primary" Clicked="ImportAsync" Disabled="@_importing" Loading="@_importing">
                @(_importing ? "Importing…" : "Import")
            </Button>
        </ModalFooter>
    </ModalContent>
</Modal>

@code {
    private static readonly int[] _pageSizes = [25, 50, 100];
    private DataGrid<EstateCustomer>? _grid;
    private List<EstateCustomer> _items = [];
    private int _total;
    private string? _search;
    private string _scope = "all";
    private DateTimeOffset? _asOf;

    private bool _importOpen;
    private bool _importing;
    private readonly ImportModel _import = new();

    // Per-customer expansion state + lazily-loaded subscription cards (null value = load failed).
    private readonly HashSet<string> _expanded = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, List<Entitlement>?> _subscriptions = new(StringComparer.OrdinalIgnoreCase);

    private bool IsExpanded(EstateCustomer c) => _expanded.Contains(c.CustomerId);

    private async Task ToggleExpandAsync(EstateCustomer customer)
    {
        if (!_expanded.Add(customer.CustomerId))
        {
            _expanded.Remove(customer.CustomerId);
            if (_grid is not null) await _grid.ToggleDetailRow(customer, forceDetailRow: true);
            return;
        }

        if (_grid is not null) await _grid.ToggleDetailRow(customer, forceDetailRow: true);

        if (_subscriptions.ContainsKey(customer.CustomerId))
        {
            return; // already loaded (or loading) — keep the cached cards
        }

        try
        {
            var result = await Api.ListEntitlementsAsync(customer.CustomerId);
            _subscriptions[customer.CustomerId] = result?.Entitlements?.ToList() ?? [];
        }
        catch
        {
            _subscriptions[customer.CustomerId] = null;
        }
    }

    private static string OfferTitle(Entitlement e) =>
        e.SkuDisplayName ?? e.ProductDisplayName ?? e.OfferDisplayName ?? e.OfferId ?? e.Id;

    private static string StateLabel(string? state) =>
        string.IsNullOrEmpty(state) ? "Unknown" : char.ToUpperInvariant(state[0]) + state[1..].ToLowerInvariant();

    private static Color StateColor(string? state) => state?.ToUpperInvariant() switch
    {
        "ACTIVE" => Color.Success,
        "SUSPENDED" => Color.Warning,
        "CANCELLED" or "CANCELED" => Color.Danger,
        "PENDING" => Color.Info,
        _ => Color.Secondary,
    };

    private static string RenewalText(Entitlement e) =>
        e.Commitment?.EndTime is { } end
            ? end.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)
            : "—";

    private static long SeatCount(Entitlement e)
    {
        var raw = e.Parameters.FirstOrDefault(p =>
            string.Equals(p.Name, "num_units", StringComparison.OrdinalIgnoreCase))?.Value;
        return long.TryParse(raw, out var n) ? n : 0;
    }

    private static string FormatMoney(decimal value, string? currency) =>
        string.IsNullOrEmpty(currency)
            ? value.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)
            : $"{currency} {value.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)}";

    // Bulk billed (actual) spend per customer for the list column — loaded once, best-effort.
    private readonly Dictionary<string, (decimal Cost, string Currency)> _billed = new(StringComparer.OrdinalIgnoreCase);
    private bool _billedLoaded;

    private async Task EnsureBilledAsync(CancellationToken token)
    {
        if (_billedLoaded) { return; }
        _billedLoaded = true;
        try
        {
            var result = await Api.GetCustomerBilledSummariesAsync(1, token);
            foreach (var g in (result?.Customers ?? []).GroupBy(c => c.CustomerId, StringComparer.OrdinalIgnoreCase))
            {
                var top = g.OrderByDescending(x => x.Cost).First();
                _billed[g.Key] = (top.Cost, top.Currency);
            }
        }
        catch
        {
            // Best-effort column; leave blanks if the billed lookup fails.
        }
    }

    private string? BilledLabel(string customerId) =>
        _billed.TryGetValue(customerId, out var v) ? FormatMoney(v.Cost, v.Currency) : null;

    // Server-side read: Blazorise pages are 1-based, the API's are 0-based; sort keys come from SortField.
    private async Task OnReadData(DataGridReadDataEventArgs<EstateCustomer> e)
    {
        if (e.CancellationToken.IsCancellationRequested)
        {
            return;
        }

        var sortColumn = e.Columns.FirstOrDefault(c => c.SortDirection != SortDirection.Default);
        try
        {
            await EnsureBilledAsync(e.CancellationToken);
            var result = await Api.ListEstateCustomersAsync(
                e.Page - 1, e.PageSize, sortColumn?.SortField,
                sortColumn?.SortDirection == SortDirection.Descending,
                _search, linkId: _scope == "all" ? null : _scope, e.CancellationToken);

            _items = result?.Items?.ToList() ?? [];
            _total = result?.Total ?? 0;
            _asOf = result?.AsOf;
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load customers: {ex.Message}", Severity.Error);
            _items = [];
            _total = 0;
        }
    }

    private async Task OnSearchChanged(string value)
    {
        _search = value;
        await (_grid?.Reload() ?? Task.CompletedTask);
    }

    private async Task OnScopeChanged(string value)
    {
        _scope = value;
        await (_grid?.Reload() ?? Task.CompletedTask);
    }

    private async Task ResyncAsync(EstateCustomer customer)
    {
        try
        {
            await Api.ResyncCustomerAsync(customer.CustomerId);
            await Snackbar.Add("Queued for refresh — data updates on the next sync cycle.", Severity.Info);
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to queue refresh: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteAsync(EstateCustomer customer)
    {
        var confirmed = await Snackbar.ConfirmAsync(
            "Delete customer",
            $"Delete '{customer.OrgName ?? customer.CustomerId}'? This cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (!confirmed)
        {
            return;
        }

        try
        {
            await Api.DeleteCustomerAsync(customer.CustomerId);
            await Snackbar.Add("Customer deleted.", Severity.Success);
            if (_grid is not null) await _grid.Reload();
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to delete customer: {ex.Message}", Severity.Error);
        }
    }

    private void OpenImportDialog()
    {
        _import.Reset();
        _importOpen = true;
    }

    private async Task ImportAsync()
    {
        if (string.IsNullOrWhiteSpace(_import.Domain)
            && string.IsNullOrWhiteSpace(_import.CloudIdentityId)
            && string.IsNullOrWhiteSpace(_import.PrimaryAdminEmail))
        {
            await Snackbar.Add("Provide a domain, Cloud Identity id, or primary admin email to import.", Severity.Warning);
            return;
        }

        _importing = true;
        try
        {
            var imported = await Api.ImportCustomerAsync(new ImportCustomerRequest
            {
                Domain = _import.Domain,
                CloudIdentityId = _import.CloudIdentityId,
                PrimaryAdminEmail = _import.PrimaryAdminEmail,
                OverwriteIfExists = _import.OverwriteIfExists
            });

            _importOpen = false;
            await Snackbar.Add($"Imported {imported?.OrgDisplayName ?? imported?.Domain ?? "customer"}.", Severity.Success);
            if (imported is not null)
            {
                Nav.NavigateTo($"/customers/{imported.Id}");
            }
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to import customer: {ex.Message}", Severity.Error);
        }
        finally
        {
            _importing = false;
        }
    }

    private sealed class ImportModel
    {
        public string? Domain { get; set; }
        public string? CloudIdentityId { get; set; }
        public string? PrimaryAdminEmail { get; set; }
        public bool OverwriteIfExists { get; set; }

        public void Reset()
        {
            Domain = null;
            CloudIdentityId = null;
            PrimaryAdminEmail = null;
            OverwriteIfExists = false;
        }
    }
}
