@page "/customers/{Id}"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject UiNotifier Snackbar
@inject NavigationManager Nav

<PageTitle>@(_customer?.OrgDisplayName ?? "Customer") · GChannel</PageTitle>

@if (_loading)
{
    <LoadingPanel Title="Loading customer…"
                  Hint="Fetching the customer's details and linked information." />
}
else if (_customer is null)
{
    <Alert Color="Color.Danger" Visible>Customer not found.</Alert>
    <Button Type="ButtonType.Link" To="/customers" Color="Color.Secondary" Outline Margin="Margin.Is4.FromTop">
        <Icon Name="@AppIcons.ArrowBack" Class="me-1" /> Back to customers
    </Button>
}
else
{
    <Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Margin="Margin.Is4.FromBottom">
        <Div>
            <Heading Size="HeadingSize.Is3" Margin="Margin.Is0">@(_customer.OrgDisplayName ?? _customer.Id)</Heading>
            <Small TextColor="TextColor.Secondary">@_customer.Domain</Small>
        </Div>
        <Div Flex="Flex.Default" Gap="Gap.Is2" Class="flex-wrap justify-content-end">
            <Button Type="ButtonType.Link" To="@($"/customers/{_customer.Id}/entitlements")" Color="Color.Primary">
                <Icon Name="@AppIcons.Subscriptions" Class="me-1" /> Entitlements
            </Button>
            <Button Type="ButtonType.Link" To="@($"/customers/{_customer.Id}/transfer")" Color="Color.Secondary" Outline>
                <Icon Name="@AppIcons.SwapHoriz" Class="me-1" /> Transfer
            </Button>
            <Button Type="ButtonType.Link" To="@($"/customers/{_customer.Id}/repricing")" Color="Color.Secondary" Outline>
                <Icon Name="@AppIcons.Percent" Class="me-1" /> Repricing
            </Button>
            @if (string.IsNullOrEmpty(_customer.CloudIdentityId))
            {
                <div style="position:relative; display:inline-flex">
                    <Button Color="Color.Primary" Outline Clicked="OpenProvisionDialog">
                        <Icon Name="@AppIcons.AddBusiness" Class="me-1" /> Provision Cloud Identity
                    </Button>
                    <FeatureBeacon Id="provision-cloud-identity-v1" Tooltip="New: create a Cloud Identity for this customer" />
                </div>
            }
            <Button Type="ButtonType.Link" To="@($"/customers/edit/{_customer.Id}")" Color="Color.Secondary" Outline>
                <Icon Name="@AppIcons.Edit" Class="me-1" /> Edit
            </Button>
            <Button Color="Color.Danger" Outline Clicked="DeleteAsync">
                <Icon Name="@AppIcons.Delete" Class="me-1" /> Delete
            </Button>
        </Div>
    </Div>

    <Card Shadow="Shadow.Small" Margin="Margin.Is4.FromBottom">
        <CardBody>
            <Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Margin="Margin.Is1.FromBottom">
                <Small TextColor="TextColor.Secondary" Class="text-uppercase fw-semibold">Estimated monthly value</Small>
                @if (_value is { MixedCurrencies: false, Currency: { Length: > 0 } cur })
                {
                    <Badge Color="Color.Light" Class="border text-body">@cur</Badge>
                }
            </Div>
            @if (_valueLoading)
            {
                <Progress Indeterminate Color="Color.Primary" Size="Size.Small" Margin="Margin.Is2.OnY" />
            }
            else if (_value is { PricedEntitlementCount: > 0 } v)
            {
                <Row>
                    <Column ColumnSize="ColumnSize.Is12.Is4.OnTablet">
                        <Small TextColor="TextColor.Secondary" Display="Display.Block">Wholesale cost</Small>
                        <Heading Size="HeadingSize.Is4" Margin="Margin.Is0">@FormatMoney(v.WholesaleMonthly, v.Currency)</Heading>
                        <Small TextColor="TextColor.Secondary">What you pay Google — actual (Ion) where available, else estimated from list</Small>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.Is4.OnTablet">
                        <Small TextColor="TextColor.Secondary" Display="Display.Block">Repriced revenue</Small>
                        <Heading Size="HeadingSize.Is4" Margin="Margin.Is0">@FormatMoney(v.RevenueMonthly, v.Currency)</Heading>
                        <Small TextColor="TextColor.Secondary">What this customer is billed</Small>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.Is4.OnTablet">
                        <Small TextColor="TextColor.Secondary" Display="Display.Block">Margin</Small>
                        <Heading Size="HeadingSize.Is4" Margin="Margin.Is0" TextColor="@(v.MarginMonthly >= 0 ? TextColor.Success : TextColor.Danger)">@FormatMoney(v.MarginMonthly, v.Currency)</Heading>
                        <Small TextColor="TextColor.Secondary">Revenue − wholesale</Small>
                    </Column>
                </Row>
                <Small TextColor="TextColor.Secondary" Display="Display.Block" Margin="Margin.Is2.FromTop">
                    Across @v.PricedEntitlementCount active entitlement(s) · @v.ActiveSeats seat(s)@(v.UnpricedEntitlementCount > 0 ? $"; {v.UnpricedEntitlementCount} unpriced (excluded)" : ""), estimated from offer
                    list pricing with repricing applied; wholesale uses actual Ion cost where available. Not an invoiced figure.@(v.MixedCurrencies ? $" Headline shows the dominant currency ({v.Currency}); every currency is broken out below." : "")
                </Small>
                @if (v.MixedCurrencies)
                {
                    <Table Narrow Hoverable Borderless Margin="Margin.Is2.FromTop">
                        <TableHeader>
                            <TableRow>
                                <TableHeaderCell>Currency</TableHeaderCell>
                                <TableHeaderCell TextAlignment="TextAlignment.End">Wholesale cost</TableHeaderCell>
                                <TableHeaderCell TextAlignment="TextAlignment.End">Repriced revenue</TableHeaderCell>
                                <TableHeaderCell TextAlignment="TextAlignment.End">Margin</TableHeaderCell>
                                <TableHeaderCell TextAlignment="TextAlignment.End">Seats</TableHeaderCell>
                                <TableHeaderCell TextAlignment="TextAlignment.End">Subscriptions</TableHeaderCell>
                            </TableRow>
                        </TableHeader>
                        <TableBody>
                            @foreach (var line in v.Currencies)
                            {
                                <TableRow>
                                    <TableRowCell>@line.Currency</TableRowCell>
                                    <TableRowCell TextAlignment="TextAlignment.End">@line.WholesaleMonthly.ToString("N2")</TableRowCell>
                                    <TableRowCell TextAlignment="TextAlignment.End">@line.RevenueMonthly.ToString("N2")</TableRowCell>
                                    <TableRowCell TextAlignment="TextAlignment.End" TextColor="@(line.MarginMonthly >= 0 ? TextColor.Success : TextColor.Danger)">@line.MarginMonthly.ToString("N2")</TableRowCell>
                                    <TableRowCell TextAlignment="TextAlignment.End">@line.ActiveSeats</TableRowCell>
                                    <TableRowCell TextAlignment="TextAlignment.End">@line.PricedEntitlementCount</TableRowCell>
                                </TableRow>
                            }
                        </TableBody>
                    </Table>
                }
            }
            else
            {
                <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is1.FromTop.Is0.FromBottom">
                    No priced subscriptions for this customer yet@(_value is { UnpricedEntitlementCount: > 0 } u ? $" ({u.UnpricedEntitlementCount} unpriced)" : "") — values appear once the background read-model has priced this customer's entitlements.
                </Paragraph>
            }
        </CardBody>
    </Card>

    @if (_spend is { Unconfigured: false })
    {
        <Card Shadow="Shadow.Small" Margin="Margin.Is4.FromBottom">
            <CardBody>
                <Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Margin="Margin.Is1.FromBottom">
                    <Small TextColor="TextColor.Secondary" Class="text-uppercase fw-semibold">Billed spend (actual)</Small>
                    @if (_spend.AsOf is { } asOf)
                    {
                        <Small TextColor="TextColor.Secondary">as of @asOf.LocalDateTime.ToString("g")</Small>
                    }
                </Div>
                @if (_spendLoading)
                {
                    <Progress Indeterminate Color="Color.Primary" Size="Size.Small" Margin="Margin.Is2.OnY" />
                }
                else if (_spend.Months is { Count: > 0 })
                {
                    <Table Narrow Hoverable Borderless Margin="Margin.Is1.FromTop">
                        <TableHeader>
                            <TableRow>
                                <TableHeaderCell>Invoice month</TableHeaderCell>
                                <TableHeaderCell TextAlignment="TextAlignment.End">Net cost</TableHeaderCell>
                                <TableHeaderCell TextAlignment="TextAlignment.End">Gross</TableHeaderCell>
                                <TableHeaderCell TextAlignment="TextAlignment.End">Credits</TableHeaderCell>
                                <TableHeaderCell>Currency</TableHeaderCell>
                            </TableRow>
                        </TableHeader>
                        <TableBody>
                            @foreach (var m in _spend.Months.OrderByDescending(m => m.InvoiceMonth))
                            {
                                <TableRow>
                                    <TableRowCell>@FormatMonth(m.InvoiceMonth)</TableRowCell>
                                    <TableRowCell TextAlignment="TextAlignment.End">@m.Cost.ToString("N2")</TableRowCell>
                                    <TableRowCell TextAlignment="TextAlignment.End">@m.GrossCost.ToString("N2")</TableRowCell>
                                    <TableRowCell TextAlignment="TextAlignment.End">@m.Credits.ToString("N2")</TableRowCell>
                                    <TableRowCell>@m.Currency</TableRowCell>
                                </TableRow>
                            }
                        </TableBody>
                    </Table>
                    <Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Margin="Margin.Is2.FromTop">
                        <Small TextColor="TextColor.Secondary">
                            Actual amounts from the GCP/Marketplace billing export — real billed figures, not the list-price estimate above.
                        </Small>
                        <Button Type="ButtonType.Link" To="@($"/billing/spend?customerId={_customer.Id}")" Color="Color.Primary" Class="btn-link text-decoration-none text-nowrap">
                            Trend <Icon Name="@AppIcons.ShowChart" Class="ms-1" />
                        </Button>
                    </Div>
                }
                else
                {
                    <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is1.FromTop.Is0.FromBottom">
                        No billed spend recorded for this customer yet — the export sync attributes spend once the customer's entitlements carry a billing account.
                    </Paragraph>
                }
            </CardBody>
        </Card>

        @if (_sellerSpend is { Unconfigured: false, ByCategory.Count: > 0 } || _marketplace is { Orders.Count: > 0 })
        {
            <Row Margin="Margin.Is4.FromBottom">
                <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop">
                    <SellerSplitCard Summary="_sellerSpend" Loading="_spendLoading" Subtitle="This customer, last 3 invoice months" MaxRows="6" />
                </Column>
                <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop">
                    <MarketplaceOrdersTable Result="_marketplace" Loading="_spendLoading" ShowAccount="false" />
                </Column>
            </Row>
        }
    }

    <Card Shadow="Shadow.Small" Margin="Margin.Is4.FromBottom">
        <CardHeader>
            <Div Flex="Flex.JustifyContent.Between.AlignItems.Center">
                <Div>
                    <CardTitle Size="HeadingSize.Is5" Margin="Margin.Is0">Entitlements</CardTitle>
                    <Small TextColor="TextColor.Secondary">
                        The subscriptions this customer holds, with seats, estimated monthly cost, renewal date and auto-renew status.
                    </Small>
                </Div>
                <Button Type="ButtonType.Link" To="@($"/customers/{_customer.Id}/entitlements")" Color="Color.Primary" Class="btn-link text-decoration-none text-nowrap">
                    Manage <Icon Name="@AppIcons.ArrowForward" Class="ms-1" />
                </Button>
            </Div>
        </CardHeader>
        <CardBody>
            @if (_entitlementsLoading)
            {
                <Progress Indeterminate Color="Color.Primary" Size="Size.Small" Margin="Margin.Is2.OnY" />
            }
            else if (_entitlements is { Count: > 0 })
            {
                <Table Narrow Hoverable Responsive>
                    <TableHeader>
                        <TableRow>
                            <TableHeaderCell>Offer / SKU</TableHeaderCell>
                            <TableHeaderCell>State</TableHeaderCell>
                            <TableHeaderCell TextAlignment="TextAlignment.End">Seats</TableHeaderCell>
                            <TableHeaderCell TextAlignment="TextAlignment.End">Est. monthly</TableHeaderCell>
                            <TableHeaderCell TextAlignment="TextAlignment.End">Ion cost / margin</TableHeaderCell>
                            <TableHeaderCell>Renewal</TableHeaderCell>
                            <TableHeaderCell>Auto-renew</TableHeaderCell>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @foreach (var e in _entitlements)
                        {
                            <TableRow>
                                <TableRowCell>
                                    <Anchor To="@($"/customers/{_customer!.Id}/entitlements/{e.Id}")">@OfferLabel(e)</Anchor>
                                    @if (!string.IsNullOrEmpty(e.ProductDisplayName ?? e.ProductId))
                                    {
                                        <Small TextColor="TextColor.Secondary" Display="Display.Block">@(e.ProductDisplayName ?? e.ProductId)</Small>
                                    }
                                </TableRowCell>
                                <TableRowCell>
                                    <Badge Color="@StateColor(e.ProvisioningState)">@(e.ProvisioningState ?? "—")</Badge>
                                    @if (e.IsTrial)
                                    {
                                        <Badge Color="Color.Info" Margin="Margin.Is1.FromStart">Trial</Badge>
                                    }
                                </TableRowCell>
                                <TableRowCell TextAlignment="TextAlignment.End">@(Seats(e) ?? "—")</TableRowCell>
                                <TableRowCell TextAlignment="TextAlignment.End">
                                    @if (MonthlyEstimate(e) is { } v)
                                    {
                                        <Tooltip Text="@EstimateBreakdown(e)" Inline><span>@FormatMoney(v, e.PriceCurrency)</span></Tooltip>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </TableRowCell>
                                <TableRowCell TextAlignment="TextAlignment.End">
                                    @if (e.IonCostPerSeat is { } ionCost)
                                    {
                                        <Tooltip Text="Actual per-seat cost from Ion (TD SYNNEX StreamOne)" Inline>
                                            <span>@FormatMoney(ionCost, e.IonCurrency)</span>
                                        </Tooltip>
                                        @if (e.IonMarginPercent is { } mp)
                                        {
                                            <Small TextColor="@(mp >= 0 ? TextColor.Success : TextColor.Danger)" Display="Display.Block">@mp.ToString("0.0")% margin</Small>
                                        }
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </TableRowCell>
                                <TableRowCell>
                                    @if (e.Commitment?.EndTime is { } end)
                                    {
                                        <Tooltip Text="@(e.PlanDescription ?? e.Commitment?.PaymentPlan)" Inline><span>@end.ToString("yyyy-MM-dd")</span></Tooltip>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </TableRowCell>
                                <TableRowCell>
                                    @if (e.Commitment?.RenewalEnabled is { } renew)
                                    {
                                        <Badge Color="@(renew ? Color.Success : Color.Warning)">@(renew ? "On" : "Off")</Badge>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </TableRowCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
            }
            else
            {
                <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is0">
                    No entitlements yet. Use <Anchor To="@($"/customers/{_customer.Id}/entitlements/new")">Purchase</Anchor> to sell this customer their first SKU.
                </Paragraph>
            }
        </CardBody>
    </Card>

    <Row>
        <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop">
            <Card Shadow="Shadow.Small" Margin="Margin.Is4.FromBottom">
                <CardHeader><CardTitle Size="HeadingSize.Is5" Margin="Margin.Is0">Details</CardTitle></CardHeader>
                <CardBody>
                    <Table Narrow Borderless Margin="Margin.Is0">
                        <TableBody>
                            <TableRow><TableRowCell><strong>Customer id</strong></TableRowCell><TableRowCell>@_customer.Id</TableRowCell></TableRow>
                            <TableRow><TableRowCell><strong>Domain</strong></TableRowCell><TableRowCell>@_customer.Domain</TableRowCell></TableRow>
                            <TableRow><TableRowCell><strong>Language</strong></TableRowCell><TableRowCell>@(_customer.LanguageCode ?? "—")</TableRowCell></TableRow>
                            <TableRow><TableRowCell><strong>Cloud Identity id</strong></TableRowCell><TableRowCell>@(_customer.CloudIdentityId ?? "—")</TableRowCell></TableRow>
                            <TableRow><TableRowCell><strong>Created</strong></TableRowCell><TableRowCell>@(_customer.CreateTime?.ToString("u") ?? "—")</TableRowCell></TableRow>
                            <TableRow>
                                <TableRowCell><strong>Channel partner</strong></TableRowCell>
                                <TableRowCell>
                                    @if (!string.IsNullOrEmpty(_customer.ChannelPartnerId))
                                    {
                                        <Anchor To="@($"/channel-partner-links/{_customer.ChannelPartnerId}")">@_customer.ChannelPartnerId</Anchor>
                                    }
                                    else
                                    {
                                        <span>Direct (no partner)</span>
                                    }
                                </TableRowCell>
                            </TableRow>
                        </TableBody>
                    </Table>
                </CardBody>
            </Card>
        </Column>

        <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop">
            <Card Shadow="Shadow.Small" Margin="Margin.Is4.FromBottom">
                <CardHeader><CardTitle Size="HeadingSize.Is5" Margin="Margin.Is0">Cloud Identity</CardTitle></CardHeader>
                <CardBody>
                    @if (_customer.CloudIdentity is { } ci)
                    {
                        <Table Narrow Borderless Margin="Margin.Is0">
                            <TableBody>
                                <TableRow><TableRowCell><strong>Type</strong></TableRowCell><TableRowCell>@(ci.CustomerType ?? "—")</TableRowCell></TableRow>
                                <TableRow><TableRowCell><strong>Primary domain</strong></TableRowCell><TableRowCell>@(ci.PrimaryDomain ?? "—")</TableRowCell></TableRow>
                                <TableRow>
                                    <TableRowCell><strong>Domain verified</strong></TableRowCell>
                                    <TableRowCell>
                                        <Badge Color="@(ci.IsDomainVerified ? Color.Success : Color.Warning)">@(ci.IsDomainVerified ? "Verified" : "Unverified")</Badge>
                                    </TableRowCell>
                                </TableRow>
                                <TableRow><TableRowCell><strong>Alternate email</strong></TableRowCell><TableRowCell>@(ci.AlternateEmail ?? "—")</TableRowCell></TableRow>
                                @if (!string.IsNullOrEmpty(ci.AdminConsoleUri))
                                {
                                    <TableRow><TableRowCell><strong>Admin console</strong></TableRowCell><TableRowCell><Anchor To="@ci.AdminConsoleUri" Target="Target.Blank">Open</Anchor></TableRowCell></TableRow>
                                }
                            </TableBody>
                        </Table>
                    }
                    else
                    {
                        <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is0">No Cloud Identity linked.</Paragraph>
                    }
                </CardBody>
            </Card>
        </Column>

        <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop">
            <Card Shadow="Shadow.Small" Margin="Margin.Is4.FromBottom">
                <CardHeader><CardTitle Size="HeadingSize.Is5" Margin="Margin.Is0">Primary contact</CardTitle></CardHeader>
                <CardBody>
                    @if (_customer.PrimaryContact is { } c)
                    {
                        <Table Narrow Borderless Margin="Margin.Is0">
                            <TableBody>
                                <TableRow><TableRowCell><strong>Name</strong></TableRowCell><TableRowCell>@($"{c.FirstName} {c.LastName}".Trim())</TableRowCell></TableRow>
                                <TableRow><TableRowCell><strong>Email</strong></TableRowCell><TableRowCell>@(c.Email ?? "—")</TableRowCell></TableRow>
                                <TableRow><TableRowCell><strong>Phone</strong></TableRowCell><TableRowCell>@(c.Phone ?? "—")</TableRowCell></TableRow>
                                <TableRow><TableRowCell><strong>Title</strong></TableRowCell><TableRowCell>@(c.Title ?? "—")</TableRowCell></TableRow>
                            </TableBody>
                        </Table>
                    }
                    else
                    {
                        <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is0">No contact on file.</Paragraph>
                    }
                </CardBody>
            </Card>
        </Column>

        <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop">
            <Card Shadow="Shadow.Small" Margin="Margin.Is4.FromBottom">
                <CardHeader><CardTitle Size="HeadingSize.Is5" Margin="Margin.Is0">Address</CardTitle></CardHeader>
                <CardBody>
                    @if (_customer.Address is { } a)
                    {
                        <Table Narrow Borderless Margin="Margin.Is0">
                            <TableBody>
                                <TableRow><TableRowCell><strong>Street</strong></TableRowCell><TableRowCell>@(string.Join(", ", a.AddressLines) is { Length: > 0 } s ? s : "—")</TableRowCell></TableRow>
                                <TableRow><TableRowCell><strong>City</strong></TableRowCell><TableRowCell>@(a.Locality ?? "—")</TableRowCell></TableRow>
                                <TableRow><TableRowCell><strong>State / province</strong></TableRowCell><TableRowCell>@(a.AdministrativeArea ?? "—")</TableRowCell></TableRow>
                                <TableRow><TableRowCell><strong>Postal code</strong></TableRowCell><TableRowCell>@(a.PostalCode ?? "—")</TableRowCell></TableRow>
                                <TableRow><TableRowCell><strong>Region</strong></TableRowCell><TableRowCell>@(a.RegionCode ?? "—")</TableRowCell></TableRow>
                            </TableBody>
                        </Table>
                    }
                    else
                    {
                        <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is0">No address on file.</Paragraph>
                    }
                </CardBody>
            </Card>
        </Column>
    </Row>

    <Card Shadow="Shadow.Small" Margin="Margin.Is2.FromTop">
        <CardHeader>
            <CardTitle Size="HeadingSize.Is5" Margin="Margin.Is0">Purchasable catalog</CardTitle>
            <Small TextColor="TextColor.Secondary">
                SKUs this customer is eligible to purchase. Pick a product to load its SKUs, then
                expand a SKU for its purchasable offers or jump to the catalog.
            </Small>
        </CardHeader>
        <CardBody>
            @if (_products is null)
            {
                <Progress Indeterminate Color="Color.Primary" Size="Size.Small" Margin="Margin.Is2.OnY" />
            }
            else
            {
                <Field Style="max-width:480px">
                    <FieldLabel>Product</FieldLabel>
                    <Select TValue="string" Value="@_selectedProductId" ValueChanged="OnProductSelected">
                        <SelectItem TValue="string" Value="@((string?)null)">Choose a product…</SelectItem>
                        @foreach (var product in _products)
                        {
                            <SelectItem TValue="string" Value="@product.Id">@(product.DisplayName ?? product.Id)</SelectItem>
                        }
                    </Select>
                </Field>

                @if (_skusLoading)
                {
                    <Progress Indeterminate Color="Color.Primary" Size="Size.Small" Margin="Margin.Is2.OnY" />
                }
                else if (_purchasableSkus is { Count: > 0 })
                {
                    <Accordion>
                        @foreach (var sku in _purchasableSkus)
                        {
                            <AccordionItem Visible="_expandedSkus.Contains(sku.SkuId ?? string.Empty)"
                                           VisibleChanged="expanded => OnSkuExpanded(sku, expanded)">
                                <AccordionHeader>
                                    <Heading Size="HeadingSize.Is6" Margin="Margin.Is0">
                                        <AccordionToggle>@(sku.DisplayName ?? sku.SkuId)</AccordionToggle>
                                    </Heading>
                                </AccordionHeader>
                                <AccordionBody>
                                    <Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Margin="Margin.Is2.FromBottom">
                                        <Small TextColor="TextColor.Secondary">SKU id: @sku.SkuId</Small>
                                        <Button Type="ButtonType.Link" To="@($"/catalog/products?product={sku.ProductId}&sku={sku.SkuId}")"
                                                Size="Size.Small" Color="Color.Primary" Class="btn-link text-decoration-none">
                                            <Icon Name="@AppIcons.OpenInNew" Class="me-1" /> View in catalog
                                        </Button>
                                    </Div>

                                    @if (_offersBySku.TryGetValue(sku.SkuId ?? string.Empty, out var offers))
                                    {
                                        @if (offers is null)
                                        {
                                            <Progress Indeterminate Color="Color.Primary" Size="Size.Small" Margin="Margin.Is2.OnY" />
                                        }
                                        else if (offers.Count == 0)
                                        {
                                            <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is0">No purchasable offers.</Paragraph>
                                        }
                                        else
                                        {
                                            <Table Narrow Hoverable Responsive Margin="Margin.Is0">
                                                <TableHeader>
                                                    <TableRow>
                                                        <TableHeaderCell>Offer</TableHeaderCell>
                                                        <TableHeaderCell>Price reference</TableHeaderCell>
                                                    </TableRow>
                                                </TableHeader>
                                                <TableBody>
                                                    @foreach (var offer in offers)
                                                    {
                                                        <TableRow>
                                                            <TableRowCell>@(offer.DisplayName ?? offer.OfferName)</TableRowCell>
                                                            <TableRowCell>@(offer.PriceReferenceId ?? "—")</TableRowCell>
                                                        </TableRow>
                                                    }
                                                </TableBody>
                                            </Table>
                                        }
                                    }
                                </AccordionBody>
                            </AccordionItem>
                        }
                    </Accordion>
                }
                else if (_purchasableSkus is not null)
                {
                    <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is0">
                        No purchasable SKUs for this product.
                    </Paragraph>
                }
            }
        </CardBody>
    </Card>

    <Button Type="ButtonType.Link" To="/customers" Color="Color.Secondary" Margin="Margin.Is4.FromTop" Class="btn-link text-decoration-none">
        <Icon Name="@AppIcons.ArrowBack" Class="me-1" /> Back to customers
    </Button>

    <Modal @bind-Visible="_provisionOpen">
        <ModalContent Centered>
            <ModalHeader>
                <ModalTitle>Provision Cloud Identity</ModalTitle>
                <CloseButton />
            </ModalHeader>
            <ModalBody>
                <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is3.FromBottom">
                    Create a brand-new Cloud Identity for <b>@(_customer.OrgDisplayName ?? _customer.Domain)</b>.
                    This is a long-running operation — you'll be taken to the Operations page to watch it finish.
                </Paragraph>
                <Field><FieldLabel>Admin first name</FieldLabel><TextInput @bind-Value="_provision.GivenName" /></Field>
                <Field><FieldLabel>Admin last name</FieldLabel><TextInput @bind-Value="_provision.FamilyName" /></Field>
                <Field>
                    <FieldLabel>Admin email</FieldLabel>
                    <TextInput @bind-Value="_provision.AdminEmail" Role="TextRole.Email" />
                    <FieldHelp>@($"Within {_customer.Domain}, e.g. admin@{_customer.Domain}")</FieldHelp>
                </Field>
                <Field>
                    <FieldLabel>Alternate (recovery) email</FieldLabel>
                    <TextInput @bind-Value="_provision.AlternateEmail" Role="TextRole.Email" />
                    <FieldHelp>Outside the customer's domain</FieldHelp>
                </Field>
                <Field><FieldLabel>Contact phone (optional)</FieldLabel><TextInput @bind-Value="_provision.PhoneNumber" Role="TextRole.Telephone" /></Field>
                <Field>
                    <FieldLabel>Language code (optional)</FieldLabel>
                    <TextInput @bind-Value="_provision.LanguageCode" />
                    <FieldHelp>e.g. en-US</FieldHelp>
                </Field>
                <Field>
                    <Check TValue="bool" @bind-Value="_provision.ValidateOnly">Validate only (don't provision yet)</Check>
                </Field>
            </ModalBody>
            <ModalFooter>
                <Button Color="Color.Secondary" Clicked="@(() => _provisionOpen = false)" Disabled="@_provisioning">Cancel</Button>
                <Button Color="Color.Primary" Clicked="ProvisionAsync" Disabled="@_provisioning" Loading="@_provisioning">
                    @(_provisioning ? "Submitting…" : (_provision.ValidateOnly ? "Validate" : "Provision"))
                </Button>
            </ModalFooter>
        </ModalContent>
    </Modal>
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private Customer? _customer;
    private bool _loading = true;

    private IReadOnlyList<CatalogProduct>? _products;
    private string? _selectedProductId;
    private IReadOnlyList<PurchasableSku>? _purchasableSkus;
    private bool _skusLoading;
    private readonly Dictionary<string, IReadOnlyList<PurchasableOffer>?> _offersBySku = [];
    private readonly HashSet<string> _expandedSkus = [];

    private CustomerEstateValue? _value;
    private bool _valueLoading = true;

    private IReadOnlyList<Entitlement>? _entitlements;
    private bool _entitlementsLoading = true;

    private CustomerSpendResult? _spend;
    private SellerSpendSummary? _sellerSpend;
    private MarketplaceOrdersResult? _marketplace;
    private bool _spendLoading = true;

    private bool _provisionOpen;
    private bool _provisioning;
    private readonly ProvisionModel _provision = new();

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _products = null;
        _selectedProductId = null;
        _purchasableSkus = null;
        _offersBySku.Clear();
        _expandedSkus.Clear();
        _value = null;
        _valueLoading = true;
        _entitlements = null;
        _entitlementsLoading = true;
        _spend = null;
        _spendLoading = true;

        try
        {
            _customer = await Api.GetCustomerAsync(Id);
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load customer: {ex.Message}", Severity.Error);
            _customer = null;
        }
        finally
        {
            _loading = false;
        }

        if (_customer is not null)
        {
            try
            {
                var products = await Api.ListProductsAsync();
                _products = products?.Products ?? [];
            }
            catch (Exception ex)
            {
                await Snackbar.Add($"Failed to load products: {ex.Message}", Severity.Error);
                _products = [];
            }

            try
            {
                _value = await Api.GetCustomerValueAsync(Id);
            }
            catch
            {
                // Estimated value is best-effort; ignore failures so the page still renders.
                _value = null;
            }
            finally
            {
                _valueLoading = false;
            }

            try
            {
                var entitlements = await Api.ListEntitlementsAsync(Id);
                _entitlements = entitlements?.Entitlements ?? [];
            }
            catch (Exception ex)
            {
                await Snackbar.Add($"Failed to load entitlements: {ex.Message}", Severity.Error);
                _entitlements = [];
            }
            finally
            {
                _entitlementsLoading = false;
            }

            try
            {
                _spend = await Api.GetCustomerSpendAsync(Id, 13);
                _sellerSpend = await Api.GetCustomerSellerSpendAsync(Id, 3);
                _marketplace = await Api.GetMarketplaceOrdersAsync(Id);
            }
            catch
            {
                // Billed spend is best-effort (export may be unconfigured); ignore so the page renders.
                _spend ??= null;
            }
            finally
            {
                _spendLoading = false;
            }
        }
        else
        {
            _valueLoading = false;
            _entitlementsLoading = false;
            _spendLoading = false;
        }
    }

    // Prefer the friendly SKU/offer name resolved from the Catalog; fall back to the opaque id.
    private static string OfferLabel(Entitlement e) =>
        e.SkuDisplayName ?? e.OfferDisplayName ?? e.OfferId ?? e.Id;

    // "202608" -> "Aug 2026"; falls back to the raw value if it isn't a YYYYMM string.
    private static string FormatMonth(string invoiceMonth) =>
        DateTime.TryParseExact(invoiceMonth, "yyyyMM", System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var d)
            ? d.ToString("MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)
            : invoiceMonth;

    private static Color StateColor(string? state) => state?.ToUpperInvariant() switch
    {
        "ACTIVE" => Color.Success,
        "SUSPENDED" => Color.Warning,
        "CANCELLED" or "CANCELED" => Color.Danger,
        "PENDING" => Color.Info,
        _ => Color.Secondary
    };

    private static string? Seats(Entitlement e) =>
        e.Parameters.FirstOrDefault(p => string.Equals(p.Name, "num_units", StringComparison.OrdinalIgnoreCase))?.Value
        ?? e.Parameters.FirstOrDefault(p => string.Equals(p.Name, "max_units", StringComparison.OrdinalIgnoreCase))?.Value;

    private static long SeatCount(Entitlement e) =>
        long.TryParse(Seats(e), System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var n) ? n : 0;

    // Estimated monthly amount = unit price × seats × (1 + repricing markup). Null when unpriced.
    private static decimal? MonthlyEstimate(Entitlement e)
    {
        if (e.UnitPrice is not { } unit || unit <= 0) return null;
        var seats = e.BillableSeats ?? SeatCount(e);
        if (seats <= 0) return null;
        var markup = 1 + ((e.RepricingPercent ?? 0m) / 100m);
        return unit * seats * markup;
    }

    private static string EstimateBreakdown(Entitlement e)
    {
        var seats = e.BillableSeats ?? SeatCount(e);
        var pct = e.RepricingPercent ?? 0m;
        var baseLine = $"{FormatMoney(e.UnitPrice ?? 0m, e.PriceCurrency)} × {seats} seat(s)";
        var markupLine = pct != 0m ? $" + {pct:0.##}% markup" : string.Empty;
        return $"Estimated from offer list pricing: {baseLine}{markupLine}. Not an invoiced figure.";
    }

    private static string FormatMoney(decimal value, string? currency) =>
        string.IsNullOrEmpty(currency)
            ? value.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)
            : $"{currency} {value.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)}";

    private async Task OnProductSelected(string? productId)
    {
        _selectedProductId = productId;
        _purchasableSkus = null;
        _offersBySku.Clear();
        _expandedSkus.Clear();
        if (string.IsNullOrEmpty(productId))
        {
            return;
        }

        _skusLoading = true;
        try
        {
            var result = await Api.ListPurchasableSkusAsync(Id, productId);
            _purchasableSkus = result?.Skus ?? [];
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load purchasable SKUs: {ex.Message}", Severity.Error);
            _purchasableSkus = [];
        }
        finally
        {
            _skusLoading = false;
        }
    }

    private async Task OnSkuExpanded(PurchasableSku sku, bool expanded)
    {
        var skuId = sku.SkuId ?? string.Empty;
        if (expanded)
        {
            _expandedSkus.Add(skuId);
        }
        else
        {
            _expandedSkus.Remove(skuId);
        }

        if (!expanded || _offersBySku.ContainsKey(skuId) || string.IsNullOrEmpty(skuId))
        {
            return;
        }

        _offersBySku[skuId] = null;
        try
        {
            var result = await Api.ListPurchasableOffersAsync(Id, sku.ProductId ?? _selectedProductId ?? string.Empty, skuId);
            _offersBySku[skuId] = result?.Offers ?? [];
        }
        catch (Exception ex)
        {
            _offersBySku.Remove(skuId);
            await Snackbar.Add($"Failed to load purchasable offers: {ex.Message}", Severity.Error);
        }
    }

    private void OpenProvisionDialog()
    {
        _provision.Reset();
        _provisionOpen = true;
    }

    private async Task ProvisionAsync()
    {
        if (_customer is null)
        {
            return;
        }

        _provisioning = true;
        try
        {
            var operation = await Api.ProvisionCloudIdentityAsync(_customer.Id, new ProvisionCloudIdentityRequest
            {
                ValidateOnly = _provision.ValidateOnly,
                AdminUser = new AdminUser
                {
                    GivenName = _provision.GivenName,
                    FamilyName = _provision.FamilyName,
                    Email = _provision.AdminEmail
                },
                CloudIdentity = new CloudIdentityDetails
                {
                    AlternateEmail = _provision.AlternateEmail,
                    PhoneNumber = _provision.PhoneNumber,
                    LanguageCode = _provision.LanguageCode
                }
            });

            _provisionOpen = false;
            if (_provision.ValidateOnly)
            {
                await Snackbar.Add("Validation succeeded — no Cloud Identity was created.", Severity.Success);
            }
            else
            {
                await Snackbar.Add("Provisioning started. Tracking the operation…", Severity.Success);
                if (operation is not null)
                {
                    Nav.NavigateTo($"/operations?operation={Uri.EscapeDataString(operation.Id)}");
                }
            }
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to provision Cloud Identity: {ex.Message}", Severity.Error);
        }
        finally
        {
            _provisioning = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (_customer is null)
        {
            return;
        }

        var confirmed = await Snackbar.ConfirmAsync(
            "Delete customer",
            $"Delete '{_customer.OrgDisplayName ?? _customer.Id}'? This cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (!confirmed)
        {
            return;
        }

        try
        {
            await Api.DeleteCustomerAsync(_customer.Id);
            await Snackbar.Add("Customer deleted.", Severity.Success);
            Nav.NavigateTo("/customers");
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to delete customer: {ex.Message}", Severity.Error);
        }
    }

    private sealed class ProvisionModel
    {
        public string? GivenName { get; set; }
        public string? FamilyName { get; set; }
        public string? AdminEmail { get; set; }
        public string? AlternateEmail { get; set; }
        public string? PhoneNumber { get; set; }
        public string? LanguageCode { get; set; }
        public bool ValidateOnly { get; set; }

        public void Reset()
        {
            GivenName = null;
            FamilyName = null;
            AdminEmail = null;
            AlternateEmail = null;
            PhoneNumber = null;
            LanguageCode = null;
            ValidateOnly = false;
        }
    }
}

