@page "/customers/{Id}"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject UiNotifier Snackbar
@inject NavigationManager Nav
@inject DialogService Dialogs

<PageTitle>@(_customer?.OrgDisplayName ?? "Customer") · GChannel</PageTitle>

@if (_loading)
{
    <LoadingPanel Title="Loading customer…"
                  Hint="Fetching the customer's details and linked information." />
}
else if (_customer is null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">Customer not found.</RadzenAlert>
    <LinkButton To="/customers" Text="Back to customers" Icon="@AppIcons.ArrowBack" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Class="rz-mt-4" />
}
else
{
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap" class="rz-mb-4">
        <div>
            <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">@(_customer.OrgDisplayName ?? _customer.Id)</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">@_customer.Domain</RadzenText>
        </div>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem" Wrap="FlexWrap.Wrap">
            <LinkButton To="@($"/customers/{_customer.Id}/entitlements")" Text="Entitlements" Icon="@AppIcons.Subscriptions" />
            <LinkButton To="@($"/customers/{_customer.Id}/transfer")" Text="Transfer" Icon="@AppIcons.SwapHoriz" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" />
            <LinkButton To="@($"/customers/{_customer.Id}/repricing")" Text="Repricing" Icon="@AppIcons.Percent" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" />
            @if (string.IsNullOrEmpty(_customer.CloudIdentityId))
            {
                <div style="position:relative; display:inline-flex">
                    <RadzenButton Text="Provision Cloud Identity" Icon="@AppIcons.AddBusiness" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Click="OpenProvisionDialogAsync" />
                    <FeatureBeacon Id="provision-cloud-identity-v1" Tooltip="New: create a Cloud Identity for this customer" />
                </div>
            }
            <LinkButton To="@($"/customers/edit/{_customer.Id}")" Text="Edit" Icon="@AppIcons.Edit" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" />
            <RadzenButton Text="Delete" Icon="@AppIcons.Delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="DeleteAsync" />
        </RadzenStack>
    </RadzenStack>

    <RadzenCard Variant="Variant.Filled" class="rz-mb-4">
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" class="rz-mb-1">
            <RadzenText TextStyle="TextStyle.Overline" class="rz-text-secondary-color rz-m-0">Estimated monthly value</RadzenText>
            @if (_value is { MixedCurrencies: false, Currency: { Length: > 0 } cur })
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@cur" />
            }
        </RadzenStack>
        @if (_valueLoading)
        {
            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" class="rz-my-2" />
        }
        else if (_value is { PricedEntitlementCount: > 0 } v)
        {
            <RadzenRow Gap="1rem" RowGap="1rem">
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">Wholesale cost</RadzenText>
                    <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">@FormatMoney(v.WholesaleMonthly, v.Currency)</RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">What you pay Google — actual (Ion) where available, else estimated from list</RadzenText>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">Repriced revenue</RadzenText>
                    <RadzenText TextStyle="TextStyle.H5" class="rz-m-0">@FormatMoney(v.RevenueMonthly, v.Currency)</RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">What this customer is billed</RadzenText>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">Margin</RadzenText>
                    <RadzenText TextStyle="TextStyle.H5" class="@($"rz-m-0 {(v.MarginMonthly >= 0 ? "rz-color-success" : "rz-color-danger")}")">@FormatMoney(v.MarginMonthly, v.Currency)</RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">Revenue − wholesale</RadzenText>
                </RadzenColumn>
            </RadzenRow>
            <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.P" class="rz-text-secondary-color rz-mt-2 rz-mb-0">
                Across @v.PricedEntitlementCount active entitlement(s) · @v.ActiveSeats seat(s)@(v.UnpricedEntitlementCount > 0 ? $"; {v.UnpricedEntitlementCount} unpriced (excluded)" : ""), estimated from offer
                list pricing with repricing applied; wholesale uses actual Ion cost where available. Not an invoiced figure.@(v.MixedCurrencies ? $" Headline shows the dominant currency ({v.Currency}); every currency is broken out below." : "")
            </RadzenText>
            @if (v.MixedCurrencies)
            {
                <table class="gchannel-table gchannel-table-hover rz-mt-2">
                    <thead>
                        <tr>
                            <th>Currency</th>
                            <th class="num">Wholesale cost</th>
                            <th class="num">Repriced revenue</th>
                            <th class="num">Margin</th>
                            <th class="num">Seats</th>
                            <th class="num">Subscriptions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in v.Currencies)
                        {
                            <tr>
                                <td>@line.Currency</td>
                                <td class="num">@line.WholesaleMonthly.ToString("N2")</td>
                                <td class="num">@line.RevenueMonthly.ToString("N2")</td>
                                <td class="@($"num {(line.MarginMonthly >= 0 ? "rz-color-success" : "rz-color-danger")}")">@line.MarginMonthly.ToString("N2")</td>
                                <td class="num">@line.ActiveSeats</td>
                                <td class="num">@line.PricedEntitlementCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
        else
        {
            <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-mt-1 rz-mb-0">
                No priced subscriptions for this customer yet@(_value is { UnpricedEntitlementCount: > 0 } u ? $" ({u.UnpricedEntitlementCount} unpriced)" : "") — values appear once the background read-model has priced this customer's entitlements.
            </RadzenText>
        }
    </RadzenCard>

    @if (_spend is { Unconfigured: false })
    {
        <RadzenCard Variant="Variant.Filled" class="rz-mb-4">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" class="rz-mb-1">
                <RadzenText TextStyle="TextStyle.Overline" class="rz-text-secondary-color rz-m-0">Billed spend (actual)</RadzenText>
                @if (_spend.AsOf is { } asOf)
                {
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">as of @asOf.LocalDateTime.ToString("g")</RadzenText>
                }
            </RadzenStack>
            @if (_spendLoading)
            {
                <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" class="rz-my-2" />
            }
            else if (_spend.Months is { Count: > 0 })
            {
                <table class="gchannel-table gchannel-table-hover rz-mt-1">
                    <thead>
                        <tr>
                            <th>Invoice month</th>
                            <th class="num">Net cost</th>
                            <th class="num">Gross</th>
                            <th class="num">Credits</th>
                            <th>Currency</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in _spend.Months.OrderByDescending(m => m.InvoiceMonth))
                        {
                            <tr>
                                <td>@FormatMonth(m.InvoiceMonth)</td>
                                <td class="num">@m.Cost.ToString("N2")</td>
                                <td class="num">@m.GrossCost.ToString("N2")</td>
                                <td class="num">@m.Credits.ToString("N2")</td>
                                <td>@m.Currency</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="1rem" class="rz-mt-2">
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">
                        Actual amounts from the GCP/Marketplace billing export — real billed figures, not the list-price estimate above.
                    </RadzenText>
                    <LinkButton To="@($"/billing/spend?customerId={_customer.Id}")" Text="Trend" Icon="@AppIcons.ShowChart" Variant="Variant.Text" Size="ButtonSize.Small" Class="rz-text-nowrap" />
                </RadzenStack>
            }
            else
            {
                <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-mt-1 rz-mb-0">
                    No billed spend recorded for this customer yet — the export sync attributes spend once the customer's entitlements carry a billing account.
                </RadzenText>
            }
        </RadzenCard>

        @if (_sellerSpend is { Unconfigured: false, ByCategory.Count: > 0 } || _marketplace is { Orders.Count: > 0 })
        {
            <RadzenRow Gap="1rem" RowGap="1rem" class="rz-mb-4">
                <RadzenColumn Size="12" SizeLG="6">
                    <SellerSplitCard Summary="_sellerSpend" Loading="_spendLoading" Subtitle="This customer, last 3 invoice months" MaxRows="6" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeLG="6">
                    <MarketplaceOrdersTable Result="_marketplace" Loading="_spendLoading" ShowAccount="false" />
                </RadzenColumn>
            </RadzenRow>
        }
    }

    <RadzenCard Variant="Variant.Filled" class="rz-mb-4">
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="1rem" class="rz-mb-3">
            <div>
                <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">Entitlements</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">
                    The subscriptions this customer holds, with seats, estimated monthly cost, renewal date and auto-renew status.
                </RadzenText>
            </div>
            <LinkButton To="@($"/customers/{_customer.Id}/entitlements")" Text="Manage" Icon="@AppIcons.ArrowForward" Variant="Variant.Text" Size="ButtonSize.Small" Class="rz-text-nowrap" />
        </RadzenStack>
        @if (_entitlementsLoading)
        {
            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" class="rz-my-2" />
        }
        else if (_entitlements is { Count: > 0 })
        {
            <RadzenDataGrid TItem="Entitlement" Data="_entitlements" AllowPaging="false" AllowSorting="false" Density="Density.Compact" GridLines="DataGridGridLines.Horizontal" Responsive="true">
                <Columns>
                    <RadzenDataGridColumn TItem="Entitlement" Title="Offer / SKU">
                        <Template Context="e">
                            <RadzenLink Path="@($"/customers/{_customer!.Id}/entitlements/{e.Id}")" Text="@OfferLabel(e)" />
                            @if (!string.IsNullOrEmpty(e.ProductDisplayName ?? e.ProductId))
                            {
                                <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Div" class="rz-text-secondary-color rz-m-0">@(e.ProductDisplayName ?? e.ProductId)</RadzenText>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Entitlement" Title="State">
                        <Template Context="e">
                            <RadzenBadge BadgeStyle="@StateColor(e.ProvisioningState)" Text="@(e.ProvisioningState ?? "—")" />
                            @if (e.IsTrial)
                            {
                                <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="Trial" class="rz-ms-1" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Entitlement" Title="Seats" TextAlign="TextAlign.End" Width="80px">
                        <Template Context="e">@(Seats(e) ?? "—")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Entitlement" Title="Est. monthly" TextAlign="TextAlign.End">
                        <Template Context="e">
                            @if (MonthlyEstimate(e) is { } v)
                            {
                                <Tip Text="@EstimateBreakdown(e)">@FormatMoney(v, e.PriceCurrency)</Tip>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Entitlement" Title="Ion cost / margin" TextAlign="TextAlign.End">
                        <Template Context="e">
                            @if (e.IonCostPerSeat is { } ionCost)
                            {
                                <Tip Text="Actual per-seat cost from Ion (TD SYNNEX StreamOne)">@FormatMoney(ionCost, e.IonCurrency)</Tip>
                                @if (e.IonMarginPercent is { } mp)
                                {
                                    <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Div" class="@($"rz-m-0 {(mp >= 0 ? "rz-color-success" : "rz-color-danger")}")">@mp.ToString("0.0")% margin</RadzenText>
                                }
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Entitlement" Title="Renewal" Width="120px">
                        <Template Context="e">
                            @if (e.Commitment?.EndTime is { } end)
                            {
                                <Tip Text="@(e.PlanDescription ?? e.Commitment?.PaymentPlan)">@end.ToString("yyyy-MM-dd")</Tip>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Entitlement" Title="Auto-renew" Width="110px">
                        <Template Context="e">
                            @if (e.Commitment?.RenewalEnabled is { } renew)
                            {
                                <RadzenBadge BadgeStyle="@(renew ? BadgeStyle.Success : BadgeStyle.Warning)" Text="@(renew ? "On" : "Off")" />
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
        else
        {
            <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-m-0">
                No entitlements yet. Use <RadzenLink Path="@($"/customers/{_customer.Id}/entitlements/new")" Text="Purchase" /> to sell this customer their first SKU.
            </RadzenText>
        }
    </RadzenCard>

    <RadzenRow Gap="1rem" RowGap="1rem" class="rz-mb-4">
        <RadzenColumn Size="12" SizeLG="6">
            <RadzenCard Variant="Variant.Filled" class="rz-h-100">
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">Details</RadzenText>
                <RadzenStack Gap="0.5rem">
                    <DetailRow Label="Customer id">@_customer.Id</DetailRow>
                    <DetailRow Label="Domain">@_customer.Domain</DetailRow>
                    <DetailRow Label="Language">@(_customer.LanguageCode ?? "—")</DetailRow>
                    <DetailRow Label="Cloud Identity id">@(_customer.CloudIdentityId ?? "—")</DetailRow>
                    <DetailRow Label="Created">@(_customer.CreateTime?.ToString("u") ?? "—")</DetailRow>
                    <DetailRow Label="Channel partner">
                        @if (!string.IsNullOrEmpty(_customer.ChannelPartnerId))
                        {
                            <RadzenLink Path="@($"/channel-partner-links/{_customer.ChannelPartnerId}")" Text="@_customer.ChannelPartnerId" />
                        }
                        else
                        {
                            <span>Direct (no partner)</span>
                        }
                    </DetailRow>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeLG="6">
            <RadzenCard Variant="Variant.Filled" class="rz-h-100">
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">Cloud Identity</RadzenText>
                @if (_customer.CloudIdentity is { } ci)
                {
                    <RadzenStack Gap="0.5rem">
                        <DetailRow Label="Type">@(ci.CustomerType ?? "—")</DetailRow>
                        <DetailRow Label="Primary domain">@(ci.PrimaryDomain ?? "—")</DetailRow>
                        <DetailRow Label="Domain verified">
                            <RadzenBadge BadgeStyle="@(ci.IsDomainVerified ? BadgeStyle.Success : BadgeStyle.Warning)" Text="@(ci.IsDomainVerified ? "Verified" : "Unverified")" />
                        </DetailRow>
                        <DetailRow Label="Alternate email">@(ci.AlternateEmail ?? "—")</DetailRow>
                        @if (!string.IsNullOrEmpty(ci.AdminConsoleUri))
                        {
                            <DetailRow Label="Admin console"><RadzenLink Path="@ci.AdminConsoleUri" Target="_blank" Text="Open" /></DetailRow>
                        }
                    </RadzenStack>
                }
                else
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-m-0">No Cloud Identity linked.</RadzenText>
                }
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeLG="6">
            <RadzenCard Variant="Variant.Filled" class="rz-h-100">
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">Primary contact</RadzenText>
                @if (_customer.PrimaryContact is { } c)
                {
                    <RadzenStack Gap="0.5rem">
                        <DetailRow Label="Name">@($"{c.FirstName} {c.LastName}".Trim())</DetailRow>
                        <DetailRow Label="Email">@(c.Email ?? "—")</DetailRow>
                        <DetailRow Label="Phone">@(c.Phone ?? "—")</DetailRow>
                        <DetailRow Label="Title">@(c.Title ?? "—")</DetailRow>
                    </RadzenStack>
                }
                else
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-m-0">No contact on file.</RadzenText>
                }
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeLG="6">
            <RadzenCard Variant="Variant.Filled" class="rz-h-100">
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">Address</RadzenText>
                @if (_customer.Address is { } a)
                {
                    <RadzenStack Gap="0.5rem">
                        <DetailRow Label="Street">@(string.Join(", ", a.AddressLines) is { Length: > 0 } s ? s : "—")</DetailRow>
                        <DetailRow Label="City">@(a.Locality ?? "—")</DetailRow>
                        <DetailRow Label="State / province">@(a.AdministrativeArea ?? "—")</DetailRow>
                        <DetailRow Label="Postal code">@(a.PostalCode ?? "—")</DetailRow>
                        <DetailRow Label="Region">@(a.RegionCode ?? "—")</DetailRow>
                    </RadzenStack>
                }
                else
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-m-0">No address on file.</RadzenText>
                }
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>

    <RadzenCard Variant="Variant.Filled" class="rz-mt-2">
        <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">Purchasable catalog</RadzenText>
        <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-mb-3">
            SKUs this customer is eligible to purchase. Pick a product to load its SKUs, then
            expand a SKU for its purchasable offers or jump to the catalog.
        </RadzenText>
        @if (_products is null)
        {
            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" class="rz-my-2" />
        }
        else
        {
            <RadzenFormField Text="Product" Variant="Variant.Outlined" Style="width:100%; max-width:480px" class="rz-mb-3">
                <RadzenDropDown TValue="string" Data="_products" TextProperty="@nameof(CatalogProduct.DisplayName)" ValueProperty="@nameof(CatalogProduct.Id)"
                                Value="@_selectedProductId" ValueChanged="OnProductSelected" AllowClear="true" Placeholder="Choose a product…" Name="product">
                    <Template Context="p">@(p.DisplayName ?? p.Id)</Template>
                </RadzenDropDown>
            </RadzenFormField>

            @if (_skusLoading)
            {
                <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" class="rz-my-2" />
            }
            else if (_purchasableSkus is { Count: > 0 })
            {
                <RadzenAccordion Multiple="true">
                    <Items>
                        @foreach (var sku in _purchasableSkus)
                        {
                            <RadzenAccordionItem Text="@(sku.DisplayName ?? sku.SkuId)"
                                                 Selected="_expandedSkus.Contains(sku.SkuId ?? string.Empty)"
                                                 SelectedChanged="expanded => OnSkuExpanded(sku, expanded)">
                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="1rem" class="rz-mb-2">
                                    <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">SKU id: @sku.SkuId</RadzenText>
                                    <LinkButton To="@($"/catalog/products?product={sku.ProductId}&sku={sku.SkuId}")" Text="View in catalog" Icon="@AppIcons.OpenInNew" Variant="Variant.Text" Size="ButtonSize.Small" />
                                </RadzenStack>

                                @if (_offersBySku.TryGetValue(sku.SkuId ?? string.Empty, out var offers))
                                {
                                    @if (offers is null)
                                    {
                                        <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" class="rz-my-2" />
                                    }
                                    else if (offers.Count == 0)
                                    {
                                        <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-m-0">No purchasable offers.</RadzenText>
                                    }
                                    else
                                    {
                                        <table class="gchannel-table gchannel-table-hover">
                                            <thead>
                                                <tr>
                                                    <th>Offer</th>
                                                    <th>Price reference</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var offer in offers)
                                                {
                                                    <tr>
                                                        <td>@(offer.DisplayName ?? offer.OfferName)</td>
                                                        <td>@(offer.PriceReferenceId ?? "—")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                }
                            </RadzenAccordionItem>
                        }
                    </Items>
                </RadzenAccordion>
            }
            else if (_purchasableSkus is not null)
            {
                <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-m-0">
                    No purchasable SKUs for this product.
                </RadzenText>
            }
        }
    </RadzenCard>

    <LinkButton To="/customers" Text="Back to customers" Icon="@AppIcons.ArrowBack" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Class="rz-mt-4" />
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private Customer? _customer;
    private bool _loading = true;

    private IReadOnlyList<CatalogProduct>? _products;
    private string? _selectedProductId;
    private IReadOnlyList<PurchasableSku>? _purchasableSkus;
    private bool _skusLoading;
    private readonly Dictionary<string, IReadOnlyList<PurchasableOffer>?> _offersBySku = [];
    private readonly HashSet<string> _expandedSkus = [];

    private CustomerEstateValue? _value;
    private bool _valueLoading = true;

    private IReadOnlyList<Entitlement>? _entitlements;
    private bool _entitlementsLoading = true;

    private CustomerSpendResult? _spend;
    private SellerSpendSummary? _sellerSpend;
    private MarketplaceOrdersResult? _marketplace;
    private bool _spendLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _products = null;
        _selectedProductId = null;
        _purchasableSkus = null;
        _offersBySku.Clear();
        _expandedSkus.Clear();
        _value = null;
        _valueLoading = true;
        _entitlements = null;
        _entitlementsLoading = true;
        _spend = null;
        _spendLoading = true;

        try
        {
            _customer = await Api.GetCustomerAsync(Id);
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load customer: {ex.Message}", Severity.Error);
            _customer = null;
        }
        finally
        {
            _loading = false;
        }

        if (_customer is not null)
        {
            try
            {
                var products = await Api.ListProductsAsync();
                _products = products?.Products ?? [];
            }
            catch (Exception ex)
            {
                await Snackbar.Add($"Failed to load products: {ex.Message}", Severity.Error);
                _products = [];
            }

            try
            {
                _value = await Api.GetCustomerValueAsync(Id);
            }
            catch
            {
                // Estimated value is best-effort; ignore failures so the page still renders.
                _value = null;
            }
            finally
            {
                _valueLoading = false;
            }

            try
            {
                var entitlements = await Api.ListEntitlementsAsync(Id);
                _entitlements = entitlements?.Entitlements ?? [];
            }
            catch (Exception ex)
            {
                await Snackbar.Add($"Failed to load entitlements: {ex.Message}", Severity.Error);
                _entitlements = [];
            }
            finally
            {
                _entitlementsLoading = false;
            }

            try
            {
                _spend = await Api.GetCustomerSpendAsync(Id, 13);
                _sellerSpend = await Api.GetCustomerSellerSpendAsync(Id, 3);
                _marketplace = await Api.GetMarketplaceOrdersAsync(Id);
            }
            catch
            {
                // Billed spend is best-effort (export may be unconfigured); ignore so the page renders.
                _spend ??= null;
            }
            finally
            {
                _spendLoading = false;
            }
        }
        else
        {
            _valueLoading = false;
            _entitlementsLoading = false;
            _spendLoading = false;
        }
    }

    // Prefer the friendly SKU/offer name resolved from the Catalog; fall back to the opaque id.
    private static string OfferLabel(Entitlement e) =>
        e.SkuDisplayName ?? e.OfferDisplayName ?? e.OfferId ?? e.Id;

    // "202608" -> "Aug 2026"; falls back to the raw value if it isn't a YYYYMM string.
    private static string FormatMonth(string invoiceMonth) =>
        DateTime.TryParseExact(invoiceMonth, "yyyyMM", System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var d)
            ? d.ToString("MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)
            : invoiceMonth;

    private static BadgeStyle StateColor(string? state) => state?.ToUpperInvariant() switch
    {
        "ACTIVE" => BadgeStyle.Success,
        "SUSPENDED" => BadgeStyle.Warning,
        "CANCELLED" or "CANCELED" => BadgeStyle.Danger,
        "PENDING" => BadgeStyle.Info,
        _ => BadgeStyle.Light
    };

    private static string? Seats(Entitlement e) =>
        e.Parameters.FirstOrDefault(p => string.Equals(p.Name, "num_units", StringComparison.OrdinalIgnoreCase))?.Value
        ?? e.Parameters.FirstOrDefault(p => string.Equals(p.Name, "max_units", StringComparison.OrdinalIgnoreCase))?.Value;

    private static long SeatCount(Entitlement e) =>
        long.TryParse(Seats(e), System.Globalization.NumberStyles.Integer, System.Globalization.CultureInfo.InvariantCulture, out var n) ? n : 0;

    // Estimated monthly amount = unit price × seats × (1 + repricing markup). Null when unpriced.
    private static decimal? MonthlyEstimate(Entitlement e)
    {
        if (e.UnitPrice is not { } unit || unit <= 0) return null;
        var seats = e.BillableSeats ?? SeatCount(e);
        if (seats <= 0) return null;
        var markup = 1 + ((e.RepricingPercent ?? 0m) / 100m);
        return unit * seats * markup;
    }

    private static string EstimateBreakdown(Entitlement e)
    {
        var seats = e.BillableSeats ?? SeatCount(e);
        var pct = e.RepricingPercent ?? 0m;
        var baseLine = $"{FormatMoney(e.UnitPrice ?? 0m, e.PriceCurrency)} × {seats} seat(s)";
        var markupLine = pct != 0m ? $" + {pct:0.##}% markup" : string.Empty;
        return $"Estimated from offer list pricing: {baseLine}{markupLine}. Not an invoiced figure.";
    }

    private static string FormatMoney(decimal value, string? currency) =>
        string.IsNullOrEmpty(currency)
            ? value.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)
            : $"{currency} {value.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)}";

    private async Task OnProductSelected(string? productId)
    {
        _selectedProductId = productId;
        _purchasableSkus = null;
        _offersBySku.Clear();
        _expandedSkus.Clear();
        if (string.IsNullOrEmpty(productId))
        {
            return;
        }

        _skusLoading = true;
        try
        {
            var result = await Api.ListPurchasableSkusAsync(Id, productId);
            _purchasableSkus = result?.Skus ?? [];
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load purchasable SKUs: {ex.Message}", Severity.Error);
            _purchasableSkus = [];
        }
        finally
        {
            _skusLoading = false;
        }
    }

    private async Task OnSkuExpanded(PurchasableSku sku, bool expanded)
    {
        var skuId = sku.SkuId ?? string.Empty;
        if (expanded)
        {
            _expandedSkus.Add(skuId);
        }
        else
        {
            _expandedSkus.Remove(skuId);
        }

        if (!expanded || _offersBySku.ContainsKey(skuId) || string.IsNullOrEmpty(skuId))
        {
            return;
        }

        _offersBySku[skuId] = null;
        try
        {
            var result = await Api.ListPurchasableOffersAsync(Id, sku.ProductId ?? _selectedProductId ?? string.Empty, skuId);
            _offersBySku[skuId] = result?.Offers ?? [];
        }
        catch (Exception ex)
        {
            _offersBySku.Remove(skuId);
            await Snackbar.Add($"Failed to load purchasable offers: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenProvisionDialogAsync()
    {
        if (_customer is null)
        {
            return;
        }

        var customerId = _customer.Id;
        var result = await Dialogs.OpenAsync<ProvisionCloudIdentityDialog>("Provision Cloud Identity", new Dictionary<string, object?>
        {
            [nameof(ProvisionCloudIdentityDialog.Customer)] = _customer,
            [nameof(ProvisionCloudIdentityDialog.Provision)] = new Func<ProvisionCloudIdentityRequest, Task<ChannelOperation?>>(request => Api.ProvisionCloudIdentityAsync(customerId, request))
        }, new DialogOptions { Width = "min(36rem, 95vw)", CloseDialogOnOverlayClick = false });

        if (result is not ProvisionCloudIdentityDialog.Result outcome)
        {
            return;
        }

        if (outcome.ValidateOnly)
        {
            await Snackbar.Add("Validation succeeded — no Cloud Identity was created.", Severity.Success);
        }
        else
        {
            await Snackbar.Add("Provisioning started. Tracking the operation…", Severity.Success);
            if (outcome.Operation is not null)
            {
                Nav.NavigateTo($"/operations?operation={Uri.EscapeDataString(outcome.Operation.Id)}");
            }
        }
    }

    private async Task DeleteAsync()
    {
        if (_customer is null)
        {
            return;
        }

        var confirmed = await Snackbar.ConfirmAsync(
            "Delete customer",
            $"Delete '{_customer.OrgDisplayName ?? _customer.Id}'? This cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (!confirmed)
        {
            return;
        }

        try
        {
            await Api.DeleteCustomerAsync(_customer.Id);
            await Snackbar.Add("Customer deleted.", Severity.Success);
            Nav.NavigateTo("/customers");
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to delete customer: {ex.Message}", Severity.Error);
        }
    }
}
