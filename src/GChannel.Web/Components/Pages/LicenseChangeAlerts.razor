@page "/license-change-alerts"
@attribute [Authorize]
@implements IDisposable
@inject GChannelApiClient Api
@inject UiNotifier Snackbar

<PageTitle>License change alerts · GChannel</PageTitle>

<Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Margin="Margin.Is2.FromBottom">
    <Div>
        <Heading Size="HeadingSize.Is3" Margin="Margin.Is0">License change alerts</Heading>
        <Small TextColor="TextColor.Secondary">Notify indirect resellers when an end customer's license changes</Small>
    </Div>
    <Button Color="Color.Secondary" Outline Clicked="LoadAsync" Disabled="_loading">
        <Icon Name="@AppIcons.Refresh" Class="me-1" /> Refresh
    </Button>
</Div>

<Alert Color="Color.Info" Visible Margin="Margin.Is4.FromBottom">
    <b>Preview only.</b> This page showcases the reseller notification email. No mail is sent — the
    "Send" action is disabled by design.
</Alert>

<Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is4.FromBottom">
    License change events arrive live on the Channel <Anchor To="/notifications">Pub/Sub feed</Anchor>.
    Each entitlement event is matched to the end customer it concerns and to the indirect reseller that
    owns that customer, so the owning reseller can be emailed a summary of what changed.
</Paragraph>

@if (!_loading && !_subscriberEnabled)
{
    <Alert Color="Color.Warning" Visible Margin="Margin.Is4.FromBottom">
        The background Pub/Sub subscriber isn't running, so no live change events are arriving. The rows
        below are illustrative samples. Configure the subscriber on the
        <Anchor To="/notifications">Notifications</Anchor> page to drive this from real events.
    </Alert>
}
else if (!_loading && _usingSamples)
{
    <Alert Color="Color.Info" Visible Margin="Margin.Is4.FromBottom">
        No license change events have arrived yet — showing illustrative samples so you can preview the email.
    </Alert>
}

<Row>
    <Column ColumnSize="ColumnSize.Is12.Is7.OnDesktop">
        <Heading Size="HeadingSize.Is5" Margin="Margin.Is2.FromBottom">Recent license changes</Heading>
        @if (_loading)
        {
            <LoadingPanel Title="Loading license changes…" Hint="Reading the live change feed and resolving owning resellers." />
        }
        else
        {
            <Card Shadow="Shadow.Small">
                <DataGrid TItem="LicenseChangeEvent" Data="_events" Hoverable Narrow Responsive Sortable
                          SelectedRow="_selected" SelectedRowChanged="OnRowSelected" RowSelectable="@(args => args.Item.IsIndirect)">
                    <DataGridColumns>
                        <DataGridColumn TItem="LicenseChangeEvent" Field="@nameof(LicenseChangeEvent.ChangeType)" Caption="Change">
                            <DisplayTemplate>
                                <Badge Color="@ChangeColor(context.Item.ChangeType)">@context.Item.ChangeType</Badge>
                                @if (!string.IsNullOrEmpty(context.Item.Detail))
                                {
                                    <Small TextColor="TextColor.Secondary" Display="Display.Block">@context.Item.Detail</Small>
                                }
                            </DisplayTemplate>
                        </DataGridColumn>
                        <DataGridColumn TItem="LicenseChangeEvent" Field="@nameof(LicenseChangeEvent.CustomerName)" Caption="End customer">
                            <DisplayTemplate>
                                <div>@context.Item.CustomerName</div>
                                <Small TextColor="TextColor.Secondary">@(context.Item.CustomerDomain ?? context.Item.CustomerId)</Small>
                            </DisplayTemplate>
                        </DataGridColumn>
                        <DataGridColumn TItem="LicenseChangeEvent" Field="@nameof(LicenseChangeEvent.ResellerName)" Caption="Indirect reseller" SortDirection="SortDirection.Ascending">
                            <DisplayTemplate>
                                @if (context.Item.IsIndirect)
                                {
                                    <span>@context.Item.ResellerName</span>
                                }
                                else
                                {
                                    <Badge Color="Color.Secondary">Direct</Badge>
                                }
                            </DisplayTemplate>
                        </DataGridColumn>
                        <DataGridColumn TItem="LicenseChangeEvent" Field="@nameof(LicenseChangeEvent.ResellerEmail)" Caption="Reseller email" Sortable="false">
                            <DisplayTemplate>
                                @if (context.Item.IsIndirect)
                                {
                                    <Anchor To="@($"mailto:{context.Item.ResellerEmail}")">@context.Item.ResellerEmail</Anchor>
                                }
                                else
                                {
                                    <span class="text-body-secondary">—</span>
                                }
                            </DisplayTemplate>
                        </DataGridColumn>
                        <DataGridColumn TItem="LicenseChangeEvent" Field="@nameof(LicenseChangeEvent.OccurredAt)" Caption="When">
                            <DisplayTemplate>@context.Item.OccurredAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</DisplayTemplate>
                        </DataGridColumn>
                        <DataGridColumn TItem="LicenseChangeEvent" Field="@nameof(LicenseChangeEvent.CustomerId)" Caption="Preview" Sortable="false" TextAlignment="TextAlignment.End" HeaderTextAlignment="TextAlignment.End">
                            <DisplayTemplate>
                                <Button Size="Size.Small" Color="Color.Primary" Class="btn-link text-decoration-none"
                                        Disabled="!context.Item.IsIndirect" Clicked="@(() => _selected = context.Item)">Preview</Button>
                            </DisplayTemplate>
                        </DataGridColumn>
                    </DataGridColumns>
                    <EmptyTemplate>
                        <Paragraph Margin="Margin.Is0">No license changes to show.</Paragraph>
                    </EmptyTemplate>
                </DataGrid>
            </Card>
        }
    </Column>

    <Column ColumnSize="ColumnSize.Is12.Is5.OnDesktop">
        <Heading Size="HeadingSize.Is5" Margin="Margin.Is2.FromBottom">Email preview</Heading>
        @if (_selected is null || !_selected.IsIndirect)
        {
            <Alert Color="Color.Info" Visible>Select an indirect reseller's license change to preview the email that would be sent.</Alert>
        }
        else
        {
            <Card Shadow="Shadow.Small">
                <CardBody>
                    <Small TextColor="TextColor.Secondary" Display="Display.Block">To</Small>
                    <Paragraph Margin="Margin.Is2.FromBottom">@_selected.ResellerName &lt;@_selected.ResellerEmail&gt;</Paragraph>

                    <Small TextColor="TextColor.Secondary" Display="Display.Block">Subject</Small>
                    <Paragraph Margin="Margin.Is3.FromBottom"><b>@Subject(_selected)</b></Paragraph>

                    <Divider Margin="Margin.Is3.FromBottom" />

                    <Paragraph Margin="Margin.Is0" Style="white-space:pre-line">@Body(_selected)</Paragraph>
                </CardBody>
                <CardFooter Background="Background.Transparent">
                    <Button Color="Color.Primary" Disabled="true">
                        <Icon Name="@AppIcons.Send" Class="me-1" /> Send (disabled in preview)
                    </Button>
                </CardFooter>
            </Card>
        }

        <Strong Display="Display.Block" Margin="Margin.Is5.FromTop.Is1.FromBottom">How it works</Strong>
        <ListGroup Flush>
            <ListGroupItem Padding="Padding.Is0.OnX.Is1.OnY" Class="border-0">
                <Icon Name="@AppIcons.Notifications" TextColor="TextColor.Secondary" Class="me-2" />A Channel entitlement change event arrives on the Pub/Sub feed.
            </ListGroupItem>
            <ListGroupItem Padding="Padding.Is0.OnX.Is1.OnY" Class="border-0">
                <Icon Name="@AppIcons.Hub" TextColor="TextColor.Secondary" Class="me-2" />The affected customer is resolved to its owning channel partner (indirect reseller).
            </ListGroupItem>
            <ListGroupItem Padding="Padding.Is0.OnX.Is1.OnY" Class="border-0">
                <Icon Name="@AppIcons.Email" TextColor="TextColor.Secondary" Class="me-2" />A summary email is composed and sent to the reseller's registered contact.
            </ListGroupItem>
        </ListGroup>
    </Column>
</Row>

@code {
    private sealed record LicenseChangeEvent(
        string ChangeType,
        string CustomerName,
        string? CustomerDomain,
        string CustomerId,
        string? EntitlementId,
        string ResellerName,
        string ResellerEmail,
        bool IsIndirect,
        string? Detail,
        DateTimeOffset OccurredAt);

    private bool _loading = true;
    private bool _subscriberEnabled;
    private bool _usingSamples;
    private LicenseChangeEvent? _selected;
    private List<LicenseChangeEvent> _events = [];
    private readonly CancellationTokenSource _cts = new();

    // Most-recent license changes resolved live (customer + entitlement lookups per row).
    private const int MaxRows = 50;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _selected = null;
        try
        {
            var feed = await Api.ListNotificationsAsync(_cts.Token);
            _subscriberEnabled = feed?.SubscriberEnabled ?? false;

            // License changes ride on entitlement events; customer events don't carry one. Cap the
            // most-recent rows we resolve live so a busy feed stays responsive and easy on the quota.
            var notifications = (feed?.Notifications ?? [])
                .Where(n => string.Equals(n.Kind, "Entitlement", StringComparison.OrdinalIgnoreCase)
                            && !string.IsNullOrEmpty(n.CustomerId))
                .Take(MaxRows)
                .ToList();

            if (notifications.Count == 0)
            {
                _events = Samples();
                _usingSamples = true;
                return;
            }

            // Owning reseller comes from each customer's ChannelPartnerId (== a channel partner link's short id).
            var links = await Api.ListChannelPartnerLinksAsync(_cts.Token);
            var linkById = (links?.Links ?? [])
                .GroupBy(l => l.Id, StringComparer.Ordinal)
                .ToDictionary(g => g.Key, g => g.First(), StringComparer.Ordinal);

            // Resolve each distinct customer live (like the Notifications page) and each distinct
            // entitlement (for the "what changed" detail); dedupe so a busy feed isn't refetched.
            var customerById = new Dictionary<string, Customer?>(StringComparer.Ordinal);
            foreach (var id in notifications.Select(n => n.CustomerId!).Distinct(StringComparer.Ordinal))
            {
                customerById[id] = await TryGetCustomerAsync(id);
            }

            // Change history per distinct entitlement drives the delta (diff of the two latest changes).
            var changesByKey = new Dictionary<string, IReadOnlyList<EntitlementChange>>(StringComparer.Ordinal);
            foreach (var n in notifications.Where(n => !string.IsNullOrEmpty(n.EntitlementId)))
            {
                var key = $"{n.CustomerId}/{n.EntitlementId}";
                if (!changesByKey.ContainsKey(key))
                {
                    changesByKey[key] = await TryGetChangesAsync(n.CustomerId!, n.EntitlementId!);
                }
            }

            _events = notifications.Select(n =>
            {
                customerById.TryGetValue(n.CustomerId!, out var customer);
                var channelPartnerId = customer?.ChannelPartnerId;
                var isIndirect = !string.IsNullOrEmpty(channelPartnerId);

                var resellerName = "Direct";
                var resellerEmail = string.Empty;
                if (isIndirect)
                {
                    linkById.TryGetValue(channelPartnerId!, out var link);
                    var domain = link?.ChannelPartner?.PrimaryDomain;
                    resellerName = domain ?? link?.Id ?? channelPartnerId!;
                    resellerEmail = domain is not null ? $"channel-ops@{domain}" : "partner contact not set";
                }

                IReadOnlyList<EntitlementChange> changes = [];
                if (!string.IsNullOrEmpty(n.EntitlementId)
                    && changesByKey.TryGetValue($"{n.CustomerId}/{n.EntitlementId}", out var found))
                {
                    changes = found;
                }

                return new LicenseChangeEvent(
                    FriendlyChange(n.EventType),
                    customer?.OrgDisplayName ?? n.CustomerId!,
                    customer?.Domain,
                    n.CustomerId!,
                    n.EntitlementId,
                    resellerName,
                    resellerEmail,
                    isIndirect,
                    DescribeChange(changes),
                    n.ReceivedAt);
            }).ToList();
            _usingSamples = false;
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            // Benign teardown.
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load license changes: {ex.Message}", Severity.Error);
            _events = Samples();
            _usingSamples = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task<Customer?> TryGetCustomerAsync(string customerId)
    {
        try
        {
            return await Api.GetCustomerAsync(customerId, _cts.Token);
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            throw;
        }
        catch
        {
            return null;
        }
    }

    private async Task<IReadOnlyList<EntitlementChange>> TryGetChangesAsync(string customerId, string entitlementId)
    {
        try
        {
            var result = await Api.ListEntitlementChangesAsync(customerId, entitlementId, _cts.Token);
            return result?.Changes ?? [];
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            throw;
        }
        catch
        {
            return [];
        }
    }

    private void OnRowSelected(LicenseChangeEvent? item)
    {
        if (item is { IsIndirect: true })
        {
            _selected = item;
        }
    }

    // The concrete amount that changed, from the entitlement change history: the seat delta between the
    // two most recent changes (e.g. "added 2 seats → 42") plus any offer switch. Null when nothing to diff.
    private static string? DescribeChange(IReadOnlyList<EntitlementChange> changes)
    {
        if (changes.Count == 0)
        {
            return null;
        }

        var ordered = changes.OrderByDescending(c => c.CreateTime ?? DateTimeOffset.MinValue).ToList();
        var latest = ordered[0];
        var prior = ordered.ElementAtOrDefault(1);
        var parts = new List<string>();

        if (latest.Seats is { } now)
        {
            if (prior?.Seats is { } before && before != now)
            {
                var diff = now - before;
                var noun = Math.Abs(diff) == 1 ? "seat" : "seats";
                parts.Add($"{(diff > 0 ? "added" : "removed")} {Math.Abs(diff)} {noun} → {now}");
            }
            else
            {
                parts.Add($"{now} seats");
            }
        }

        var offerNow = latest.OfferDisplayName ?? latest.OfferId;
        var offerBefore = prior?.OfferDisplayName ?? prior?.OfferId;
        if (!string.IsNullOrEmpty(offerNow))
        {
            parts.Add(!string.IsNullOrEmpty(offerBefore)
                      && !string.Equals(offerBefore, offerNow, StringComparison.OrdinalIgnoreCase)
                ? $"{offerBefore} → {offerNow}"
                : offerNow);
        }

        return parts.Count > 0 ? string.Join(" · ", parts) : null;
    }

    private static string FriendlyChange(string? eventType) => eventType switch
    {
        null or "" => "License change",
        "LICENSE_ASSIGNMENT_CHANGED" => "Seats changed",
        "LICENSE_CAP_CHANGED" => "Seat cap changed",
        "ENTITLEMENT_CREATED" => "New license",
        "ENTITLEMENT_PLAN_CHANGED" or "ENTITLEMENT_OFFER_CHANGED" => "Offer change",
        "ENTITLEMENT_RENEWED" => "Renewed",
        "ENTITLEMENT_RENEWAL_SETTING_CHANGED" => "Renewal changed",
        "ENTITLEMENT_SUSPENDED" => "Suspended",
        "ENTITLEMENT_ACTIVATED" => "Activated",
        "ENTITLEMENT_CANCELLED" or "ENTITLEMENT_DELETED" => "Cancelled",
        _ => "License change"
    };

    private static Color ChangeColor(string changeType) => changeType switch
    {
        "New license" or "Seats changed" or "Activated" or "Renewed" => Color.Success,
        "Offer change" or "Renewal changed" or "Seat cap changed" => Color.Info,
        "Suspended" => Color.Warning,
        "Cancelled" => Color.Danger,
        _ => Color.Secondary
    };

    private static string Subject(LicenseChangeEvent e) =>
        $"License change for {e.CustomerName}: {e.ChangeType}";

    private static string Body(LicenseChangeEvent e) =>
        $"""
        Hello {e.ResellerName},

        A license change was recorded for one of your customers:

          Customer:  {e.CustomerName}{(e.CustomerDomain is null ? "" : $" ({e.CustomerDomain})")}
          Change:    {e.ChangeType}
          License:   {e.Detail ?? "—"}
          When:      {e.OccurredAt.LocalDateTime:f}

        Sign in to the console to review the entitlement and its change history.

        — GChannel automated notifications
        """;

    // Illustrative fallback shown only when the live feed has no license change events yet.
    private static List<LicenseChangeEvent> Samples() =>
    [
        new("Seats changed", "Northwind Trading", "northwind.example", "sample-1", null,
            "contoso.example", "channel-ops@contoso.example", true, "Seats 25 → 40 (+15)",
            DateTimeOffset.Now.AddHours(-2)),
        new("Seats changed", "Fabrikam Media", "fabrikam.example", "sample-2", null,
            "adventure-works.example", "channel-ops@adventure-works.example", true, "Seats 120 → 90 (−30)",
            DateTimeOffset.Now.AddHours(-6)),
        new("Offer change", "Tailspin Toys", "tailspin.example", "sample-3", null,
            "contoso.example", "channel-ops@contoso.example", true, "Business Starter → Business Standard",
            DateTimeOffset.Now.AddDays(-1)),
        new("Suspended", "Wingtip Legal", "wingtip.example", "sample-4", null,
            "adventure-works.example", "channel-ops@adventure-works.example", true, "Entitlement suspended (billing)",
            DateTimeOffset.Now.AddDays(-2)),
        new("Cancelled", "Proseware Health", "proseware.example", "sample-5", null,
            "fourthcoffee.example", "channel-ops@fourthcoffee.example", true, "Entitlement cancelled",
            DateTimeOffset.Now.AddDays(-3)),
    ];

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}

