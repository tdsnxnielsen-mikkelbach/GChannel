@page "/license-change-alerts"
@attribute [Authorize]
@implements IDisposable
@inject GChannelApiClient Api
@inject ISnackbar Snackbar

<PageTitle>License change alerts · GChannel</PageTitle>

<div class="d-flex justify-space-between align-center mb-2">
    <div>
        <MudText Typo="Typo.h4">License change alerts</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Notify indirect resellers when an end customer's license changes</MudText>
    </div>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh"
               OnClick="LoadAsync" Disabled="_loading">Refresh</MudButton>
</div>

<MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">
    <b>Preview only.</b> This page showcases the reseller notification email. No mail is sent — the
    "Send" action is disabled by design.
</MudAlert>

<MudText Typo="Typo.body1" Class="mb-4" Color="Color.Secondary">
    License change events arrive live on the Channel <MudLink Href="/notifications">Pub/Sub feed</MudLink>.
    Each entitlement event is matched to the end customer it concerns and to the indirect reseller that
    owns that customer, so the owning reseller can be emailed a summary of what changed.
</MudText>

@if (!_loading && !_subscriberEnabled)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4" Dense="true">
        The background Pub/Sub subscriber isn't running, so no live change events are arriving. The rows
        below are illustrative samples. Configure the subscriber on the
        <MudLink Href="/notifications">Notifications</MudLink> page to drive this from real events.
    </MudAlert>
}
else if (!_loading && _usingSamples)
{
    <MudAlert Severity="Severity.Info" Class="mb-4" Dense="true">
        No license change events have arrived yet — showing illustrative samples so you can preview the email.
    </MudAlert>
}

<MudGrid>
    <MudItem xs="12" md="7">
        <MudText Typo="Typo.h6" Class="mb-2">Recent license changes</MudText>
        @if (_loading)
        {
            <LoadingPanel Title="Loading license changes…" Hint="Reading the live change feed and resolving owning resellers." />
        }
        else
        {
            <MudTable Items="_events" Hover="true" Elevation="2" Dense="true"
                      @bind-SelectedItem="_selected" T="LicenseChangeEvent" OnRowClick="OnRowClick">
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="new Func<LicenseChangeEvent, object>(e => e.ChangeType)">Change</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<LicenseChangeEvent, object>(e => e.CustomerName)">End customer</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel InitialDirection="SortDirection.Ascending" SortBy="new Func<LicenseChangeEvent, object>(e => e.ResellerName)">Indirect reseller</MudTableSortLabel></MudTh>
                    <MudTh>Reseller email</MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<LicenseChangeEvent, object>(e => e.OccurredAt)">When</MudTableSortLabel></MudTh>
                    <MudTh Style="text-align:right">Preview</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Change">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@ChangeColor(context.ChangeType)">
                            @context.ChangeType
                        </MudChip>
                        @if (!string.IsNullOrEmpty(context.Detail))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">@context.Detail</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="End customer">
                        <MudText Typo="Typo.body2">@context.CustomerName</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@(context.CustomerDomain ?? context.CustomerId)</MudText>
                    </MudTd>
                    <MudTd DataLabel="Indirect reseller">
                        @if (context.IsIndirect)
                        {
                            <MudText Typo="Typo.body2">@context.ResellerName</MudText>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">Direct</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Reseller email">
                        @if (context.IsIndirect)
                        {
                            <MudLink Href="@($"mailto:{context.ResellerEmail}")">@context.ResellerEmail</MudLink>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">—</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="When">@context.OccurredAt.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</MudTd>
                    <MudTd DataLabel="Preview" Style="text-align:right">
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                   Disabled="!context.IsIndirect" OnClick="@(() => _selected = context)">Preview</MudButton>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText>No license changes to show.</MudText>
                </NoRecordsContent>
            </MudTable>
        }
    </MudItem>

    <MudItem xs="12" md="5">
        <MudText Typo="Typo.h6" Class="mb-2">Email preview</MudText>
        @if (_selected is null || !_selected.IsIndirect)
        {
            <MudAlert Severity="Severity.Info">Select an indirect reseller's license change to preview the email that would be sent.</MudAlert>
        }
        else
        {
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">To</MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">@_selected.ResellerName &lt;@_selected.ResellerEmail&gt;</MudText>

                    <MudText Typo="Typo.caption" Color="Color.Secondary">Subject</MudText>
                    <MudText Typo="Typo.body1" Class="mb-3"><b>@Subject(_selected)</b></MudText>

                    <MudDivider Class="mb-3" />

                    <MudText Typo="Typo.body2" Style="white-space:pre-line">@Body(_selected)</MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Send" Disabled="true">
                        Send (disabled in preview)
                    </MudButton>
                </MudCardActions>
            </MudCard>
        }

        <MudText Typo="Typo.subtitle2" Class="mt-6 mb-1">How it works</MudText>
        <MudList T="string" Dense="true">
            <MudListItem T="string" Icon="@Icons.Material.Filled.Notifications">
                A Channel entitlement change event arrives on the Pub/Sub feed.
            </MudListItem>
            <MudListItem T="string" Icon="@Icons.Material.Filled.Hub">
                The affected customer is resolved to its owning channel partner (indirect reseller).
            </MudListItem>
            <MudListItem T="string" Icon="@Icons.Material.Filled.Email">
                A summary email is composed and sent to the reseller's registered contact.
            </MudListItem>
        </MudList>
    </MudItem>
</MudGrid>

@code {
    private sealed record LicenseChangeEvent(
        string ChangeType,
        string CustomerName,
        string? CustomerDomain,
        string CustomerId,
        string? EntitlementId,
        string ResellerName,
        string ResellerEmail,
        bool IsIndirect,
        string? Detail,
        DateTimeOffset OccurredAt);

    private bool _loading = true;
    private bool _subscriberEnabled;
    private bool _usingSamples;
    private LicenseChangeEvent? _selected;
    private List<LicenseChangeEvent> _events = [];
    private readonly CancellationTokenSource _cts = new();

    // Most-recent license changes resolved live (customer + entitlement lookups per row).
    private const int MaxRows = 50;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _selected = null;
        try
        {
            var feed = await Api.ListNotificationsAsync(_cts.Token);
            _subscriberEnabled = feed?.SubscriberEnabled ?? false;

            // License changes ride on entitlement events; customer events don't carry one. Cap the
            // most-recent rows we resolve live so a busy feed stays responsive and easy on the quota.
            var notifications = (feed?.Notifications ?? [])
                .Where(n => string.Equals(n.Kind, "Entitlement", StringComparison.OrdinalIgnoreCase)
                            && !string.IsNullOrEmpty(n.CustomerId))
                .Take(MaxRows)
                .ToList();

            if (notifications.Count == 0)
            {
                _events = Samples();
                _usingSamples = true;
                return;
            }

            // Owning reseller comes from each customer's ChannelPartnerId (== a channel partner link's short id).
            var links = await Api.ListChannelPartnerLinksAsync(_cts.Token);
            var linkById = (links?.Links ?? [])
                .GroupBy(l => l.Id, StringComparer.Ordinal)
                .ToDictionary(g => g.Key, g => g.First(), StringComparer.Ordinal);

            // Resolve each distinct customer live (like the Notifications page) and each distinct
            // entitlement (for the "what changed" detail); dedupe so a busy feed isn't refetched.
            var customerById = new Dictionary<string, Customer?>(StringComparer.Ordinal);
            foreach (var id in notifications.Select(n => n.CustomerId!).Distinct(StringComparer.Ordinal))
            {
                customerById[id] = await TryGetCustomerAsync(id);
            }

            var entitlementByKey = new Dictionary<string, Entitlement?>(StringComparer.Ordinal);
            foreach (var n in notifications.Where(n => !string.IsNullOrEmpty(n.EntitlementId)))
            {
                var key = $"{n.CustomerId}/{n.EntitlementId}";
                if (!entitlementByKey.ContainsKey(key))
                {
                    entitlementByKey[key] = await TryGetEntitlementAsync(n.CustomerId!, n.EntitlementId!);
                }
            }

            _events = notifications.Select(n =>
            {
                customerById.TryGetValue(n.CustomerId!, out var customer);
                var channelPartnerId = customer?.ChannelPartnerId;
                var isIndirect = !string.IsNullOrEmpty(channelPartnerId);

                var resellerName = "Direct";
                var resellerEmail = string.Empty;
                if (isIndirect)
                {
                    linkById.TryGetValue(channelPartnerId!, out var link);
                    var domain = link?.ChannelPartner?.PrimaryDomain;
                    resellerName = domain ?? link?.Id ?? channelPartnerId!;
                    resellerEmail = domain is not null ? $"channel-ops@{domain}" : "partner contact not set";
                }

                Entitlement? entitlement = null;
                if (!string.IsNullOrEmpty(n.EntitlementId))
                {
                    entitlementByKey.TryGetValue($"{n.CustomerId}/{n.EntitlementId}", out entitlement);
                }

                return new LicenseChangeEvent(
                    FriendlyChange(n.EventType),
                    customer?.OrgDisplayName ?? n.CustomerId!,
                    customer?.Domain,
                    n.CustomerId!,
                    n.EntitlementId,
                    resellerName,
                    resellerEmail,
                    isIndirect,
                    DescribeChange(entitlement),
                    n.ReceivedAt);
            }).ToList();
            _usingSamples = false;
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            // Benign teardown.
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load license changes: {ex.Message}", Severity.Error);
            _events = Samples();
            _usingSamples = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task<Customer?> TryGetCustomerAsync(string customerId)
    {
        try
        {
            return await Api.GetCustomerAsync(customerId, _cts.Token);
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            throw;
        }
        catch
        {
            return null;
        }
    }

    private async Task<Entitlement?> TryGetEntitlementAsync(string customerId, string entitlementId)
    {
        try
        {
            return await Api.GetEntitlementAsync(customerId, entitlementId, _cts.Token);
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            throw;
        }
        catch
        {
            return null;
        }
    }

    private void OnRowClick(TableRowClickEventArgs<LicenseChangeEvent> args)
    {
        if (args.Item is { IsIndirect: true })
        {
            _selected = args.Item;
        }
    }

    // The license's current state after the change (offer · seats · state) — the concrete "what changed"
    // context the Pub/Sub event itself doesn't carry. Best-effort; null when the entitlement can't be read.
    private static string? DescribeChange(Entitlement? entitlement)
    {
        if (entitlement is null)
        {
            return null;
        }

        var parts = new List<string>();
        var offer = entitlement.OfferDisplayName ?? entitlement.SkuDisplayName ?? entitlement.ProductDisplayName;
        if (!string.IsNullOrEmpty(offer)) parts.Add(offer);
        if (Seats(entitlement) is { } seats) parts.Add($"{seats} seats");
        if (!string.IsNullOrEmpty(entitlement.ProvisioningState)) parts.Add(entitlement.ProvisioningState);
        return parts.Count > 0 ? string.Join(" · ", parts) : null;
    }

    private static long? Seats(Entitlement entitlement)
    {
        var units = entitlement.Parameters
            .FirstOrDefault(p => string.Equals(p.Name, "num_units", StringComparison.OrdinalIgnoreCase));
        return long.TryParse(units?.Value, out var n) ? n : entitlement.BillableSeats;
    }

    private static string FriendlyChange(string? eventType) => eventType switch
    {
        null or "" => "License change",
        "LICENSE_ASSIGNMENT_CHANGED" => "Seats changed",
        "LICENSE_CAP_CHANGED" => "Seat cap changed",
        "ENTITLEMENT_CREATED" => "New license",
        "ENTITLEMENT_PLAN_CHANGED" or "ENTITLEMENT_OFFER_CHANGED" => "Offer change",
        "ENTITLEMENT_RENEWED" => "Renewed",
        "ENTITLEMENT_RENEWAL_SETTING_CHANGED" => "Renewal changed",
        "ENTITLEMENT_SUSPENDED" => "Suspended",
        "ENTITLEMENT_ACTIVATED" => "Activated",
        "ENTITLEMENT_CANCELLED" or "ENTITLEMENT_DELETED" => "Cancelled",
        _ => "License change"
    };

    private static Color ChangeColor(string changeType) => changeType switch
    {
        "New license" or "Seats changed" or "Activated" or "Renewed" => Color.Success,
        "Offer change" or "Renewal changed" or "Seat cap changed" => Color.Info,
        "Suspended" => Color.Warning,
        "Cancelled" => Color.Error,
        _ => Color.Default
    };

    private static string Subject(LicenseChangeEvent e) =>
        $"License change for {e.CustomerName}: {e.ChangeType}";

    private static string Body(LicenseChangeEvent e) =>
        $"""
        Hello {e.ResellerName},

        A license change was recorded for one of your customers:

          Customer:  {e.CustomerName}{(e.CustomerDomain is null ? "" : $" ({e.CustomerDomain})")}
          Change:    {e.ChangeType}
          License:   {e.Detail ?? "—"}
          When:      {e.OccurredAt.LocalDateTime:f}

        Sign in to the console to review the entitlement and its change history.

        — GChannel automated notifications
        """;

    // Illustrative fallback shown only when the live feed has no license change events yet.
    private static List<LicenseChangeEvent> Samples() =>
    [
        new("Seats changed", "Northwind Trading", "northwind.example", "sample-1", null,
            "contoso.example", "channel-ops@contoso.example", true, "Seats 25 → 40 (+15)",
            DateTimeOffset.Now.AddHours(-2)),
        new("Seats changed", "Fabrikam Media", "fabrikam.example", "sample-2", null,
            "adventure-works.example", "channel-ops@adventure-works.example", true, "Seats 120 → 90 (−30)",
            DateTimeOffset.Now.AddHours(-6)),
        new("Offer change", "Tailspin Toys", "tailspin.example", "sample-3", null,
            "contoso.example", "channel-ops@contoso.example", true, "Business Starter → Business Standard",
            DateTimeOffset.Now.AddDays(-1)),
        new("Suspended", "Wingtip Legal", "wingtip.example", "sample-4", null,
            "adventure-works.example", "channel-ops@adventure-works.example", true, "Entitlement suspended (billing)",
            DateTimeOffset.Now.AddDays(-2)),
        new("Cancelled", "Proseware Health", "proseware.example", "sample-5", null,
            "fourthcoffee.example", "channel-ops@fourthcoffee.example", true, "Entitlement cancelled",
            DateTimeOffset.Now.AddDays(-3)),
    ];

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
