@page "/catalog/products"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject UiNotifier Snackbar

<PageTitle>Products · GChannel</PageTitle>

<RadzenText TextStyle="TextStyle.H4" class="rz-mb-2">Products</RadzenText>
<RadzenText TextStyle="TextStyle.Body1" class="rz-text-secondary-color rz-mb-6">
    The products you are authorized to sell. Expand a product to load its SKUs, then jump to the
    offers for any SKU.
</RadzenText>

@if (_loading)
{
    <LoadingPanel Title="Loading products…"
                  Hint="Fetching the products you're authorized to sell." />
}
else if (_products is { Count: > 0 })
{
    <RadzenAccordion Multiple="true">
        <Items>
            @foreach (var product in _products)
            {
                <RadzenAccordionItem Text="@(product.DisplayName ?? product.Id)"
                                     Selected="_expanded.Contains(product.Id)"
                                     SelectedChanged="expanded => OnProductExpanded(product, expanded)">
                    @if (!string.IsNullOrWhiteSpace(product.Description))
                    {
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-mb-3">@product.Description</RadzenText>
                    }

                    @if (_skusByProduct.TryGetValue(product.Id, out var skus))
                    {
                        @if (skus is null)
                        {
                            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" class="rz-my-2" />
                        }
                        else if (skus.Count == 0)
                        {
                            <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color">No SKUs found.</RadzenText>
                        }
                        else
                        {
                            <table class="gchannel-table gchannel-table-hover">
                                <thead>
                                    <tr>
                                        <th>SKU</th>
                                        <th>Id</th>
                                        <th>Related</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var sku in skus)
                                    {
                                        <tr class="@(IsDeepLinkedSku(sku) ? "selected" : null)">
                                            <td><Tip Text="@sku.Id">@(sku.DisplayName ?? sku.Id)</Tip></td>
                                            <td>@sku.Id</td>
                                            <td>
                                                <LinkButton To="@($"/catalog/offers?sku={sku.Id}")" Text="Offers" Icon="@AppIcons.LocalOffer"
                                                            Variant="Variant.Text" Size="ButtonSize.Small" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }
                </RadzenAccordionItem>
            }
        </Items>
    </RadzenAccordion>
}
else
{
    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">No products available.</RadzenAlert>
}

@code {
    [SupplyParameterFromQuery(Name = "product")]
    public string? ProductId { get; set; }

    [SupplyParameterFromQuery(Name = "sku")]
    public string? SkuId { get; set; }

    private IReadOnlyList<CatalogProduct>? _products;
    private readonly Dictionary<string, IReadOnlyList<CatalogSku>?> _skusByProduct = [];
    private readonly HashSet<string> _expanded = [];
    private bool _loading = true;
    private bool _deepLinkApplied;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Api.ListProductsAsync();
            _products = result?.Products ?? [];
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load products: {ex.Message}", Severity.Error);
            _products = [];
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Deep link: /catalog/products?product={id}&sku={id} — auto-expand and load the target.
        if (_deepLinkApplied || string.IsNullOrEmpty(ProductId) || _products is null)
        {
            return;
        }

        _deepLinkApplied = true;
        var target = _products.FirstOrDefault(p => string.Equals(p.Id, ProductId, StringComparison.OrdinalIgnoreCase));
        if (target is not null)
        {
            await OnProductExpanded(target, true);
        }
    }

    private async Task OnProductExpanded(CatalogProduct product, bool expanded)
    {
        if (expanded)
        {
            _expanded.Add(product.Id);
        }
        else
        {
            _expanded.Remove(product.Id);
        }

        if (!expanded || _skusByProduct.ContainsKey(product.Id))
        {
            return;
        }

        // Mark as loading (null) so the panel shows a progress bar.
        _skusByProduct[product.Id] = null;
        try
        {
            var result = await Api.ListSkusAsync(product.Id);
            _skusByProduct[product.Id] = result?.Skus ?? [];
        }
        catch (Exception ex)
        {
            _skusByProduct.Remove(product.Id);
            await Snackbar.Add($"Failed to load SKUs: {ex.Message}", Severity.Error);
        }
    }

    private bool IsDeepLinkedSku(CatalogSku sku) =>
        !string.IsNullOrEmpty(SkuId) && string.Equals(sku.Id, SkuId, StringComparison.OrdinalIgnoreCase);
}

