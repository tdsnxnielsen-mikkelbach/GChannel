@page "/billing/spend"
@attribute [Authorize]
@using Blazorise
@using Blazorise.DataGrid
@using ApexCharts
@* ApexCharts and Blazorise both export these names; the page uses the Blazorise meaning except for Theme. *@
@using Color = Blazorise.Color
@using Size = Blazorise.Size
@using Padding = Blazorise.Padding
@using Tooltip = Blazorise.Tooltip
@using Label = Blazorise.Label
@using Orientation = Blazorise.Orientation
@using Theme = ApexCharts.Theme
@inject GChannelApiClient Api
@inject NavigationManager Nav

<PageTitle>Spend trends · GChannel</PageTitle>

<Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Margin="Margin.Is4.FromBottom">
    <Div>
        <Heading Size="HeadingSize.Is3" Margin="Margin.Is0">Spend trends</Heading>
        <Small TextColor="TextColor.Secondary">
            Actual GCP &amp; Marketplace spend from the Cloud Billing → BigQuery cost export — real billed
            figures, distinct from the list-price estimates elsewhere.
        </Small>
    </Div>
</Div>

@if (_unconfigured)
{
    <Alert Color="Color.Info" Visible Margin="Margin.Is4.FromBottom">
        The BigQuery billing-export sync isn't configured, so there is no billed spend to show. Set
        <code>GoogleBilling:BigQueryEnabled</code> plus the project/dataset/table to enable it.
    </Alert>
}

<Row>
    <Column ColumnSize="ColumnSize.Is12.Is5.OnDesktop">
        <Card Shadow="Shadow.Small">
            <CardBody>
                <Heading Size="HeadingSize.Is5" Margin="Margin.Is2.FromBottom">Top spenders</Heading>
                @if (_topLoading)
                {
                    <Progress Indeterminate Color="Color.Primary" Size="Size.Small" Margin="Margin.Is2.OnY" />
                }
                else if (_top is { Count: > 0 })
                {
                    <Table Narrow Hoverable Borderless Margin="Margin.Is0">
                        <TableHeader>
                            <TableRow>
                                <TableHeaderCell>Customer</TableHeaderCell>
                                <TableHeaderCell TextAlignment="TextAlignment.End">Billed (last month)</TableHeaderCell>
                                <TableHeaderCell>Currency</TableHeaderCell>
                            </TableRow>
                        </TableHeader>
                        <TableBody>
                            @foreach (var s in _top)
                            {
                                <TableRow>
                                    <TableRowCell>
                                        <Anchor To="@($"/billing/spend?customerId={s.CustomerId}")">@CustomerLabel(s.CustomerId)</Anchor>
                                        @if (!string.IsNullOrEmpty(s.OwningLinkId))
                                        {
                                            <Small TextColor="TextColor.Secondary" Display="Display.Block">via reseller @(s.ResellerName ?? s.OwningLinkId)</Small>
                                        }
                                    </TableRowCell>
                                    <TableRowCell TextAlignment="TextAlignment.End">@s.Cost.ToString("N2")</TableRowCell>
                                    <TableRowCell>@s.Currency</TableRowCell>
                                </TableRow>
                            }
                        </TableBody>
                    </Table>
                    @if (_topAsOf is { } asOf)
                    {
                        <Small TextColor="TextColor.Secondary" Display="Display.Block" Margin="Margin.Is2.FromTop">as of @asOf.LocalDateTime.ToString("g")</Small>
                    }
                }
                else
                {
                    <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is0">No billed spend recorded yet.</Paragraph>
                }
            </CardBody>
        </Card>

        <Card Shadow="Shadow.Small" Margin="Margin.Is4.FromTop">
            <CardBody>
                <Heading Size="HeadingSize.Is5" Margin="Margin.Is2.FromBottom">By reseller</Heading>
                @if (_resellersLoading)
                {
                    <Progress Indeterminate Color="Color.Primary" Size="Size.Small" Margin="Margin.Is2.OnY" />
                }
                else if (_resellers is { Count: > 0 })
                {
                    <Table Narrow Hoverable Borderless Margin="Margin.Is0">
                        <TableHeader>
                            <TableRow>
                                <TableHeaderCell>Reseller</TableHeaderCell>
                                <TableHeaderCell TextAlignment="TextAlignment.End">Customers</TableHeaderCell>
                                <TableHeaderCell TextAlignment="TextAlignment.End">Billed (last month)</TableHeaderCell>
                                <TableHeaderCell>Currency</TableHeaderCell>
                            </TableRow>
                        </TableHeader>
                        <TableBody>
                            @foreach (var r in _resellers)
                            {
                                <TableRow>
                                    <TableRowCell>
                                        @if (string.IsNullOrEmpty(r.OwningLinkId))
                                        {
                                            <span>Direct (no partner)</span>
                                        }
                                        else
                                        {
                                            <Anchor To="@($"/channel-partner-links/{r.OwningLinkId}")">@(r.ResellerName ?? r.OwningLinkId)</Anchor>
                                        }
                                    </TableRowCell>
                                    <TableRowCell TextAlignment="TextAlignment.End">@r.CustomerCount</TableRowCell>
                                    <TableRowCell TextAlignment="TextAlignment.End">@r.Cost.ToString("N2")</TableRowCell>
                                    <TableRowCell>@r.Currency</TableRowCell>
                                </TableRow>
                            }
                        </TableBody>
                    </Table>
                    <Small TextColor="TextColor.Secondary" Display="Display.Block" Margin="Margin.Is2.FromTop">
                        Distributor rollup: each resold customer's billed spend attributed to its owning channel partner.
                    </Small>
                }
                else
                {
                    <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is0">No billed spend recorded yet.</Paragraph>
                }
            </CardBody>
        </Card>
    </Column>

    <Column ColumnSize="ColumnSize.Is12.Is7.OnDesktop">
        <Card Shadow="Shadow.Small">
            <CardBody>
                <Div Flex="Flex.JustifyContent.Between.AlignItems.Center.Wrap" Gap="Gap.Is2" Margin="Margin.Is2.FromBottom">
                    <Heading Size="HeadingSize.Is5" Margin="Margin.Is0">Daily trend</Heading>
                    <Select TValue="string" Value="@CustomerId" ValueChanged="OnCustomerChanged" Style="min-width: 240px" aria-label="Customer">
                        <SelectItem TValue="string" Value="@((string?)null)">All customers</SelectItem>
                        @foreach (var c in _customers)
                        {
                            <SelectItem TValue="string" Value="@c.Id">@(c.OrgDisplayName ?? c.Id)</SelectItem>
                        }
                    </Select>
                </Div>

                @if (string.IsNullOrEmpty(CustomerId))
                {
                    <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is0">Pick a customer to see their daily spend and any spikes.</Paragraph>
                }
                else if (_trendLoading)
                {
                    <Div Flex="Flex.AlignItems.Center.JustifyContent.Center" Style="height: 260px;">
                        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading…</span></div>
                    </Div>
                }
                else if (_trendByCurrency.Count > 0)
                {
                    @foreach (var group in _trendByCurrency)
                    {
                        <Strong Display="Display.Block" TextColor="TextColor.Secondary" Margin="Margin.Is2.FromTop">@group.Key</Strong>
                        <ApexChart TItem="TrendItem" Options="_trendOptions" @key="(group.Key, IsDarkMode)">
                            <ApexPointSeries TItem="TrendItem" Items="group.Value" Name="Daily cost"
                                             SeriesType="SeriesType.Line"
                                             XValue="@(p => p.Label)" YValue="@(p => p.Cost)" />
                            @{
                                var spikes = group.Value.Where(p => p.IsSpike).ToList();
                            }
                            @if (spikes.Count > 0)
                            {
                                <ApexPointSeries TItem="TrendItem" Items="spikes" Name="Spike"
                                                 SeriesType="SeriesType.Scatter"
                                                 XValue="@(p => p.Label)" YValue="@(p => p.Cost)" />
                            }
                        </ApexChart>
                    }
                    @if (_trendAsOf is { } asOf)
                    {
                        <Small TextColor="TextColor.Secondary" Display="Display.Block" Margin="Margin.Is2.FromTop">as of @asOf.LocalDateTime.ToString("g")</Small>
                    }
                }
                else
                {
                    <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is0">No billed spend recorded for this customer yet.</Paragraph>
                }
            </CardBody>
        </Card>
    </Column>
</Row>

<Row Margin="Margin.Is2.FromTop">
    <Column ColumnSize="ColumnSize.Is12.Is5.OnDesktop">
        <SellerSplitCard Summary="_sellers" Loading="_sellersLoading" Subtitle="Estate-wide, last invoice month" />
    </Column>
    <Column ColumnSize="ColumnSize.Is12.Is7.OnDesktop">
        <Card Shadow="Shadow.Small">
            <CardBody>
                <Heading Size="HeadingSize.Is5" Margin="Margin.Is2.FromBottom">Third-party share by customer</Heading>
                @if (_splitsLoading)
                {
                    <Progress Indeterminate Color="Color.Primary" Size="Size.Small" Margin="Margin.Is2.OnY" />
                }
                else if (_splits is { Count: > 0 })
                {
                    <DataGrid TItem="CustomerSellerSplit" Data="_splits" Narrow Hoverable Responsive Sortable
                              ShowPager ShowPageSizes PageSize="15" PageSizes="_splitPageSizes">
                        <DataGridColumns>
                            <DataGridColumn TItem="CustomerSellerSplit" Field="@nameof(CustomerSellerSplit.CustomerId)" Caption="Customer" Sortable="false">
                                <DisplayTemplate><Anchor To="@($"/customers/{context.Item.CustomerId}")">@CustomerLabel(context.Item.CustomerId)</Anchor></DisplayTemplate>
                            </DataGridColumn>
                            <DataGridColumn TItem="CustomerSellerSplit" Field="@nameof(CustomerSellerSplit.GoogleCost)" Caption="Google Cloud" TextAlignment="TextAlignment.End">
                                <DisplayTemplate>@context.Item.GoogleCost.ToString("N0") <small class="text-body-secondary">@context.Item.Currency</small></DisplayTemplate>
                            </DataGridColumn>
                            <DataGridColumn TItem="CustomerSellerSplit" Field="@nameof(CustomerSellerSplit.ThirdPartyCost)" Caption="Third-party" TextAlignment="TextAlignment.End" SortDirection="SortDirection.Descending">
                                <DisplayTemplate>@context.Item.ThirdPartyCost.ToString("N0")</DisplayTemplate>
                            </DataGridColumn>
                            <DataGridColumn TItem="CustomerSellerSplit" Field="@nameof(CustomerSellerSplit.ThirdPartyPercent)" Caption="Share">
                                <DisplayTemplate>
                                    <Badge Color="@(context.Item.ThirdPartyPercent >= 50 ? Color.Secondary : Color.Light)" Class="@(context.Item.ThirdPartyPercent >= 50 ? null : "text-body border")">@context.Item.ThirdPartyPercent.ToString("0.#")%</Badge>
                                </DisplayTemplate>
                            </DataGridColumn>
                            <DataGridColumn TItem="CustomerSellerSplit" Field="@nameof(CustomerSellerSplit.Sellers)" Caption="Sellers" Sortable="false">
                                <DisplayTemplate><Small>@string.Join(", ", context.Item.Sellers)</Small></DisplayTemplate>
                            </DataGridColumn>
                        </DataGridColumns>
                    </DataGrid>
                }
                else
                {
                    <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is0">No seller breakdown yet.</Paragraph>
                }
            </CardBody>
        </Card>
    </Column>
    <Column ColumnSize="ColumnSize.Is12">
        <MarketplaceOrdersTable Result="_orders" Loading="_ordersLoading" />
    </Column>
</Row>

@code {
    [SupplyParameterFromQuery]
    public string? CustomerId { get; set; }

    private static readonly int[] _splitPageSizes = [15, 50];

    // Cascaded from MainLayout so the ApexChart axis/legend text follows the app's light/dark theme.
    [CascadingParameter(Name = "IsDarkMode")]
    private bool IsDarkMode { get; set; }

    private readonly ApexChartOptions<TrendItem> _trendOptions = new()
    {
        Yaxis =
        [
            new YAxis
            {
                DecimalsInFloat = 2,
                Labels = new YAxisLabels
                {
                    Formatter = "function (val) { return val == null ? '' : Number(val).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }"
                }
            }
        ]
    };

    private bool _unconfigured;

    private IReadOnlyList<TopSpender> _top = [];
    private DateTimeOffset? _topAsOf;
    private bool _topLoading = true;

    private IReadOnlyList<ResellerSpend> _resellers = [];
    private bool _resellersLoading = true;

    private SellerSpendSummary? _sellers;
    private bool _sellersLoading = true;
    private IReadOnlyList<CustomerSellerSplit> _splits = [];
    private bool _splitsLoading = true;
    private MarketplaceOrdersResult? _orders;
    private bool _ordersLoading = true;

    private IReadOnlyList<Customer> _customers = [];
    private readonly Dictionary<string, string> _customerNames = new(StringComparer.Ordinal);

    private readonly List<KeyValuePair<string, List<TrendItem>>> _trendByCurrency = [];
    private DateTimeOffset? _trendAsOf;
    private bool _trendLoading;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var customers = await Api.ListCustomersAsync();
            _customers = customers?.Customers ?? [];
            foreach (var c in _customers)
            {
                _customerNames[c.Id] = c.OrgDisplayName ?? c.Domain ?? c.Id;
            }
        }
        catch
        {
            _customers = [];
        }

        try
        {
            var top = await Api.GetTopSpendersAsync(months: 1, limit: 15);
            _unconfigured = top?.Unconfigured ?? false;
            _top = top?.Spenders ?? [];
            _topAsOf = top?.AsOf;
        }
        catch
        {
            _top = [];
        }
        finally
        {
            _topLoading = false;
        }

        try
        {
            var resellers = await Api.GetResellerSpendAsync(months: 1);
            _resellers = resellers?.Resellers ?? [];
        }
        catch
        {
            _resellers = [];
        }
        finally
        {
            _resellersLoading = false;
        }

        try { _sellers = await Api.GetSellerSpendAsync(months: 1); } catch { _sellers = null; } finally { _sellersLoading = false; }
        try { _splits = (await Api.GetCustomerSellerSplitsAsync(months: 1))?.Customers ?? []; } catch { _splits = []; } finally { _splitsLoading = false; }
        try { _orders = await Api.GetMarketplaceOrdersAsync(); } catch { _orders = null; } finally { _ordersLoading = false; }
    }

    protected override async Task OnParametersSetAsync()
    {
        _trendOptions.Theme = new Theme { Mode = IsDarkMode ? Mode.Dark : Mode.Light };

        if (string.IsNullOrEmpty(CustomerId))
        {
            _trendByCurrency.Clear();
            return;
        }

        _trendLoading = true;
        _trendByCurrency.Clear();
        try
        {
            var trend = await Api.GetCustomerSpendTrendAsync(CustomerId, days: 90);
            _trendAsOf = trend?.AsOf;
            if (trend is { Unconfigured: false, Days.Count: > 0 })
            {
                foreach (var byCurrency in trend.Days.GroupBy(d => d.Currency))
                {
                    var items = byCurrency
                        .OrderBy(d => d.Day)
                        .Select(d => new TrendItem(d.Day.ToString("MMM d", System.Globalization.CultureInfo.InvariantCulture), (decimal)d.Cost, d.IsSpike))
                        .ToList();
                    _trendByCurrency.Add(new(byCurrency.Key, items));
                }
            }
        }
        catch
        {
            _trendByCurrency.Clear();
        }
        finally
        {
            _trendLoading = false;
        }
    }

    private void OnCustomerChanged(string? customerId) =>
        Nav.NavigateTo(string.IsNullOrEmpty(customerId) ? "/billing/spend" : $"/billing/spend?customerId={customerId}");

    private string CustomerLabel(string customerId) =>
        _customerNames.TryGetValue(customerId, out var name) ? name : customerId;

    private sealed record TrendItem(string Label, decimal Cost, bool IsSpike);
}

