@page "/billing/spend"
@attribute [Authorize]
@using ApexCharts
@* ApexCharts and Radzen both export these names; the page uses the Radzen meaning except for Theme/Mode. *@
@using Orientation = Radzen.Orientation
@using Theme = ApexCharts.Theme
@inject GChannelApiClient Api
@inject NavigationManager Nav

<PageTitle>Spend trends · GChannel</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Start" Gap="1rem" Wrap="FlexWrap.Wrap" class="rz-mb-4">
    <div>
        <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">Spend trends</RadzenText>
        <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">
            Actual GCP &amp; Marketplace spend from the Cloud Billing → BigQuery cost export — real billed
            figures, distinct from the list-price estimates elsewhere. The monthly panels show the last
            complete month unless you pick another.
        </RadzenText>
    </div>
    @if (_monthOptions.Count > 0)
    {
        <div>
            <RadzenDropDown TValue="string" Data="_monthOptions" ValueProperty="@nameof(SelectOption.Value)" TextProperty="@nameof(SelectOption.Text)"
                            Value="@_month" ValueChanged="OnMonthChanged" AllowClear="false" Style="min-width: 220px" aria-label="Billing month" Name="month" />
            @if (_month == _currentMonth)
            {
                <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Div" class="rz-text-secondary-color rz-mt-1 rz-mb-0">Month to date — still accruing.</RadzenText>
            }
        </div>
    }
</RadzenStack>

@if (_unconfigured)
{
    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-mb-4">
        The BigQuery billing-export sync isn't configured, so there is no billed spend to show. Set
        <code>GoogleBilling:BigQueryEnabled</code> plus the project/dataset/table to enable it.
    </RadzenAlert>
}

<RadzenRow Gap="1rem" RowGap="1rem">
    <RadzenColumn Size="12" SizeLG="5">
        <RadzenCard Variant="Variant.Filled">
            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Top spenders</RadzenText>
            @if (_topLoading)
            {
                <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" class="rz-my-2" />
            }
            else if (_top is { Count: > 0 })
            {
                <table class="gchannel-table gchannel-table-hover">
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th class="num">Billed (@WindowLabel)</th>
                            <th>Currency</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in _top)
                        {
                            <tr>
                                <td>
                                    <RadzenLink Path="@($"/billing/spend?customerId={s.CustomerId}")" Text="@CustomerLabel(s.CustomerId)" />
                                    @if (!string.IsNullOrEmpty(s.OwningLinkId))
                                    {
                                        <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Div" class="rz-text-secondary-color rz-m-0">via reseller @(s.ResellerName ?? s.OwningLinkId)</RadzenText>
                                    }
                                </td>
                                <td class="num">@s.Cost.ToString("N2")</td>
                                <td>@s.Currency</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (_topAsOf is { } asOf)
                {
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-mt-2 rz-mb-0">as of @DisplayFormat.Timestamp(asOf)</RadzenText>
                }
            }
            else
            {
                <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-m-0">No billed spend recorded for @WindowLabel.</RadzenText>
            }
        </RadzenCard>

        <RadzenCard Variant="Variant.Filled" class="rz-mt-4">
            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">By reseller</RadzenText>
            @if (_resellersLoading)
            {
                <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" class="rz-my-2" />
            }
            else if (_resellers is { Count: > 0 })
            {
                <table class="gchannel-table gchannel-table-hover">
                    <thead>
                        <tr>
                            <th>Reseller</th>
                            <th class="num">Customers</th>
                            <th class="num">Billed (@WindowLabel)</th>
                            <th>Currency</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _resellers)
                        {
                            <tr>
                                <td>
                                    @if (string.IsNullOrEmpty(r.OwningLinkId))
                                    {
                                        <span>Direct (no partner)</span>
                                    }
                                    else
                                    {
                                        <RadzenLink Path="@($"/channel-partner-links/{r.OwningLinkId}")" Text="@(r.ResellerName ?? r.OwningLinkId)" />
                                    }
                                </td>
                                <td class="num">@r.CustomerCount</td>
                                <td class="num">@r.Cost.ToString("N2")</td>
                                <td>@r.Currency</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-mt-2 rz-mb-0">
                    Distributor rollup: each resold customer's billed spend attributed to its owning channel partner.
                </RadzenText>
            }
            else
            {
                <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-m-0">No billed spend recorded for @WindowLabel.</RadzenText>
            }
        </RadzenCard>
    </RadzenColumn>

    <RadzenColumn Size="12" SizeLG="7">
        <RadzenCard Variant="Variant.Filled">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap" class="rz-mb-2">
                <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">Daily trend</RadzenText>
                <RadzenDropDown TValue="string" Data="_customers" ValueProperty="@nameof(Customer.Id)" TextProperty="@nameof(Customer.OrgDisplayName)"
                                Value="@CustomerId" ValueChanged="OnCustomerChanged" AllowClear="true" Placeholder="All customers" Style="min-width: 240px" aria-label="Customer" Name="customer">
                    <Template Context="c">@(c.OrgDisplayName ?? c.Id)</Template>
                </RadzenDropDown>
            </RadzenStack>

            @if (string.IsNullOrEmpty(CustomerId))
            {
                <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-m-0">Pick a customer to see their daily spend and any spikes.</RadzenText>
            }
            else if (_trendLoading)
            {
                <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Style="height: 260px;">
                    <RadzenProgressBarCircular Mode="ProgressBarMode.Indeterminate" ShowValue="false" aria-label="Loading" />
                </RadzenStack>
            }
            else if (_trendByCurrency.Count > 0)
            {
                @foreach (var group in _trendByCurrency)
                {
                    <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-text-secondary-color rz-mt-2 rz-mb-0">@group.Key</RadzenText>
                    <ApexChart TItem="TrendItem" Options="_trendOptions" @key="(group.Key, IsDarkMode)">
                        <ApexPointSeries TItem="TrendItem" Items="group.Value" Name="Daily cost"
                                         SeriesType="SeriesType.Line"
                                         XValue="@(p => p.Label)" YValue="@(p => p.Cost)" />
                        @{
                            var spikes = group.Value.Where(p => p.IsSpike).ToList();
                        }
                        @if (spikes.Count > 0)
                        {
                            <ApexPointSeries TItem="TrendItem" Items="spikes" Name="Spike"
                                             SeriesType="SeriesType.Scatter"
                                             XValue="@(p => p.Label)" YValue="@(p => p.Cost)" />
                        }
                    </ApexChart>
                }
                @if (_trendAsOf is { } asOf)
                {
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-mt-2 rz-mb-0">as of @DisplayFormat.Timestamp(asOf)</RadzenText>
                }
            }
            else
            {
                <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-m-0">No billed spend recorded for this customer yet.</RadzenText>
            }
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

<RadzenRow Gap="1rem" RowGap="1rem" class="rz-mt-2">
    <RadzenColumn Size="12" SizeLG="5">
        <SellerSplitCard Summary="_sellers" Loading="_sellersLoading" Subtitle="@($"Estate-wide, {WindowLabel}")" />
    </RadzenColumn>
    <RadzenColumn Size="12" SizeLG="7">
        <RadzenCard Variant="Variant.Filled">
            <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">Third-party share by customer</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Div" class="rz-text-secondary-color rz-mb-2">Billed @WindowLabel</RadzenText>
            @if (_splitsLoading)
            {
                <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" class="rz-my-2" />
            }
            else if (_splits is { Count: > 0 })
            {
                <RadzenDataGrid TItem="CustomerSellerSplit" Data="_splits" AllowSorting="true" AllowPaging="true" PageSize="15" PageSizeOptions="_splitPageSizes" ShowPagingSummary="true"
                                Density="Density.Compact" GridLines="DataGridGridLines.Horizontal" Responsive="true">
                    <Columns>
                        <RadzenDataGridColumn TItem="CustomerSellerSplit" Title="Customer" Sortable="false">
                            <Template Context="s"><RadzenLink Path="@($"/customers/{s.CustomerId}")" Text="@CustomerLabel(s.CustomerId)" /></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="CustomerSellerSplit" Property="@nameof(CustomerSellerSplit.GoogleCost)" Title="Google Cloud" TextAlign="TextAlign.End">
                            <Template Context="s">@s.GoogleCost.ToString("N0") <small class="rz-text-secondary-color">@s.Currency</small></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="CustomerSellerSplit" Property="@nameof(CustomerSellerSplit.ThirdPartyCost)" Title="Third-party" TextAlign="TextAlign.End" SortOrder="SortOrder.Descending">
                            <Template Context="s">@s.ThirdPartyCost.ToString("N0")</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="CustomerSellerSplit" Property="@nameof(CustomerSellerSplit.ThirdPartyPercent)" Title="Share" Width="90px">
                            <Template Context="s">
                                <RadzenBadge BadgeStyle="@(s.ThirdPartyPercent >= 50 ? BadgeStyle.Secondary : BadgeStyle.Light)" Text="@($"{s.ThirdPartyPercent:0.#}%")" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="CustomerSellerSplit" Title="Sellers" Sortable="false">
                            <Template Context="s"><small>@string.Join(", ", s.Sellers)</small></Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
            else
            {
                <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-m-0">No seller breakdown for @WindowLabel.</RadzenText>
            }
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn Size="12">
        <MarketplaceOrdersTable Result="_orders" Loading="_ordersLoading" />
    </RadzenColumn>
</RadzenRow>

@code {
    [SupplyParameterFromQuery]
    public string? CustomerId { get; set; }

    private static readonly IEnumerable<int> _splitPageSizes = [15, 50];

    // Cascaded from MainLayout so the ApexChart axis/legend text follows the app's light/dark theme.
    [CascadingParameter(Name = "IsDarkMode")]
    private bool IsDarkMode { get; set; }

    private readonly ApexChartOptions<TrendItem> _trendOptions = new()
    {
        Yaxis =
        [
            new YAxis
            {
                DecimalsInFloat = 2,
                Labels = new YAxisLabels
                {
                    Formatter = "function (val) { return val == null ? '' : Number(val).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }"
                }
            }
        ]
    };

    private bool _unconfigured;

    // The invoice month (YYYYMM) the monthly panels show. It starts as the API's default — the last complete
    // month — and follows the picker. _window is the month(s) the API actually used, for the panel labels.
    private string? _month;
    private string? _currentMonth;
    private IReadOnlyList<SelectOption> _monthOptions = [];
    private IReadOnlyList<string> _window = [];
    private int _estateLoad;
    private string WindowLabel => _window.Count > 0 ? DisplayFormat.InvoiceWindow(_window) : "last month";

    private IReadOnlyList<TopSpender> _top = [];
    private DateTimeOffset? _topAsOf;
    private bool _topLoading = true;

    private IReadOnlyList<ResellerSpend> _resellers = [];
    private bool _resellersLoading = true;

    private SellerSpendSummary? _sellers;
    private bool _sellersLoading = true;
    private IReadOnlyList<CustomerSellerSplit> _splits = [];
    private bool _splitsLoading = true;
    private MarketplaceOrdersResult? _orders;
    private bool _ordersLoading = true;

    private IReadOnlyList<Customer> _customers = [];
    private readonly Dictionary<string, string> _customerNames = new(StringComparer.Ordinal);

    private readonly List<KeyValuePair<string, List<TrendItem>>> _trendByCurrency = [];
    private DateTimeOffset? _trendAsOf;
    private bool _trendLoading;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var customers = await Api.ListCustomersAsync();
            _customers = customers?.Customers ?? [];
            foreach (var c in _customers)
            {
                _customerNames[c.Id] = c.OrgDisplayName ?? c.Domain ?? c.Id;
            }
        }
        catch
        {
            _customers = [];
        }

        try
        {
            var months = await Api.GetSpendMonthsAsync();
            if (months is { Unconfigured: false, Months.Count: > 0 })
            {
                _currentMonth = months.CurrentMonth;
                _month = months.DefaultMonth;
                _monthOptions = [.. months.Months.Select(m => new SelectOption(
                    m, m == months.CurrentMonth ? $"{DisplayFormat.InvoiceMonth(m)} (month to date)" : DisplayFormat.InvoiceMonth(m)))];
            }
        }
        catch
        {
            _monthOptions = [];
        }

        await Task.WhenAll(LoadEstateAsync(), LoadOrdersAsync());
    }

    // (Re)loads every panel that depends on the selected month. The calls run in parallel, and a response is
    // dropped if another month was picked while it was in flight.
    private async Task LoadEstateAsync()
    {
        var load = ++_estateLoad;
        var month = _month;
        _topLoading = _resellersLoading = _sellersLoading = _splitsLoading = true;

        var top = TryAsync(() => Api.GetTopSpendersAsync(month, limit: 15));
        var resellers = TryAsync(() => Api.GetResellerSpendAsync(month));
        var sellers = TryAsync(() => Api.GetSellerSpendAsync(month));
        var splits = TryAsync(() => Api.GetCustomerSellerSplitsAsync(month));
        await Task.WhenAll(top, resellers, sellers, splits);
        if (load != _estateLoad)
        {
            return;
        }

        var topResult = await top;
        _unconfigured = topResult?.Unconfigured ?? false;
        _top = topResult?.Spenders ?? [];
        _topAsOf = topResult?.AsOf;
        _window = topResult?.InvoiceMonths ?? [];
        _resellers = (await resellers)?.Resellers ?? [];
        _sellers = await sellers;
        _splits = (await splits)?.Customers ?? [];
        _topLoading = _resellersLoading = _sellersLoading = _splitsLoading = false;
    }

    private async Task LoadOrdersAsync()
    {
        try { _orders = await Api.GetMarketplaceOrdersAsync(); } catch { _orders = null; } finally { _ordersLoading = false; }
    }

    private async Task OnMonthChanged(string? month)
    {
        if (string.IsNullOrEmpty(month) || month == _month)
        {
            return;
        }

        _month = month;
        await LoadEstateAsync();
    }

    // A failed call leaves its panel empty rather than breaking the page.
    private static async Task<T?> TryAsync<T>(Func<Task<T?>> call) where T : class
    {
        try { return await call(); }
        catch { return null; }
    }

    protected override async Task OnParametersSetAsync()
    {
        _trendOptions.Theme = new Theme { Mode = IsDarkMode ? Mode.Dark : Mode.Light };

        if (string.IsNullOrEmpty(CustomerId))
        {
            _trendByCurrency.Clear();
            return;
        }

        _trendLoading = true;
        _trendByCurrency.Clear();
        try
        {
            var trend = await Api.GetCustomerSpendTrendAsync(CustomerId, days: 90);
            _trendAsOf = trend?.AsOf;
            if (trend is { Unconfigured: false, Days.Count: > 0 })
            {
                foreach (var byCurrency in trend.Days.GroupBy(d => d.Currency))
                {
                    var items = byCurrency
                        .OrderBy(d => d.Day)
                        .Select(d => new TrendItem(d.Day.ToString("dd-MM", System.Globalization.CultureInfo.InvariantCulture), (decimal)d.Cost, d.IsSpike))
                        .ToList();
                    _trendByCurrency.Add(new(byCurrency.Key, items));
                }
            }
        }
        catch
        {
            _trendByCurrency.Clear();
        }
        finally
        {
            _trendLoading = false;
        }
    }

    private void OnCustomerChanged(string? customerId) =>
        Nav.NavigateTo(string.IsNullOrEmpty(customerId) ? "/billing/spend" : $"/billing/spend?customerId={customerId}");

    private string CustomerLabel(string customerId) =>
        _customerNames.TryGetValue(customerId, out var name) ? name : customerId;

    private sealed record TrendItem(string Label, decimal Cost, bool IsSpike);
}

