@page "/operations"
@attribute [Authorize]
@implements IDisposable
@using Blazorise
@inject GChannelApiClient Api
@inject UiNotifier Snackbar

<PageTitle>Operations · GChannel</PageTitle>

<Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Margin="Margin.Is2.FromBottom">
    <Div>
        <Heading Size="HeadingSize.Is3" Margin="Margin.Is0">Operations</Heading>
        <Small TextColor="TextColor.Secondary">Long-running operations</Small>
    </Div>
    <Button Color="Color.Secondary" Outline Clicked="RefreshListAsync" Disabled="_listLoading">
        <Icon Name="@AppIcons.Refresh" Class="me-1" /> Refresh
    </Button>
</Div>

<Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is3.FromBottom">
    Mutating Channel calls (entitlement create/change/state changes, transfers) run asynchronously and
    return an operation. Track one by id to watch it complete, then deep-link to the customer or
    entitlement it affected.
</Paragraph>

<Accordion Margin="Margin.Is5.FromBottom">
    <AccordionItem @bind-Visible="_helpOpen">
        <AccordionHeader>
            <Heading Size="HeadingSize.Is6" Margin="Margin.Is0">
                <AccordionToggle><Icon Name="@AppIcons.HelpOutline" Class="me-2" />How operations work &amp; examples</AccordionToggle>
            </Heading>
        </AccordionHeader>
        <AccordionBody>
            <Strong Display="Display.Block" Margin="Margin.Is1.FromBottom">Where the id comes from</Strong>
            <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is3.FromBottom">
                When you buy/change/suspend an entitlement or run a transfer, the API returns an operation name
                like <code>operations/abc-123-def</code>. Paste that whole string, or just the
                <code>abc-123-def</code> id segment, into the box below. You usually don't need this page for
                small accounts — most actions finish in seconds — but it's handy for transfers and bulk changes
                that stay <em>Running</em> for a while.
            </Paragraph>

            <Strong Display="Display.Block" Margin="Margin.Is1.FromBottom">What you'll see</Strong>
            <ListGroup Flush Margin="Margin.Is3.FromBottom">
                <ListGroupItem Padding="Padding.Is0.OnX.Is1.OnY" Class="border-0">
                    <Icon Name="@AppIcons.Sync" TextColor="TextColor.Secondary" Class="me-2" /><b>Running</b> — still processing; refresh or leave the badge polling until it settles.
                </ListGroupItem>
                <ListGroupItem Padding="Padding.Is0.OnX.Is1.OnY" Class="border-0">
                    <Icon Name="@AppIcons.CheckCircle" TextColor="TextColor.Success" Class="me-2" /><b>Done</b> — finished; jump straight to the affected Customer or Entitlement.
                </ListGroupItem>
                <ListGroupItem Padding="Padding.Is0.OnX.Is1.OnY" Class="border-0">
                    <Icon Name="@AppIcons.Error" TextColor="TextColor.Danger" Class="me-2" /><b>Failed</b> — shows the error message + code (e.g. quota, invalid state) so you can retry.
                </ListGroupItem>
            </ListGroup>

            <Strong Display="Display.Block" Margin="Margin.Is1.FromBottom">Examples</Strong>
            <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is0">
                • Purchase a Workspace SKU → track the op to confirm provisioning before assigning licenses.<br />
                • Transfer customers from another reseller → watch the op finish, then open the entitlement.<br />
                • Suspend/cancel/start-paid-service → confirm the state change actually applied.<br />
                <em>Note:</em> Google's Channel API has no global "list all operations", so track by id rather
                than browse — you can still cancel a still-running operation.
            </Paragraph>
        </AccordionBody>
    </AccordionItem>
</Accordion>

<Card Shadow="Shadow.Small" Margin="Margin.Is5.FromBottom">
    <CardBody>
        <Div Flex="Flex.AlignItems.Center.Wrap" Gap="Gap.Is3">
            <TextInput @bind-Value="_lookupId" Placeholder="operations/… or the id segment" Class="flex-grow-1" aria-label="Operation id" />
            <Button Color="Color.Primary" Clicked="TrackAsync" Disabled="@(string.IsNullOrWhiteSpace(_lookupId) || _tracking)" Loading="_tracking">
                <Icon Name="@AppIcons.Search" Class="me-1" /> Track
            </Button>
        </Div>

        @if (_tracked is not null)
        {
            <Divider Margin="Margin.Is4.OnY" />
            <Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Margin="Margin.Is2.FromBottom">
                <Div>
                    <Strong Display="Display.Block">@(_tracked.OperationType ?? "Operation")</Strong>
                    <Small TextColor="TextColor.Secondary">@_tracked.Name</Small>
                </Div>
                @if (_tracked.Done)
                {
                    <Badge Color="@(_tracked.Error is null ? Color.Success : Color.Danger)">
                        <Icon Name="@(_tracked.Error is null ? AppIcons.CheckCircle : AppIcons.Error)" Class="me-1" />@(_tracked.Error is null ? "Done" : "Failed")
                    </Badge>
                }
                else
                {
                    <Badge Color="Color.Info"><Icon Name="@AppIcons.Sync" Class="me-1 fa-spin" />Running</Badge>
                }
            </Div>

            @if (!string.IsNullOrEmpty(_tracked.Error))
            {
                <Alert Color="Color.Danger" Visible Margin="Margin.Is3.FromBottom">
                    @_tracked.Error @(_tracked.ErrorCode is { } code and not 0 ? $"(code {code})" : "")
                </Alert>
            }

            @if (!string.IsNullOrEmpty(_tracked.CustomerId) || !string.IsNullOrEmpty(_tracked.EntitlementId))
            {
                <Div Flex="Flex.Wrap" Gap="Gap.Is2" Margin="Margin.Is3.FromBottom">
                    @if (!string.IsNullOrEmpty(_tracked.CustomerId))
                    {
                        <Button Type="ButtonType.Link" To="@($"/customers/{_tracked.CustomerId}")" Color="Color.Secondary" Outline Size="Size.Small">
                            <Icon Name="@AppIcons.Person" Class="me-1" /> Customer
                        </Button>
                    }
                    @if (!string.IsNullOrEmpty(_tracked.CustomerId) && !string.IsNullOrEmpty(_tracked.EntitlementId))
                    {
                        <Button Type="ButtonType.Link" To="@($"/customers/{_tracked.CustomerId}/entitlements/{_tracked.EntitlementId}")" Color="Color.Secondary" Outline Size="Size.Small">
                            <Icon Name="@AppIcons.Subscriptions" Class="me-1" /> Entitlement
                        </Button>
                    }
                </Div>
            }

            <Div Flex="Flex.Default" Gap="Gap.Is2">
                <Button Color="Color.Primary" Size="Size.Small" Class="btn-link text-decoration-none" Clicked="@(() => RefreshTrackedAsync(true))">
                    <Icon Name="@AppIcons.Refresh" Class="me-1" /> Refresh
                </Button>
                @if (!_tracked.Done)
                {
                    <Button Color="Color.Danger" Size="Size.Small" Class="btn-link text-decoration-none" Clicked="CancelAsync" Disabled="_cancelling">
                        <Icon Name="@AppIcons.Cancel" Class="me-1" /> Cancel
                    </Button>
                }
            </Div>
        }
    </CardBody>
</Card>

<Heading Size="HeadingSize.Is5" Margin="Margin.Is2.FromBottom">Recent operations</Heading>
@if (_listLoading)
{
    <LoadingPanel Title="Loading operations…" Hint="Fetching long-running operations from the Channel API." />
}
else if (_listUnavailable)
{
    <Alert Color="Color.Info" Visible>
        Listing operations isn't available for this account. Track an operation by id using its name from a
        mutating call's response.
    </Alert>
}
else if (_operations is { Count: > 0 })
{
    <Card Shadow="Shadow.Small">
        <Table Narrow Hoverable Responsive Margin="Margin.Is0">
            <TableHeader>
                <TableRow>
                    <TableHeaderCell>Type</TableHeaderCell>
                    <TableHeaderCell>Id</TableHeaderCell>
                    <TableHeaderCell>State</TableHeaderCell>
                    <TableHeaderCell>Correlation</TableHeaderCell>
                    <TableHeaderCell TextAlignment="TextAlignment.End">Actions</TableHeaderCell>
                </TableRow>
            </TableHeader>
            <TableBody>
                @foreach (var op in _operations)
                {
                    <TableRow>
                        <TableRowCell>@(op.OperationType ?? "—")</TableRowCell>
                        <TableRowCell><code>@op.Id</code></TableRowCell>
                        <TableRowCell>
                            @if (op.Done)
                            {
                                <Badge Color="@(op.Error is null ? Color.Success : Color.Danger)">@(op.Error is null ? "Done" : "Failed")</Badge>
                            }
                            else
                            {
                                <Badge Color="Color.Info">Running</Badge>
                            }
                        </TableRowCell>
                        <TableRowCell>
                            @if (!string.IsNullOrEmpty(op.CustomerId) && !string.IsNullOrEmpty(op.EntitlementId))
                            {
                                <Anchor To="@($"/customers/{op.CustomerId}/entitlements/{op.EntitlementId}")">Entitlement</Anchor>
                            }
                            else if (!string.IsNullOrEmpty(op.CustomerId))
                            {
                                <Anchor To="@($"/customers/{op.CustomerId}")">Customer</Anchor>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </TableRowCell>
                        <TableRowCell TextAlignment="TextAlignment.End">
                            <Tooltip Text="Track" Inline>
                                <Button Size="Size.Small" Color="Color.Light" Clicked="@(() => TrackByIdAsync(op.Id))" aria-label="Track">
                                    <Icon Name="@AppIcons.Visibility" />
                                </Button>
                            </Tooltip>
                        </TableRowCell>
                    </TableRow>
                }
            </TableBody>
        </Table>
    </Card>
}
else
{
    <Alert Color="Color.Info" Visible>No recent operations.</Alert>
}

@code {
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(5);

    private readonly CancellationTokenSource _cts = new();

    /// <summary>Optional operation id to auto-track, e.g. deep-linked after provisioning a Cloud Identity.</summary>
    [SupplyParameterFromQuery(Name = "operation")]
    public string? OperationId { get; set; }

    private bool _helpOpen;
    private string _lookupId = string.Empty;
    private ChannelOperation? _tracked;
    private bool _tracking;
    private bool _cancelling;

    private IReadOnlyList<ChannelOperation>? _operations;
    private bool _listLoading = true;
    private bool _listUnavailable;
    private Task? _pollTask;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(OperationId))
        {
            await TrackByIdAsync(OperationId.Trim());
        }

        await RefreshListAsync();
    }

    private async Task RefreshListAsync()
    {
        _listLoading = true;
        _listUnavailable = false;
        StateHasChanged();
        try
        {
            var result = await Api.ListOperationsAsync(_cts.Token);
            _operations = result?.Operations ?? [];
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            return;
        }
        catch
        {
            // The Channel API may not support listing operations for every account; degrade gracefully.
            _listUnavailable = true;
            _operations = [];
        }
        finally
        {
            _listLoading = false;
            StateHasChanged();
        }
    }

    private Task TrackAsync() => TrackByIdAsync(_lookupId.Trim());

    private async Task TrackByIdAsync(string operationId)
    {
        if (string.IsNullOrWhiteSpace(operationId))
        {
            return;
        }

        _lookupId = operationId;
        _tracking = true;
        try
        {
            _tracked = await Api.GetOperationAsync(operationId, _cts.Token);
            StartPolling();
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            // Component torn down.
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load operation: {ex.Message}", Severity.Error);
        }
        finally
        {
            _tracking = false;
        }
    }

    private async Task RefreshTrackedAsync(bool notify)
    {
        if (_tracked is null)
        {
            return;
        }

        try
        {
            var operation = await Api.GetOperationAsync(_tracked.Id, _cts.Token);
            _tracked = operation;
            if (notify && operation is not null)
            {
                await Snackbar.Add(operation.Done ? "Operation is done." : "Operation still running.", Severity.Info);
            }
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            // Ignore.
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to refresh operation: {ex.Message}", Severity.Error);
        }
    }

    private void StartPolling()
    {
        if (_pollTask is { IsCompleted: false } || _tracked is null || _tracked.Done)
        {
            return;
        }

        _pollTask = PollLoopAsync(_cts.Token);
    }

    private async Task PollLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(PollInterval);
            while (_tracked is { Done: false } && await timer.WaitForNextTickAsync(cancellationToken))
            {
                await RefreshTrackedAsync(false);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            // Circuit torn down.
        }
    }

    private async Task CancelAsync()
    {
        if (_tracked is null)
        {
            return;
        }

        _cancelling = true;
        try
        {
            _tracked = await Api.CancelOperationAsync(_tracked.Id, _cts.Token);
            await Snackbar.Add("Cancellation requested.", Severity.Success);
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to cancel operation: {ex.Message}", Severity.Error);
        }
        finally
        {
            _cancelling = false;
        }
    }

    public void Dispose()
    {
        try
        {
            _cts.Cancel();
        }
        catch (ObjectDisposedException)
        {
        }

        _cts.Dispose();
    }
}

