@page "/operations"
@attribute [Authorize]
@implements IDisposable
@inject GChannelApiClient Api
@inject UiNotifier Snackbar

<PageTitle>Operations · GChannel</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="1rem" class="rz-mb-2">
    <div>
        <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">Operations</RadzenText>
        <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">Long-running operations</RadzenText>
    </div>
    <RadzenButton Text="Refresh" Icon="@AppIcons.Refresh" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Click="RefreshListAsync" Disabled="_listLoading" />
</RadzenStack>

<RadzenText TextStyle="TextStyle.Body1" class="rz-text-secondary-color rz-mb-3">
    Mutating Channel calls (entitlement create/change/state changes, transfers) run asynchronously and
    return an operation. Track one by id to watch it complete, then deep-link to the customer or
    entitlement it affected.
</RadzenText>

<RadzenAccordion class="rz-mb-6">
    <Items>
        <RadzenAccordionItem Text="How operations work &amp; examples" Icon="@AppIcons.HelpOutline" @bind-Selected="_helpOpen">
            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-1">Where the id comes from</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-mb-3">
                When you buy/change/suspend an entitlement or run a transfer, the API returns an operation name
                like <code>operations/abc-123-def</code>. Paste that whole string, or just the
                <code>abc-123-def</code> id segment, into the box below. You usually don't need this page for
                small accounts — most actions finish in seconds — but it's handy for transfers and bulk changes
                that stay <em>Running</em> for a while.
            </RadzenText>

            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-1">What you'll see</RadzenText>
            <RadzenStack Gap="0.25rem" class="rz-mb-3">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="@AppIcons.Sync" class="rz-text-secondary-color" /><span><b>Running</b> — still processing; refresh or leave the badge polling until it settles.</span>
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="@AppIcons.CheckCircle" IconColor="@Colors.Success" /><span><b>Done</b> — finished; jump straight to the affected Customer or Entitlement.</span>
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                    <RadzenIcon Icon="@AppIcons.Error" IconColor="@Colors.Danger" /><span><b>Failed</b> — shows the error message + code (e.g. quota, invalid state) so you can retry.</span>
                </RadzenStack>
            </RadzenStack>

            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-1">Examples</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-m-0">
                • Purchase a Workspace SKU → track the op to confirm provisioning before assigning licenses.<br />
                • Transfer customers from another reseller → watch the op finish, then open the entitlement.<br />
                • Suspend/cancel/start-paid-service → confirm the state change actually applied.<br />
                <em>Note:</em> Google's Channel API has no global "list all operations", so track by id rather
                than browse — you can still cancel a still-running operation.
            </RadzenText>
        </RadzenAccordionItem>
    </Items>
</RadzenAccordion>

<RadzenCard Variant="Variant.Filled" class="rz-mb-6">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Wrap="FlexWrap.Wrap">
        <RadzenTextBox @bind-Value="_lookupId" Placeholder="operations/… or the id segment" Style="flex: 1 1 16rem" aria-label="Operation id" Name="operationId" />
        <RadzenButton Text="Track" Icon="@AppIcons.Search" ButtonStyle="ButtonStyle.Primary" Click="TrackAsync" Disabled="@string.IsNullOrWhiteSpace(_lookupId)" IsBusy="_tracking" />
    </RadzenStack>

    @if (_tracked is not null)
    {
        <hr class="rz-my-4" />
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="1rem" class="rz-mb-2">
            <div>
                <RadzenText TextStyle="TextStyle.Body1" class="rz-m-0" Style="font-weight:600">@(_tracked.OperationType ?? "Operation")</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">@_tracked.Name</RadzenText>
            </div>
            @if (_tracked.Done)
            {
                <RadzenBadge BadgeStyle="@(_tracked.Error is null ? BadgeStyle.Success : BadgeStyle.Danger)" Text="@(_tracked.Error is null ? "Done" : "Failed")" />
            }
            else
            {
                <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="Running" />
            }
        </RadzenStack>

        @if (!string.IsNullOrEmpty(_tracked.Error))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-mb-3">
                @_tracked.Error @(_tracked.ErrorCode is { } code and not 0 ? $"(code {code})" : "")
            </RadzenAlert>
        }

        @if (!string.IsNullOrEmpty(_tracked.CustomerId) || !string.IsNullOrEmpty(_tracked.EntitlementId))
        {
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap" class="rz-mb-3">
                @if (!string.IsNullOrEmpty(_tracked.CustomerId))
                {
                    <LinkButton To="@($"/customers/{_tracked.CustomerId}")" Text="Customer" Icon="@AppIcons.Person" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Size="ButtonSize.Small" />
                }
                @if (!string.IsNullOrEmpty(_tracked.CustomerId) && !string.IsNullOrEmpty(_tracked.EntitlementId))
                {
                    <LinkButton To="@($"/customers/{_tracked.CustomerId}/entitlements/{_tracked.EntitlementId}")" Text="Entitlement" Icon="@AppIcons.Subscriptions" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Size="ButtonSize.Small" />
                }
            </RadzenStack>
        }

        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <RadzenButton Text="Refresh" Icon="@AppIcons.Refresh" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text" Size="ButtonSize.Small" Click="@(() => RefreshTrackedAsync(true))" />
            @if (!_tracked.Done)
            {
                <RadzenButton Text="Cancel" Icon="@AppIcons.Cancel" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Size="ButtonSize.Small" Click="CancelAsync" Disabled="_cancelling" />
            }
        </RadzenStack>
    }
</RadzenCard>

<RadzenText TextStyle="TextStyle.H6" class="rz-mb-2">Recent operations</RadzenText>
@if (_listLoading)
{
    <LoadingPanel Title="Loading operations…" Hint="Fetching long-running operations from the Channel API." />
}
else if (_listUnavailable)
{
    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">
        Listing operations isn't available for this account. Track an operation by id using its name from a
        mutating call's response.
    </RadzenAlert>
}
else if (_operations is { Count: > 0 })
{
    <RadzenCard Variant="Variant.Filled">
        <RadzenDataGrid TItem="ChannelOperation" Data="_operations" AllowPaging="false" AllowSorting="false" Density="Density.Compact" GridLines="DataGridGridLines.Horizontal" Responsive="true">
            <Columns>
                <RadzenDataGridColumn TItem="ChannelOperation" Title="Type">
                    <Template Context="op">@(op.OperationType ?? "—")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ChannelOperation" Title="Id">
                    <Template Context="op"><code>@op.Id</code></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ChannelOperation" Title="State" Width="110px">
                    <Template Context="op">
                        @if (op.Done)
                        {
                            <RadzenBadge BadgeStyle="@(op.Error is null ? BadgeStyle.Success : BadgeStyle.Danger)" Text="@(op.Error is null ? "Done" : "Failed")" />
                        }
                        else
                        {
                            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="Running" />
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ChannelOperation" Title="Correlation">
                    <Template Context="op">
                        @if (!string.IsNullOrEmpty(op.CustomerId) && !string.IsNullOrEmpty(op.EntitlementId))
                        {
                            <RadzenLink Path="@($"/customers/{op.CustomerId}/entitlements/{op.EntitlementId}")" Text="Entitlement" />
                        }
                        else if (!string.IsNullOrEmpty(op.CustomerId))
                        {
                            <RadzenLink Path="@($"/customers/{op.CustomerId}")" Text="Customer" />
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ChannelOperation" Title="Actions" TextAlign="TextAlign.End" Width="90px">
                    <Template Context="op">
                        <Tip Text="Track">
                            <RadzenButton Icon="@AppIcons.Visibility" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Click="@(() => TrackByIdAsync(op.Id))" aria-label="Track" />
                        </Tip>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
}
else
{
    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">No recent operations.</RadzenAlert>
}

@code {
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(5);

    private readonly CancellationTokenSource _cts = new();

    /// <summary>Optional operation id to auto-track, e.g. deep-linked after provisioning a Cloud Identity.</summary>
    [SupplyParameterFromQuery(Name = "operation")]
    public string? OperationId { get; set; }

    private bool _helpOpen;
    private string _lookupId = string.Empty;
    private ChannelOperation? _tracked;
    private bool _tracking;
    private bool _cancelling;

    private IReadOnlyList<ChannelOperation>? _operations;
    private bool _listLoading = true;
    private bool _listUnavailable;
    private Task? _pollTask;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(OperationId))
        {
            await TrackByIdAsync(OperationId.Trim());
        }

        await RefreshListAsync();
    }

    private async Task RefreshListAsync()
    {
        _listLoading = true;
        _listUnavailable = false;
        StateHasChanged();
        try
        {
            var result = await Api.ListOperationsAsync(_cts.Token);
            _operations = result?.Operations ?? [];
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            return;
        }
        catch
        {
            // The Channel API may not support listing operations for every account; degrade gracefully.
            _listUnavailable = true;
            _operations = [];
        }
        finally
        {
            _listLoading = false;
            StateHasChanged();
        }
    }

    private Task TrackAsync() => TrackByIdAsync(_lookupId.Trim());

    private async Task TrackByIdAsync(string operationId)
    {
        if (string.IsNullOrWhiteSpace(operationId))
        {
            return;
        }

        _lookupId = operationId;
        _tracking = true;
        try
        {
            _tracked = await Api.GetOperationAsync(operationId, _cts.Token);
            StartPolling();
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            // Component torn down.
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load operation: {ex.Message}", Severity.Error);
        }
        finally
        {
            _tracking = false;
        }
    }

    private async Task RefreshTrackedAsync(bool notify)
    {
        if (_tracked is null)
        {
            return;
        }

        try
        {
            var operation = await Api.GetOperationAsync(_tracked.Id, _cts.Token);
            _tracked = operation;
            if (notify && operation is not null)
            {
                await Snackbar.Add(operation.Done ? "Operation is done." : "Operation still running.", Severity.Info);
            }
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            // Ignore.
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to refresh operation: {ex.Message}", Severity.Error);
        }
    }

    private void StartPolling()
    {
        if (_pollTask is { IsCompleted: false } || _tracked is null || _tracked.Done)
        {
            return;
        }

        _pollTask = PollLoopAsync(_cts.Token);
    }

    private async Task PollLoopAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(PollInterval);
            while (_tracked is { Done: false } && await timer.WaitForNextTickAsync(cancellationToken))
            {
                await RefreshTrackedAsync(false);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            // Circuit torn down.
        }
    }

    private async Task CancelAsync()
    {
        if (_tracked is null)
        {
            return;
        }

        _cancelling = true;
        try
        {
            _tracked = await Api.CancelOperationAsync(_tracked.Id, _cts.Token);
            await Snackbar.Add("Cancellation requested.", Severity.Success);
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to cancel operation: {ex.Message}", Severity.Error);
        }
        finally
        {
            _cancelling = false;
        }
    }

    public void Dispose()
    {
        try
        {
            _cts.Cancel();
        }
        catch (ObjectDisposedException)
        {
        }

        _cts.Dispose();
    }
}

