@page "/support/new"
@attribute [Authorize]
@implements IDisposable
@inject GChannelApiClient Api
@inject UiNotifier Snackbar
@inject NavigationManager Navigation

<PageTitle>New support case · GChannel</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="1rem" class="rz-mb-4">
    <RadzenStack Gap="0.25rem">
        <RadzenLink Path="/support" Text="← Support" />
        <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">New support case</RadzenText>
        <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">Opened for the organization with the GChannel service account</RadzenText>
    </RadzenStack>
    <GuidedWalkthrough Id="support-new-case" Steps="_walkthrough" />
</RadzenStack>

<RadzenCard Variant="Variant.Filled" Style="max-width: 860px">
    <RadzenStack Gap="1rem">
        <div data-walkthrough="new-case-classification">
            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-1">Classification</RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap">
                <SearchBox Value="@_classificationSearch" ValueChanged="SearchClassificationsAsync" Label="Search classifications" Placeholder="e.g. Billing, Compute Engine…" Name="classificationSearch" />
                <RadzenFormField Text="Classification" Variant="Variant.Outlined" Style="flex: 1; min-width: 280px">
                    <RadzenDropDown @bind-Value="_classificationId" Data="_classifications" TextProperty="DisplayName" ValueProperty="Id"
                                    Placeholder="@(_classificationsLoading ? "Loading…" : "Pick the closest match")" Disabled="_classificationsLoading" Name="classification" />
                </RadzenFormField>
            </RadzenStack>
        </div>

        <RadzenFormField Text="Title" Variant="Variant.Outlined" Style="width: 100%">
            <RadzenTextBox @bind-Value="_title" MaxLength="200" Name="caseTitle" />
        </RadzenFormField>

        <RadzenFormField Text="Description" Variant="Variant.Outlined" Style="width: 100%">
            <RadzenTextArea @bind-Value="_description" Rows="8" MaxLength="10000" Name="caseDescription"
                            Placeholder="What happened, which customer / resource is affected, what you've tried, and the impact." />
        </RadzenFormField>

        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.Center" data-walkthrough="new-case-priority">
            <RadzenFormField Text="Priority" Variant="Variant.Outlined" Style="min-width: 320px">
                <RadzenDropDown @bind-Value="_priority" Data="Priorities" TextProperty="Text" ValueProperty="Value" Name="priority" />
            </RadzenFormField>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenSwitch @bind-Value="_testCase" Name="testCase" />
                <RadzenLabel Text="Test case (Google won't work on it)" Component="testCase" />
            </RadzenStack>
        </RadzenStack>

        <RadzenFormField Text="Also notify (comma-separated emails, optional)" Variant="Variant.Outlined" Style="width: 100%">
            <RadzenTextBox @bind-Value="_subscribers" Name="subscribers" />
        </RadzenFormField>

        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
            <RadzenButton Text="@(_saving ? "Creating…" : "Create case")" Icon="@AppIcons.Send" ButtonStyle="ButtonStyle.Primary" Click="CreateAsync" Disabled="@(!CanCreate || _saving)" />
            <LinkButton To="/support" Text="Cancel" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" />
        </RadzenStack>
    </RadzenStack>
</RadzenCard>

@code {
    private static readonly IReadOnlyList<WalkthroughStep> _walkthrough =
    [
        new("[data-walkthrough=\"new-case-classification\"]", "Classification", "Search Google's issue categories and pick the closest one — it routes the case to the right team."),
        new("[data-walkthrough=\"new-case-priority\"]", "Priority", "P1/P0 page Google Support around the clock (plan permitting); use the test-case switch to try the flow without Google acting on it."),
    ];

    private sealed record Option(string Value, string Text);

    private static readonly IReadOnlyList<Option> Priorities =
    [
        new("P0", "P0 — Critical: production down"),
        new("P1", "P1 — High: significant impact"),
        new("P2", "P2 — Medium: partial impact"),
        new("P3", "P3 — Low: minor impact"),
        new("P4", "P4 — General question"),
    ];

    private readonly CancellationTokenSource _cts = new();

    private IReadOnlyList<SupportClassification> _classifications = [];
    private bool _classificationsLoading = true;
    private string? _classificationSearch;
    private string? _classificationId;
    private string? _title;
    private string? _description;
    private string _priority = "P3";
    private bool _testCase;
    private string? _subscribers;
    private bool _saving;

    private bool CanCreate =>
        !string.IsNullOrWhiteSpace(_classificationId) && !string.IsNullOrWhiteSpace(_title) && !string.IsNullOrWhiteSpace(_description);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SearchClassificationsAsync(null);
        }
    }

    private async Task SearchClassificationsAsync(string? search)
    {
        CancellationToken token;
        try
        {
            token = _cts.Token;
        }
        catch (ObjectDisposedException)
        {
            return;
        }

        _classificationSearch = search;
        _classificationsLoading = true;
        StateHasChanged();
        try
        {
            _classifications = (await Api.SearchSupportClassificationsAsync(search, token))?.Classifications ?? [];
            if (_classificationId is not null && _classifications.All(c => c.Id != _classificationId))
            {
                _classificationId = null;
            }
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            return;
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load classifications: {ex.Message}", Severity.Error);
        }
        finally
        {
            _classificationsLoading = false;
            StateHasChanged();
        }
    }

    private async Task CreateAsync()
    {
        CancellationToken token;
        try
        {
            token = _cts.Token;
        }
        catch (ObjectDisposedException)
        {
            return;
        }

        _saving = true;
        try
        {
            var created = await Api.CreateSupportCaseAsync(new CreateSupportCaseRequest
            {
                ClassificationId = _classificationId!,
                DisplayName = _title!,
                Description = _description!,
                Priority = _priority,
                TestCase = _testCase,
                SubscriberEmailAddresses = (_subscribers ?? string.Empty)
                    .Split([',', ';', ' '], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries),
            }, token);
            await Snackbar.Add($"Case {created?.Case.CaseId} created.", Severity.Success);
            Navigation.NavigateTo(created is null ? "/support" : $"/support/cases/{created.Case.CaseId}");
        }
        catch (Exception ex) when (ex is OperationCanceledException or ObjectDisposedException)
        {
            return;
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to create the case: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    public void Dispose()
    {
        try
        {
            _cts.Cancel();
        }
        catch (ObjectDisposedException)
        {
        }

        _cts.Dispose();
    }
}
