@page "/customers/{Id}/transfer"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject UiNotifier Snackbar
@inject NavigationManager Nav

<PageTitle>Transfer entitlements · GChannel</PageTitle>

<Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Margin="Margin.Is2.FromBottom">
    <Div>
        <Heading Size="HeadingSize.Is3" Margin="Margin.Is0">Transfer entitlements</Heading>
        <Small TextColor="TextColor.Secondary">
            @(_customer?.OrgDisplayName ?? Id)@(string.IsNullOrEmpty(_customer?.Domain) ? "" : $" · {_customer!.Domain}")
        </Small>
    </Div>
    <Button Type="ButtonType.Link" To="@($"/customers/{Id}")" Color="Color.Secondary" Outline>
        <Icon Name="@AppIcons.ArrowBack" Class="me-1" /> Back to customer
    </Button>
</Div>

<Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is5.FromBottom">
    Bring this customer's existing subscriptions into your reseller account. Pick the transferable
    SKUs and the Offer to transfer each onto, set the seats, then submit. Google provisions the
    transfer asynchronously.
</Paragraph>

@if (_loading)
{
    <LoadingPanel Title="Loading transferable SKUs…"
                  Hint="Inspecting the subscriptions this customer currently holds." />
}
else
{
    <Row>
        <Column ColumnSize="ColumnSize.Is12.Is7.OnDesktop">
            <Card Shadow="Shadow.Small">
                <CardHeader>
                    <CardTitle Size="HeadingSize.Is5" Margin="Margin.Is0">Transferable SKUs</CardTitle>
                    <Small TextColor="TextColor.Secondary">
                        Expand an eligible SKU to load its transferable offers and add it to the transfer.
                    </Small>
                </CardHeader>
                <CardBody>
                    @if (_skus is { Count: > 0 })
                    {
                        <Accordion>
                            @foreach (var sku in _skus)
                            {
                                <AccordionItem Visible="_expandedSkus.Contains(sku.SkuId ?? string.Empty)"
                                               VisibleChanged="expanded => OnSkuExpanded(sku, expanded)">
                                    <AccordionHeader>
                                        <Heading Size="HeadingSize.Is6" Margin="Margin.Is0">
                                            <AccordionToggle>
                                                <Div Flex="Flex.AlignItems.Center.JustifyContent.Between" Width="Width.Is100" Class="pe-3">
                                                    <Div>
                                                        <span>@(sku.SkuDisplayName ?? sku.SkuId)</span>
                                                        <Small TextColor="TextColor.Secondary" Display="Display.Block" Class="fw-normal">
                                                            @(sku.ProductDisplayName ?? sku.ProductId) · SKU @sku.SkuId
                                                        </Small>
                                                    </Div>
                                                    <Badge Color="@(sku.IsEligible ? Color.Success : Color.Warning)">
                                                        @(sku.IsEligible ? "Eligible" : "Not eligible")
                                                    </Badge>
                                                </Div>
                                            </AccordionToggle>
                                        </Heading>
                                    </AccordionHeader>
                                    <AccordionBody>
                                        @if (!sku.IsEligible)
                                        {
                                            <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is0">
                                                @(sku.EligibilityDescription ?? sku.IneligibilityReason ?? "This SKU can't be transferred.")
                                            </Paragraph>
                                        }
                                        else
                                        {
                                            <Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Margin="Margin.Is2.FromBottom">
                                                <Small TextColor="TextColor.Secondary">SKU id: @sku.SkuId</Small>
                                                <Button Type="ButtonType.Link" To="@($"/catalog/products?product={sku.ProductId}&sku={sku.SkuId}")"
                                                        Size="Size.Small" Color="Color.Primary" Class="btn-link text-decoration-none">
                                                    <Icon Name="@AppIcons.OpenInNew" Class="me-1" /> View in catalog
                                                </Button>
                                            </Div>

                                            @if (_offersBySku.TryGetValue(sku.SkuId ?? string.Empty, out var offers))
                                            {
                                                @if (offers is null)
                                                {
                                                    <Progress Indeterminate Color="Color.Primary" Size="Size.Small" Margin="Margin.Is2.OnY" />
                                                }
                                                else if (offers.Count == 0)
                                                {
                                                    <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is0">No transferable offers.</Paragraph>
                                                }
                                                else
                                                {
                                                    <Table Narrow Hoverable Margin="Margin.Is0">
                                                        <TableHeader>
                                                            <TableRow>
                                                                <TableHeaderCell>Offer</TableHeaderCell>
                                                                <TableHeaderCell TextAlignment="TextAlignment.End">Add</TableHeaderCell>
                                                            </TableRow>
                                                        </TableHeader>
                                                        <TableBody>
                                                            @foreach (var offer in offers)
                                                            {
                                                                <TableRow>
                                                                    <TableRowCell>@(offer.OfferDisplayName ?? offer.OfferId)</TableRowCell>
                                                                    <TableRowCell TextAlignment="TextAlignment.End">
                                                                        <Button Size="Size.Small" Color="Color.Primary"
                                                                                Disabled="@_basket.Any(b => b.OfferName == offer.OfferName)"
                                                                                Clicked="@(() => AddToBasket(sku, offer))">
                                                                            <Icon Name="@AppIcons.Add" Class="me-1" /> Add
                                                                        </Button>
                                                                    </TableRowCell>
                                                                </TableRow>
                                                            }
                                                        </TableBody>
                                                    </Table>
                                                }
                                            }
                                        }
                                    </AccordionBody>
                                </AccordionItem>
                            }
                        </Accordion>
                    }
                    else
                    {
                        <Alert Color="Color.Info" Visible Margin="Margin.Is0">
                            This customer has no transferable SKUs. Transfers are available only when the
                            customer already holds subscriptions (with Google directly or another reseller).
                        </Alert>
                    }
                </CardBody>
            </Card>
        </Column>

        <Column ColumnSize="ColumnSize.Is12.Is5.OnDesktop">
            <Card Shadow="Shadow.Small">
                <CardHeader>
                    <CardTitle Size="HeadingSize.Is5" Margin="Margin.Is0">Transfer</CardTitle>
                    <Small TextColor="TextColor.Secondary">Offers to transfer into this account.</Small>
                </CardHeader>
                <CardBody>
                    @if (_basket.Count == 0)
                    {
                        <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is0">
                            No offers selected yet. Add one or more from the transferable SKUs.
                        </Paragraph>
                    }
                    else
                    {
                        @foreach (var line in _basket)
                        {
                            <Div Margin="Margin.Is4.FromBottom">
                                <Div Flex="Flex.JustifyContent.Between.AlignItems.Center">
                                    <span>@line.OfferDisplay</span>
                                    <Button Size="Size.Small" Color="Color.Light" Clicked="@(() => _basket.Remove(line))" aria-label="Remove">
                                        <Icon Name="@AppIcons.Close" />
                                    </Button>
                                </Div>
                                <Small TextColor="TextColor.Secondary">@line.SkuDisplay</Small>
                                <Div Flex="Flex.Default" Gap="Gap.Is2" Margin="Margin.Is1.FromTop">
                                    <Field Margin="Margin.Is0" Style="max-width:120px">
                                        <FieldLabel>Seats</FieldLabel>
                                        <NumericPicker TValue="int" @bind-Value="line.Seats" Min="1" Size="Size.Small" />
                                    </Field>
                                    <Field Margin="Margin.Is0" Class="flex-grow-1">
                                        <FieldLabel>PO id (optional)</FieldLabel>
                                        <TextInput @bind-Value="line.PurchaseOrderId" Size="Size.Small" />
                                    </Field>
                                </Div>
                            </Div>
                        }

                        <Field Margin="Margin.Is2.FromTop">
                            <FieldLabel>Transfer auth token (optional)</FieldLabel>
                            <TextInput @bind-Value="_authToken" Size="Size.Small" />
                            <FieldHelp>Required only when transferring from another reseller.</FieldHelp>
                        </Field>
                    }
                </CardBody>
                <CardFooter Background="Background.Transparent">
                    <Button Color="Color.Primary" Disabled="@(_submitting || _basket.Count == 0)" Loading="_submitting" Clicked="SubmitAsync">
                        <Icon Name="@AppIcons.SwapHoriz" Class="me-1" /> @(_submitting ? "Submitting…" : "Transfer to my account")
                    </Button>
                </CardFooter>
            </Card>
        </Column>
    </Row>
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private Customer? _customer;
    private IReadOnlyList<TransferableSku>? _skus;
    private readonly Dictionary<string, IReadOnlyList<TransferableOffer>?> _offersBySku = [];
    private readonly HashSet<string> _expandedSkus = [];
    private readonly List<BasketLine> _basket = [];
    private string? _authToken;
    private bool _loading = true;
    private bool _submitting;

    // A selected offer to transfer, with its editable seats / purchase-order id.
    private sealed class BasketLine
    {
        public required string OfferName { get; init; }
        public required string OfferDisplay { get; init; }
        public required string SkuDisplay { get; init; }
        public int Seats { get; set; } = 1;
        public string? PurchaseOrderId { get; set; }
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _skus = null;
        _offersBySku.Clear();
        _expandedSkus.Clear();
        _basket.Clear();

        try
        {
            _customer = await Api.GetCustomerAsync(Id);
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load customer: {ex.Message}", Severity.Error);
            _customer = null;
        }

        try
        {
            var result = await Api.ListTransferableSkusAsync(Id);
            _skus = result?.Skus ?? [];
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load transferable SKUs: {ex.Message}", Severity.Error);
            _skus = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSkuExpanded(TransferableSku sku, bool expanded)
    {
        var skuId = sku.SkuId ?? string.Empty;
        if (expanded)
        {
            _expandedSkus.Add(skuId);
        }
        else
        {
            _expandedSkus.Remove(skuId);
        }

        if (!expanded || _offersBySku.ContainsKey(skuId) || string.IsNullOrEmpty(skuId))
        {
            return;
        }

        _offersBySku[skuId] = null;
        try
        {
            var result = await Api.ListTransferableOffersAsync(Id, sku.ProductId ?? string.Empty, skuId);
            _offersBySku[skuId] = result?.Offers ?? [];
        }
        catch (Exception ex)
        {
            _offersBySku.Remove(skuId);
            await Snackbar.Add($"Failed to load transferable offers: {ex.Message}", Severity.Error);
        }
    }

    private void AddToBasket(TransferableSku sku, TransferableOffer offer)
    {
        if (_basket.Any(b => b.OfferName == offer.OfferName))
        {
            return;
        }

        _basket.Add(new BasketLine
        {
            OfferName = offer.OfferName,
            OfferDisplay = offer.OfferDisplayName ?? offer.OfferId ?? offer.OfferName,
            SkuDisplay = $"{sku.ProductDisplayName ?? sku.ProductId} · {sku.SkuDisplayName ?? sku.SkuId}"
        });
    }

    private async Task SubmitAsync()
    {
        if (_basket.Count == 0)
        {
            return;
        }

        _submitting = true;
        try
        {
            var request = new TransferEntitlementsRequest
            {
                AuthToken = string.IsNullOrWhiteSpace(_authToken) ? null : _authToken,
                Entitlements = _basket
                    .Select(b => new TransferEntitlementLine
                    {
                        OfferId = b.OfferName,
                        PurchaseOrderId = string.IsNullOrWhiteSpace(b.PurchaseOrderId) ? null : b.PurchaseOrderId,
                        Parameters = [new EntitlementParameterInput { Name = "num_units", IntValue = b.Seats }]
                    })
                    .ToList()
            };

            var op = await Api.TransferEntitlementsAsync(Id, request);
            if (!string.IsNullOrEmpty(op?.Error))
            {
                await Snackbar.Add($"Transfer failed: {op!.Error}", Severity.Error);
                return;
            }

            await Snackbar.Add(op?.Done == true
                ? "Entitlements transferred."
                : "Transfer submitted — Google is processing it, this may take a moment.", Severity.Success);
            Nav.NavigateTo($"/customers/{Id}/entitlements");
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Transfer failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }
}

