@page "/customers/{Id}/transfer"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Transfer entitlements · GChannel</PageTitle>

<div class="d-flex justify-space-between align-center mb-2">
    <div>
        <MudText Typo="Typo.h4">Transfer entitlements</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @(_customer?.OrgDisplayName ?? Id)@(string.IsNullOrEmpty(_customer?.Domain) ? "" : $" · {_customer!.Domain}")
        </MudText>
    </div>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack"
               Href="@($"/customers/{Id}")">Back to customer</MudButton>
</div>

<MudText Typo="Typo.body1" Class="mb-6" Color="Color.Secondary">
    Bring this customer's existing subscriptions into your reseller account. Pick the transferable
    SKUs and the Offer to transfer each onto, set the seats, then submit. Google provisions the
    transfer asynchronously.
</MudText>

@if (_loading)
{
    <LoadingPanel Title="Loading transferable SKUs…"
                  Hint="Inspecting the subscriptions this customer currently holds." />
}
else
{
    <MudGrid>
        <MudItem xs="12" md="7">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Transferable SKUs</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Expand an eligible SKU to load its transferable offers and add it to the
                            transfer.
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (_skus is { Count: > 0 })
                    {
                        <MudExpansionPanels MultiExpansion="true" Elevation="0">
                            @foreach (var sku in _skus)
                            {
                                <MudExpansionPanel Expanded="_expandedSkus.Contains(sku.SkuId ?? string.Empty)"
                                                   ExpandedChanged="expanded => OnSkuExpanded(sku, expanded)"
                                                   Disabled="!sku.IsEligible">
                                    <TitleContent>
                                        <div class="d-flex align-center justify-space-between" style="width:100%">
                                            <div>
                                                <MudText Typo="Typo.body1">@(sku.SkuDisplayName ?? sku.SkuId)</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @(sku.ProductDisplayName ?? sku.ProductId) · SKU @sku.SkuId
                                                </MudText>
                                            </div>
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                                     Color="@(sku.IsEligible ? Color.Success : Color.Warning)">
                                                @(sku.IsEligible ? "Eligible" : "Not eligible")
                                            </MudChip>
                                        </div>
                                    </TitleContent>
                                    <ChildContent>
                                        @if (!sku.IsEligible)
                                        {
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                                @(sku.EligibilityDescription ?? sku.IneligibilityReason ?? "This SKU can't be transferred.")
                                            </MudText>
                                        }
                                        else
                                        {
                                            <div class="d-flex justify-space-between align-center mb-2">
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">SKU id: @sku.SkuId</MudText>
                                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                                           StartIcon="@Icons.Material.Filled.OpenInNew"
                                                           Href="@($"/catalog/products?product={sku.ProductId}&sku={sku.SkuId}")">
                                                    View in catalog
                                                </MudButton>
                                            </div>

                                            @if (_offersBySku.TryGetValue(sku.SkuId ?? string.Empty, out var offers))
                                            {
                                                @if (offers is null)
                                                {
                                                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-2" />
                                                }
                                                else if (offers.Count == 0)
                                                {
                                                    <MudText Typo="Typo.body2" Color="Color.Secondary">No transferable offers.</MudText>
                                                }
                                                else
                                                {
                                                    <MudTable Items="offers" Dense="true" Hover="true" Elevation="0">
                                                        <HeaderContent>
                                                            <MudTh>Offer</MudTh>
                                                            <MudTh Style="text-align:right">Add</MudTh>
                                                        </HeaderContent>
                                                        <RowTemplate>
                                                            <MudTd DataLabel="Offer">@(context.OfferDisplayName ?? context.OfferId)</MudTd>
                                                            <MudTd DataLabel="Add" Style="text-align:right">
                                                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                                                           StartIcon="@Icons.Material.Filled.Add"
                                                                           Disabled="@_basket.Any(b => b.OfferName == context.OfferName)"
                                                                           OnClick="@(() => AddToBasket(sku, context))">
                                                                    Add
                                                                </MudButton>
                                                            </MudTd>
                                                        </RowTemplate>
                                                    </MudTable>
                                                }
                                            }
                                        }
                                    </ChildContent>
                                </MudExpansionPanel>
                            }
                        </MudExpansionPanels>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">
                            This customer has no transferable SKUs. Transfers are available only when the
                            customer already holds subscriptions (with Google directly or another reseller).
                        </MudAlert>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="5">
            <MudCard Elevation="2">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Transfer</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Offers to transfer into this account.
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    @if (_basket.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            No offers selected yet. Add one or more from the transferable SKUs.
                        </MudText>
                    }
                    else
                    {
                        @foreach (var line in _basket)
                        {
                            <div class="mb-4">
                                <div class="d-flex justify-space-between align-center">
                                    <MudText Typo="Typo.body1">@line.OfferDisplay</MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                   OnClick="@(() => _basket.Remove(line))" />
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@line.SkuDisplay</MudText>
                                <div class="d-flex gap-2 mt-1">
                                    <MudNumericField T="int" @bind-Value="line.Seats" Label="Seats" Min="1"
                                                     Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:120px" />
                                    <MudTextField T="string" @bind-Value="line.PurchaseOrderId" Label="PO id (optional)"
                                                  Margin="Margin.Dense" Variant="Variant.Outlined" />
                                </div>
                            </div>
                        }

                        <MudTextField T="string" @bind-Value="_authToken" Label="Transfer auth token (optional)"
                                      HelperText="Required only when transferring from another reseller."
                                      Margin="Margin.Dense" Variant="Variant.Outlined" Class="mt-2" />
                    }
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SwapHoriz"
                               Disabled="@(_submitting || _basket.Count == 0)" OnClick="SubmitAsync">
                        @(_submitting ? "Submitting…" : "Transfer to my account")
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private Customer? _customer;
    private IReadOnlyList<TransferableSku>? _skus;
    private readonly Dictionary<string, IReadOnlyList<TransferableOffer>?> _offersBySku = [];
    private readonly HashSet<string> _expandedSkus = [];
    private readonly List<BasketLine> _basket = [];
    private string? _authToken;
    private bool _loading = true;
    private bool _submitting;

    // A selected offer to transfer, with its editable seats / purchase-order id.
    private sealed class BasketLine
    {
        public required string OfferName { get; init; }
        public required string OfferDisplay { get; init; }
        public required string SkuDisplay { get; init; }
        public int Seats { get; set; } = 1;
        public string? PurchaseOrderId { get; set; }
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _skus = null;
        _offersBySku.Clear();
        _expandedSkus.Clear();
        _basket.Clear();

        try
        {
            _customer = await Api.GetCustomerAsync(Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load customer: {ex.Message}", Severity.Error);
            _customer = null;
        }

        try
        {
            var result = await Api.ListTransferableSkusAsync(Id);
            _skus = result?.Skus ?? [];
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load transferable SKUs: {ex.Message}", Severity.Error);
            _skus = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSkuExpanded(TransferableSku sku, bool expanded)
    {
        var skuId = sku.SkuId ?? string.Empty;
        if (expanded)
        {
            _expandedSkus.Add(skuId);
        }
        else
        {
            _expandedSkus.Remove(skuId);
        }

        if (!expanded || _offersBySku.ContainsKey(skuId) || string.IsNullOrEmpty(skuId))
        {
            return;
        }

        _offersBySku[skuId] = null;
        try
        {
            var result = await Api.ListTransferableOffersAsync(Id, sku.ProductId ?? string.Empty, skuId);
            _offersBySku[skuId] = result?.Offers ?? [];
        }
        catch (Exception ex)
        {
            _offersBySku.Remove(skuId);
            Snackbar.Add($"Failed to load transferable offers: {ex.Message}", Severity.Error);
        }
    }

    private void AddToBasket(TransferableSku sku, TransferableOffer offer)
    {
        if (_basket.Any(b => b.OfferName == offer.OfferName))
        {
            return;
        }

        _basket.Add(new BasketLine
        {
            OfferName = offer.OfferName,
            OfferDisplay = offer.OfferDisplayName ?? offer.OfferId ?? offer.OfferName,
            SkuDisplay = $"{sku.ProductDisplayName ?? sku.ProductId} · {sku.SkuDisplayName ?? sku.SkuId}"
        });
    }

    private async Task SubmitAsync()
    {
        if (_basket.Count == 0)
        {
            return;
        }

        _submitting = true;
        try
        {
            var request = new TransferEntitlementsRequest
            {
                AuthToken = string.IsNullOrWhiteSpace(_authToken) ? null : _authToken,
                Entitlements = _basket
                    .Select(b => new TransferEntitlementLine
                    {
                        OfferId = b.OfferName,
                        PurchaseOrderId = string.IsNullOrWhiteSpace(b.PurchaseOrderId) ? null : b.PurchaseOrderId,
                        Parameters = [new EntitlementParameterInput { Name = "num_units", IntValue = b.Seats }]
                    })
                    .ToList()
            };

            var op = await Api.TransferEntitlementsAsync(Id, request);
            if (!string.IsNullOrEmpty(op?.Error))
            {
                Snackbar.Add($"Transfer failed: {op!.Error}", Severity.Error);
                return;
            }

            Snackbar.Add(op?.Done == true
                ? "Entitlements transferred."
                : "Transfer submitted — Google is processing it, this may take a moment.", Severity.Success);
            Nav.NavigateTo($"/customers/{Id}/entitlements");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Transfer failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }
}
