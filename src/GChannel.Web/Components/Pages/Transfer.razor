@page "/customers/{Id}/transfer"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject UiNotifier Snackbar
@inject NavigationManager Nav

<PageTitle>Transfer entitlements · GChannel</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap" class="rz-mb-2">
    <div>
        <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">Transfer entitlements</RadzenText>
        <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">
            @(_customer?.OrgDisplayName ?? Id)@(string.IsNullOrEmpty(_customer?.Domain) ? "" : $" · {_customer!.Domain}")
        </RadzenText>
    </div>
    <LinkButton To="@($"/customers/{Id}")" Text="Back to customer" Icon="@AppIcons.ArrowBack" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" />
</RadzenStack>

<RadzenText TextStyle="TextStyle.Body1" class="rz-text-secondary-color rz-mb-6">
    Bring this customer's existing subscriptions into your reseller account. Pick the transferable
    SKUs and the Offer to transfer each onto, set the seats, then submit. Google provisions the
    transfer asynchronously.
</RadzenText>

@if (_loading)
{
    <LoadingPanel Title="Loading transferable SKUs…"
                  Hint="Inspecting the subscriptions this customer currently holds." />
}
else
{
    <RadzenRow Gap="1rem" RowGap="1rem">
        <RadzenColumn Size="12" SizeLG="7">
            <RadzenCard Variant="Variant.Filled">
                <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">Transferable SKUs</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-mb-3">
                    Expand an eligible SKU to load its transferable offers and add it to the transfer.
                </RadzenText>
                @if (_skus is { Count: > 0 })
                {
                    <RadzenAccordion Multiple="true">
                        <Items>
                            @foreach (var sku in _skus)
                            {
                                <RadzenAccordionItem Selected="_expandedSkus.Contains(sku.SkuId ?? string.Empty)"
                                                     SelectedChanged="expanded => OnSkuExpanded(sku, expanded)">
                                    <Template>
                                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.75rem" Style="width:100%" class="rz-pe-3">
                                            <div>
                                                <span>@(sku.SkuDisplayName ?? sku.SkuId)</span>
                                                <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Div" class="rz-text-secondary-color rz-m-0" Style="font-weight:400">
                                                    @(sku.ProductDisplayName ?? sku.ProductId) · SKU @sku.SkuId
                                                </RadzenText>
                                            </div>
                                            <RadzenBadge BadgeStyle="@(sku.IsEligible ? BadgeStyle.Success : BadgeStyle.Warning)" Text="@(sku.IsEligible ? "Eligible" : "Not eligible")" />
                                        </RadzenStack>
                                    </Template>
                                    <ChildContent>
                                        @if (!sku.IsEligible)
                                        {
                                            <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-m-0">
                                                @(sku.EligibilityDescription ?? sku.IneligibilityReason ?? "This SKU can't be transferred.")
                                            </RadzenText>
                                        }
                                        else
                                        {
                                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="1rem" class="rz-mb-2">
                                                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">SKU id: @sku.SkuId</RadzenText>
                                                <LinkButton To="@($"/catalog/products?product={sku.ProductId}&sku={sku.SkuId}")" Text="View in catalog" Icon="@AppIcons.OpenInNew" Variant="Variant.Text" Size="ButtonSize.Small" />
                                            </RadzenStack>

                                            @if (_offersBySku.TryGetValue(sku.SkuId ?? string.Empty, out var offers))
                                            {
                                                @if (offers is null)
                                                {
                                                    <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" class="rz-my-2" />
                                                }
                                                else if (offers.Count == 0)
                                                {
                                                    <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-m-0">No transferable offers.</RadzenText>
                                                }
                                                else
                                                {
                                                    <table class="gchannel-table gchannel-table-hover">
                                                        <thead>
                                                            <tr>
                                                                <th>Offer</th>
                                                                <th class="num">Add</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var offer in offers)
                                                            {
                                                                <tr>
                                                                    <td>@(offer.OfferDisplayName ?? offer.OfferId)</td>
                                                                    <td class="num">
                                                                        <RadzenButton Text="Add" Icon="@AppIcons.Add" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary"
                                                                                      Disabled="@_basket.Any(b => b.OfferName == offer.OfferName)"
                                                                                      Click="@(() => AddToBasket(sku, offer))" />
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                }
                                            }
                                        }
                                    </ChildContent>
                                </RadzenAccordionItem>
                            }
                        </Items>
                    </RadzenAccordion>
                }
                else
                {
                    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-m-0">
                        This customer has no transferable SKUs. Transfers are available only when the
                        customer already holds subscriptions (with Google directly or another reseller).
                    </RadzenAlert>
                }
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeLG="5">
            <RadzenCard Variant="Variant.Filled">
                <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">Transfer</RadzenText>
                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-mb-3">Offers to transfer into this account.</RadzenText>
                @if (_basket.Count == 0)
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-mb-3">
                        No offers selected yet. Add one or more from the transferable SKUs.
                    </RadzenText>
                }
                else
                {
                    @foreach (var line in _basket)
                    {
                        <div class="rz-mb-4">
                            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <span>@line.OfferDisplay</span>
                                <RadzenButton Icon="@AppIcons.Close" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Click="@(() => _basket.Remove(line))" aria-label="Remove" />
                            </RadzenStack>
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">@line.SkuDisplay</RadzenText>
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" class="rz-mt-2">
                                <RadzenFormField Text="Seats" Variant="Variant.Outlined" Style="max-width:120px">
                                    <RadzenNumeric TValue="int" @bind-Value="line.Seats" Min="1" Name="@($"seats-{line.OfferName}")" />
                                </RadzenFormField>
                                <RadzenFormField Text="PO id (optional)" Variant="Variant.Outlined" Style="flex: 1 1 auto">
                                    <RadzenTextBox @bind-Value="line.PurchaseOrderId" Name="@($"po-{line.OfferName}")" />
                                </RadzenFormField>
                            </RadzenStack>
                        </div>
                    }

                    <RadzenFormField Text="Transfer auth token (optional)" Variant="Variant.Outlined" Style="width:100%" class="rz-mt-2 rz-mb-3">
                        <ChildContent><RadzenTextBox @bind-Value="_authToken" Name="authToken" /></ChildContent>
                        <Helper><RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">Required only when transferring from another reseller.</RadzenText></Helper>
                    </RadzenFormField>
                }
                <RadzenButton Text="Transfer to my account" Icon="@AppIcons.SwapHoriz" ButtonStyle="ButtonStyle.Primary" Disabled="@(_basket.Count == 0)" IsBusy="_submitting" BusyText="Submitting…" Click="SubmitAsync" />
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private Customer? _customer;
    private IReadOnlyList<TransferableSku>? _skus;
    private readonly Dictionary<string, IReadOnlyList<TransferableOffer>?> _offersBySku = [];
    private readonly HashSet<string> _expandedSkus = [];
    private readonly List<BasketLine> _basket = [];
    private string? _authToken;
    private bool _loading = true;
    private bool _submitting;

    // A selected offer to transfer, with its editable seats / purchase-order id.
    private sealed class BasketLine
    {
        public required string OfferName { get; init; }
        public required string OfferDisplay { get; init; }
        public required string SkuDisplay { get; init; }
        public int Seats { get; set; } = 1;
        public string? PurchaseOrderId { get; set; }
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _skus = null;
        _offersBySku.Clear();
        _expandedSkus.Clear();
        _basket.Clear();

        try
        {
            _customer = await Api.GetCustomerAsync(Id);
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load customer: {ex.Message}", Severity.Error);
            _customer = null;
        }

        try
        {
            var result = await Api.ListTransferableSkusAsync(Id);
            _skus = result?.Skus ?? [];
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load transferable SKUs: {ex.Message}", Severity.Error);
            _skus = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSkuExpanded(TransferableSku sku, bool expanded)
    {
        var skuId = sku.SkuId ?? string.Empty;
        if (expanded)
        {
            _expandedSkus.Add(skuId);
        }
        else
        {
            _expandedSkus.Remove(skuId);
        }

        if (!expanded || _offersBySku.ContainsKey(skuId) || string.IsNullOrEmpty(skuId))
        {
            return;
        }

        _offersBySku[skuId] = null;
        try
        {
            var result = await Api.ListTransferableOffersAsync(Id, sku.ProductId ?? string.Empty, skuId);
            _offersBySku[skuId] = result?.Offers ?? [];
        }
        catch (Exception ex)
        {
            _offersBySku.Remove(skuId);
            await Snackbar.Add($"Failed to load transferable offers: {ex.Message}", Severity.Error);
        }
    }

    private void AddToBasket(TransferableSku sku, TransferableOffer offer)
    {
        if (_basket.Any(b => b.OfferName == offer.OfferName))
        {
            return;
        }

        _basket.Add(new BasketLine
        {
            OfferName = offer.OfferName,
            OfferDisplay = offer.OfferDisplayName ?? offer.OfferId ?? offer.OfferName,
            SkuDisplay = $"{sku.ProductDisplayName ?? sku.ProductId} · {sku.SkuDisplayName ?? sku.SkuId}"
        });
    }

    private async Task SubmitAsync()
    {
        if (_basket.Count == 0)
        {
            return;
        }

        _submitting = true;
        try
        {
            var request = new TransferEntitlementsRequest
            {
                AuthToken = string.IsNullOrWhiteSpace(_authToken) ? null : _authToken,
                Entitlements = _basket
                    .Select(b => new TransferEntitlementLine
                    {
                        OfferId = b.OfferName,
                        PurchaseOrderId = string.IsNullOrWhiteSpace(b.PurchaseOrderId) ? null : b.PurchaseOrderId,
                        Parameters = [new EntitlementParameterInput { Name = "num_units", IntValue = b.Seats }]
                    })
                    .ToList()
            };

            var op = await Api.TransferEntitlementsAsync(Id, request);
            if (!string.IsNullOrEmpty(op?.Error))
            {
                await Snackbar.Add($"Transfer failed: {op!.Error}", Severity.Error);
                return;
            }

            await Snackbar.Add(op?.Done == true
                ? "Entitlements transferred."
                : "Transfer submitted — Google is processing it, this may take a moment.", Severity.Success);
            Nav.NavigateTo($"/customers/{Id}/entitlements");
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Transfer failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }
}

