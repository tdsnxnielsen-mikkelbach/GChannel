@page "/entitlements"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject UiNotifier Snackbar
@inject NavigationManager Nav

<PageTitle>Entitlements · GChannel</PageTitle>

<RadzenText TextStyle="TextStyle.H4" class="rz-mb-4">Entitlements</RadzenText>

<RadzenText TextStyle="TextStyle.Body1" class="rz-text-secondary-color rz-mb-4">
    Estate-wide subscriptions from the synced read-model. Filter by lifecycle state to see the
    entitlements behind the dashboard KPIs. Paging, sorting and search run server-side.
</RadzenText>

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="0.75rem" Wrap="FlexWrap.Wrap" class="rz-mb-2">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" Wrap="FlexWrap.Wrap">
        <RadzenDropDown TValue="string" Data="_stateOptions" ValueProperty="@nameof(SelectOption.Value)" TextProperty="@nameof(SelectOption.Text)"
                        Value="@_state" ValueChanged="OnStateChanged" Style="min-width:150px" aria-label="State" Name="state" />
        <RadzenDropDown TValue="string" Data="_scopeOptions" ValueProperty="@nameof(SelectOption.Value)" TextProperty="@nameof(SelectOption.Text)"
                        Value="@_scope" ValueChanged="OnScopeChanged" Style="min-width:170px" aria-label="Scope" Name="scope" />
        <SearchBox Value="@_search" ValueChanged="OnSearchChanged" Label="Search customer, offer, id…" Style="width: 100%; min-width: 280px" />
    </RadzenStack>
    <AsOfBadge AsOf="_asOf" />
</RadzenStack>

<RadzenCard Variant="Variant.Filled">
    <RadzenDataGrid @ref="_grid" TItem="EstateEntitlement" Data="_items" Count="_total" LoadData="OnLoadData" IsLoading="_loading"
                    AllowPaging="true" PageSize="25" PageSizeOptions="_pageSizes" ShowPagingSummary="true"
                    AllowSorting="true" Density="Density.Compact" GridLines="DataGridGridLines.Horizontal" Responsive="true">
        <Columns>
            <RadzenDataGridColumn TItem="EstateEntitlement" Property="@nameof(EstateEntitlement.CustomerName)" SortProperty="customer" Title="Customer">
                <Template Context="e">
                    <RadzenLink Path="@($"/customers/{e.CustomerId}")" Text="@(e.CustomerName ?? e.CustomerId)" />
                    @if (!string.IsNullOrEmpty(e.OwningLinkId))
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Light" Text="Reseller" class="rz-ms-1" />
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="EstateEntitlement" Property="@nameof(EstateEntitlement.OfferName)" SortProperty="product" Title="Product / offer">
                <Template Context="e">
                    <div>@(e.OfferName ?? e.SkuName ?? "—")</div>
                    @if (!string.IsNullOrEmpty(e.ProductName))
                    {
                        <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Div" class="rz-text-secondary-color rz-m-0">@e.ProductName</RadzenText>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="EstateEntitlement" Property="@nameof(EstateEntitlement.State)" SortProperty="state" Title="State" Width="120px">
                <Template Context="e">
                    <RadzenBadge BadgeStyle="@StateColor(e)" Text="@StateLabel(e)" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="EstateEntitlement" Property="@nameof(EstateEntitlement.Seats)" SortProperty="seats" Title="Seats" TextAlign="TextAlign.End" Width="90px" />
            <RadzenDataGridColumn TItem="EstateEntitlement" Title="Est. monthly" Sortable="false" TextAlign="TextAlign.End">
                <Template Context="e">
                    @if (EstimatedMonthly(e) is { } v)
                    {
                        <Tip Text="@($"Wholesale {FormatMoney(e.UnitPrice * e.BillableSeats, e.Currency)} × (1 + {e.RepricingPercent:0.##}% markup). Estimated from offer list pricing — not invoiced.")">@FormatMoney(v, e.Currency)</Tip>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="EstateEntitlement" Property="@nameof(EstateEntitlement.CommitmentEndTime)" SortProperty="renewal" Title="Renewal" Width="130px">
                <Template Context="e">
                    @(e.CommitmentEndTime?.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture) ?? "—")
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="EstateEntitlement" Title="Actions" Sortable="false" TextAlign="TextAlign.End" Width="90px">
                <Template Context="e">
                    <Tip Text="View entitlement">
                        <LinkButton To="@($"/customers/{e.CustomerId}/entitlements/{e.EntitlementId}")" Icon="@AppIcons.Visibility" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Title="View entitlement" />
                    </Tip>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
        <EmptyTemplate>
            @if (_loading)
            {
                <LoadingPanel Title="Loading entitlements…" Hint="Querying the synced read-model." />
            }
            else
            {
                <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-m-3">No entitlements match the current filters.</RadzenAlert>
            }
        </EmptyTemplate>
    </RadzenDataGrid>
</RadzenCard>

@code {
    [SupplyParameterFromQuery(Name = "state")]
    public string? StateQuery { get; set; }

    [SupplyParameterFromQuery(Name = "scope")]
    public string? ScopeQuery { get; set; }

    private static readonly IEnumerable<int> _pageSizes = [25, 50, 100];
    private static readonly SelectOption[] _stateOptions =
    [
        new("", "All states"),
        new("active", "Active"),
        new("trial", "Trial"),
        new("suspended", "Suspended"),
    ];
    private static readonly SelectOption[] _scopeOptions =
    [
        new("direct", "Direct"),
        new("indirect", "Indirect (resellers)"),
        new("all", "All"),
    ];

    private RadzenDataGrid<EstateEntitlement>? _grid;
    private List<EstateEntitlement> _items = [];
    private int _total;
    private bool _loading = true;
    private string _state = "";
    private string _scope = "direct";
    private string? _search;
    private DateTimeOffset? _asOf;

    protected override void OnParametersSet()
    {
        var state = NormalizeState(StateQuery);
        var scope = NormalizeScope(ScopeQuery);
        if (state != _state || scope != _scope)
        {
            _state = state;
            _scope = scope;
            _ = _grid?.FirstPage(true);
        }
    }

    private static string NormalizeState(string? s) => (s ?? "").ToLowerInvariant() switch
    {
        "active" => "active",
        "trial" => "trial",
        "suspended" => "suspended",
        _ => "",
    };

    private static string NormalizeScope(string? s) => (s ?? "").ToLowerInvariant() switch
    {
        "indirect" => "indirect",
        "all" => "all",
        _ => "direct",
    };

    private async Task OnStateChanged(string value)
    {
        _state = value ?? "";
        await ReloadFirstPageAsync();
    }

    private async Task OnScopeChanged(string value)
    {
        _scope = string.IsNullOrEmpty(value) ? "direct" : value;
        await ReloadFirstPageAsync();
    }

    private async Task OnSearchChanged(string? value)
    {
        _search = value;
        await ReloadFirstPageAsync();
    }

    private Task ReloadFirstPageAsync() => _grid?.FirstPage(true) ?? Task.CompletedTask;

    // Server-side read: Radzen gives Skip/Top, the API takes a 0-based page; sort keys come from SortProperty.
    private async Task OnLoadData(LoadDataArgs args)
    {
        _loading = true;
        var pageSize = args.Top ?? 25;
        var page = pageSize == 0 ? 0 : (args.Skip ?? 0) / pageSize;
        var sort = args.Sorts?.FirstOrDefault();
        try
        {
            var result = await Api.ListEstateEntitlementsAsync(
                page, pageSize, sort?.Property,
                sort?.SortOrder == SortOrder.Descending,
                _search, string.IsNullOrEmpty(_state) ? null : _state,
                _scope, CancellationToken.None);

            _items = result?.Items?.ToList() ?? [];
            _total = result?.Total ?? 0;
            _asOf = result?.AsOf;
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load entitlements: {ex.Message}", Severity.Error);
            _items = [];
            _total = 0;
        }
        finally
        {
            _loading = false;
        }
    }

    private static decimal? EstimatedMonthly(EstateEntitlement e)
    {
        if (e.UnitPrice <= 0 || e.BillableSeats <= 0) return null;
        return e.UnitPrice * e.BillableSeats * (1 + (e.RepricingPercent / 100m));
    }

    private static string StateLabel(EstateEntitlement e)
    {
        if (e.IsTrial) return "Trial";
        return string.IsNullOrEmpty(e.State)
            ? "Unknown"
            : char.ToUpperInvariant(e.State[0]) + e.State[1..].ToLowerInvariant();
    }

    private static BadgeStyle StateColor(EstateEntitlement e)
    {
        if (e.IsTrial) return BadgeStyle.Info;
        return e.State?.ToUpperInvariant() switch
        {
            "ACTIVE" => BadgeStyle.Success,
            "SUSPENDED" => BadgeStyle.Warning,
            "CANCELLED" or "CANCELED" => BadgeStyle.Danger,
            "PENDING" => BadgeStyle.Info,
            _ => BadgeStyle.Light,
        };
    }

    private static string FormatMoney(decimal value, string? currency) =>
        string.IsNullOrEmpty(currency)
            ? value.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)
            : $"{currency} {value.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)}";
}
