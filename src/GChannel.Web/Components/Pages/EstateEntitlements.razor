@page "/entitlements"
@attribute [Authorize]
@using Blazorise
@using Blazorise.DataGrid
@inject GChannelApiClient Api
@inject UiNotifier Snackbar
@inject NavigationManager Nav

<PageTitle>Entitlements · GChannel</PageTitle>

<Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Margin="Margin.Is4.FromBottom">
    <Heading Size="HeadingSize.Is3" Margin="Margin.Is0">Entitlements</Heading>
</Div>

<Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is4.FromBottom">
    Estate-wide subscriptions from the synced read-model. Filter by lifecycle state to see the
    entitlements behind the dashboard KPIs. Paging, sorting and search run server-side.
</Paragraph>

<Div Flex="Flex.Wrap.JustifyContent.Between.AlignItems.Center" Gap="Gap.Is3" Margin="Margin.Is2.FromBottom">
    <Div Flex="Flex.Wrap.AlignItems.Center" Gap="Gap.Is3">
        <Select TValue="string" Value="@_state" ValueChanged="OnStateChanged" Style="min-width:150px" aria-label="State">
            <SelectItem TValue="string" Value="@("")">All states</SelectItem>
            <SelectItem TValue="string" Value="@("active")">Active</SelectItem>
            <SelectItem TValue="string" Value="@("trial")">Trial</SelectItem>
            <SelectItem TValue="string" Value="@("suspended")">Suspended</SelectItem>
        </Select>
        <Select TValue="string" Value="@_scope" ValueChanged="OnScopeChanged" Style="min-width:150px" aria-label="Scope">
            <SelectItem TValue="string" Value="@("direct")">Direct</SelectItem>
            <SelectItem TValue="string" Value="@("indirect")">Indirect (resellers)</SelectItem>
            <SelectItem TValue="string" Value="@("all")">All</SelectItem>
        </Select>
        <Addons Style="min-width:280px">
            <Addon AddonType="AddonType.Start"><AddonLabel><Icon Name="@AppIcons.Search" /></AddonLabel></Addon>
            <Addon AddonType="AddonType.Body">
                <TextInput Value="@_search" ValueChanged="OnSearchChanged" Debounce="true" DebounceInterval="400"
                           Placeholder="Search customer, offer, id…" />
            </Addon>
        </Addons>
    </Div>
    <AsOfBadge AsOf="_asOf" />
</Div>

<Card Shadow="Shadow.Small">
    <DataGrid @ref="_grid" TItem="EstateEntitlement" Data="_items" ReadData="OnReadData" TotalItems="_total"
              ShowPager ShowPageSizes PageSize="25" PageSizes="_pageSizes" Hoverable Responsive Sortable SortMode="DataGridSortMode.Single">
        <DataGridColumns>
            <DataGridColumn TItem="EstateEntitlement" Field="@nameof(EstateEntitlement.CustomerName)" SortField="customer" Caption="Customer">
                <DisplayTemplate>
                    <Anchor To="@($"/customers/{context.Item.CustomerId}")">@(context.Item.CustomerName ?? context.Item.CustomerId)</Anchor>
                    @if (!string.IsNullOrEmpty(context.Item.OwningLinkId))
                    {
                        <Badge Color="Color.Secondary" Margin="Margin.Is1.FromStart">Reseller</Badge>
                    }
                </DisplayTemplate>
            </DataGridColumn>
            <DataGridColumn TItem="EstateEntitlement" Field="@nameof(EstateEntitlement.OfferName)" SortField="product" Caption="Product / offer">
                <DisplayTemplate>
                    <div>@(context.Item.OfferName ?? context.Item.SkuName ?? "—")</div>
                    @if (!string.IsNullOrEmpty(context.Item.ProductName))
                    {
                        <Small TextColor="TextColor.Secondary">@context.Item.ProductName</Small>
                    }
                </DisplayTemplate>
            </DataGridColumn>
            <DataGridColumn TItem="EstateEntitlement" Field="@nameof(EstateEntitlement.State)" SortField="state" Caption="State">
                <DisplayTemplate>
                    <Badge Color="@StateColor(context.Item)">@StateLabel(context.Item)</Badge>
                </DisplayTemplate>
            </DataGridColumn>
            <DataGridColumn TItem="EstateEntitlement" Field="@nameof(EstateEntitlement.Seats)" SortField="seats" Caption="Seats" TextAlignment="TextAlignment.End" HeaderTextAlignment="TextAlignment.End" />
            <DataGridColumn TItem="EstateEntitlement" Field="@nameof(EstateEntitlement.UnitPrice)" Caption="Est. monthly" Sortable="false" TextAlignment="TextAlignment.End" HeaderTextAlignment="TextAlignment.End">
                <DisplayTemplate>
                    @if (EstimatedMonthly(context.Item) is { } v)
                    {
                        <Tooltip Text="@($"Wholesale {FormatMoney(context.Item.UnitPrice * context.Item.BillableSeats, context.Item.Currency)} × (1 + {context.Item.RepricingPercent:0.##}% markup). Estimated from offer list pricing — not invoiced.")" Multiline Inline>
                            <span>@FormatMoney(v, context.Item.Currency)</span>
                        </Tooltip>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </DisplayTemplate>
            </DataGridColumn>
            <DataGridColumn TItem="EstateEntitlement" Field="@nameof(EstateEntitlement.CommitmentEndTime)" SortField="renewal" Caption="Renewal">
                <DisplayTemplate>
                    @(context.Item.CommitmentEndTime?.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture) ?? "—")
                </DisplayTemplate>
            </DataGridColumn>
            <DataGridColumn TItem="EstateEntitlement" Field="@nameof(EstateEntitlement.EntitlementId)" Caption="Actions" Sortable="false" TextAlignment="TextAlignment.End" HeaderTextAlignment="TextAlignment.End">
                <DisplayTemplate>
                    <Tooltip Text="View entitlement" Inline>
                        <Button Type="ButtonType.Link" To="@($"/customers/{context.Item.CustomerId}/entitlements/{context.Item.EntitlementId}")"
                                Size="Size.Small" Color="Color.Light" aria-label="View entitlement">
                            <Icon Name="@AppIcons.Visibility" />
                        </Button>
                    </Tooltip>
                </DisplayTemplate>
            </DataGridColumn>
        </DataGridColumns>
        <EmptyTemplate>
            <Alert Color="Color.Info" Visible Margin="Margin.Is0">No entitlements match the current filters.</Alert>
        </EmptyTemplate>
        <LoadingTemplate>
            <LoadingPanel Title="Loading entitlements…" Hint="Querying the synced read-model." />
        </LoadingTemplate>
    </DataGrid>
</Card>

@code {
    [SupplyParameterFromQuery(Name = "state")]
    public string? StateQuery { get; set; }

    [SupplyParameterFromQuery(Name = "scope")]
    public string? ScopeQuery { get; set; }

    private static readonly int[] _pageSizes = [25, 50, 100];
    private DataGrid<EstateEntitlement>? _grid;
    private List<EstateEntitlement> _items = [];
    private int _total;
    private string _state = "";
    private string _scope = "direct";
    private string? _search;
    private DateTimeOffset? _asOf;

    protected override void OnParametersSet()
    {
        var state = NormalizeState(StateQuery);
        var scope = NormalizeScope(ScopeQuery);
        if (state != _state || scope != _scope)
        {
            _state = state;
            _scope = scope;
            _ = _grid?.Reload();
        }
    }

    private static string NormalizeState(string? s) => (s ?? "").ToLowerInvariant() switch
    {
        "active" => "active",
        "trial" => "trial",
        "suspended" => "suspended",
        _ => "",
    };

    private static string NormalizeScope(string? s) => (s ?? "").ToLowerInvariant() switch
    {
        "indirect" => "indirect",
        "all" => "all",
        _ => "direct",
    };

    private async Task OnStateChanged(string value)
    {
        _state = value ?? "";
        await (_grid?.Reload() ?? Task.CompletedTask);
    }

    private async Task OnScopeChanged(string value)
    {
        _scope = string.IsNullOrEmpty(value) ? "direct" : value;
        await (_grid?.Reload() ?? Task.CompletedTask);
    }

    private async Task OnSearchChanged(string value)
    {
        _search = value;
        await (_grid?.Reload() ?? Task.CompletedTask);
    }

    // Server-side read: Blazorise pages are 1-based, the API's are 0-based; sort keys come from SortField.
    private async Task OnReadData(DataGridReadDataEventArgs<EstateEntitlement> e)
    {
        if (e.CancellationToken.IsCancellationRequested)
        {
            return;
        }

        var sortColumn = e.Columns.FirstOrDefault(c => c.SortDirection != SortDirection.Default);
        try
        {
            var result = await Api.ListEstateEntitlementsAsync(
                e.Page - 1, e.PageSize, sortColumn?.SortField,
                sortColumn?.SortDirection == SortDirection.Descending,
                _search, string.IsNullOrEmpty(_state) ? null : _state,
                _scope, e.CancellationToken);

            _items = result?.Items?.ToList() ?? [];
            _total = result?.Total ?? 0;
            _asOf = result?.AsOf;
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load entitlements: {ex.Message}", Severity.Error);
            _items = [];
            _total = 0;
        }
    }

    private static decimal? EstimatedMonthly(EstateEntitlement e)
    {
        if (e.UnitPrice <= 0 || e.BillableSeats <= 0) return null;
        return e.UnitPrice * e.BillableSeats * (1 + (e.RepricingPercent / 100m));
    }

    private static string StateLabel(EstateEntitlement e)
    {
        if (e.IsTrial) return "Trial";
        return string.IsNullOrEmpty(e.State)
            ? "Unknown"
            : char.ToUpperInvariant(e.State[0]) + e.State[1..].ToLowerInvariant();
    }

    private static Color StateColor(EstateEntitlement e)
    {
        if (e.IsTrial) return Color.Info;
        return e.State?.ToUpperInvariant() switch
        {
            "ACTIVE" => Color.Success,
            "SUSPENDED" => Color.Warning,
            "CANCELLED" or "CANCELED" => Color.Danger,
            "PENDING" => Color.Info,
            _ => Color.Secondary,
        };
    }

    private static string FormatMoney(decimal value, string? currency) =>
        string.IsNullOrEmpty(currency)
            ? value.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)
            : $"{currency} {value.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)}";
}
