@page "/customers/{CustomerId}/entitlements/{Id}"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject UiNotifier Snackbar

<PageTitle>Entitlement · GChannel</PageTitle>

@if (_loading)
{
    <LoadingPanel Title="Loading entitlement…"
                  Hint="Fetching the entitlement and its change history." />
}
else if (_entitlement is null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">Entitlement not found.</RadzenAlert>
    <LinkButton To="@($"/customers/{CustomerId}/entitlements")" Text="Back to entitlements" Icon="@AppIcons.ArrowBack" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Class="rz-mt-4" />
}
else
{
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap" class="rz-mb-4">
        <div>
            <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">@(_entitlement.SkuDisplayName ?? _entitlement.OfferDisplayName ?? _entitlement.OfferId ?? _entitlement.Id)</RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mt-1">
                <RadzenBadge BadgeStyle="@StateColor(_entitlement.ProvisioningState)" Text="@(_entitlement.ProvisioningState ?? "—")" />
                @if (_entitlement.IsTrial)
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="Trial" />
                }
            </RadzenStack>
        </div>
        <LinkButton To="@($"/customers/{CustomerId}/entitlements")" Text="Entitlements" Icon="@AppIcons.ArrowBack" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" />
    </RadzenStack>

    <RadzenRow Gap="1rem" RowGap="1rem">
        <RadzenColumn Size="12" SizeLG="6">
            <RadzenCard Variant="Variant.Filled" class="rz-mb-4">
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">Details</RadzenText>
                <RadzenStack Gap="0.5rem">
                    <DetailRow Label="Entitlement id">@_entitlement.Id</DetailRow>
                    <DetailRow Label="Offer">
                        @if (!string.IsNullOrEmpty(_entitlement.SkuId))
                        {
                            <RadzenLink Path="@($"/catalog/offers?sku={_entitlement.SkuId}")" Text="@(_entitlement.OfferDisplayName ?? _entitlement.OfferId ?? "—")" />
                        }
                        else { <span>@(_entitlement.OfferDisplayName ?? _entitlement.OfferId ?? "—")</span> }
                        @if (!string.IsNullOrEmpty(_entitlement.OfferId) && !string.IsNullOrEmpty(_entitlement.OfferDisplayName))
                        {
                            <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Div" class="rz-text-secondary-color rz-m-0">@_entitlement.OfferId</RadzenText>
                        }
                    </DetailRow>
                    <DetailRow Label="Product / SKU">
                        @if (!string.IsNullOrEmpty(_entitlement.ProductId))
                        {
                            <RadzenLink Path="@($"/catalog/products?product={_entitlement.ProductId}&sku={_entitlement.SkuId}")"
                                        Text="@($"{_entitlement.ProductDisplayName ?? _entitlement.ProductId} / {_entitlement.SkuDisplayName ?? _entitlement.SkuId}")" />
                            <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Div" class="rz-text-secondary-color rz-m-0">@(_entitlement.ProductId) / @(_entitlement.SkuId)</RadzenText>
                        }
                        else { <span>—</span> }
                    </DetailRow>
                    <DetailRow Label="Seats">@(Seats(_entitlement) ?? "—")</DetailRow>
                    <DetailRow Label="Purchase order">@(_entitlement.PurchaseOrderId ?? "—")</DetailRow>
                    <DetailRow Label="Billing account">
                        @if (!string.IsNullOrEmpty(_entitlement.BillingAccount))
                        {
                            <span>@(BillingAccountId ?? _entitlement.BillingAccount)</span>
                            <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Div" class="rz-text-secondary-color rz-m-0">@_entitlement.BillingAccount</RadzenText>
                        }
                        else { <span>—</span> }
                    </DetailRow>
                    <DetailRow Label="Created">@(_entitlement.CreateTime?.ToString("u") ?? "—")</DetailRow>
                    <DetailRow Label="Updated">@(_entitlement.UpdateTime?.ToString("u") ?? "—")</DetailRow>
                    @if (_entitlement.IsTrial && _entitlement.TrialEndTime is not null)
                    {
                        <DetailRow Label="Trial ends">@_entitlement.TrialEndTime.Value.ToString("u")</DetailRow>
                    }
                    @if (_entitlement.SuspensionReasons.Count > 0)
                    {
                        <DetailRow Label="Suspension reasons">@string.Join(", ", _entitlement.SuspensionReasons)</DetailRow>
                    }
                </RadzenStack>
            </RadzenCard>

            <RadzenCard Variant="Variant.Filled" class="rz-mb-4">
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">Commitment &amp; renewal</RadzenText>
                <RadzenStack Gap="0.5rem" class="rz-mb-3">
                    <DetailRow Label="Payment plan">@(_entitlement.Commitment?.PaymentPlan ?? "—")</DetailRow>
                    <DetailRow Label="Commitment start">@(_entitlement.Commitment?.StartTime?.ToString("u") ?? "—")</DetailRow>
                    <DetailRow Label="Commitment end">@(_entitlement.Commitment?.EndTime?.ToString("u") ?? "—")</DetailRow>
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenSwitch @bind-Value="_renewalEnabled" Name="renewal" />
                        <RadzenLabel Text="Auto-renew" Component="renewal" />
                    </RadzenStack>
                    <RadzenButton Text="Save renewal" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Disabled="_busy" Click="SaveRenewalAsync" />
                </RadzenStack>
            </RadzenCard>

            <RadzenCard Variant="Variant.Filled" class="rz-mb-4">
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">Licenses</RadzenText>
                <RadzenStack Gap="0.5rem" class="rz-mb-2">
                    <DetailRow Label="Total licenses">@SeatCount</DetailRow>
                    <DetailRow Label="Assigned">
                        <Tip Text="Assigned-seat counts aren't exposed by the Channel API — they live in each customer's own Workspace tenant (Enterprise License Manager / Admin SDK), which needs per-customer authorization.">
                            <span>— <span class="rz-text-secondary-color">(not available)</span></span>
                        </Tip>
                    </DetailRow>
                </RadzenStack>
                <LinkButton To="#modify" Text="Manage licenses" Icon="@AppIcons.Tune" Variant="Variant.Text" Size="ButtonSize.Small" />
            </RadzenCard>

            <RadzenCard Variant="Variant.Filled" class="rz-mb-4">
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">Payment &amp; pricing (estimated)</RadzenText>
                @if (_pricingLoading)
                {
                    <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" class="rz-my-2" />
                }
                else if (SeatPrice is { } seat)
                {
                    <RadzenStack Gap="0.5rem" class="rz-mb-2">
                        <DetailRow Label="Billing cycle">@(string.IsNullOrEmpty(_offerCycle) ? "—" : _offerCycle)</DetailRow>
                        <DetailRow Label="Wholesale / seat">@seat.Display@(string.IsNullOrEmpty(_offerCycle) ? "" : $" · {_offerCycle.ToLowerInvariant()}")</DetailRow>
                        <DetailRow Label="Seats">@SeatCount</DetailRow>
                        <DetailRow Label="Wholesale total">@($"{seat.CurrencyCode} {WholesaleTotal:0.00}")</DetailRow>
                        @if (_entitlement.IonCostPerSeat is { } ionCost)
                        {
                            <DetailRow Label="Ion cost / seat (actual)">@($"{_entitlement.IonCurrency ?? seat.CurrencyCode} {ionCost:0.00}")</DetailRow>
                            @if (_entitlement.IonMarginPercent is { } ionMp)
                            {
                                <DetailRow Label="Ion margin">@ionMp.ToString("0.0")%</DetailRow>
                            }
                        }
                        @if (_repricingPercent is { } pct)
                        {
                            <DetailRow Label="Repricing">@(pct >= 0 ? "+" : "")@pct.ToString("0.##")%</DetailRow>
                            <DetailRow Label="Computed price">@($"{seat.CurrencyCode} {ComputedTotal:0.00}")</DetailRow>
                            <DetailRow Label="Est. margin">@($"{seat.CurrencyCode} {(ComputedTotal - WholesaleTotal):0.00}")</DetailRow>
                        }
                        <DetailRow Label="Estimated / month">@($"{seat.CurrencyCode} {ComputedMonthly:0.00}")@(MonthsInCycle() > 1 ? $" (≈ {seat.CurrencyCode} {ComputedTotal:0.00} ÷ {MonthsInCycle()} mo)" : "")</DetailRow>
                        <DetailRow Label="Renewal">@RenewalTermText()</DetailRow>
                    </RadzenStack>
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">
                        Estimated wholesale list pricing × seats, normalised to a monthly figure@(_repricingPercent is null ? " (no repricing config; computed price = wholesale)" : "") — not an invoiced amount.
                        @if (_entitlement.IonCostPerSeat is not null)
                        {
                            <span> The <b>Ion</b> rows are <b>actual</b> transacted cost/margin from TD SYNNEX StreamOne; all other figures are estimated from Google list pricing.</span>
                        }
                    </RadzenText>
                }
                else
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-m-0">No list pricing available for this offer.</RadzenText>
                }
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeLG="6">
            <RadzenCard Variant="Variant.Filled" class="rz-mb-4" id="modify">
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">Modify</RadzenText>
                <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-1">Seats</RadzenText>
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" class="rz-mb-4">
                    <RadzenFormField Text="num_units" Variant="Variant.Outlined" Style="max-width:160px">
                        <RadzenNumeric TValue="int" @bind-Value="_newSeats" Min="1" Name="seats" />
                    </RadzenFormField>
                    <RadzenButton Text="Update seats" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Disabled="_busy" Click="ChangeSeatsAsync" />
                </RadzenStack>

                <hr class="rz-my-3" />

                <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-mb-1">Change offer</RadzenText>
                @if (_offers is null)
                {
                    <RadzenButton Text="@(_offersLoading ? "Loading offers…" : "Load eligible offers")" Icon="@AppIcons.SwapHoriz" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text" Click="LoadOffersAsync" Disabled="_offersLoading" />
                }
                else if (_offers.Count == 0)
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-m-0">No alternative offers available for this SKU.</RadzenText>
                }
                else
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                        <RadzenFormField Text="New offer" Variant="Variant.Outlined" Style="width:100%; max-width:320px">
                            <RadzenDropDown TValue="string" @bind-Value="_changeOfferName" Data="_offers" ValueProperty="@nameof(PurchasableOffer.OfferName)" TextProperty="@nameof(PurchasableOffer.DisplayName)"
                                            AllowClear="true" Placeholder="Choose an offer…" Name="newOffer">
                                <Template Context="o">@(o.DisplayName ?? o.OfferName)</Template>
                            </RadzenDropDown>
                        </RadzenFormField>
                        <RadzenButton Text="Change" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Disabled="@(_busy || string.IsNullOrEmpty(_changeOfferName))" Click="ChangeOfferAsync" />
                    </RadzenStack>
                }
            </RadzenCard>

            <RadzenCard Variant="Variant.Filled" class="rz-mb-4">
                <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">Lifecycle</RadzenText>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                    @if (IsSuspended(_entitlement))
                    {
                        <RadzenButton Text="Activate" Icon="@AppIcons.PlayArrow" ButtonStyle="ButtonStyle.Success" Variant="Variant.Outlined" Disabled="_busy" Click="ActivateAsync" />
                    }
                    else
                    {
                        <RadzenButton Text="Suspend" Icon="@AppIcons.Pause" ButtonStyle="ButtonStyle.Warning" Variant="Variant.Outlined" Disabled="_busy" Click="SuspendAsync" />
                    }
                    @if (_entitlement.IsTrial)
                    {
                        <RadzenButton Text="Start paid service" Icon="@AppIcons.Paid" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Disabled="_busy" Click="StartPaidAsync" />
                    }
                    <RadzenButton Text="Cancel" Icon="@AppIcons.Cancel" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Disabled="_busy" Click="CancelAsync" />
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>

    <RadzenCard Variant="Variant.Filled" class="rz-mt-2">
        <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">Change history</RadzenText>
        @if (_changes is null)
        {
            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" class="rz-my-2" />
        }
        else if (_changes.Count == 0)
        {
            <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-m-0">No recorded changes.</RadzenText>
        }
        else
        {
            <RadzenDataGrid TItem="EntitlementChange" Data="_changes" AllowPaging="false" AllowSorting="false" Density="Density.Compact" GridLines="DataGridGridLines.Horizontal" Responsive="true">
                <Columns>
                    <RadzenDataGridColumn TItem="EntitlementChange" Title="When" Width="190px">
                        <Template Context="change">@(change.CreateTime?.ToString("u") ?? "—")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="EntitlementChange" Title="Change">
                        <Template Context="change">@(change.ChangeType ?? "—")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="EntitlementChange" Title="Offer">
                        <Template Context="change">
                            @if (!string.IsNullOrEmpty(change.OfferId))
                            {
                                <Tip Text="@change.OfferId"><RadzenLink Path="@($"/catalog/offers?sku={_entitlement.SkuId}")" Text="@(change.OfferDisplayName ?? change.OfferId)" /></Tip>
                            }
                            else { <span>—</span> }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="EntitlementChange" Title="By">
                        <Template Context="change">@(change.OperatorType ?? "—")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="EntitlementChange" Title="Reason">
                        <Template Context="change">@(change.Reason ?? "—")</Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
    </RadzenCard>
}

@code {
    [Parameter]
    public string CustomerId { get; set; } = string.Empty;

    [Parameter]
    public string Id { get; set; } = string.Empty;

    private Entitlement? _entitlement;
    private IReadOnlyList<EntitlementChange>? _changes;
    private bool _loading = true;
    private bool _busy;

    private bool _renewalEnabled;
    private int _newSeats = 1;

    private IReadOnlyList<PurchasableOffer>? _offers;
    private bool _offersLoading;
    private string? _changeOfferName;

    private bool _pricingLoading;
    private CatalogOffer? _offerPricing;
    private string? _offerCycle;
    private double? _repricingPercent;

    private MoneyAmount? SeatPrice => _offerPricing?.Pricing?.FirstOrDefault() is { } p ? (p.EffectivePrice ?? p.BasePrice) : null;
    private int SeatCount => int.TryParse(Seats(_entitlement!), out var s) ? s : 1;
    private decimal WholesaleTotal => (SeatPrice?.Value ?? 0) * SeatCount;
    private decimal ComputedTotal => WholesaleTotal * (1 + (decimal)(_repricingPercent ?? 0) / 100);
    private decimal ComputedMonthly => MonthsInCycle() is var m && m > 0 ? ComputedTotal / m : ComputedTotal;

    private string? BillingAccountId =>
        string.IsNullOrEmpty(_entitlement?.BillingAccount)
            ? null
            : _entitlement.BillingAccount.Split('/', StringSplitOptions.RemoveEmptyEntries).LastOrDefault();

    private int MonthsInCycle()
    {
        var c = _offerCycle?.Trim().ToLowerInvariant();
        if (string.IsNullOrEmpty(c)) return 1;
        if (c is "monthly") return 1;
        if (c is "annual" or "yearly") return 12;
        if (c is "daily") return 1;
        var dash = c.IndexOf('-');
        if (dash > 0 && int.TryParse(c[..dash], out var n) && n > 0)
        {
            if (c.Contains("year")) return n * 12;
            if (c.Contains("month")) return n;
        }
        return 1;
    }

    private string RenewalTermText()
    {
        if (_entitlement?.Commitment?.EndTime is not { } end)
        {
            return "No commitment end date";
        }
        var verb = _renewalEnabled ? "Renews" : "Ends";
        return $"{verb} {end:MMM d, yyyy} · auto-renew {(_renewalEnabled ? "on" : "off")}";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _changes = null;
        _offers = null;
        _changeOfferName = null;
        try
        {
            _entitlement = await Api.GetEntitlementAsync(CustomerId, Id);
            if (_entitlement is not null)
            {
                _renewalEnabled = _entitlement.Commitment?.RenewalEnabled ?? false;
                _newSeats = int.TryParse(Seats(_entitlement), out var seats) ? seats : 1;
            }
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load entitlement: {ex.Message}", Severity.Error);
            _entitlement = null;
        }
        finally
        {
            _loading = false;
        }

        if (_entitlement is not null)
        {
            try
            {
                var changes = await Api.ListEntitlementChangesAsync(CustomerId, Id);
                _changes = changes?.Changes ?? [];
            }
            catch (Exception ex)
            {
                await Snackbar.Add($"Failed to load change history: {ex.Message}", Severity.Error);
                _changes = [];
            }

            await LoadPricingAsync();
        }
    }

    private async Task LoadPricingAsync()
    {
        _pricingLoading = true;
        _offerPricing = null;
        _offerCycle = null;
        _repricingPercent = null;
        try
        {
            _offerPricing = await Api.LookupEntitlementOfferAsync(CustomerId, Id);
            _offerCycle = _offerPricing?.PaymentCycle;

            var configs = await Api.ListCustomerRepricingConfigsAsync(CustomerId);
            var match = configs?.Configs?.FirstOrDefault(c =>
                string.Equals(c.EntitlementId, Id, StringComparison.OrdinalIgnoreCase));
            _repricingPercent = match is null ? null : (double)match.PercentageAdjustment;
        }
        catch
        {
            // pricing is best-effort; leave card empty on failure
        }
        finally
        {
            _pricingLoading = false;
        }
    }

    private async Task LoadOffersAsync()
    {
        if (_entitlement is null || string.IsNullOrEmpty(_entitlement.ProductId) || string.IsNullOrEmpty(_entitlement.SkuId))
        {
            await Snackbar.Add("This entitlement has no resolvable product/SKU to look up offers.", Severity.Warning);
            return;
        }

        _offersLoading = true;
        try
        {
            var result = await Api.ListPurchasableOffersAsync(CustomerId, _entitlement.ProductId, _entitlement.SkuId);
            _offers = result?.Offers ?? [];
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load offers: {ex.Message}", Severity.Error);
        }
        finally
        {
            _offersLoading = false;
        }
    }

    private async Task ChangeSeatsAsync()
    {
        await MutateAsync("Update seats", () => Api.ChangeEntitlementParametersAsync(CustomerId, Id, new ChangeParametersRequest
        {
            Parameters = [new EntitlementParameterInput { Name = "num_units", IntValue = _newSeats }]
        }));
    }

    private async Task ChangeOfferAsync()
    {
        if (string.IsNullOrEmpty(_changeOfferName))
        {
            return;
        }

        await MutateAsync("Change offer", () => Api.ChangeEntitlementOfferAsync(CustomerId, Id, new ChangeOfferRequest
        {
            OfferId = _changeOfferName!
        }));
    }

    private Task SaveRenewalAsync() =>
        MutateAsync(_renewalEnabled ? "Enable renewal" : "Disable renewal",
            () => Api.ChangeEntitlementRenewalAsync(CustomerId, Id, new ChangeRenewalSettingsRequest { EnableRenewal = _renewalEnabled }));

    private Task ActivateAsync() =>
        ConfirmMutateAsync("Activate", "Activate this entitlement?", () => Api.ActivateEntitlementAsync(CustomerId, Id));

    private Task SuspendAsync() =>
        ConfirmMutateAsync("Suspend", "Suspend this entitlement? The customer loses access until reactivated.",
            () => Api.SuspendEntitlementAsync(CustomerId, Id));

    private Task StartPaidAsync() =>
        ConfirmMutateAsync("Start paid service", "Start paid service? This ends the trial and begins billing.",
            () => Api.StartPaidServiceAsync(CustomerId, Id));

    private Task CancelAsync() =>
        ConfirmMutateAsync("Cancel", "Cancel this entitlement? This cannot be undone.",
            () => Api.CancelEntitlementAsync(CustomerId, Id));

    private async Task ConfirmMutateAsync(string action, string confirm, Func<Task<EntitlementOperation?>> call)
    {
        var confirmed = await Snackbar.ConfirmAsync($"{action} entitlement", confirm, yesText: action, cancelText: "Cancel");
        if (confirmed)
        {
            await MutateAsync(action, call);
        }
    }

    private async Task MutateAsync(string action, Func<Task<EntitlementOperation?>> call)
    {
        _busy = true;
        try
        {
            var op = await call();
            if (!string.IsNullOrEmpty(op?.Error))
            {
                await Snackbar.Add($"{action} failed: {op!.Error}", Severity.Error);
                return;
            }

            await Snackbar.Add(op?.Done == true
                ? $"{action} completed."
                : $"{action} submitted — Google is processing it, this may take a moment.",
                op?.Done == true ? Severity.Success : Severity.Info);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"{action} failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private static bool IsSuspended(Entitlement e) =>
        string.Equals(e.ProvisioningState, "SUSPENDED", StringComparison.OrdinalIgnoreCase);

    private static BadgeStyle StateColor(string? state) => state?.ToUpperInvariant() switch
    {
        "ACTIVE" => BadgeStyle.Success,
        "SUSPENDED" => BadgeStyle.Warning,
        "CANCELLED" or "CANCELED" => BadgeStyle.Danger,
        "PENDING" => BadgeStyle.Info,
        _ => BadgeStyle.Light
    };

    private static string? Seats(Entitlement e) =>
        e.Parameters.FirstOrDefault(p => string.Equals(p.Name, "num_units", StringComparison.OrdinalIgnoreCase))?.Value
        ?? e.Parameters.FirstOrDefault(p => string.Equals(p.Name, "max_units", StringComparison.OrdinalIgnoreCase))?.Value;
}

