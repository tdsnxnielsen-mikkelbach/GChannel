@page "/customers/{CustomerId}/entitlements/{Id}"
@attribute [Authorize]
@using Blazorise
@inject GChannelApiClient Api
@inject UiNotifier Snackbar

<PageTitle>Entitlement · GChannel</PageTitle>

@if (_loading)
{
    <LoadingPanel Title="Loading entitlement…"
                  Hint="Fetching the entitlement and its change history." />
}
else if (_entitlement is null)
{
    <Alert Color="Color.Danger" Visible>Entitlement not found.</Alert>
    <Button Type="ButtonType.Link" To="@($"/customers/{CustomerId}/entitlements")" Color="Color.Secondary" Outline Margin="Margin.Is4.FromTop">
        <Icon Name="@AppIcons.ArrowBack" Class="me-1" /> Back to entitlements
    </Button>
}
else
{
    <Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Margin="Margin.Is4.FromBottom">
        <Div>
            <Heading Size="HeadingSize.Is3" Margin="Margin.Is0">@(_entitlement.SkuDisplayName ?? _entitlement.OfferDisplayName ?? _entitlement.OfferId ?? _entitlement.Id)</Heading>
            <Div Flex="Flex.AlignItems.Center" Gap="Gap.Is2" Margin="Margin.Is1.FromTop">
                <Badge Color="@StateColor(_entitlement.ProvisioningState)">@(_entitlement.ProvisioningState ?? "—")</Badge>
                @if (_entitlement.IsTrial)
                {
                    <Badge Color="Color.Info">Trial</Badge>
                }
            </Div>
        </Div>
        <Button Type="ButtonType.Link" To="@($"/customers/{CustomerId}/entitlements")" Color="Color.Secondary" Outline>
            <Icon Name="@AppIcons.ArrowBack" Class="me-1" /> Entitlements
        </Button>
    </Div>

    <Row>
        <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop">
            <Card Shadow="Shadow.Small" Margin="Margin.Is4.FromBottom">
                <CardHeader><CardTitle Size="HeadingSize.Is5" Margin="Margin.Is0">Details</CardTitle></CardHeader>
                <CardBody>
                    <Table Narrow Borderless Margin="Margin.Is0">
                        <TableBody>
                            <TableRow><TableRowCell><strong>Entitlement id</strong></TableRowCell><TableRowCell>@_entitlement.Id</TableRowCell></TableRow>
                            <TableRow>
                                <TableRowCell><strong>Offer</strong></TableRowCell>
                                <TableRowCell>
                                    @if (!string.IsNullOrEmpty(_entitlement.SkuId))
                                    {
                                        <Anchor To="@($"/catalog/offers?sku={_entitlement.SkuId}")">@(_entitlement.OfferDisplayName ?? _entitlement.OfferId ?? "—")</Anchor>
                                    }
                                    else { <span>@(_entitlement.OfferDisplayName ?? _entitlement.OfferId ?? "—")</span> }
                                    @if (!string.IsNullOrEmpty(_entitlement.OfferId) && !string.IsNullOrEmpty(_entitlement.OfferDisplayName))
                                    {
                                        <Small TextColor="TextColor.Secondary" Display="Display.Block">@_entitlement.OfferId</Small>
                                    }
                                </TableRowCell>
                            </TableRow>
                            <TableRow>
                                <TableRowCell><strong>Product / SKU</strong></TableRowCell>
                                <TableRowCell>
                                    @if (!string.IsNullOrEmpty(_entitlement.ProductId))
                                    {
                                        <Anchor To="@($"/catalog/products?product={_entitlement.ProductId}&sku={_entitlement.SkuId}")">
                                            @(_entitlement.ProductDisplayName ?? _entitlement.ProductId) / @(_entitlement.SkuDisplayName ?? _entitlement.SkuId)
                                        </Anchor>
                                        <Small TextColor="TextColor.Secondary" Display="Display.Block">@(_entitlement.ProductId) / @(_entitlement.SkuId)</Small>
                                    }
                                    else { <span>—</span> }
                                </TableRowCell>
                            </TableRow>
                            <TableRow><TableRowCell><strong>Seats</strong></TableRowCell><TableRowCell>@(Seats(_entitlement) ?? "—")</TableRowCell></TableRow>
                            <TableRow><TableRowCell><strong>Purchase order</strong></TableRowCell><TableRowCell>@(_entitlement.PurchaseOrderId ?? "—")</TableRowCell></TableRow>
                            <TableRow>
                                <TableRowCell><strong>Billing account</strong></TableRowCell>
                                <TableRowCell>
                                    @if (!string.IsNullOrEmpty(_entitlement.BillingAccount))
                                    {
                                        <span>@(BillingAccountId ?? _entitlement.BillingAccount)</span>
                                        <Small TextColor="TextColor.Secondary" Display="Display.Block">@_entitlement.BillingAccount</Small>
                                    }
                                    else { <span>—</span> }
                                </TableRowCell>
                            </TableRow>
                            <TableRow><TableRowCell><strong>Created</strong></TableRowCell><TableRowCell>@(_entitlement.CreateTime?.ToString("u") ?? "—")</TableRowCell></TableRow>
                            <TableRow><TableRowCell><strong>Updated</strong></TableRowCell><TableRowCell>@(_entitlement.UpdateTime?.ToString("u") ?? "—")</TableRowCell></TableRow>
                            @if (_entitlement.IsTrial && _entitlement.TrialEndTime is not null)
                            {
                                <TableRow><TableRowCell><strong>Trial ends</strong></TableRowCell><TableRowCell>@_entitlement.TrialEndTime.Value.ToString("u")</TableRowCell></TableRow>
                            }
                            @if (_entitlement.SuspensionReasons.Count > 0)
                            {
                                <TableRow><TableRowCell><strong>Suspension reasons</strong></TableRowCell><TableRowCell>@string.Join(", ", _entitlement.SuspensionReasons)</TableRowCell></TableRow>
                            }
                        </TableBody>
                    </Table>
                </CardBody>
            </Card>

            <Card Shadow="Shadow.Small" Margin="Margin.Is4.FromBottom">
                <CardHeader><CardTitle Size="HeadingSize.Is5" Margin="Margin.Is0">Commitment &amp; renewal</CardTitle></CardHeader>
                <CardBody>
                    <Table Narrow Borderless Margin="Margin.Is2.FromBottom">
                        <TableBody>
                            <TableRow><TableRowCell><strong>Payment plan</strong></TableRowCell><TableRowCell>@(_entitlement.Commitment?.PaymentPlan ?? "—")</TableRowCell></TableRow>
                            <TableRow><TableRowCell><strong>Commitment start</strong></TableRowCell><TableRowCell>@(_entitlement.Commitment?.StartTime?.ToString("u") ?? "—")</TableRowCell></TableRow>
                            <TableRow><TableRowCell><strong>Commitment end</strong></TableRowCell><TableRowCell>@(_entitlement.Commitment?.EndTime?.ToString("u") ?? "—")</TableRowCell></TableRow>
                        </TableBody>
                    </Table>
                    <Div Flex="Flex.AlignItems.Center" Gap="Gap.Is4">
                        <Switch TValue="bool" @bind-Value="_renewalEnabled" Color="Color.Primary">Auto-renew</Switch>
                        <Button Size="Size.Small" Color="Color.Secondary" Outline Disabled="_busy" Clicked="SaveRenewalAsync">
                            Save renewal
                        </Button>
                    </Div>
                </CardBody>
            </Card>

            <Card Shadow="Shadow.Small" Margin="Margin.Is4.FromBottom">
                <CardHeader><CardTitle Size="HeadingSize.Is5" Margin="Margin.Is0">Licenses</CardTitle></CardHeader>
                <CardBody>
                    <Table Narrow Borderless Margin="Margin.Is0">
                        <TableBody>
                            <TableRow><TableRowCell><strong>Total licenses</strong></TableRowCell><TableRowCell>@SeatCount</TableRowCell></TableRow>
                            <TableRow>
                                <TableRowCell><strong>Assigned</strong></TableRowCell>
                                <TableRowCell>
                                    <Tooltip Text="Assigned-seat counts aren't exposed by the Channel API — they live in each customer's own Workspace tenant (Enterprise License Manager / Admin SDK), which needs per-customer authorization." Multiline Inline>
                                        <span>— <Small TextColor="TextColor.Secondary">(not available)</Small></span>
                                    </Tooltip>
                                </TableRowCell>
                            </TableRow>
                        </TableBody>
                    </Table>
                    <Button Type="ButtonType.Link" To="#modify" Size="Size.Small" Color="Color.Primary" Class="btn-link text-decoration-none">
                        <Icon Name="@AppIcons.Tune" Class="me-1" /> Manage licenses
                    </Button>
                </CardBody>
            </Card>

            <Card Shadow="Shadow.Small" Margin="Margin.Is4.FromBottom">
                <CardHeader><CardTitle Size="HeadingSize.Is5" Margin="Margin.Is0">Payment &amp; pricing (estimated)</CardTitle></CardHeader>
                <CardBody>
                    @if (_pricingLoading)
                    {
                        <Progress Indeterminate Color="Color.Primary" Size="Size.Small" Margin="Margin.Is2.OnY" />
                    }
                    else if (SeatPrice is { } seat)
                    {
                        <Table Narrow Borderless Margin="Margin.Is0">
                            <TableBody>
                                <TableRow><TableRowCell><strong>Billing cycle</strong></TableRowCell><TableRowCell>@(string.IsNullOrEmpty(_offerCycle) ? "—" : _offerCycle)</TableRowCell></TableRow>
                                <TableRow><TableRowCell><strong>Wholesale / seat</strong></TableRowCell><TableRowCell>@seat.Display@(string.IsNullOrEmpty(_offerCycle) ? "" : $" · {_offerCycle.ToLowerInvariant()}")</TableRowCell></TableRow>
                                <TableRow><TableRowCell><strong>Seats</strong></TableRowCell><TableRowCell>@SeatCount</TableRowCell></TableRow>
                                <TableRow><TableRowCell><strong>Wholesale total</strong></TableRowCell><TableRowCell>@($"{seat.CurrencyCode} {WholesaleTotal:0.00}")</TableRowCell></TableRow>
                                @if (_entitlement.IonCostPerSeat is { } ionCost)
                                {
                                    <TableRow><TableRowCell><strong>Ion cost / seat (actual)</strong></TableRowCell><TableRowCell>@($"{_entitlement.IonCurrency ?? seat.CurrencyCode} {ionCost:0.00}")</TableRowCell></TableRow>
                                    @if (_entitlement.IonMarginPercent is { } ionMp)
                                    {
                                        <TableRow><TableRowCell><strong>Ion margin</strong></TableRowCell><TableRowCell>@ionMp.ToString("0.0")%</TableRowCell></TableRow>
                                    }
                                }
                                @if (_repricingPercent is { } pct)
                                {
                                    <TableRow><TableRowCell><strong>Repricing</strong></TableRowCell><TableRowCell>@(pct >= 0 ? "+" : "")@pct.ToString("0.##")%</TableRowCell></TableRow>
                                    <TableRow><TableRowCell><strong>Computed price</strong></TableRowCell><TableRowCell>@($"{seat.CurrencyCode} {ComputedTotal:0.00}")</TableRowCell></TableRow>
                                    <TableRow><TableRowCell><strong>Est. margin</strong></TableRowCell><TableRowCell>@($"{seat.CurrencyCode} {(ComputedTotal - WholesaleTotal):0.00}")</TableRowCell></TableRow>
                                }
                                <TableRow><TableRowCell><strong>Estimated / month</strong></TableRowCell><TableRowCell>@($"{seat.CurrencyCode} {ComputedMonthly:0.00}")@(MonthsInCycle() > 1 ? $" (≈ {seat.CurrencyCode} {ComputedTotal:0.00} ÷ {MonthsInCycle()} mo)" : "")</TableRowCell></TableRow>
                                <TableRow><TableRowCell><strong>Renewal</strong></TableRowCell><TableRowCell>@RenewalTermText()</TableRowCell></TableRow>
                            </TableBody>
                        </Table>
                        <Small TextColor="TextColor.Secondary">
                            Estimated wholesale list pricing × seats, normalised to a monthly figure@(_repricingPercent is null ? " (no repricing config; computed price = wholesale)" : "") — not an invoiced amount.
                            @if (_entitlement.IonCostPerSeat is not null)
                            {
                                <span> The <b>Ion</b> rows are <b>actual</b> transacted cost/margin from TD SYNNEX StreamOne; all other figures are estimated from Google list pricing.</span>
                            }
                        </Small>
                    }
                    else
                    {
                        <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is0">No list pricing available for this offer.</Paragraph>
                    }
                </CardBody>
            </Card>
        </Column>

        <Column ColumnSize="ColumnSize.Is12.Is6.OnDesktop">
            <Card Shadow="Shadow.Small" Margin="Margin.Is4.FromBottom" id="modify">
                <CardHeader><CardTitle Size="HeadingSize.Is5" Margin="Margin.Is0">Modify</CardTitle></CardHeader>
                <CardBody>
                    <Strong Display="Display.Block" Margin="Margin.Is1.FromBottom">Seats</Strong>
                    <Div Flex="Flex.AlignItems.End" Gap="Gap.Is4" Margin="Margin.Is4.FromBottom">
                        <Field Margin="Margin.Is0" Style="max-width:160px">
                            <FieldLabel>num_units</FieldLabel>
                            <NumericPicker TValue="int" @bind-Value="_newSeats" Min="1" />
                        </Field>
                        <Button Size="Size.Small" Color="Color.Secondary" Outline Disabled="_busy" Clicked="ChangeSeatsAsync">
                            Update seats
                        </Button>
                    </Div>

                    <Divider Margin="Margin.Is3.OnY" />

                    <Strong Display="Display.Block" Margin="Margin.Is1.FromBottom">Change offer</Strong>
                    @if (_offers is null)
                    {
                        <Button Size="Size.Small" Color="Color.Primary" Class="btn-link text-decoration-none" Clicked="LoadOffersAsync" Disabled="_offersLoading">
                            <Icon Name="@AppIcons.SwapHoriz" Class="me-1" /> @(_offersLoading ? "Loading offers…" : "Load eligible offers")
                        </Button>
                    }
                    else if (_offers.Count == 0)
                    {
                        <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is0">No alternative offers available for this SKU.</Paragraph>
                    }
                    else
                    {
                        <Div Flex="Flex.AlignItems.End" Gap="Gap.Is4">
                            <Field Margin="Margin.Is0" Style="max-width:320px">
                                <FieldLabel>New offer</FieldLabel>
                                <Select TValue="string" @bind-Value="_changeOfferName">
                                    <SelectItem TValue="string" Value="@((string?)null)">Choose an offer…</SelectItem>
                                    @foreach (var offer in _offers)
                                    {
                                        <SelectItem TValue="string" Value="@offer.OfferName">@(offer.DisplayName ?? offer.OfferName)</SelectItem>
                                    }
                                </Select>
                            </Field>
                            <Button Size="Size.Small" Color="Color.Secondary" Outline Disabled="@(_busy || string.IsNullOrEmpty(_changeOfferName))"
                                    Clicked="ChangeOfferAsync">Change</Button>
                        </Div>
                    }
                </CardBody>
            </Card>

            <Card Shadow="Shadow.Small" Margin="Margin.Is4.FromBottom">
                <CardHeader><CardTitle Size="HeadingSize.Is5" Margin="Margin.Is0">Lifecycle</CardTitle></CardHeader>
                <CardBody>
                    <Div Flex="Flex.Wrap" Gap="Gap.Is2">
                        @if (IsSuspended(_entitlement))
                        {
                            <Button Color="Color.Success" Outline Disabled="_busy" Clicked="ActivateAsync">
                                <Icon Name="@AppIcons.PlayArrow" Class="me-1" /> Activate
                            </Button>
                        }
                        else
                        {
                            <Button Color="Color.Warning" Outline Disabled="_busy" Clicked="SuspendAsync">
                                <Icon Name="@AppIcons.Pause" Class="me-1" /> Suspend
                            </Button>
                        }
                        @if (_entitlement.IsTrial)
                        {
                            <Button Color="Color.Primary" Outline Disabled="_busy" Clicked="StartPaidAsync">
                                <Icon Name="@AppIcons.Paid" Class="me-1" /> Start paid service
                            </Button>
                        }
                        <Button Color="Color.Danger" Outline Disabled="_busy" Clicked="CancelAsync">
                            <Icon Name="@AppIcons.Cancel" Class="me-1" /> Cancel
                        </Button>
                    </Div>
                </CardBody>
            </Card>
        </Column>
    </Row>

    <Card Shadow="Shadow.Small" Margin="Margin.Is2.FromTop">
        <CardHeader><CardTitle Size="HeadingSize.Is5" Margin="Margin.Is0">Change history</CardTitle></CardHeader>
        <CardBody>
            @if (_changes is null)
            {
                <Progress Indeterminate Color="Color.Primary" Size="Size.Small" Margin="Margin.Is2.OnY" />
            }
            else if (_changes.Count == 0)
            {
                <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is0">No recorded changes.</Paragraph>
            }
            else
            {
                <Table Narrow Hoverable Responsive Margin="Margin.Is0">
                    <TableHeader>
                        <TableRow>
                            <TableHeaderCell>When</TableHeaderCell>
                            <TableHeaderCell>Change</TableHeaderCell>
                            <TableHeaderCell>Offer</TableHeaderCell>
                            <TableHeaderCell>By</TableHeaderCell>
                            <TableHeaderCell>Reason</TableHeaderCell>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @foreach (var change in _changes)
                        {
                            <TableRow>
                                <TableRowCell>@(change.CreateTime?.ToString("u") ?? "—")</TableRowCell>
                                <TableRowCell>@(change.ChangeType ?? "—")</TableRowCell>
                                <TableRowCell>
                                    @if (!string.IsNullOrEmpty(change.OfferId))
                                    {
                                        <Tooltip Text="@change.OfferId" Inline>
                                            <Anchor To="@($"/catalog/offers?sku={_entitlement.SkuId}")">@(change.OfferDisplayName ?? change.OfferId)</Anchor>
                                        </Tooltip>
                                    }
                                    else { <span>—</span> }
                                </TableRowCell>
                                <TableRowCell>@(change.OperatorType ?? "—")</TableRowCell>
                                <TableRowCell>@(change.Reason ?? "—")</TableRowCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
            }
        </CardBody>
    </Card>
}

@code {
    [Parameter]
    public string CustomerId { get; set; } = string.Empty;

    [Parameter]
    public string Id { get; set; } = string.Empty;

    private Entitlement? _entitlement;
    private IReadOnlyList<EntitlementChange>? _changes;
    private bool _loading = true;
    private bool _busy;

    private bool _renewalEnabled;
    private int _newSeats = 1;

    private IReadOnlyList<PurchasableOffer>? _offers;
    private bool _offersLoading;
    private string? _changeOfferName;

    private bool _pricingLoading;
    private CatalogOffer? _offerPricing;
    private string? _offerCycle;
    private double? _repricingPercent;

    private MoneyAmount? SeatPrice => _offerPricing?.Pricing?.FirstOrDefault() is { } p ? (p.EffectivePrice ?? p.BasePrice) : null;
    private int SeatCount => int.TryParse(Seats(_entitlement!), out var s) ? s : 1;
    private decimal WholesaleTotal => (SeatPrice?.Value ?? 0) * SeatCount;
    private decimal ComputedTotal => WholesaleTotal * (1 + (decimal)(_repricingPercent ?? 0) / 100);
    private decimal ComputedMonthly => MonthsInCycle() is var m && m > 0 ? ComputedTotal / m : ComputedTotal;

    private string? BillingAccountId =>
        string.IsNullOrEmpty(_entitlement?.BillingAccount)
            ? null
            : _entitlement.BillingAccount.Split('/', StringSplitOptions.RemoveEmptyEntries).LastOrDefault();

    private int MonthsInCycle()
    {
        var c = _offerCycle?.Trim().ToLowerInvariant();
        if (string.IsNullOrEmpty(c)) return 1;
        if (c is "monthly") return 1;
        if (c is "annual" or "yearly") return 12;
        if (c is "daily") return 1;
        var dash = c.IndexOf('-');
        if (dash > 0 && int.TryParse(c[..dash], out var n) && n > 0)
        {
            if (c.Contains("year")) return n * 12;
            if (c.Contains("month")) return n;
        }
        return 1;
    }

    private string RenewalTermText()
    {
        if (_entitlement?.Commitment?.EndTime is not { } end)
        {
            return "No commitment end date";
        }
        var verb = _renewalEnabled ? "Renews" : "Ends";
        return $"{verb} {end:MMM d, yyyy} · auto-renew {(_renewalEnabled ? "on" : "off")}";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _changes = null;
        _offers = null;
        _changeOfferName = null;
        try
        {
            _entitlement = await Api.GetEntitlementAsync(CustomerId, Id);
            if (_entitlement is not null)
            {
                _renewalEnabled = _entitlement.Commitment?.RenewalEnabled ?? false;
                _newSeats = int.TryParse(Seats(_entitlement), out var seats) ? seats : 1;
            }
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load entitlement: {ex.Message}", Severity.Error);
            _entitlement = null;
        }
        finally
        {
            _loading = false;
        }

        if (_entitlement is not null)
        {
            try
            {
                var changes = await Api.ListEntitlementChangesAsync(CustomerId, Id);
                _changes = changes?.Changes ?? [];
            }
            catch (Exception ex)
            {
                await Snackbar.Add($"Failed to load change history: {ex.Message}", Severity.Error);
                _changes = [];
            }

            await LoadPricingAsync();
        }
    }

    private async Task LoadPricingAsync()
    {
        _pricingLoading = true;
        _offerPricing = null;
        _offerCycle = null;
        _repricingPercent = null;
        try
        {
            _offerPricing = await Api.LookupEntitlementOfferAsync(CustomerId, Id);
            _offerCycle = _offerPricing?.PaymentCycle;

            var configs = await Api.ListCustomerRepricingConfigsAsync(CustomerId);
            var match = configs?.Configs?.FirstOrDefault(c =>
                string.Equals(c.EntitlementId, Id, StringComparison.OrdinalIgnoreCase));
            _repricingPercent = match is null ? null : (double)match.PercentageAdjustment;
        }
        catch
        {
            // pricing is best-effort; leave card empty on failure
        }
        finally
        {
            _pricingLoading = false;
        }
    }

    private async Task LoadOffersAsync()
    {
        if (_entitlement is null || string.IsNullOrEmpty(_entitlement.ProductId) || string.IsNullOrEmpty(_entitlement.SkuId))
        {
            await Snackbar.Add("This entitlement has no resolvable product/SKU to look up offers.", Severity.Warning);
            return;
        }

        _offersLoading = true;
        try
        {
            var result = await Api.ListPurchasableOffersAsync(CustomerId, _entitlement.ProductId, _entitlement.SkuId);
            _offers = result?.Offers ?? [];
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load offers: {ex.Message}", Severity.Error);
        }
        finally
        {
            _offersLoading = false;
        }
    }

    private async Task ChangeSeatsAsync()
    {
        await MutateAsync("Update seats", () => Api.ChangeEntitlementParametersAsync(CustomerId, Id, new ChangeParametersRequest
        {
            Parameters = [new EntitlementParameterInput { Name = "num_units", IntValue = _newSeats }]
        }));
    }

    private async Task ChangeOfferAsync()
    {
        if (string.IsNullOrEmpty(_changeOfferName))
        {
            return;
        }

        await MutateAsync("Change offer", () => Api.ChangeEntitlementOfferAsync(CustomerId, Id, new ChangeOfferRequest
        {
            OfferId = _changeOfferName!
        }));
    }

    private Task SaveRenewalAsync() =>
        MutateAsync(_renewalEnabled ? "Enable renewal" : "Disable renewal",
            () => Api.ChangeEntitlementRenewalAsync(CustomerId, Id, new ChangeRenewalSettingsRequest { EnableRenewal = _renewalEnabled }));

    private Task ActivateAsync() =>
        ConfirmMutateAsync("Activate", "Activate this entitlement?", () => Api.ActivateEntitlementAsync(CustomerId, Id));

    private Task SuspendAsync() =>
        ConfirmMutateAsync("Suspend", "Suspend this entitlement? The customer loses access until reactivated.",
            () => Api.SuspendEntitlementAsync(CustomerId, Id));

    private Task StartPaidAsync() =>
        ConfirmMutateAsync("Start paid service", "Start paid service? This ends the trial and begins billing.",
            () => Api.StartPaidServiceAsync(CustomerId, Id));

    private Task CancelAsync() =>
        ConfirmMutateAsync("Cancel", "Cancel this entitlement? This cannot be undone.",
            () => Api.CancelEntitlementAsync(CustomerId, Id));

    private async Task ConfirmMutateAsync(string action, string confirm, Func<Task<EntitlementOperation?>> call)
    {
        var confirmed = await Snackbar.ConfirmAsync($"{action} entitlement", confirm, yesText: action, cancelText: "Cancel");
        if (confirmed)
        {
            await MutateAsync(action, call);
        }
    }

    private async Task MutateAsync(string action, Func<Task<EntitlementOperation?>> call)
    {
        _busy = true;
        try
        {
            var op = await call();
            if (!string.IsNullOrEmpty(op?.Error))
            {
                await Snackbar.Add($"{action} failed: {op!.Error}", Severity.Error);
                return;
            }

            await Snackbar.Add(op?.Done == true
                ? $"{action} completed."
                : $"{action} submitted — Google is processing it, this may take a moment.",
                op?.Done == true ? Severity.Success : Severity.Info);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"{action} failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private static bool IsSuspended(Entitlement e) =>
        string.Equals(e.ProvisioningState, "SUSPENDED", StringComparison.OrdinalIgnoreCase);

    private static Color StateColor(string? state) => state?.ToUpperInvariant() switch
    {
        "ACTIVE" => Color.Success,
        "SUSPENDED" => Color.Warning,
        "CANCELLED" or "CANCELED" => Color.Danger,
        "PENDING" => Color.Info,
        _ => Color.Secondary
    };

    private static string? Seats(Entitlement e) =>
        e.Parameters.FirstOrDefault(p => string.Equals(p.Name, "num_units", StringComparison.OrdinalIgnoreCase))?.Value
        ?? e.Parameters.FirstOrDefault(p => string.Equals(p.Name, "max_units", StringComparison.OrdinalIgnoreCase))?.Value;
}

