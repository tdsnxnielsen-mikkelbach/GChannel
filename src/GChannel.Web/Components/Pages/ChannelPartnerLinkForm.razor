@page "/channel-partner-links/new"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject UiNotifier Snackbar
@inject NavigationManager Nav

<PageTitle>Invite channel partner · GChannel</PageTitle>

<Div Flex="Flex.AlignItems.Center" Gap="Gap.Is2" Margin="Margin.Is4.FromBottom">
    <Button Type="ButtonType.Link" To="/channel-partner-links" Color="Color.Light" aria-label="Back to channel partner links">
        <Icon Name="@AppIcons.ArrowBack" />
    </Button>
    <Heading Size="HeadingSize.Is3" Margin="Margin.Is0">Invite channel partner</Heading>
</Div>

<Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is5.FromBottom">
    Link a downstream reseller to your distributor account. Enter the reseller's Cloud Identity ID;
    the link starts in the <strong>INVITED</strong> state and the partner accepts it via the
    invitation link shown afterwards.
</Paragraph>

<Card Shadow="Shadow.Small" Style="max-width: 640px;">
    <CardBody Padding="Padding.Is4">
        <Validations @ref="_validations" Mode="ValidationMode.Manual">
            <Validation Validator="ValidationRule.IsNotEmpty">
                <Field>
                    <FieldLabel>Reseller Cloud Identity ID</FieldLabel>
                    <TextInput @bind-Value="_resellerCloudIdentityId">
                        <Feedback><ValidationError>A reseller Cloud Identity ID is required.</ValidationError></Feedback>
                    </TextInput>
                    <FieldHelp>The downstream reseller's Cloud Identity customer ID.</FieldHelp>
                </Field>
            </Validation>

            <Field>
                <FieldLabel>Reseller domain (optional)</FieldLabel>
                <TextInput @bind-Value="_resellerDomain" />
                <FieldHelp>Recorded so a later Cloud Identity check on this domain can find this invitation.</FieldHelp>
            </Field>

            <Div Flex="Flex.Default" Gap="Gap.Is2">
                <Button Color="Color.Primary" Clicked="SubmitAsync" Disabled="_submitting" Loading="_submitting">
                    <Icon Name="@AppIcons.AddLink" Class="me-1" /> @(_submitting ? "Inviting…" : "Invite partner")
                </Button>
                <Button Type="ButtonType.Link" To="/channel-partner-links" Color="Color.Secondary" Outline Disabled="_submitting">
                    Cancel
                </Button>
            </Div>
        </Validations>
    </CardBody>
</Card>

@code {
    private Validations? _validations;
    private string _resellerCloudIdentityId = string.Empty;
    private string _resellerDomain = string.Empty;
    private bool _submitting;

    private async Task SubmitAsync()
    {
        if (_validations is not null && !await _validations.ValidateAll())
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_resellerCloudIdentityId))
        {
            await Snackbar.Add("A reseller Cloud Identity ID is required.", Severity.Warning);
            return;
        }

        _submitting = true;
        try
        {
            var created = await Api.CreateChannelPartnerLinkAsync(new CreateChannelPartnerLinkRequest
            {
                ResellerCloudIdentityId = _resellerCloudIdentityId.Trim(),
                Domain = string.IsNullOrWhiteSpace(_resellerDomain) ? null : _resellerDomain.Trim()
            });

            await Snackbar.Add("Channel partner link created.", Severity.Success);
            if (created is not null)
            {
                Nav.NavigateTo($"/channel-partner-links/{created.Id}");
            }
            else
            {
                Nav.NavigateTo("/channel-partner-links");
            }
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to create channel partner link: {ex.Message}", Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }
}
