@page "/channel-partner-links/new"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject UiNotifier Snackbar
@inject NavigationManager Nav

<PageTitle>Invite channel partner · GChannel</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" class="rz-mb-4">
    <LinkButton To="/channel-partner-links" Icon="@AppIcons.ArrowBack" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" Title="Back to channel partner links" />
    <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">Invite channel partner</RadzenText>
</RadzenStack>

<RadzenText TextStyle="TextStyle.Body1" class="rz-text-secondary-color rz-mb-6">
    Link a downstream reseller to your distributor account. Enter the reseller's Cloud Identity ID;
    the link starts in the <strong>INVITED</strong> state and the partner accepts it via the
    invitation link shown afterwards.
</RadzenText>

<RadzenCard Variant="Variant.Filled" Style="max-width: 640px;">
    <RadzenTemplateForm TItem="InviteModel" Data="_model" Submit="SubmitAsync">
        <RadzenStack Gap="1rem">
            <RadzenFormField Text="Reseller Cloud Identity ID" Variant="Variant.Outlined" Style="width:100%">
                <ChildContent><RadzenTextBox @bind-Value="_model.ResellerCloudIdentityId" Name="ResellerCloudIdentityId" /></ChildContent>
                <Helper>
                    <RadzenRequiredValidator Component="ResellerCloudIdentityId" Text="A reseller Cloud Identity ID is required." />
                    <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">The downstream reseller's Cloud Identity customer ID.</RadzenText>
                </Helper>
            </RadzenFormField>

            <RadzenFormField Text="Reseller domain (optional)" Variant="Variant.Outlined" Style="width:100%">
                <ChildContent><RadzenTextBox @bind-Value="_model.ResellerDomain" Name="ResellerDomain" /></ChildContent>
                <Helper><RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">Recorded so a later Cloud Identity check on this domain can find this invitation.</RadzenText></Helper>
            </RadzenFormField>

            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                <RadzenButton ButtonType="ButtonType.Submit" Text="Invite partner" Icon="@AppIcons.AddLink" ButtonStyle="ButtonStyle.Primary" IsBusy="_submitting" BusyText="Inviting…" />
                <LinkButton To="/channel-partner-links" Text="Cancel" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Disabled="_submitting" />
            </RadzenStack>
        </RadzenStack>
    </RadzenTemplateForm>
</RadzenCard>

@code {
    private readonly InviteModel _model = new();
    private bool _submitting;

    // Only called by RadzenTemplateForm once the required-field validator passes.
    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_model.ResellerCloudIdentityId))
        {
            await Snackbar.Add("A reseller Cloud Identity ID is required.", Severity.Warning);
            return;
        }

        _submitting = true;
        try
        {
            var created = await Api.CreateChannelPartnerLinkAsync(new CreateChannelPartnerLinkRequest
            {
                ResellerCloudIdentityId = _model.ResellerCloudIdentityId.Trim(),
                Domain = string.IsNullOrWhiteSpace(_model.ResellerDomain) ? null : _model.ResellerDomain.Trim()
            });

            await Snackbar.Add("Channel partner link created.", Severity.Success);
            if (created is not null)
            {
                Nav.NavigateTo($"/channel-partner-links/{created.Id}");
            }
            else
            {
                Nav.NavigateTo("/channel-partner-links");
            }
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to create channel partner link: {ex.Message}", Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }

    private sealed class InviteModel
    {
        public string ResellerCloudIdentityId { get; set; } = string.Empty;
        public string ResellerDomain { get; set; } = string.Empty;
    }
}
