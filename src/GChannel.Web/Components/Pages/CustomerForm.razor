@page "/customers/new"
@page "/customers/edit/{Id}"
@attribute [Authorize]
@using Blazorise
@inject GChannelApiClient Api
@inject UiNotifier Snackbar
@inject NavigationManager Nav

<PageTitle>@(IsEdit ? "Edit customer" : "New customer") · GChannel</PageTitle>

<Div Flex="Flex.JustifyContent.Between.AlignItems.Center">
    <Heading Size="HeadingSize.Is3" Margin="Margin.Is2.FromBottom">@(IsEdit ? "Edit customer" : "New customer")</Heading>
    @if (!IsEdit)
    {
        <GuidedWalkthrough Id="customer-new" Steps="_walkthrough" AutoStart="true" />
    }
</Div>

@if (_loading)
{
    <LoadingPanel Title="Loading customer…"
                  Hint="Fetching the customer's current details." />
}
else
{
    <Validations @ref="_validations" Mode="ValidationMode.Manual">
        <Card Shadow="Shadow.Small" Margin="Margin.Is4.FromBottom">
            <CardHeader><CardTitle Size="HeadingSize.Is5" Margin="Margin.Is0">Organization</CardTitle></CardHeader>
            <CardBody>
                <Validation Validator="ValidationRule.IsNotEmpty">
                    <Field data-walkthrough="cf-org">
                        <FieldLabel>Organization name</FieldLabel>
                        <TextInput @bind-Value="_model.OrgDisplayName">
                            <Feedback><ValidationError>Organization name is required.</ValidationError></Feedback>
                        </TextInput>
                    </Field>
                </Validation>
                <Validation Validator="ValidationRule.IsNotEmpty">
                    <Field data-walkthrough="cf-domain">
                        <FieldLabel>Primary domain</FieldLabel>
                        <TextInput @bind-Value="_model.Domain" Disabled="IsEdit">
                            <Feedback><ValidationError>Domain is required.</ValidationError></Feedback>
                        </TextInput>
                        <FieldHelp>@(IsEdit ? "Domain cannot be changed after creation." : "e.g. contoso.com")</FieldHelp>
                    </Field>
                </Validation>
                <Field>
                    <FieldLabel>Language code</FieldLabel>
                    <TextInput @bind-Value="_model.LanguageCode" />
                    <FieldHelp>e.g. en-US</FieldHelp>
                </Field>
            </CardBody>
        </Card>

        <Card Shadow="Shadow.Small" Margin="Margin.Is4.FromBottom" data-walkthrough="cf-contact">
            <CardHeader><CardTitle Size="HeadingSize.Is5" Margin="Margin.Is0">Primary contact</CardTitle></CardHeader>
            <CardBody>
                <Row>
                    <Column ColumnSize="ColumnSize.Is12.Is6.OnTablet">
                        <Field><FieldLabel>First name</FieldLabel><TextInput @bind-Value="_model.FirstName" /></Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.Is6.OnTablet">
                        <Field><FieldLabel>Last name</FieldLabel><TextInput @bind-Value="_model.LastName" /></Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.Is6.OnTablet">
                        <Field><FieldLabel>Email</FieldLabel><TextInput @bind-Value="_model.Email" Role="TextRole.Email" /></Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.Is6.OnTablet">
                        <Field><FieldLabel>Phone</FieldLabel><TextInput @bind-Value="_model.Phone" Role="TextRole.Telephone" /></Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12">
                        <Field><FieldLabel>Title</FieldLabel><TextInput @bind-Value="_model.Title" /></Field>
                    </Column>
                </Row>
            </CardBody>
        </Card>

        <Card Shadow="Shadow.Small" Margin="Margin.Is4.FromBottom" data-walkthrough="cf-address">
            <CardHeader><CardTitle Size="HeadingSize.Is5" Margin="Margin.Is0">Address</CardTitle></CardHeader>
            <CardBody>
                <Row>
                    <Column ColumnSize="ColumnSize.Is12.Is4.OnTablet">
                        <Validation Validator="ValidationRule.IsNotEmpty">
                            <Field>
                                <FieldLabel>Region code</FieldLabel>
                                <TextInput @bind-Value="_model.RegionCode">
                                    <Feedback><ValidationError>Region code is required.</ValidationError></Feedback>
                                </TextInput>
                                <FieldHelp>e.g. US</FieldHelp>
                            </Field>
                        </Validation>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.Is4.OnTablet">
                        <Field><FieldLabel>Postal code</FieldLabel><TextInput @bind-Value="_model.PostalCode" /></Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.Is4.OnTablet">
                        <Field><FieldLabel>State / province</FieldLabel><TextInput @bind-Value="_model.AdministrativeArea" /></Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.Is6.OnTablet">
                        <Field><FieldLabel>City</FieldLabel><TextInput @bind-Value="_model.Locality" /></Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is12.Is6.OnTablet">
                        <Field><FieldLabel>Address line</FieldLabel><TextInput @bind-Value="_model.AddressLine" /></Field>
                    </Column>
                </Row>
            </CardBody>
        </Card>

        <Div Flex="Flex.Default" Gap="Gap.Is3">
            <Button Color="Color.Primary" Clicked="SaveAsync" Disabled="_saving" Loading="_saving" data-walkthrough="cf-save">
                @(_saving ? "Saving…" : (IsEdit ? "Save changes" : "Create customer"))
            </Button>
            <Button Color="Color.Secondary" Outline Clicked="Cancel" Disabled="_saving">Cancel</Button>
        </Div>
    </Validations>
}

@code {
    [Parameter]
    public string? Id { get; set; }

    [SupplyParameterFromQuery(Name = "domain")]
    public string? Domain { get; set; }

    /// <summary>When set, the form manages a customer owned by this channel partner link (n-tier).</summary>
    [SupplyParameterFromQuery(Name = "linkId")]
    public string? LinkId { get; set; }

    private bool IsEdit => !string.IsNullOrEmpty(Id);

    private bool IsPartner => !string.IsNullOrEmpty(LinkId);

    private Validations? _validations;
    private readonly CustomerEditModel _model = new();
    private bool _loading;
    private bool _saving;

    private static readonly IReadOnlyList<WalkthroughStep> _walkthrough =
    [
        new("[data-walkthrough=\"cf-org\"]", "Organization name", "Type the customer's organization name to continue.",
            RequireValueOf: "[data-walkthrough=\"cf-org\"]"),
        new("[data-walkthrough=\"cf-domain\"]", "Primary domain", "Enter the domain you verified in the Cloud Identity check — it can't be changed later.",
            RequireValueOf: "[data-walkthrough=\"cf-domain\"]"),
        new("[data-walkthrough=\"cf-contact\"]", "Primary contact", "Optional contact details for the customer's main administrator."),
        new("[data-walkthrough=\"cf-address\"]", "Address", "Region code is required; the rest helps with tax and billing."),
        new("[data-walkthrough=\"cf-save\"]", "Create the customer", "Submit to create the reseller customer, then purchase entitlements for them."),
    ];

    protected override async Task OnParametersSetAsync()
    {
        if (!IsEdit)
        {
            if (!string.IsNullOrWhiteSpace(Domain) && string.IsNullOrWhiteSpace(_model.Domain))
            {
                _model.Domain = Domain;
            }

            return;
        }

        _loading = true;
        try
        {
            var customer = IsPartner
                ? await Api.GetChannelPartnerCustomerAsync(LinkId!, Id!)
                : await Api.GetCustomerAsync(Id!);
            if (customer is not null)
            {
                _model.OrgDisplayName = customer.OrgDisplayName ?? string.Empty;
                _model.Domain = customer.Domain ?? string.Empty;
                _model.LanguageCode = customer.LanguageCode;
                _model.FirstName = customer.PrimaryContact?.FirstName;
                _model.LastName = customer.PrimaryContact?.LastName;
                _model.Email = customer.PrimaryContact?.Email;
                _model.Phone = customer.PrimaryContact?.Phone;
                _model.Title = customer.PrimaryContact?.Title;
                _model.RegionCode = customer.Address?.RegionCode ?? string.Empty;
                _model.PostalCode = customer.Address?.PostalCode;
                _model.AdministrativeArea = customer.Address?.AdministrativeArea;
                _model.Locality = customer.Address?.Locality;
                _model.AddressLine = customer.Address?.AddressLines.FirstOrDefault();
            }
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load customer: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_validations is not null && !await _validations.ValidateAll())
        {
            return;
        }

        _saving = true;
        try
        {
            var request = _model.ToRequest(Id);
            var saved = IsPartner
                ? (IsEdit
                    ? await Api.UpdateChannelPartnerCustomerAsync(LinkId!, Id!, request)
                    : await Api.CreateChannelPartnerCustomerAsync(LinkId!, request))
                : (IsEdit
                    ? await Api.UpdateCustomerAsync(Id!, request)
                    : await Api.CreateCustomerAsync(request));

            await Snackbar.Add(IsEdit ? "Customer updated." : "Customer created.", Severity.Success);
            Nav.NavigateTo(IsPartner ? $"/channel-partner-links/{LinkId}" : (saved is not null ? $"/customers/{saved.Id}" : "/customers"));
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to save customer: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() =>
        Nav.NavigateTo(IsPartner
            ? $"/channel-partner-links/{LinkId}"
            : (IsEdit ? $"/customers/{Id}" : "/customers"));

    private sealed class CustomerEditModel
    {
        public string OrgDisplayName { get; set; } = string.Empty;
        public string Domain { get; set; } = string.Empty;
        public string? LanguageCode { get; set; }
        public string? FirstName { get; set; }
        public string? LastName { get; set; }
        public string? Email { get; set; }
        public string? Phone { get; set; }
        public string? Title { get; set; }
        public string RegionCode { get; set; } = string.Empty;
        public string? PostalCode { get; set; }
        public string? AdministrativeArea { get; set; }
        public string? Locality { get; set; }
        public string? AddressLine { get; set; }

        public SaveCustomerRequest ToRequest(string? id) => new()
        {
            Id = id,
            OrgDisplayName = OrgDisplayName,
            Domain = Domain,
            LanguageCode = LanguageCode,
            PrimaryContact = HasContact
                ? new CustomerContact
                {
                    FirstName = FirstName,
                    LastName = LastName,
                    Email = Email,
                    Phone = Phone,
                    Title = Title
                }
                : null,
            Address = new CustomerAddress
            {
                RegionCode = RegionCode,
                PostalCode = PostalCode,
                AdministrativeArea = AdministrativeArea,
                Locality = Locality,
                AddressLines = string.IsNullOrWhiteSpace(AddressLine) ? [] : [AddressLine!]
            }
        };

        private bool HasContact =>
            !string.IsNullOrWhiteSpace(FirstName) || !string.IsNullOrWhiteSpace(LastName) ||
            !string.IsNullOrWhiteSpace(Email) || !string.IsNullOrWhiteSpace(Phone) ||
            !string.IsNullOrWhiteSpace(Title);
    }
}
