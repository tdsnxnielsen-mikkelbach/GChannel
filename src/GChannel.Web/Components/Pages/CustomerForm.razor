@page "/customers/new"
@page "/customers/edit/{Id}"
@attribute [Authorize]
@inject GChannelApiClient Api
@inject UiNotifier Snackbar
@inject NavigationManager Nav

<PageTitle>@(IsEdit ? "Edit customer" : "New customer") · GChannel</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="1rem" class="rz-mb-4">
    <RadzenText TextStyle="TextStyle.H4" class="rz-m-0">@(IsEdit ? "Edit customer" : "New customer")</RadzenText>
    @if (!IsEdit)
    {
        <GuidedWalkthrough Id="customer-new" Steps="_walkthrough" AutoStart="true" />
    }
</RadzenStack>

@if (_loading)
{
    <LoadingPanel Title="Loading customer…"
                  Hint="Fetching the customer's current details." />
}
else
{
    <RadzenTemplateForm TItem="CustomerEditModel" Data="_model" Submit="SaveAsync">
        <RadzenCard Variant="Variant.Filled" class="rz-mb-4">
            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">Organization</RadzenText>
            <RadzenStack Gap="1rem">
                <div data-walkthrough="cf-org">
                    <RadzenFormField Text="Organization name" Variant="Variant.Outlined" Style="width:100%">
                        <ChildContent><RadzenTextBox @bind-Value="_model.OrgDisplayName" Name="OrgDisplayName" /></ChildContent>
                        <Helper><RadzenRequiredValidator Component="OrgDisplayName" Text="Organization name is required." /></Helper>
                    </RadzenFormField>
                </div>
                <div data-walkthrough="cf-domain">
                    <RadzenFormField Text="Primary domain" Variant="Variant.Outlined" Style="width:100%">
                        <ChildContent><RadzenTextBox @bind-Value="_model.Domain" Name="Domain" Disabled="IsEdit" /></ChildContent>
                        <Helper>
                            <RadzenRequiredValidator Component="Domain" Text="Domain is required." />
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">@(IsEdit ? "Domain cannot be changed after creation." : "e.g. contoso.com")</RadzenText>
                        </Helper>
                    </RadzenFormField>
                </div>
                <RadzenFormField Text="Language code" Variant="Variant.Outlined" Style="width:100%">
                    <ChildContent><RadzenTextBox @bind-Value="_model.LanguageCode" Name="LanguageCode" /></ChildContent>
                    <Helper><RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">e.g. en-US</RadzenText></Helper>
                </RadzenFormField>
            </RadzenStack>
        </RadzenCard>

        <RadzenCard Variant="Variant.Filled" class="rz-mb-4" data-walkthrough="cf-contact">
            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">Primary contact</RadzenText>
            <RadzenRow Gap="1rem" RowGap="1rem">
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="First name" Variant="Variant.Outlined" Style="width:100%"><RadzenTextBox @bind-Value="_model.FirstName" Name="FirstName" /></RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Last name" Variant="Variant.Outlined" Style="width:100%"><RadzenTextBox @bind-Value="_model.LastName" Name="LastName" /></RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Email" Variant="Variant.Outlined" Style="width:100%"><RadzenTextBox @bind-Value="_model.Email" Name="Email" type="email" /></RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Phone" Variant="Variant.Outlined" Style="width:100%"><RadzenTextBox @bind-Value="_model.Phone" Name="Phone" type="tel" /></RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12">
                    <RadzenFormField Text="Title" Variant="Variant.Outlined" Style="width:100%"><RadzenTextBox @bind-Value="_model.Title" Name="Title" /></RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        <RadzenCard Variant="Variant.Filled" class="rz-mb-4" data-walkthrough="cf-address">
            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-3">Address</RadzenText>
            <RadzenRow Gap="1rem" RowGap="1rem">
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Region code" Variant="Variant.Outlined" Style="width:100%">
                        <ChildContent><RadzenTextBox @bind-Value="_model.RegionCode" Name="RegionCode" /></ChildContent>
                        <Helper>
                            <RadzenRequiredValidator Component="RegionCode" Text="Region code is required." />
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-m-0">e.g. US</RadzenText>
                        </Helper>
                    </RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="Postal code" Variant="Variant.Outlined" Style="width:100%"><RadzenTextBox @bind-Value="_model.PostalCode" Name="PostalCode" /></RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="4">
                    <RadzenFormField Text="State / province" Variant="Variant.Outlined" Style="width:100%"><RadzenTextBox @bind-Value="_model.AdministrativeArea" Name="AdministrativeArea" /></RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="City" Variant="Variant.Outlined" Style="width:100%"><RadzenTextBox @bind-Value="_model.Locality" Name="Locality" /></RadzenFormField>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenFormField Text="Address line" Variant="Variant.Outlined" Style="width:100%"><RadzenTextBox @bind-Value="_model.AddressLine" Name="AddressLine" /></RadzenFormField>
                </RadzenColumn>
            </RadzenRow>
        </RadzenCard>

        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem">
            <RadzenButton ButtonType="ButtonType.Submit" Text="@(IsEdit ? "Save changes" : "Create customer")" ButtonStyle="ButtonStyle.Primary"
                          IsBusy="_saving" BusyText="Saving…" data-walkthrough="cf-save" />
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined" Click="Cancel" Disabled="_saving" />
        </RadzenStack>
    </RadzenTemplateForm>
}

@code {
    [Parameter]
    public string? Id { get; set; }

    [SupplyParameterFromQuery(Name = "domain")]
    public string? Domain { get; set; }

    /// <summary>When set, the form manages a customer owned by this channel partner link (n-tier).</summary>
    [SupplyParameterFromQuery(Name = "linkId")]
    public string? LinkId { get; set; }

    private bool IsEdit => !string.IsNullOrEmpty(Id);

    private bool IsPartner => !string.IsNullOrEmpty(LinkId);

    private readonly CustomerEditModel _model = new();
    private bool _loading;
    private bool _saving;

    private static readonly IReadOnlyList<WalkthroughStep> _walkthrough =
    [
        new("[data-walkthrough=\"cf-org\"]", "Organization name", "Type the customer's organization name to continue.",
            RequireValueOf: "[data-walkthrough=\"cf-org\"]"),
        new("[data-walkthrough=\"cf-domain\"]", "Primary domain", "Enter the domain you verified in the Cloud Identity check — it can't be changed later.",
            RequireValueOf: "[data-walkthrough=\"cf-domain\"]"),
        new("[data-walkthrough=\"cf-contact\"]", "Primary contact", "Optional contact details for the customer's main administrator."),
        new("[data-walkthrough=\"cf-address\"]", "Address", "Region code is required; the rest helps with tax and billing."),
        new("[data-walkthrough=\"cf-save\"]", "Create the customer", "Submit to create the reseller customer, then purchase entitlements for them."),
    ];

    protected override async Task OnParametersSetAsync()
    {
        if (!IsEdit)
        {
            if (!string.IsNullOrWhiteSpace(Domain) && string.IsNullOrWhiteSpace(_model.Domain))
            {
                _model.Domain = Domain;
            }

            return;
        }

        _loading = true;
        try
        {
            var customer = IsPartner
                ? await Api.GetChannelPartnerCustomerAsync(LinkId!, Id!)
                : await Api.GetCustomerAsync(Id!);
            if (customer is not null)
            {
                _model.OrgDisplayName = customer.OrgDisplayName ?? string.Empty;
                _model.Domain = customer.Domain ?? string.Empty;
                _model.LanguageCode = customer.LanguageCode;
                _model.FirstName = customer.PrimaryContact?.FirstName;
                _model.LastName = customer.PrimaryContact?.LastName;
                _model.Email = customer.PrimaryContact?.Email;
                _model.Phone = customer.PrimaryContact?.Phone;
                _model.Title = customer.PrimaryContact?.Title;
                _model.RegionCode = customer.Address?.RegionCode ?? string.Empty;
                _model.PostalCode = customer.Address?.PostalCode;
                _model.AdministrativeArea = customer.Address?.AdministrativeArea;
                _model.Locality = customer.Address?.Locality;
                _model.AddressLine = customer.Address?.AddressLines.FirstOrDefault();
            }
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to load customer: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // Only called by RadzenTemplateForm once the required-field validators pass.
    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            var request = _model.ToRequest(Id);
            var saved = IsPartner
                ? (IsEdit
                    ? await Api.UpdateChannelPartnerCustomerAsync(LinkId!, Id!, request)
                    : await Api.CreateChannelPartnerCustomerAsync(LinkId!, request))
                : (IsEdit
                    ? await Api.UpdateCustomerAsync(Id!, request)
                    : await Api.CreateCustomerAsync(request));

            await Snackbar.Add(IsEdit ? "Customer updated." : "Customer created.", Severity.Success);
            Nav.NavigateTo(IsPartner ? $"/channel-partner-links/{LinkId}" : (saved is not null ? $"/customers/{saved.Id}" : "/customers"));
        }
        catch (Exception ex)
        {
            await Snackbar.Add($"Failed to save customer: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() =>
        Nav.NavigateTo(IsPartner
            ? $"/channel-partner-links/{LinkId}"
            : (IsEdit ? $"/customers/{Id}" : "/customers"));

    private sealed class CustomerEditModel
    {
        public string OrgDisplayName { get; set; } = string.Empty;
        public string Domain { get; set; } = string.Empty;
        public string? LanguageCode { get; set; }
        public string? FirstName { get; set; }
        public string? LastName { get; set; }
        public string? Email { get; set; }
        public string? Phone { get; set; }
        public string? Title { get; set; }
        public string RegionCode { get; set; } = string.Empty;
        public string? PostalCode { get; set; }
        public string? AdministrativeArea { get; set; }
        public string? Locality { get; set; }
        public string? AddressLine { get; set; }

        public SaveCustomerRequest ToRequest(string? id) => new()
        {
            Id = id,
            OrgDisplayName = OrgDisplayName,
            Domain = Domain,
            LanguageCode = LanguageCode,
            PrimaryContact = HasContact
                ? new CustomerContact
                {
                    FirstName = FirstName,
                    LastName = LastName,
                    Email = Email,
                    Phone = Phone,
                    Title = Title
                }
                : null,
            Address = new CustomerAddress
            {
                RegionCode = RegionCode,
                PostalCode = PostalCode,
                AdministrativeArea = AdministrativeArea,
                Locality = Locality,
                AddressLines = string.IsNullOrWhiteSpace(AddressLine) ? [] : [AddressLine!]
            }
        };

        private bool HasContact =>
            !string.IsNullOrWhiteSpace(FirstName) || !string.IsNullOrWhiteSpace(LastName) ||
            !string.IsNullOrWhiteSpace(Email) || !string.IsNullOrWhiteSpace(Phone) ||
            !string.IsNullOrWhiteSpace(Title);
    }
}
