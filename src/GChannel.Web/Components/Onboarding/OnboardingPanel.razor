@using Blazorise
@inject OnboardingStateService Onboarding
@inject OnboardingTourService Tour
@inject NavigationManager Nav

@* §9 phase 1: first-run welcome card + dashboard onboarding checklist. State persists per-browser. *@

@if (_state is not null && !_state.WelcomeDismissed)
{
    <Modal Visible="true" Closing="@(e => { e.Cancel = true; return Task.CompletedTask; })" ShowBackdrop>
        <ModalContent Centered>
            <ModalBody Padding="Padding.Is4">
                <Div Flex="Flex.AlignItems.Center" Margin="Margin.Is3.FromBottom">
                    <Icon Name="@AppIcons.WavingHand" TextColor="TextColor.Primary" IconSize="IconSize.x2" Margin="Margin.Is3.FromEnd" />
                    <Heading Size="HeadingSize.Is4" Margin="Margin.Is0">Welcome to GChannel</Heading>
                </Div>
                <Paragraph Margin="Margin.Is2.FromBottom">
                    This console manages your Google Cloud reseller business — customers, catalog SKUs,
                    entitlements, transfers and eventing.
                </Paragraph>
                <Paragraph TextColor="TextColor.Secondary" Margin="Margin.Is4.FromBottom">
                    We'll add a short checklist to your dashboard to help you complete the first key steps.
                </Paragraph>
                <Div Flex="Flex.JustifyContent.End" Gap="Gap.Is2">
                    <Button Color="Color.Secondary" Clicked="SkipAsync" Class="btn-link text-decoration-none">Skip onboarding</Button>
                    <Button Color="Color.Primary" Outline Clicked="GetStartedAsync">Maybe later</Button>
                    <Button Color="Color.Primary" Clicked="TakeTourAsync">
                        <Icon Name="@AppIcons.Tour" Class="me-1" /> Take a tour
                    </Button>
                </Div>
            </ModalBody>
        </ModalContent>
    </Modal>
}

@if (_state is not null && _state.WelcomeDismissed && !_state.ChecklistDismissed)
{
    <Card Margin="Margin.Is4.FromBottom">
        <CardBody>
            <Div Flex="Flex.AlignItems.Center.JustifyContent.Between" Margin="Margin.Is2.FromBottom">
                <Div Flex="Flex.AlignItems.Center">
                    <Icon Name="@AppIcons.Checklist" TextColor="TextColor.Primary" Margin="Margin.Is2.FromEnd" />
                    <Heading Size="HeadingSize.Is5" Margin="Margin.Is0">Getting started</Heading>
                </Div>
                <Div Flex="Flex.AlignItems.Center" Gap="Gap.Is2">
                    <Small TextColor="TextColor.Secondary">@CompletedCount of @Steps.Count done</Small>
                    <Button Color="Color.Primary" Size="Size.Small" Clicked="RestartTourAsync" Class="btn-link text-decoration-none">
                        <Icon Name="@AppIcons.Tour" Class="me-1" /> Restart tour
                    </Button>
                    <Tooltip Text="Hide this checklist" Inline>
                        <Button Color="Color.Secondary" Size="Size.Small" Clicked="DismissChecklistAsync" Class="btn-link" aria-label="Hide this checklist">
                            <Icon Name="@AppIcons.Close" />
                        </Button>
                    </Tooltip>
                </Div>
            </Div>

            <Progress Value="@((int)Math.Round(ProgressValue))" Color="Color.Primary" Size="Size.Small" Margin="Margin.Is3.FromBottom" />

            <ListGroup Flush>
                @foreach (var step in Steps)
                {
                    var done = IsDone(step);
                    <ListGroupItem Padding="Padding.Is0.OnX.Is2.OnY">
                        <Div Flex="Flex.AlignItems.Center.JustifyContent.Between" Width="Width.Is100">
                            <Div Flex="Flex.AlignItems.Center" Gap="Gap.Is3">
                                @if (step.Manual)
                                {
                                    <Check TValue="bool" Value="done" ValueChanged="@(v => ToggleManualAsync(step, v))" />
                                }
                                else
                                {
                                    <Icon Name="@(done ? AppIcons.CheckCircle : AppIcons.RadioButtonUnchecked)"
                                          TextColor="@(done ? TextColor.Success : TextColor.Secondary)" />
                                }
                                <Div>
                                    <Text Display="Display.Block" Style="@(done ? "text-decoration: line-through; opacity: 0.7;" : null)">
                                        @step.Title
                                    </Text>
                                    <Small TextColor="TextColor.Secondary">@step.Description</Small>
                                </Div>
                            </Div>
                            <Button Color="Color.Primary" Size="Size.Small" Class="btn-link text-decoration-none text-nowrap"
                                    Clicked="@(() => Nav.NavigateTo(step.Link))">
                                @step.Action <Icon Name="@AppIcons.ArrowForward" Class="ms-1" />
                            </Button>
                        </Div>
                    </ListGroupItem>
                }
            </ListGroup>
        </CardBody>
    </Card>
}

@if (_state is not null && _state.WelcomeDismissed && _state.ChecklistDismissed)
{
    <Div Flex="Flex.JustifyContent.End.AlignItems.Center" Gap="Gap.Is1" Margin="Margin.Is4.FromBottom">
        <Button Color="Color.Primary" Size="Size.Small" Clicked="RestartTourAsync" Class="btn-link text-decoration-none">
            <Icon Name="@AppIcons.Tour" Class="me-1" /> Take the product tour
        </Button>
        <Button Color="Color.Secondary" Size="Size.Small" Clicked="ShowChecklistAsync" Class="btn-link text-decoration-none">
            <Icon Name="@AppIcons.Checklist" Class="me-1" /> Show checklist
        </Button>
    </Div>
}

@code {
    /// <summary>Number of customers from the dashboard — drives the "create a customer" step.</summary>
    [Parameter]
    public int CustomerCount { get; set; }

    /// <summary>Total entitlements (active + trial + suspended) — drives the "purchase" step.</summary>
    [Parameter]
    public int EntitlementCount { get; set; }

    private OnboardingState? _state;

    private sealed record Step(string Key, string Title, string Description, string Action, string Link, bool Manual);

    private List<Step> Steps =>
    [
        new("verify-domain", "Verify a customer's domain", "Check a domain's Cloud Identity status before you onboard it.",
            "Open", "/accounts/cloud-identity", Manual: true),
        new("create-customer", "Create your first customer", "Add a reseller customer to start managing entitlements.",
            "Add", "/customers/new", Manual: false),
        new("buy-entitlement", "Purchase an entitlement", "Assign a SKU to a customer from the catalog.",
            "Browse", "/customers", Manual: false),
        new("eventing", "Explore eventing", "Review operations and Pub/Sub notifications for live activity.",
            "View", "/notifications", Manual: true),
    ];

    private bool IsDone(Step step)
    {
        if (_state is not null && _state.CompletedSteps.Contains(step.Key))
        {
            return true;
        }

        return step.Key switch
        {
            "create-customer" => CustomerCount > 0,
            "buy-entitlement" => EntitlementCount > 0,
            _ => false,
        };
    }

    private int CompletedCount => Steps.Count(IsDone);

    private double ProgressValue => Steps.Count == 0 ? 0 : (double)CompletedCount / Steps.Count * 100;

    // Protected local storage is only reachable on the live circuit, so load after the first render.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _state = await Onboarding.LoadAsync();
        StateHasChanged();
    }

    private async Task GetStartedAsync()
    {
        if (_state is null)
        {
            return;
        }

        _state.WelcomeDismissed = true;
        await Onboarding.SaveAsync(_state);
    }

    private async Task TakeTourAsync()
    {
        if (_state is null)
        {
            return;
        }

        _state.WelcomeDismissed = true;
        await Onboarding.SaveAsync(_state);
        StateHasChanged();
        await Tour.StartAsync();
    }

    private async Task SkipAsync()
    {
        if (_state is null)
        {
            return;
        }

        _state.WelcomeDismissed = true;
        _state.ChecklistDismissed = true;
        await Onboarding.SaveAsync(_state);
    }

    private async Task DismissChecklistAsync()
    {
        if (_state is null)
        {
            return;
        }

        _state.ChecklistDismissed = true;
        await Onboarding.SaveAsync(_state);
    }

    private async Task ShowChecklistAsync()
    {
        if (_state is null)
        {
            return;
        }

        _state.ChecklistDismissed = false;
        await Onboarding.SaveAsync(_state);
    }

    private Task RestartTourAsync() => Tour.StartAsync();

    private async Task ToggleManualAsync(Step step, bool value)
    {
        if (_state is null)
        {
            return;
        }

        if (value)
        {
            if (!_state.CompletedSteps.Contains(step.Key))
            {
                _state.CompletedSteps.Add(step.Key);
            }
        }
        else
        {
            _state.CompletedSteps.Remove(step.Key);
        }

        await Onboarding.SaveAsync(_state);
    }
}
