@inject OnboardingStateService Onboarding
@inject OnboardingTourService Tour
@inject NavigationManager Nav

@* §9 phase 1: first-run welcome card + dashboard onboarding checklist. State persists per-browser. *@

@if (_state is not null && !_state.WelcomeDismissed)
{
    <div class="gchannel-overlay" role="dialog" aria-modal="true" aria-labelledby="gchannel-welcome-title">
        <RadzenCard Variant="Variant.Filled" Style="max-width: 36rem; width: 100%" class="rz-p-6 rz-shadow-6">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem" class="rz-mb-3">
                <RadzenIcon Icon="@AppIcons.WavingHand" IconColor="@Colors.Primary" Style="font-size: 2.5rem; width: auto; height: auto" />
                <RadzenText TextStyle="TextStyle.H5" class="rz-m-0" id="gchannel-welcome-title">Welcome to GChannel</RadzenText>
            </RadzenStack>
            <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-2">
                This console manages your Google Cloud reseller business — customers, catalog SKUs,
                entitlements, transfers and eventing.
            </RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color rz-mb-5">
                We'll add a short checklist to your dashboard to help you complete the first key steps.
            </RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <RadzenButton Text="Skip onboarding" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Click="SkipAsync" />
                <RadzenButton Text="Maybe later" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Click="GetStartedAsync" />
                <RadzenButton Text="Take a tour" Icon="@AppIcons.Tour" ButtonStyle="ButtonStyle.Primary" Click="TakeTourAsync" />
            </RadzenStack>
        </RadzenCard>
    </div>
}

@if (_state is not null && _state.WelcomeDismissed && !_state.ChecklistDismissed)
{
    <RadzenCard Variant="Variant.Filled" class="rz-mb-5">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem" Wrap="FlexWrap.Wrap" class="rz-mb-2">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenIcon Icon="@AppIcons.Checklist" IconColor="@Colors.Primary" />
                <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">Getting started</RadzenText>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">@CompletedCount of @Steps.Count done</RadzenText>
                <RadzenButton Text="Restart tour" Icon="@AppIcons.Tour" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text" Size="ButtonSize.Small" Click="RestartTourAsync" />
                <Tip Text="Hide this checklist">
                    <RadzenButton Icon="@AppIcons.Close" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small" Click="DismissChecklistAsync" aria-label="Hide this checklist" />
                </Tip>
            </RadzenStack>
        </RadzenStack>

        <RadzenProgressBar Value="@Math.Round(ProgressValue)" ShowValue="false" ProgressBarStyle="ProgressBarStyle.Primary" Style="height: 6px" class="rz-mb-3" />

        <RadzenStack Gap="0">
            @foreach (var step in Steps)
            {
                var done = IsDone(step);
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Gap="0.75rem" class="rz-py-2 rz-border-bottom rz-border-color-base-200 gchannel-checklist-item">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                        @if (step.Manual)
                        {
                            <RadzenCheckBox TValue="bool" Value="done" Change="@((bool v) => ToggleManualAsync(step, v))" aria-label="@step.Title" />
                        }
                        else
                        {
                            <RadzenIcon Icon="@(done ? AppIcons.CheckCircle : AppIcons.RadioButtonUnchecked)" IconColor="@(done ? Colors.Success : Colors.Base500)" />
                        }
                        <div>
                            <RadzenText TextStyle="TextStyle.Body1" class="rz-m-0" Style="@(done ? "text-decoration: line-through; opacity: 0.7;" : null)">
                                @step.Title
                            </RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">@step.Description</RadzenText>
                        </div>
                    </RadzenStack>
                    <RadzenButton Text="@step.Action" Icon="@AppIcons.ArrowForward" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text" Size="ButtonSize.Small"
                                  Click="@(() => Nav.NavigateTo(step.Link))" class="rz-text-nowrap" />
                </RadzenStack>
            }
        </RadzenStack>
    </RadzenCard>
}

@if (_state is not null && _state.WelcomeDismissed && _state.ChecklistDismissed)
{
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="0.25rem" class="rz-mb-5">
        <RadzenButton Text="Take the product tour" Icon="@AppIcons.Tour" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text" Size="ButtonSize.Small" Click="RestartTourAsync" />
        <RadzenButton Text="Show checklist" Icon="@AppIcons.Checklist" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small" Click="ShowChecklistAsync" />
    </RadzenStack>
}

@code {
    /// <summary>Number of customers from the dashboard — drives the "create a customer" step.</summary>
    [Parameter]
    public int CustomerCount { get; set; }

    /// <summary>Total entitlements (active + trial + suspended) — drives the "purchase" step.</summary>
    [Parameter]
    public int EntitlementCount { get; set; }

    private OnboardingState? _state;

    private sealed record Step(string Key, string Title, string Description, string Action, string Link, bool Manual);

    private List<Step> Steps =>
    [
        new("verify-domain", "Verify a customer's domain", "Check a domain's Cloud Identity status before you onboard it.",
            "Open", "/accounts/cloud-identity", Manual: true),
        new("create-customer", "Create your first customer", "Add a reseller customer to start managing entitlements.",
            "Add", "/customers/new", Manual: false),
        new("buy-entitlement", "Purchase an entitlement", "Assign a SKU to a customer from the catalog.",
            "Browse", "/customers", Manual: false),
        new("eventing", "Explore eventing", "Review operations and Pub/Sub notifications for live activity.",
            "View", "/notifications", Manual: true),
    ];

    private bool IsDone(Step step)
    {
        if (_state is not null && _state.CompletedSteps.Contains(step.Key))
        {
            return true;
        }

        return step.Key switch
        {
            "create-customer" => CustomerCount > 0,
            "buy-entitlement" => EntitlementCount > 0,
            _ => false,
        };
    }

    private int CompletedCount => Steps.Count(IsDone);

    private double ProgressValue => Steps.Count == 0 ? 0 : (double)CompletedCount / Steps.Count * 100;

    // Protected local storage is only reachable on the live circuit, so load after the first render.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _state = await Onboarding.LoadAsync();
        StateHasChanged();
    }

    private async Task GetStartedAsync()
    {
        if (_state is null)
        {
            return;
        }

        _state.WelcomeDismissed = true;
        await Onboarding.SaveAsync(_state);
    }

    private async Task TakeTourAsync()
    {
        if (_state is null)
        {
            return;
        }

        _state.WelcomeDismissed = true;
        await Onboarding.SaveAsync(_state);
        StateHasChanged();
        await Tour.StartAsync();
    }

    private async Task SkipAsync()
    {
        if (_state is null)
        {
            return;
        }

        _state.WelcomeDismissed = true;
        _state.ChecklistDismissed = true;
        await Onboarding.SaveAsync(_state);
    }

    private async Task DismissChecklistAsync()
    {
        if (_state is null)
        {
            return;
        }

        _state.ChecklistDismissed = true;
        await Onboarding.SaveAsync(_state);
    }

    private async Task ShowChecklistAsync()
    {
        if (_state is null)
        {
            return;
        }

        _state.ChecklistDismissed = false;
        await Onboarding.SaveAsync(_state);
    }

    private Task RestartTourAsync() => Tour.StartAsync();

    private async Task ToggleManualAsync(Step step, bool value)
    {
        if (_state is null)
        {
            return;
        }

        if (value)
        {
            if (!_state.CompletedSteps.Contains(step.Key))
            {
                _state.CompletedSteps.Add(step.Key);
            }
        }
        else
        {
            _state.CompletedSteps.Remove(step.Key);
        }

        await Onboarding.SaveAsync(_state);
    }
}

