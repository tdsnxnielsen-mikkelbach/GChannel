@inject IJSRuntime JS
@inject OnboardingStateService Onboarding
@implements IAsyncDisposable

@* §9 phase 3: a page-scoped guided walkthrough. Renders a "Show me how" launcher and (optionally)
   auto-runs once per user, reusing the Driver.js interop from phase 2. Completion persists per Id. *@

<MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
           StartIcon="@Icons.Material.Filled.Lightbulb" OnClick="StartAsync" Class="@Class">
    @ButtonText
</MudButton>

@code {
    /// <summary>Stable id for this walkthrough; completion is stored under "wt:{Id}".</summary>
    [Parameter, EditorRequired]
    public string Id { get; set; } = "";

    /// <summary>Ordered popover steps. Steps whose target element is absent are skipped client-side.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<WalkthroughStep> Steps { get; set; } = [];

    /// <summary>When true, the walkthrough runs automatically the first time a user reaches the page.</summary>
    [Parameter]
    public bool AutoStart { get; set; }

    [Parameter]
    public string ButtonText { get; set; } = "Show me how";

    [Parameter]
    public string? Class { get; set; }

    private IJSObjectReference? _module;
    private DotNetObjectReference<GuidedWalkthrough>? _selfRef;
    private OnboardingState? _state;

    private string StepKey => $"wt:{Id}";

    // Storage + JS interop are only reachable on the live circuit, so load (and maybe auto-start) after
    // the first render once the page's target elements exist.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _state = await Onboarding.LoadAsync();
        if (AutoStart && !_state.CompletedSteps.Contains(StepKey))
        {
            await StartAsync();
        }
    }

    public async Task StartAsync()
    {
        if (Steps.Count == 0)
        {
            return;
        }

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/onboarding.js");
        _selfRef ??= DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("startTour", _selfRef, Steps);
    }

    [JSInvokable]
    public async Task OnTourCompleted()
    {
        _state ??= await Onboarding.LoadAsync();
        if (_state.CompletedSteps.Contains(StepKey))
        {
            return;
        }

        _state.CompletedSteps.Add(StepKey);
        await Onboarding.SaveAsync(_state);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch
            {
                // Circuit already gone.
            }
        }

        _selfRef?.Dispose();
    }
}
