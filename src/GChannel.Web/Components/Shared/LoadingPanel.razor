@namespace GChannel.Web.Components

@*
    Shared loading indicator: a centered spinner plus a short title and an optional explanatory hint so the
    user knows what is being fetched and why it might take a moment (some Channel API aggregations are slow).
*@

<RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="0.75rem" class="@($"rz-p-8 rz-my-6 {Class}")">
    <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Large" ShowValue="false" aria-label="Loading" />
    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.P" class="rz-m-0">@Title</RadzenText>
    @if (!string.IsNullOrWhiteSpace(Hint))
    {
        <RadzenText TextStyle="TextStyle.Body2" TagName="TagName.P" TextAlign="TextAlign.Center" class="rz-text-secondary-color rz-m-0" Style="max-width:32rem">
            @Hint
        </RadzenText>
    }
</RadzenStack>

@code {
    /// <summary>Short headline describing what is loading, e.g. "Loading customers…".</summary>
    [Parameter] public string Title { get; set; } = "Loading…";

    /// <summary>Optional secondary line giving extra context (data source, expected wait, etc.).</summary>
    [Parameter] public string? Hint { get; set; }

    /// <summary>Extra CSS classes to apply to the wrapper.</summary>
    [Parameter] public string? Class { get; set; }
}
