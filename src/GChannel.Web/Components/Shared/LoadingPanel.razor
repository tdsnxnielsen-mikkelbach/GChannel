@using Blazorise
@namespace GChannel.Web.Components

@*
    Shared loading indicator: a centered spinner plus a short title and an optional explanatory hint so the
    user knows what is being fetched and why it might take a moment (some Channel API aggregations are slow).
*@

<Div Flex="Flex.Column.AlignItems.Center.JustifyContent.Center" Padding="Padding.Is5" Margin="Margin.Is4.OnY" Class="@Class">
    <div class="spinner-border text-primary" role="status" style="width:3rem;height:3rem">
        <span class="visually-hidden">Loading…</span>
    </div>
    <Paragraph Margin="Margin.Is4.FromTop.Is0.FromBottom" Class="fs-5">@Title</Paragraph>
    @if (!string.IsNullOrWhiteSpace(Hint))
    {
        <Paragraph TextColor="TextColor.Secondary" TextAlignment="TextAlignment.Center" Margin="Margin.Is1.FromTop" Style="max-width:32rem">
            @Hint
        </Paragraph>
    }
</Div>

@code {
    /// <summary>Short headline describing what is loading, e.g. "Loading customers…".</summary>
    [Parameter] public string Title { get; set; } = "Loading…";

    /// <summary>Optional secondary line giving extra context (data source, expected wait, etc.).</summary>
    [Parameter] public string? Hint { get; set; }

    /// <summary>Extra CSS classes to apply to the wrapper.</summary>
    [Parameter] public string? Class { get; set; }
}
