@using Blazorise
@* Native Google vs third-party (Marketplace / partner) split of billed spend, from the export's
   transaction_type / seller_name. Used estate-wide on Spend trends and per customer on the detail page. *@

<Card Shadow="Shadow.Small">
    <CardBody>
        <Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Margin="Margin.Is1.FromBottom">
            <Div>
                <Heading Size="HeadingSize.Is5" Margin="Margin.Is0">Google Cloud vs Marketplace / partners</Heading>
                @if (Subtitle is not null)
                {
                    <Small TextColor="TextColor.Secondary">@Subtitle</Small>
                }
            </Div>
            @if (Summary?.AsOf is { } asOf)
            {
                <Small TextColor="TextColor.Secondary">as of @asOf.LocalDateTime.ToString("g")</Small>
            }
        </Div>

        @if (Loading)
        {
            <Progress Indeterminate Color="Color.Primary" Size="Size.Small" Margin="Margin.Is2.OnY" />
        }
        else if (Summary is null || Summary.Unconfigured)
        {
            <Paragraph TextColor="TextColor.Secondary">Billing export not configured.</Paragraph>
        }
        else if (Summary.ByCategory.Count == 0)
        {
            <Paragraph TextColor="TextColor.Secondary">
                No seller breakdown yet — it is populated by the next billing-export sync.
            </Paragraph>
        }
        else
        {
            @foreach (var currency in Summary.ByCategory.Select(l => l.Currency).Distinct())
            {
                var lines = Summary.ByCategory.Where(l => l.Currency == currency).ToList();
                var total = lines.Sum(l => l.Cost);
                var google = lines.Where(l => l.Category == SellerCategory.Google).Sum(l => l.Cost);
                var third = lines.Where(l => SellerCategories.IsThirdParty(l.Category)).Sum(l => l.Cost);
                var pctThird = total == 0 ? 0 : (double)(third / total) * 100;

                <Div Margin="Margin.Is3.FromBottom">
                    <Div Flex="Flex.AlignItems.Baseline" Gap="Gap.Is2" Margin="Margin.Is1.FromBottom">
                        <Heading Size="HeadingSize.Is4" Margin="Margin.Is0">@third.ToString("N0") <span style="font-size:0.7em">@currency</span></Heading>
                        <Small TextColor="TextColor.Secondary">third-party · @pctThird.ToString("0.#")% of @total.ToString("N0")</Small>
                    </Div>
                    <Progress Value="@((int)Math.Round(pctThird))" Color="Color.Secondary" Size="Size.Small" Margin="Margin.Is2.FromBottom" />
                    <Table Narrow Hoverable Borderless>
                        <TableBody>
                            @foreach (var l in lines.OrderBy(l => l.Category))
                            {
                                <TableRow>
                                    <TableRowCell>
                                        <Badge Color="@CategoryColor(l.Category)" Pill>@SellerCategories.Label(l.Category)</Badge>
                                    </TableRowCell>
                                    <TableRowCell TextAlignment="TextAlignment.End">@l.Cost.ToString("N2")</TableRowCell>
                                    <TableRowCell TextAlignment="TextAlignment.End">
                                        <Small TextColor="TextColor.Secondary">@(total == 0 ? "—" : $"{(double)(l.Cost / total) * 100:0.#}%")</Small>
                                    </TableRowCell>
                                </TableRow>
                            }
                        </TableBody>
                    </Table>
                </Div>
            }

            @if (Summary.ThirdPartySellers.Count > 0)
            {
                <Heading Size="HeadingSize.Is6" Margin="Margin.Is2.FromTop.Is1.FromBottom">Third-party sellers</Heading>
                <Table Narrow Hoverable Borderless>
                    <TableHeader>
                        <TableRow>
                            <TableHeaderCell>Seller</TableHeaderCell>
                            <TableHeaderCell>Via</TableHeaderCell>
                            <TableHeaderCell TextAlignment="TextAlignment.End">Net cost</TableHeaderCell>
                            <TableHeaderCell>Currency</TableHeaderCell>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @foreach (var s in Summary.ThirdPartySellers.Take(MaxRows))
                        {
                            <TableRow>
                                <TableRowCell>@s.SellerName</TableRowCell>
                                <TableRowCell><Small TextColor="TextColor.Secondary">@SellerCategories.Label(s.Category)</Small></TableRowCell>
                                <TableRowCell TextAlignment="TextAlignment.End">@s.Cost.ToString("N2")</TableRowCell>
                                <TableRowCell>@s.Currency</TableRowCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
            }

            @if (ShowProducts && Summary.ThirdPartyProducts.Count > 0)
            {
                <Heading Size="HeadingSize.Is6" Margin="Margin.Is3.FromTop.Is1.FromBottom">Third-party products</Heading>
                <Table Narrow Hoverable Borderless>
                    <TableHeader>
                        <TableRow>
                            <TableHeaderCell>Product</TableHeaderCell>
                            <TableHeaderCell>Seller</TableHeaderCell>
                            <TableHeaderCell TextAlignment="TextAlignment.End">Net cost</TableHeaderCell>
                            <TableHeaderCell>Currency</TableHeaderCell>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @foreach (var p in Summary.ThirdPartyProducts.Take(MaxRows))
                        {
                            <TableRow>
                                <TableRowCell>@p.ServiceDescription</TableRowCell>
                                <TableRowCell><Small TextColor="TextColor.Secondary">@p.SellerName</Small></TableRowCell>
                                <TableRowCell TextAlignment="TextAlignment.End">@p.Cost.ToString("N2")</TableRowCell>
                                <TableRowCell>@p.Currency</TableRowCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
            }

            <Small TextColor="TextColor.Secondary" Display="Display.Block" Margin="Margin.Is2.FromTop">
                Split by the export's <code>transaction_type</code>: GOOGLE = native Google Cloud; THIRD_PARTY_RESELLER / THIRD_PARTY_AGENCY = Marketplace, ISV and partner products. "Unclassified" covers taxes, adjustments and rows without a type.
                @if (Summary.InvoiceMonths.Count > 0)
                {
                    <span> Window: @FormatMonth(Summary.InvoiceMonths.First())@(Summary.InvoiceMonths.Count > 1 ? $" – {FormatMonth(Summary.InvoiceMonths.Last())}" : "").</span>
                }
            </Small>
        }
    </CardBody>
</Card>

@code {
    [Parameter] public SellerSpendSummary? Summary { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public bool ShowProducts { get; set; } = true;
    [Parameter] public int MaxRows { get; set; } = 10;

    private static Color CategoryColor(SellerCategory c) => c switch
    {
        SellerCategory.Google => Color.Primary,
        SellerCategory.ThirdPartyReseller => Color.Secondary,
        SellerCategory.ThirdPartyAgency => Color.Info,
        _ => Color.Light
    };

    private static string FormatMonth(string yyyymm) =>
        yyyymm.Length == 6 && int.TryParse(yyyymm[..4], out var y) && int.TryParse(yyyymm[4..], out var m)
            ? new DateTime(y, m, 1).ToString("MMM yyyy")
            : yyyymm;
}
