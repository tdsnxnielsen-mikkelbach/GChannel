@* Marketplace orders (subscriptions / plans) from the Consumer Procurement API — entitlement-level view
   of third-party products, independent of whether they generated spend this month. *@

<Card Shadow="Shadow.Small">
    <CardBody>
        <Div Flex="Flex.JustifyContent.Between.AlignItems.Center" Margin="Margin.Is1.FromBottom">
            <Div>
                <Heading Size="HeadingSize.Is5" Margin="Margin.Is0">Marketplace orders</Heading>
                <Small TextColor="TextColor.Secondary">
                    Third-party subscriptions and plans on the billing account(s), from the Cloud Commerce Consumer Procurement API.
                </Small>
            </Div>
            @if (Result?.AsOf is { } asOf)
            {
                <Small TextColor="TextColor.Secondary">scanned @asOf.LocalDateTime.ToString("g")</Small>
            }
        </Div>

        @if (Loading)
        {
            <Progress Indeterminate Color="Color.Primary" Size="Size.Small" Margin="Margin.Is2.OnY" />
        }
        else if (Result is null || Result.Unconfigured)
        {
            <Paragraph TextColor="TextColor.Secondary">
                Marketplace order scan isn't configured (<code>GoogleBilling:MarketplaceOrdersEnabled</code> + service account).
            </Paragraph>
        }
        else
        {
            @if (Result.Errors.Count > 0)
            {
                <Alert Color="Color.Warning" Visible Margin="Margin.Is2.FromBottom">
                    Orders couldn't be read for @Result.Errors.Count billing account(s) — typically the Consumer Procurement API isn't
                    enabled or the service account lacks <code>consumerprocurement.orders.list</code>.
                    <Tooltip Multiline Text="@string.Join("\n", Result.Errors.Select(e => $"{e.Key}: {e.Value}"))" Inline><Anchor To="#" Class="small">details</Anchor></Tooltip>
                </Alert>
            }

            @if (Result.Orders.Count == 0)
            {
                <Paragraph TextColor="TextColor.Secondary">
                    @(Result.AsOf is null ? "No scan has completed yet." : "No Marketplace orders found.")
                </Paragraph>
            }
            else
            {
                <DataGrid TItem="MarketplaceOrder" Data="Result.Orders" Hoverable Narrow Sortable Responsive
                          ShowPager PageSize="25" ShowPageSizes PageSizes="_pageSizes" PagerPosition="DataGridPagerPosition.Bottom">
                    <DataGridColumns>
                        <DataGridColumn TItem="MarketplaceOrder" Field="@nameof(MarketplaceOrder.Provider)" Caption="Provider">
                            <DisplayTemplate>@(context.Item.Provider ?? "—")</DisplayTemplate>
                        </DataGridColumn>
                        <DataGridColumn TItem="MarketplaceOrder" Field="@nameof(MarketplaceOrder.DisplayName)" Caption="Order">
                            <DisplayTemplate>@(context.Item.DisplayName ?? context.Item.Name.Split('/').Last())</DisplayTemplate>
                        </DataGridColumn>
                        <DataGridColumn TItem="MarketplaceOrder" Field="@nameof(MarketplaceOrder.Name)" Caption="Product" Sortable="false">
                            <DisplayTemplate>
                                @foreach (var p in context.Item.Products) { <Small Display="Display.Block">@p</Small> }
                            </DisplayTemplate>
                        </DataGridColumn>
                        @if (ShowAccount)
                        {
                            <DataGridColumn TItem="MarketplaceOrder" Field="@nameof(MarketplaceOrder.BillingAccountId)" Caption="Billing account" Sortable="false">
                                <DisplayTemplate>
                                    <Small>@context.Item.BillingAccountId</Small>
                                    @if (context.Item.CustomerId is not null) { <Anchor To="@($"/customers/{context.Item.CustomerId}")" Class="small d-block">customer</Anchor> }
                                </DisplayTemplate>
                            </DataGridColumn>
                        }
                        <DataGridColumn TItem="MarketplaceOrder" Field="@nameof(MarketplaceOrder.Active)" Caption="State">
                            <DisplayTemplate>
                                <Badge Color="@(context.Item.Active ? Color.Success : Color.Secondary)" Pill>@(context.Item.Active ? "active" : "cancelled")</Badge>
                            </DisplayTemplate>
                        </DataGridColumn>
                        <DataGridColumn TItem="MarketplaceOrder" Field="@nameof(MarketplaceOrder.CreateTime)" Caption="Created">
                            <DisplayTemplate>@(context.Item.CreateTime?.LocalDateTime.ToString("d") ?? "—")</DisplayTemplate>
                        </DataGridColumn>
                    </DataGridColumns>
                </DataGrid>
            }
        }
    </CardBody>
</Card>

@code {
    private static readonly int[] _pageSizes = [25, 50];
    [Parameter] public MarketplaceOrdersResult? Result { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool ShowAccount { get; set; } = true;
}
