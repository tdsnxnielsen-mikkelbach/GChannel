@* Marketplace orders (subscriptions / plans) from the Consumer Procurement API — entitlement-level view
   of third-party products, independent of whether they generated spend this month. *@

<RadzenCard Variant="Variant.Filled">
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Gap="1rem" class="rz-mb-2">
        <div>
            <RadzenText TextStyle="TextStyle.H6" class="rz-m-0">Marketplace orders</RadzenText>
            <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0">
                Third-party subscriptions and plans on the billing account(s), from the Cloud Commerce Consumer Procurement API.
            </RadzenText>
        </div>
        @if (Result?.AsOf is { } asOf)
        {
            <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary-color rz-m-0 rz-text-nowrap">scanned @asOf.LocalDateTime.ToString("g")</RadzenText>
        }
    </RadzenStack>

    @if (Loading)
    {
        <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" ShowValue="false" class="rz-my-2" />
    }
    else if (Result is null || Result.Unconfigured)
    {
        <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color">
            Marketplace order scan isn't configured (<code>GoogleBilling:MarketplaceOrdersEnabled</code> + service account).
        </RadzenText>
    }
    else
    {
        @if (Result.Errors.Count > 0)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="rz-mb-2">
                Orders couldn't be read for @Result.Errors.Count billing account(s) — typically the Consumer Procurement API isn't
                enabled or the service account lacks <code>consumerprocurement.orders.list</code>.
                <Tip Text="@string.Join("\n", Result.Errors.Select(e => $"{e.Key}: {e.Value}"))"><RadzenLink Path="#" Text="details" class="rz-text-caption" /></Tip>
            </RadzenAlert>
        }

        @if (Result.Orders.Count == 0)
        {
            <RadzenText TextStyle="TextStyle.Body2" class="rz-text-secondary-color">
                @(Result.AsOf is null ? "No scan has completed yet." : "No Marketplace orders found.")
            </RadzenText>
        }
        else
        {
            <RadzenDataGrid TItem="MarketplaceOrder" Data="Result.Orders" AllowSorting="true" AllowPaging="true" PageSize="25" PageSizeOptions="_pageSizes"
                            ShowPagingSummary="true" Density="Density.Compact" GridLines="DataGridGridLines.Horizontal" Responsive="true">
                <Columns>
                    <RadzenDataGridColumn TItem="MarketplaceOrder" Property="@nameof(MarketplaceOrder.Provider)" Title="Provider">
                        <Template Context="order">@(order.Provider ?? "—")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MarketplaceOrder" Property="@nameof(MarketplaceOrder.DisplayName)" Title="Order">
                        <Template Context="order">@(order.DisplayName ?? order.Name.Split('/').Last())</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MarketplaceOrder" Title="Product" Sortable="false">
                        <Template Context="order">
                            @foreach (var p in order.Products) { <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Div" class="rz-m-0">@p</RadzenText> }
                        </Template>
                    </RadzenDataGridColumn>
                    @if (ShowAccount)
                    {
                        <RadzenDataGridColumn TItem="MarketplaceOrder" Title="Billing account" Sortable="false">
                            <Template Context="order">
                                <RadzenText TextStyle="TextStyle.Caption" TagName="TagName.Span" class="rz-m-0">@order.BillingAccountId</RadzenText>
                                @if (order.CustomerId is not null) { <RadzenLink Path="@($"/customers/{order.CustomerId}")" Text="customer" class="rz-text-caption rz-display-block" /> }
                            </Template>
                        </RadzenDataGridColumn>
                    }
                    <RadzenDataGridColumn TItem="MarketplaceOrder" Property="@nameof(MarketplaceOrder.Active)" Title="State">
                        <Template Context="order">
                            <RadzenBadge BadgeStyle="@(order.Active ? BadgeStyle.Success : BadgeStyle.Light)" IsPill="true" Text="@(order.Active ? "active" : "cancelled")" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MarketplaceOrder" Property="@nameof(MarketplaceOrder.CreateTime)" Title="Created">
                        <Template Context="order">@(order.CreateTime?.LocalDateTime.ToString("d") ?? "—")</Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
    }
</RadzenCard>

@code {
    private static readonly IEnumerable<int> _pageSizes = [25, 50];
    [Parameter] public MarketplaceOrdersResult? Result { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool ShowAccount { get; set; } = true;
}
