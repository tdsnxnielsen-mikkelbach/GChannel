@using Blazorise
@namespace GChannel.Web.Components
@* Shows how fresh synced read-model data is. Bound to the page's "as-of" timestamp. *@
<Tooltip Multiline Placement="TooltipPlacement.Bottom"
         Text="@(AsOf is null
             ? "No background sync has completed yet."
             : $"Last background reconciliation: {AsOf:yyyy-MM-dd HH:mm:ss} UTC. Changes you make here are written through immediately, and Google change events refresh the affected customer within seconds — so the list is usually fresher than this timestamp, which tracks the periodic full background sync.")">
    <Badge Color="Color.Light" Pill Class="text-body-secondary fw-normal">
        <Icon Name="@AppIcons.Schedule" Class="me-1" />
        As of @(AsOf is null ? "—" : $"{Relative(AsOf.Value)} ago")
    </Badge>
</Tooltip>

@code {
    [Parameter] public DateTimeOffset? AsOf { get; set; }

    private static string Relative(DateTimeOffset utc)
    {
        var span = DateTimeOffset.UtcNow - utc;
        if (span < TimeSpan.Zero) span = TimeSpan.Zero;
        if (span.TotalMinutes < 1) return $"{(int)span.TotalSeconds}s";
        if (span.TotalHours < 1) return $"{(int)span.TotalMinutes}m";
        if (span.TotalDays < 1) return $"{(int)span.TotalHours}h";
        return $"{(int)span.TotalDays}d";
    }
}
