{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run AppHost (Aspire)",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/src/GChannel.AppHost/GChannel.AppHost.csproj"
        },
        {
            "name": "Run AppHost (coreclr)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-apphost",
            "program": "${workspaceFolder}/src/GChannel.AppHost/bin/Debug/net10.0/GChannel.AppHost.dll",
            "cwd": "${workspaceFolder}/src/GChannel.AppHost",
            "launchSettingsProfile": "https",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "DOTNET_ENVIRONMENT": "Development"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "Login to the dashboard at \\b(https?://\\S+)",
                "uriFormat": "%s"
            }
        }
    ]
}
